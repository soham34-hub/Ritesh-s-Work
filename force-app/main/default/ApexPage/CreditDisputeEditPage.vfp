                        <apex:outputPanel id="letterSectionForInquiryRemoval" >
                            <apex:outputPanel >
                                <apex:pageBlockSection title="Letter Details"  rendered="{!case.Type='Inquiry Removal Request' && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)'}" >                         
                                    
                                    <apex:pageBlockSectionItem rendered="{! (case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)')}">
                                        <apex:outputLabel value="NC Property State"/>                            
                                        <apex:actionRegion >
                                            <!-- August 2024 - US1328358 - CD.01 - NC Property State Alignment with Letters Code
                                            <apex:inputField value="{!case.NC_Property_State__c}" > -->
                                            <apex:inputField value="{!case.NC_Property_State__c}" rendered="{! (case.Letters__c != 'CB105 - CBD NC Update' && case.Letters__c != 'CB106 - CBD NC Denial')}">
                                                <apex:actionSupport event="onchange" action="{!nullifyLetterFields}" rerender="letterSectionForInquiryRemoval" status="LetterStatus" />                                      
                                            </apex:inputField>
                                            <!-- August 2024 - US1328358 - CD.01 - NC Property State Alignment with Letters Code -->
                                            <apex:outputfield value="{!case.NC_Property_State__c}" rendered="{! (case.Letters__c == 'CB105 - CBD NC Update' || case.Letters__c == 'CB106 - CBD NC Denial')}"/>
                                        </apex:actionRegion>
                                    </apex:pageBlockSectionItem>
                                    
                                    <apex:pageBlockSectionItem rendered="{! !(case.Call_Source__c!='CARRT' && case.Call_Source__c!='MERT' && case.Call_Source__c!='CLEAR' && case.Call_Source__c!='Social Media' && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)' && case.Call_Source__c!='Legal' )}"/>
                                    
                                    <!-- Start Changes for the rendering conditions for the CD bug Fix 2015 -->   
                                    <apex:pageBlockSectionItem rendered="{!(case.Call_Source__c!='CARRT' && case.Call_Source__c!='MERT' && case.Call_Source__c!='CLEAR' && case.Call_Source__c!='Social Media' && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)' && case.Call_Source__c!='Legal' )}">
                                        <apex:outputLabel value="Letters"  />
                                        <apex:define name="requiredSelectAccount">
                                            <div class="requiredInput">
                                                <div class="requiredBlock" ></div> 
                                                <apex:actionRegion >
                                                    <apex:inputField value="{!case.Letters__c}" >
                                                        <apex:actionSupport event="onchange" action="{!assignStatusOnTheBasisOfLetter}" rerender="letterSectionForInquiryRemoval,DealershipInformationPanel,DealershipSection,InquiryPanel,InquirySection,InquiryRemovalSection1,InquiryRemovalSection,CaseClosurePanel,CaseClosureSection,CaseClosureSection1,MissingIformationPanel,DOFDAndPrincipal,DOFD1,Principal1,CurrentLoanBalance1,PrincipalName1,SuspenseBalance1,PrincipalAddress1,EscrowBalance1,PrincipalAddress2" status="LetterStatus" />
                                                    </apex:inputField> 
                                                </apex:actionRegion>
                                            </div>
                                        </apex:define>  
                                    </apex:pageBlockSectionItem>
                                    
                                    <!--CD Stories addition of new fields-->
                                    <apex:pageBlockSectionItem rendered="{!!case.NC_Property_State__c}"/>
                                    
                                    <apex:pageBlockSectionItem rendered="{! case.NC_Property_State__c}">
                                        <apex:outputLabel value="Check if Account is Delinquent"/>
                                        <apex:actionRegion >                           
                                            <apex:inputField id="debtDeliquency" value="{!case.Debt_Delinquency__c}" >                                                                                         
                                                <apex:actionSupport event="onchange"  action="{!nullifyLetterFields}" rerender="letterSectionForInquiryRemoval" status="LetterStatus" />                                      
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </apex:pageBlockSectionItem>
                                    <apex:pageBlockSectionItem rendered="{! case.Letters__c == null || case.Letters__c == 'No Letter Needed' || case.Letters__c == 'CB101 - DealerNbr Inquiries'}"/>
                                    
                                    <apex:pageBlockSectionItem id="options2" rendered="{!case.Letters__c != null && case.Letters__c != 'No Letter Needed' && case.Letters__c != 'CB101 - DealerNbr Inquiries'}">                             
                                        <apex:outputLabel value="Options"   /> 
                                        <apex:define name="requiredSelectAccount">
                                            <div class="requiredInput">
                                                <div class="requiredBlock" ></div> 
                                                <apex:actionRegion >
                                                    <apex:inputField value="{!case.Options__c}" >
                                                        <apex:actionSupport event="onchange" rerender="letterSectionForInquiryRemoval,lastReportingDate" status="LetterStatus" />                                         
                                                    </apex:inputField>   
                                                </apex:actionRegion>
                                            </div>
                                        </apex:define>                              
                                    </apex:pageBlockSectionItem> 
                                    
                                    <!-- <apex:inputField id="options" value="{!case.Options__c}" rendered="{!case.Letters__c != null && case.Letters__c != 'No Letter Needed'}" style="width:250px">
<apex:actionSupport event="onchange" rerender="LetterSection,lastReportingDate" status="LetterStatus" />                                         
</apex:inputField>-->
                                    <apex:pageBlockSectionItem rendered="{! !case.Debt_Delinquency__c }"/>
                                    
                                    <apex:inputField id="debtDeliquencyDate" value="{!case.Debt_Delinquency_Date__c}" rendered="{! case.Debt_Delinquency__c == true}"/>    
                                    
                                    <apex:pageBlockSectionItem rendered="{! case.Options__c == '104B - Duplicate Dispute'}"/>
                                    
                                    <apex:pageBlockSectionItem id="lastReportingDate" rendered="{!case.Options__c == '104B - Duplicate Dispute'}">
                                        <apex:outputLabel value="Last Reporting Date"   /> 
                                        <apex:define name="requiredSelectAccount">
                                            <div class="requiredInput">
                                                <div class="requiredBlock" ></div> 
                                                <apex:inputField value="{!case.Last_Reporting_Date__c}" />                                                                        
                                            </div>
                                        </apex:define>                              
                                    </apex:pageBlockSectionItem> 
                                    
