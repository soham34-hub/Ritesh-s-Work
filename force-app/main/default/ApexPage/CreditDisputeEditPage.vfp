                    <!--Inquiry Section-->
                    
                    <apex:outputPanel id="InquiryPanel"> 
                        <apex:outputPanel >           
                            <apex:pageBlockSection id="InquirySection" title="Inquiry" columns="2" rendered="{!case.Type!='Validation' && case.Type!='Internal Request' && case.Type!='MSP Task' && case.Type!='Inquiry Removal Request' &&  (case.Letters__c = 'Cannot Remove Inquiry Letter Credit Applied For' || case.Letters__c = 'Remove Inquiry letter')}"> <!--Added for Case Type=MSP Task-->
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Type of Account Applied For"/>
                                    <apex:define name="delphoneNumber" >
                                        <!--<apex:image value="{!$Resource.mandatorySign}" height="15px" width="5px" rendered="{!case.Letters__c = 'Cannot Remove Inquiry Letter Credit Applied For'}"  id="image4"/>-->
                                        <div class="requiredInput">
                                            <div class="requiredBlock" style="{!IF((case.Letters__c = 'Cannot Remove Inquiry Letter Credit Applied For' || case.Letters__c = 'Remove Inquiry letter') ,'background-color:C00','background-color:transparent')}"></div>       
