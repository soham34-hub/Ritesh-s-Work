                                    <apex:define name="delphoneNumber" >
                                        <!--<apex:image value="{!$Resource.mandatorySign}" height="15px" width="5px" rendered="{!OR(case.Letters__c = 'Cannot Remove Inquiry Letter Credit Applied For',case.Status='Closed')}"  id="image6"/>-->
                                        <div class="requiredInput"> <!--Start Credit Dispute Changes Warranty 1 End-->
