                                        <!-- June 2025 - US1450241 - CD.6 - Application ID for Inquiry Removal Request                        
                                        <div class="requiredBlock" style="{!IF((case.Letters__c = 'Cannot Remove Inquiry Letter Credit Applied For' || case.Letters__c = 'Remove Inquiry letter'),'background-color:C00','background-color:transparent')}"></div> -->       
                                        <div class="requiredBlock" style="{'background-color:C00','background-color:transparent')}"></div>                            
