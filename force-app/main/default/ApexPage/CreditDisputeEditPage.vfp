-->
                <apex:outputPanel id="ClientInfoPanelForMSPTask">  <!--Added for Case Type=MSP Task-->
                    <apex:outputPanel >           
                        <apex:pageBlockSection id="ClientInfoSection2" title="Client Information" columns="2" rendered="{!case.Type='MSP Task'}">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Account #"/>
                                <apex:inputField value="{!case.Account_Number__c}" required="{!case.Status='Closed'}"/>
                            </apex:pageBlockSectionItem>
                            <!-- April 2024 changes to set dispute lob for accont type-->
                            <!--apex:pageBlockSectionItem >
                                <apex:outputLabel value="Account Type"/>
                                <apex:inputField value="{!case.Account_Type__c}"/>
                            </apex:pageBlockSectionItem-->
                            
                            <apex:pageblockSectionItem >    
                                    <apex:outputLabel value="Account Type"/>
                                    <apex:actionRegion >
                                        <apex:inputfield value="{!case.Account_Type__c}" >
                                            <apex:actionsupport rerender="DisputeLOB" event="onchange" status="" action="{!nullifyAccountTypeDetail}"/>
                                        </apex:inputField>
                                    </apex:actionRegion> 
                                </apex:pageblockSectionItem>
                            <!-- April 2024 changes to set dispute lob for accont type-->
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                </apex:outputPanel>    
                
                <!--apex:pageBlockSection >
<apex:inputField value="{!case.Dispute_LOB__c}" required="true"/>   
</apex:pageBlockSection-->
                
                
                <!--apex:outputLabel value="Dispute LOB"/-->
                
                
                
            </apex:outputPanel> <!-- End of 'mainPanel'  -->    
            <apex:outputPanel id="DisputeLOB">
                <apex:pageBlockSection >
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Dispute LOB"/>
                        <apex:actionregion >
                        <apex:define name="requiredDisputeLOB"> 
                            <div class="requiredInput">
                                <div class="requiredBlock" style="background-color:C00"></div>                                            
                                <apex:inputField value="{!case.Dispute_LOB__c}">
                                    <apex:actionsupport event="onchange" action="{!handleDisputeLOB}" rerender="CaseClosurePanel,LetterDetailsPanel" status="InqRemovalStatus"/>
                                </apex:inputField>
                            </div>
                        </apex:define>
                        </apex:actionregion>
                    </apex:pageBlockSectionItem> 
                </apex:pageBlockSection> 
                </apex:outputPanel>
                
                <!--MARCH 2023-->
                            <apex:outputPanel id="CEOLineIndicator">
                                <apex:pageblockSection rendered="{!(case.Type == 'Internal Request' && (case.Account_Type__c =='Credit Card' || rendershowApplicationID=true))}" >
                                      
                                    <apex:pageBlockSectionItem >
                                        <apex:outputlabel value="CEO Chairman line indicator" />
                                        <apex:inputField value="{!case.CEO_Chairman_line_indicator__c}"/>
                                    </apex:pageBlockSectionItem>
                                </apex:pageblockSection>
                            </apex:outputPanel>   
                            <!--MARCH 2023-->
            
            
            
            <!-- *****************************Letter Details**************************    -->
            <apex:actionRegion >
                
                <!-- Start Changes for the rendering conditions for the CD bug Fix 2015 -->
                
                <apex:outputPanel id="LetterDetailsPanel">
                    <!-- Mohan Changes for US1610716  -->
                    <apex:outputPanel rendered="{!(( case.Type == 'QWR' || case.Type == 'Dispute' || case.Type == 'Deposit Dispute') && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)')}" >
                        
                        <apex:pageBlockSection id="LetterSection" title="Letter Details"  columns="2">     <!--Added for Case Type=MSP Task-->
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="NC Property State"/>                            
                                <apex:actionRegion >
                                    <!-- August 2024 - US1328358 - CD.01 - NC Property State Alignment with Letters Code 
                                    <apex:inputField value="{!case.NC_Property_State__c}" rendered="{! (case.Type == 'QWR' || case.Type == 'Dispute') && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)'}"> -->
                                    <!-- Mohan Changes US1610716 -->
                                    <apex:inputField value="{!case.NC_Property_State__c}" rendered="{! (case.Type == 'QWR' || case.Type == 'Dispute' || case.Type == 'Deposit Dispute') && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)' && (case.Letters__c != 'CB105 - CBD NC Update' && case.Letters__c != 'CB106 - CBD NC Denial')}">    
                                        <apex:actionSupport event="onchange" action="{!nullifyLetterFields}" rerender="LetterDetailsPanel" status="LetterStatus" />                                      
                                    </apex:inputField>
                                    <!-- August 2024 - US1328358 - CD.01 - NC Property State Alignment with Letters Code -->
                                     <!-- Mohan Changes US1610716 -->
                                    <apex:outputfield value="{!case.NC_Property_State__c}" rendered="{! (case.Type == 'QWR' || case.Type == 'Dispute' || case.Type == 'Deposit Dispute') && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)' && (case.Letters__c == 'CB105 - CBD NC Update' || case.Letters__c == 'CB106 - CBD NC Denial')}"/>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!-- Code added for alignment of fields -->
                            <apex:pageBlockSectionItem rendered="{!( case.Call_Source__c=='CARRT' || case.Call_Source__c=='MERT' || case.Call_Source__c=='CLEAR' || case.Call_Source__c=='CFS' || case.Call_Source__c=='Social Media' || case.Call_Source__c=='eOscar(Non Fraud)' || case.Call_Source__c=='eOscar(Fraud)' || case.Call_Source__c=='Legal' || case.Type == 'QWR' || case.Type == 'Inquiry Removal Request' )}"/ >
                                
                                <apex:pageBlockSectionItem rendered="{!( case.Call_Source__c!='CARRT' && case.Call_Source__c!='MERT' && case.Call_Source__c!='CLEAR' && case.Call_Source__c!='CFS' && case.Call_Source__c!='Social Media' && case.Call_Source__c!='eOscar(Non Fraud)' && case.Call_Source__c!='eOscar(Fraud)' && case.Call_Source__c!='Legal' && case.Type != 'QWR' && case.Type != 'Inquiry Removal Request' )}" >
                                    <apex:outputLabel value="Letters" />                            
                                    <apex:define name="requiredSelectAccount">
                                        <div class="requiredInput">
                                            <div class="requiredBlock" style="{!IF(AND(case.Status='Closed',Case.Call_Source__c!='Escalation Banking Operations',Case.Call_Source__c!='Escalation Mortgage'),'background-color:C00','background-color:transparent')}"></div> 
                                            <!--apex:actionRegion-->
                                            <apex:inputField value="{!case.Letters__c}" >
