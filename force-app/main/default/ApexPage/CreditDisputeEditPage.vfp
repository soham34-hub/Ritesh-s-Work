                            <apex:pageBlockSection title="Dealership Information" columns="2" rendered="{!case.Type!='Validation' && case.Type!='Internal Request' &&  case.Type!='MSP Task' && case.Letters__c == 'CB101 - DealerNbr Inquiries'}" > <!--Added for Case Type=MSP Task-->
                                
                                <apex:pageBlockSectionItem >
                                    
                                    <apex:outputLabel value="Dealership Name"/>
                                    <apex:define name="delphoneNumber" >
                                        <!--<apex:image value="{!$Resource.mandatorySign}" height="15px" width="5px" rendered="{!case.Letters__c = 'Dealership Credit Inquiry Valid Letter'}"  id="image1"/>-->
                                        <div class="requiredInput">
                                            <div class="requiredBlock" style="{!IF(case.Letters__c = 'CB101 - DealerNbr Inquiries','background-color:C00','background-color:transparent')}"></div>       
