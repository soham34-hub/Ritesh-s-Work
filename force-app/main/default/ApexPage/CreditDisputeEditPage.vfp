                    <!-- ********************** MISSING INFORMATION/INVESTIGATION ******************* -->    
                    <apex:outputPanel id="MissingIformationPanel"> 
                        <apex:outputPanel >           
                            <apex:pageBlockSection title="Missing Information / Investigation" columns="2" rendered="{!case.Type!='Validation' && case.Type!='Internal Request' && case.Type!='Inquiry Removal Request' && case.Type!='MSP Task' && case.Type!='QWR' && (case.Letters__c = 'STB Missing Info' || case.Letters__c = 'STM Missing Info')}"> <!--Added for Case Type=MSP Task-->
