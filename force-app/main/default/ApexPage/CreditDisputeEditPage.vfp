                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="ACAPS # / Application #"/> <!--//This field is repeated in the requirement. It is present in the first section 'Case Type Details' section and this section. It needs to be clarified.-->
                                <apex:inputField value="{!case.ACAPS__c}" />
