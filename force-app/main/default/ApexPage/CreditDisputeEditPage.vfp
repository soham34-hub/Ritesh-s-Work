                    <apex:outputPanel id="CaseClosurePanel">             
                        <apex:outputPanel >
                            <apex:pageBlockSection id="CaseClosureSection1" title="Case Closure" columns="2" rendered="{! case.Type!='Internal Request' && case.Type!='MSP Task'}">  <!--Added for Case Type=MSP Task-->
                                
                                
                                <!-- October 2024 - US1381479 - CD.1 - Decision Code for Direct Cases -->
                                <!-- <apex:pageBlockSectionItem rendered="{!case.Type='Inquiry Removal Request' || case.Type='Dispute' || case.Type='QWR' }">  --> 
                                 <!-- Mohan Changes US1610716 -->
                                <apex:pageBlockSectionItem rendered="{!((case.Type='Inquiry Removal Request' || case.Type='QWR') || ((case.Type='Dispute' ||case.Type = 'Deposit Dispute')  && (case.Call_Source__c = 'eOscar(Fraud)' || case.Call_Source__c = 'eOscar(Non Fraud)' || case.Call_Source__c = Null))) }">
                                    <apex:outputlabel value="Decision Code" /> 
                                    <apex:define name="delphoneNumber" >
                                        <!--<apex:image value="{!$Resource.mandatorySign}" height="15px" width="5px" rendered="{!case.Status='Closed'}"  id="image4"/>-->        
