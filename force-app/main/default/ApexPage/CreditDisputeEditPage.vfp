<apex:actionSupport event="onchange" rerender="LetterSection,lastReportingDate" status="LetterStatus" />                                         
</apex:inputField> -->          <apex:pageBlockSectionItem rendered="{! case.NC_Property_State__c && case.Dispute_LOB__c == 'Mortgage'}">
