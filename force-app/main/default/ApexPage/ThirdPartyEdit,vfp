<apex:page standardController="Case" action="{!retrieveArrangementSummariesList}" extensions="ThirdPartyEdit_ControllerExtension,CategoryLists_ControllerExtension,CMIClientManagement_ControllerExtension,ExecutiveServiceEdit_ControllerExtension" showHeader="True" sidebar="False" id="id1">

    <apex:messages style="color:red;font-weight:bold;" />
    
    <script type="text/javascript" >            
        var originalOnload = window.onload;
        window.onload = rootCauseDetailPageLoad;
        function rootCauseDetailPageLoad() 
        {
            originalOnload();
            if(document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='Non SunTrust Impact')
            { 
                document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseDetails}').style.display='none';
            }         
        }  
        
        function hidefieldsrootCauseDetail()
        {
         
             if(document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseFields.id3}').value=='Non SunTrust Impact')
             {
                 
                 document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseDetails}').style.display='none';
             }
             else
             {
                 document.getElementById('{!$Component.id1.editForm.thirdPartyedit.rootCauseDetails}').style.display='block';
             }
        }
        <!--start changes for CMI 2016 December release-->
        <!--Complaint From or About A Supplier is nullified on selecting supplier search-->
        function vendorsearch()
        {
             document.getElementById('{!$Component.id1.editForm.thirdPartyedit.clientFeedbackDetails.SupplierBlock.SupplierField}').value='';      
        }
        <!--End changes for CMI 2016 December release-->
        function noenter(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:thirdPartyedit:CategoryPanel:catButton1:catSearchButton');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
        
    </script>
       
    <apex:form id="editForm">        
        <!-- B-2078 changes for CMI September 2018 Release--> 
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
        <!-- End of B-2078 changes for CMI September 2018 Release-->
        <apex:pageBlock title="Third Party Case" mode="edit" id="thirdPartyedit">
            
            <apex:pageBlockButtons location="both">
                <apex:commandbutton action="{!save}" value="Save"/>
                <apex:commandbutton action="{!cancel}" value="Cancel"/>
            </apex:pageBlockButtons>
                                        
            <apex:pageBlockSection title="Case Information" id="CaseInformation">
                <apex:outputField value="{!case.CaseNumber}"/>
                <apex:outputField value="{!case.RecordTypeId}"/>
                <apex:outputField value="{!case.OwnerId}"/>
                <apex:outputField value="{!case.Origin}"/>
                <!-- ********************************************* -->
                <!-- *   DR-2656 September 2018 monthy Release   * -->
                <!-- ********************************************* -->
                <!----Start changes for DR-2656 for September 2018 Release -->
                <apex:inputField value="{!case.Case_Group_Assignment__c}"
                                 rendered="{!AND((case.Auto_Closed_Review__c==true), case.Case_Group_Assignment__c=='CAO')}"/>
                <apex:outputField value="{!case.Case_Group_Assignment__c}"
                                  rendered="{!AND((case.Auto_Closed_Review__c==false), case.Case_Group_Assignment__c=='CAO')}"/>
                
                <!----End changes for DR-2656 for September 2018 Release -->
                
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Source of Feedback?" />
                    <apex:actionRegion >                        
                        <apex:inputField value="{!case.Call_Source__c}" required="true" >
                            <apex:actionSupport event="onchange" rerender="CFPBPanel,CaseInformation,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess" status="SOFStatus"/>                            
                        </apex:inputField>
                    </apex:actionRegion>                                
                </apex:pageBlockSectionItem>                
                
                <apex:pageBlockSectionItem rendered="{!case.Call_Source__c == 'Attorney General' || case.Call_Source__c == 'Agency'}"/>                
                <apex:pageBlockSectionItem rendered="{!case.Call_Source__c == 'Attorney General'}">
                    <apex:outputLabel value="AG State" />                                
                    <apex:inputField value="{!case.AG_State__c}" rendered="{!case.Call_Source__c == 'Attorney General'}"/>                                
                </apex:pageBlockSectionItem>              
               
                <apex:pageBlockSectionItem rendered="{!case.Call_Source__c == 'Agency'}"> 
                    <apex:outputLabel value="Agency Name" />                           
                    <apex:inputText value="{!Case.Agency_Name__c}"/>                                                              
                </apex:pageBlockSectionItem>
                                
                
                <apex:pageblocksectionitem >
                    <apex:outputLabel value="Case Type"/>               
                    <apex:actionRegion >                                                
                        <apex:inputField value="{!case.Type}" required="true">  
                            <!--Start Changes for CMI October 2017 Release-->                              
                            <apex:actionSupport event="onchange" rerender="FeedbackComplaintDesignation,authThirdParty,servicingInteractionDispositonFields" status="SOFStatus"/>
                            <!--End Changes for CMI October 2017 Release-->
                        </apex:inputField>                              
                    </apex:actionRegion>
                </apex:pageblocksectionitem>                                               
                
                <apex:outputField value="{!case.Escalation_Case_Type__c}"/>                    
                <apex:outputField value="{!case.Source_Received_Date_Time__c}"/>                                                             
            </apex:pageBlockSection>
                
            <apex:actionStatus id="SOFStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
                
            <apex:pageBlocksection title="Supplier Client Information">
                <apex:outputField value="{!case.Client_Prospect_Name__c}"/>
                <apex:outputField value="{!case.Historic_CIN__c}"/>
                <apex:outputField value="{!case.Client_Prospect_Address__c}"/> <br/>
                <apex:outputField value="{!case.Co_Signer_Name__c}"/> <br/>
                <apex:inputField value="{!case.Loan_Account_or_Client_Identifier__c}" required="true" />
            </apex:pageBlocksection>
                
            <apex:pageBlocksection title="Client Information" id="ClientInfoPanel">
                <apex:pageblocksectionitem >
                    <apex:outputlabel value="Is this a Client?"/>
                        <apex:actionRegion >                                                    
                        <apex:inputField value="{!case.Is_this_a_Client__c}" required="true">                                
                            <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="nameSearch,modalDialog,renderAccountDetails,ClientInfoPanel,authThirdParty,ClientSectionAfterBypassingSearchClient" status="clientInformationStatus"/>
                        </apex:inputField>
                        </apex:actionRegion>                        
                </apex:pageblocksectionitem>
            </apex:pageBlocksection>
                
            <apex:outputPanel id="modalDialog">
                <apex:pageblockSection columns="2" rendered="{!case.Is_this_a_Client__c='Yes'}">                        
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch,LobAccountDetailsPanel" value="Search Client" disabled="{!case.BypassSearchProcess__c}"/>                                                                               
                    
                    <c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                        <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>                            
                        <br/>                   
                    </c:Modal_Dialog>
                </apex:pageblockSection>
                
                
                <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='No'}">                        
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>
                    <c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                        <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase" />
                        <div style="text-align:center">
                            <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetailsForCreateClient,authThirdParty" value="Return To Case" />
                        </div>
                        <br/>
                    </c:Modal_Dialog>                     
                </apex:pageblockSection>
            </apex:outputPanel>
                
            <apex:actionStatus id="clientInformationStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
                
            <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient">
                
                <apex:outputPanel rendered="{!((assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes') || (case.Is_this_a_Client__c='Yes' && case.Call_Source__c ='BBT Internal'))}">                         
                    <apex:pageBlockSection >                         
                        <apex:pageBlockSectionItem >    
                            <apex:outputlabel value="Bypass Client Search"/> 
                                <apex:actionRegion > 
                                <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                   <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="ClientSectionAfterBypassingSearchClient,modalDialog,nameSearch,FieldsOnBypassingSearchProcess,authThirdParty"  status="bypassClientStatus"/>
                                </apex:inputCheckbox> 
                                </apex:actionRegion> 
                         </apex:pageblocksectionitem>
                    </apex:pageBlockSection>
                </apex:outputPanel>
                    
                    
                    
                <!--<apex:outputPanel rendered="{!(case.Reason_for_Overriding_Search_Process__c != null && !case.BypassSearchProcess__c && case.Is_this_a_Client__c='Yes')}">                         
                    <apex:pageBlockSection >                             
                        <apex:pageblockSectionItem >
                            <apex:outputlabel value="Reason for Bypass"/>
                            <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                        </apex:pageblockSectionItem>                            
                    </apex:pageBlockSection>
                </apex:outputPanel>-->
                
            </apex:outputPanel>
                
            <apex:actionStatus id="bypassClientStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
                
            <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                <apex:outPutPanel rendered="{!case.BypassSearchProcess__c}">
                    <apex:pageBlockSection columns="1" >                              
                        <apex:pageBlockSectionItem >                                
                            <apex:outputlabel value="Reason for Bypass"/>
                            
                                <apex:actionRegion >
                                <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                    <apex:actionSupport event="onchange" rerender="CINField"  status="bypassReasonStatus"/>
                                </apex:inputField>
                                </apex:actionRegion>
                        </apex:pageBlockSectionItem> 
                                                     
                    </apex:pageBlockSection>
                                           
                    <apex:pageBlockSection >
                    <apex:inputField value="{!case.Contact_Name__c}" required="true"/><br/>                        
                    <apex:inputField value="{!case.Contact_Phone__c}" required="true"/>
                    </apex:pageBlockSection>  
                    
                     <apex:pageBlockSection id="CINField" columns="1">                              
                        <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available'}"/>                            
                    </apex:pageBlockSection>  
                    
                    <apex:actionStatus id="bypassReasonStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                            
                    <apex:pageBlockSection >                              
                        
                         
                         <apex:pageBlockSectionItem >
                             <apex:outputlabel value="Is This A Private Wealth Client?" />
                                <apex:actionRegion > 
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                    <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                </apex:inputField>
                                </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <br/>                                
                         <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>
                         <br/>
                         <!--Start changes for CMI BBT Pilot M07 2020 -->
                         <apex:inputField value="{!case.CIF__c}" required="false" rendered="{!case.BypassSearchProcess__c && case.Call_Source__c = 'BBT Internal'}"/> 
                         <apex:outputField value="{!case.CIF__c}" rendered="{!case.BypassSearchProcess__c=False}"/>                                 
                         <!--End changes for CMI BBT Pilot M07 2020 -->
                        <br/>
                         <apex:pageBlockSectionItem >
                             <apex:outputlabel value="Account Type"/>
                                 <apex:actionRegion >
                                 <apex:inputField value="{!case.Account_Type__c}" required="true">
                                     <apex:actionSupport event="onchange" reRender="accTypeDetail,AlternateAddress,AccountNumber,ClientStateDetailsSection1,accTypeInput" status="AccountTypeStatus" action="{!defaultAccountTypeDetailField}"/>
                                 </apex:inputField>
                                 </apex:actionRegion>
                         </apex:pageBlockSectionItem>
                         
                    </apex:pageBlockSection>                        
                        
                    <apex:pageBlockSection id="AccountNumber">
                        <apex:inputField id="AccountNumber" value="{!case.Account_Number__c}" required="true"/> 
                    </apex:pageBlockSection>

                    <apex:pageBlockSection id="accTypeDetail"> 
                    <!--Start of changes for feb 2017-->
                    <!--Account type detail should render for account type=Commercial loan-->                                                       
                    <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Wholesale Other' || case.Account_Type__c = 'Consumer Loan' || case.Account_Type__c = 'Commercial Loan'}"  required="true"/>                                                        
                    <!--End of changes for feb 2017-->
                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}"/>
                    
                    </apex:pageBlockSection>                        
                </apex:outPutPanel>
            </apex:outPutPanel>
                
            <apex:actionStatus id="AccountTypeStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
                                
            <apex:outPutPanel id="nameSearch"> 
                
                    <apex:pageblockSection columns="2" rendered="{!(case.CIN__c!=Null) && (NOT(case.BypassSearchProcess__c))}" >
                        
                        <apex:pageBlockSectionItem rendered="{!case.Account_Type__c==null || case.Account_Type__c==''}">
                            <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                            <apex:define name="requiredSelectAccount">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >                                
                                        <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                                            <apex:selectOptions value="{!accountsList}"/>
                                            <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="nameSearch,selectAccountModal, renderAccountDetails, renderAccountDetailsForCreateClient,accountFields,accTypeDetail1,relationshipManagedBySAD,crsWin" status="selectAccountStatus"/>
                                        </apex:selectList>                                               
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        
                        <apex:pageBlockSectionItem rendered="{!case.Account_Type__c!=null && case.Account_Type__c!=''}">
                            <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                            
                                    <apex:actionRegion >                                
                                        <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                                            <apex:selectOptions value="{!accountsList}"/>
                                            <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="nameSearch,selectAccountModal, renderAccountDetails, renderAccountDetailsForCreateClient,accountFields,accTypeDetail1,relationshipManagedBySAD,crsWin" status="selectAccountStatus"/>
                                        </apex:selectList>                                               
                                    </apex:actionRegion>
                                
                        </apex:pageBlockSectionItem>                         
                            
                        <!--Start changes for CMI 2016 April release.Client Name is displayed as a link to open the Related Account Record-->
                        <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null}">
                            <apex:outputLabel value="Client Name"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2016 April release.-->                        
                        
                        <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->
                        <apex:pageBlockSectionItem rendered="{!AND(case.Account_Number__c<>null,selectedAccountInformation!='Other',case.Client_Name__c!=Null,case.Client_Name__c!='',stProductId!=null,stProductId!='')}">
                            <apex:outputLabel value="Account Number"/>
                            <apex:actionRegion >                                                                                                   
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>                                    
                        <apex:outputField rendered="{!AND(case.Account_Number__c<>null,selectedAccountInformation!='Other',case.Client_Name__c!=Null,case.Client_Name__c!='',OR(stProductId=null,stProductId=''))}" value="{!case.Account_Number__c}"/>
                        <!--End changes for CMI 2016 June Release-->                        
                        <apex:inputField rendered="{!(renderAccountType || comingAfterCreatingClient)}" value="{!case.Account_Number__c}"  required="true"/>                        
                        <apex:pageBlockSectionItem rendered="{!case.Account_Number__c==Null && case.Account_Number__c=='' && selectedAccountInformation==Null}"/>
                        <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                        
                        <apex:outputField rendered="{!case.Account_Type__c<>null &&  !renderAccountType && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type__c}"/>
                        
                        <apex:pageBlockSectionItem rendered="{!(renderAccountType|| comingAfterCreatingClient)}">
                            <apex:outputlabel value="Account Type" rendered="{!(renderAccountType || comingAfterCreatingClient)}"/>
                                <apex:actionRegion >                        
                                <apex:inputField rendered="{!(renderAccountType || comingAfterCreatingClient)}" value="{!case.Account_Type__c}"  required="true">
                                    <apex:actionSupport event="onchange"  reRender="accTypeDetail1,ClientStateDetailsSection1,relationshipManagedBySAD,accTypeInput,lob,LOBAccountDetailsPanel,crsWin" status="selectAccountStatus" action="{!defaultAccountTypeDetailField}"/>
                                </apex:inputField>
                                </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                            
                        <apex:pageBlockSectionItem rendered="{!case.Account_Number__c==Null && case.Account_Number__c=='' && selectedAccountInformation==Null && !comingAfterCreatingClient}"/>
                        <apex:outputField rendered="{!case.Business_or_Personal__c<>null}" value="{!case.Business_or_Personal__c}"/>
                        
                        <!--<apex:pageblockSectionItem rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}"/>
                        <apex:outputField rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}" value="{!case.HH_Info__c}"/>-->
                        <apex:pageblockSectionItem rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}"/>
                        <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>                                                                                    
                        <!--<apex:pageblockSectionItem rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}"/>
                        <apex:outputField rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}" value="{!case.Client_Segmentation_Code__c}"/>-->
                        
                    </apex:pageblockSection>
                        
                    <apex:pageblockSection id="accTypeDetail1" rendered="{! NOT(case.BypassSearchProcess__c)}" > 
                        <!--Start of changes for feb 2017-->
                        <!--Account type detail should render for account type=Commercial loan-->
                        <apex:pageBlockSectionItem rendered="{!(case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Consumer Loan' || case.Account_Type__c='Private Wealth Mgmt' || (case.Business_or_Personal__c = 'Business' && case.Account_Type__c = 'Wholesale Other') )}">
                                <apex:outputLabel value="Account Type Detail" />
                                <apex:define name="requiredSelectAccount">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                            <apex:selectOptions value="{!acctTypeDetailFieldValue}"/>                                                    
                                        </apex:selectList>
                                    </div>
                                </apex:define> 
                        </apex:pageBlockSectionItem>
                         <!--End of changes for 2017-->
                    </apex:pageblockSection>                                                        
                                                    
                    <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                        <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                        <br/>
                    </c:Modal_Dialog>
                        
                    <apex:actionStatus id="selectAccountStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                
            </apex:outPutPanel>
            
            <apex:pageBlockSection columns="1" id="authThirdParty"> 
                           <apex:pageBlockSectionItem rendered="{!AND(NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Service Request',case.Type='Tracking Only'))}" >
                                <apex:outputlabel value="Is This An Authorized Third Party" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!AND(NOT(case.BypassSearchProcess__c))}">

                                        <apex:actionSupport event="onchange"  reRender="authThirdParty" status="ClientStatus"/>
                                    </apex:inputField> 
                                </apex:actionRegion> 
                           </apex:pageBlockSectionItem>
                            <apex:inputField rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only',case.Type='Service Request'))}" required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}"/>
                            <apex:inputField rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only',case.Type='Service Request'))}" value="{!case.Contact_Phone__c}"/>
                        </apex:pageBlockSection>
            
            <apex:pageBlockSection >
                <apex:inputField value="{!case.Functional_Area__c}" required="true"/>
            </apex:pageBlockSection>
                                                
            <apex:outputpanel id="LOBAccountDetailsPanel" >
                <apex:actionRegion >   
                    
                    <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c)}"  title="LOB Account Details">
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This A Private Wealth Client?" rendered="{!NOT(case.BypassSearchProcess__c)}"/>
                            
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!NOT(case.BypassSearchProcess__c)}" required="{!case.LOB_Relationship__c=='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Account_Type__c == 'Private Wealth Mgmt' || case.Account_Type__c == 'Investment Services'}">                                
                                    <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="lob,officerId"/>                                
                                </apex:inputField>
                            
                        </apex:pageBlockSectionItem>                                                                       
                    </apex:pageBlockSection>
                    
                    <apex:outputPanel id="lob">
                        <apex:outputPanel >  
                            <apex:pageBlockSection columns="2" >
                                <apex:outputField value="{!case.LOB_Relationship__c}" rendered="{!(case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c =='PWM')}"/>                                                                
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputlabel value="Relationship Id" />
