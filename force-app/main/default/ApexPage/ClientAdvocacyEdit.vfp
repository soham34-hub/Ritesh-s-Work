            <apex:actionRegion > 
                <div style="margin-bottom:-1.0%"> 
                    <apex:outputpanel styleclass="grey">
                        <apex:pageBlockSection title="Client Feedback Details" id="clientFeedbackDetails" columns="2" collapsible="false">
                            <apex:pageblocksectionitem >
                                <apex:outputlabel value="Is Feedback Regarding TM/Dept/Supp/Dlr?" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />                        
                                <apex:inputField value="{!case.Is_Feedback_regarding_a_TM_Dept__c}" required="{!case.Type='Complaint'}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" >
                                    <apex:actionSupport event="onchange" rerender="clientFeedbackDetails,supplierDetailsPanel2,supplierDetailsPanel,servicingChallenges,ServicingChallengesReported,SupportInfo,ThirdPartydetails,dealerDetailsPanel" status="feedbackDetailStatus"/>
                                </apex:inputField>                        
                            </apex:pageblocksectionitem>
                            
                            <c:CustomLookup value="{!Case.Dealer_Search__c}" object="Vendor_Management__c" 
                                            objectName="Case" fieldName="Dealer_Search__c" 
                                            displayFields="Dealer_Number__c,Brief_Description__c,Dealer_Location_City__c,Dealer_Location_ID__c,ActiveOrInactive__c" 
                                            dealerType="{!case.Is_Feedback_regarding_a_TM_Dept__c}"
                                            rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CACPRManagerProfile))}"
                                            required="{!OR(case.Is_Feedback_regarding_a_TM_Dept__c='Dealer - Regional Acceptance Corp',case.Is_Feedback_regarding_a_TM_Dept__c='Dealer - Sheffield Financial, LLC')}"/>
                            <apex:outputField value="{!Case.Dealer_Search__c}"
                                              rendered="{!AND(CACPRManagerProfile,case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'')}" />
                            <br/>
                            <c:CustomLookup value="{!Case.Teammate_Search__c}" object="Contact"
                                            objectName="Case" fieldName="Teammate_Search__c"
                                            displayFields="Email,Title,Phone"
                                            rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CACPRManagerProfile))}"  required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Truist Teammate'|| case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate'}"/>
                            <apex:outputField value="{!Case.Teammate_Search__c}"
                                              rendered="{!AND(CACPRManagerProfile,case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'')}" />
                            
                            <!--apex:inputField value="{!Case.Teammate_Search__c}" rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CRTQualityAssuranceSpecialist))}"  required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Truist Teammate'|| case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate'}"/-->
                            <br/>
                            <!--Added below Field for JAN22 Release-->
                            <apex:inputField value="{!case.Secondary_Teammate_Search__c}" rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CRTQualityAssuranceSpecialist))}" />
                            <br/>
                            <c:CustomLookup id="branchSearch"
                                            value="{!Case.Department_Search__c}" object="Org_Unit__c"
                                            objectName="Case" fieldName="department_search__c"
                                            displayFields="RecordType.Name,Cost_Center__c,Address__c,City__c,State__c"
                                            rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',Case.Department_Search__c!=Null,Case.Department_Search__c!='',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CACPRManagerProfile))}" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI'}" />
                            <apex:outputField value="{!Case.Department_Search__c}"
                                              rendered="{!AND(CACPRManagerProfile,Case.Department_Search__c!=Null,Case.Department_Search__c!='',case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'')}" />
                            <!--Start TeammatePackage May 2022-->
                            <c:CustomLookup id="branchSearch2"
                                            value="{!Case.Truist_Department_Search__c}" object="sfte_teammate__Center__c"
                                            objectName="Case" fieldName="Truist_Department_Search__c"
                                            displayFields="RecordType.Name,sfte_teammate__Center_Number__c,sfte_teammate__Address__c,sfte_teammate__City__c,sfte_teammate__State__c"
                                            rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,(Case.Department_Search__c=Null || Case.Department_Search__c=""),case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CACPRManagerProfile))}" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI'}" />
                            <apex:outputField value="{!Case.Truist_Department_Search__c}"
                                              rendered="{!AND(CACPRManagerProfile,case.Is_Feedback_regarding_a_TM_Dept__c!='No',(Case.Department_Search__c=Null || Case.Department_Search__c=""),case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'')}" />
                            
                            <!--End TeammatePackage May2022 -->
                            
                            <!--apex:inputField value="{!Case.Department_Search__c}" rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null,case.Is_Feedback_regarding_a_TM_Dept__c<>'',NOT(CRTQualityAssuranceSpecialist))}" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI'}" /-->
                            <br/>
                            
                            <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}">
                                <apex:outputlabel value="Supplier Search" rendered="{!NOT(CRTQualityAssuranceSpecialist)}"/>
                                <apex:define name="requiredSupplier">
                                    <div class="requiredInput">
                                        <div class="{!IF(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','requiredBlock','')}" ></div>                                                          
                                        <apex:inputField value="{!case.Vendor_Search__c}"  rendered="{!NOT(CRTQualityAssuranceSpecialist)}" onclick="vendorsearch();">
                                            <apex:actionSupport event="onchange" action="{!populateSupplierRelatedFields}" reRender="supplierDetailsPanel,supplierDetailsPanel2,clientFeedbackDetails,activeSupplier" status="complaintDetailStatus"/>
                                        </apex:inputField>
                                    </div>
                                </apex:define>                        
                            </apex:pageBlockSectionItem>
                            
                            <apex:outputField value="{!case.Vendor_Search__c}" rendered="{!AND(CRTQualityAssuranceSpecialist,case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null)}"/>
                            <apex:pageBlockSectionItem rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='') }" />
                            
                            <apex:pageBlockSectionItem id="SupplierBlock" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) && case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c!='' }">
                                <apex:outputlabel value="Complaint from or about a Supplier?"/>
                                <apex:define name="requiredComplaintFromSupplier">
                                    <div class="requiredInput">
                                        <div class="{!IF((case.Vendor_Search__c!=Null&&case.Vendor_Search__c!='')|| case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','requiredBlock','')}"></div>  
                                        <apex:inputField value="{!case.Complaint_From_or_About_A_Supplier__c}" id="SupplierField"></apex:inputField>
                                    </div>
                                </apex:define>
