                <div style="margin-left:-2.00%;margin-top:-1.50%; padding-left: 15px;">
                    <apex:pageblocksection id="servicingChallenges">
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' &&  (case.Type == 'Service Request' || case.Type == 'Complaint')  }" > 
                            <apex:outputLabel value="Servicing Challenges Category"/>
                            <apex:define name="requiredServicingCategory">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>  
                                    <apex:inputfield style="min-width: fit-content" value="{!case.Servicing_Challenges_Category__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>                              
                        
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && (case.Type != 'Complaint' || case.Type != 'Service Request') }"/> 
                    </apex:pageBlockSection>
                </div>
            </apex:actionRegion>
            
            <div style="margin-top:-1.0%">
                
                <apex:pageBlockSection id="ServicingChallengesReported"> 
                    <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && (case.Type == 'Service Request' || case.Type == 'Complaint') && NOT(CACPRManagerProfile) }"> 
                        <apex:outputLabel value="Servicing Challenges Reported"/>                          
                        <apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7"  />                            
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Servicing_Challenges_Reported__c}"
                                      rendered="{!OR(CACPRManagerProfile)}" />
                </apex:pageBlockSection>                  
            </div>
            
            <div style="margin-top:-1.0%">                
                <apex:pageBlockSection id="Description">                
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(CACPRManagerProfile),case.Type='Complaint')}">
                        <!--Mohan Changes as part of US1654407 (M10) -->
                        <!-- US1900225 - (DR-4317) M.1 - Client Feedback Alignment -->
                        <apex:outputLabel value="Client Feedback" style="display:block;width:154px;"/>
                        <apex:define name="requiredQ2">
                            <div class="requiredInput" >
                                <div class="requiredBlock"></div>
                                <apex:inputTextArea required="{!case.Type='Complaint'}"  value="{!case.Description}" style="width:1000px;height:170px;"/>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(CACPRManagerProfile),case.Type!='Complaint')}">
                        <apex:outputLabel value="Client Feedback"/>
                        <apex:inputTextArea required="{!case.Type='Complaint'}" value="{!case.Description}" cols="80" rows="7"/>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Description}"
                                      rendered="{!OR(CACPRManagerProfile)}" />
                </apex:pageBlockSection>
            </div>
            <div style="margin-top:-1.00%">
                <apex:pageBlockSection id="priorContacts" rendered="{!case.CreatedDate=case.CreatedDate}">
                    <apex:pageBlockSectionItem helpText="Include the number of contacts client stated and/or contacts discovered during research.">                        
                        <apex:outputLabel value="# of Prior Contacts"/>
                        <apex:actionRegion > 
                            <apex:inputField value="{!case.Number_of_Prior_Contacts__c}">
                                 <!-- US1807650  US-02 2026-->
                                <apex:actionSupport event="onchange"  action="{!defaultSelectSpecificComplaintIndicatorTerm}" reRender="priorContacts,Question2BDependentQuestionsSection2" status="feedbackDetailStatus"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <br/>
                    <apex:inputField style="min-width: fit-content" value="{!case.Prior_Contacts_Utilized__c}" required="{!case.Number_of_Prior_Contacts__c!='No Prior Contacts Noted' && case.Number_of_Prior_Contacts__c!=Null}"/>
                    
                    <!--Commented below Fields for JAN22 Release-->
                    <!--br/>
<apex:pageBlockSectionItem helpText="In addition to teammate identified in teammate search, list all other persons identified in the complaint. Include RACF IDs for teammates where appropriate.">                        
<apex:outputLabel value="Other Persons Identified in Complaint"/> 
<apex:inputTextArea value="{!case.Other_Persons_Identified_in_Complaint__c}" cols="80" rows="7" /> 

</apex:pageBlockSectionItem>  
<br/-->
                    
                    <!-- Start-- Added "Correspondence Related to Complaint" field for Feb 2021 Release-->
                    <!--apex:pageBlockSectionItem >                        
<apex:outputLabel value="Correspondence Related to Complaint"/> 
<apex:inputTextArea value="{!case.Correspondence_Related_to_Complaint__c}" cols="80" rows="7" />       
</apex:pageBlockSectionItem-->
                    <!-- End-- Added "Correspondence Related to Complaint" field for Feb 2021 Release-->
                    
                </apex:pageBlockSection>
            </div>
            <div style="margin-top:-1.00%">
                <apex:pageBlockSection columns="2" id="SubmitterChannel1">
                    <apex:pageBlockSectionItem rendered="{!(case.Origin = 'Standalone Research')}">
                        
                        <apex:outputlabel value="Submitter Channel" />
                        
                        
                        <apex:inputField value="{!case.Submitter_Channel__c}">
                            <apex:actionSupport event="onchange"  reRender="ResearchRequest,ResearchRequest1" status="ResearchRequestStatus"/>
                        </apex:inputField>
                        
                    </apex:pageBlockSectionItem>
                    
                    <apex:outputField value="{!case.Submitter_Channel__c}" rendered="{!(case.Origin = 'CMITruistBankStandalone' || case.Origin = 'CMITruistBankClientCentral')}" />
                </apex:pageBlockSection>
            </div>
            <!--Supplier Details Section September 2022-->
            <apex:outputPanel id="supplierDetailsPanel2">                 
                <apex:pageBlockSection columns="2" title="Third Party Details" rendered="{!((case.Type='Complaint' || case.Type='Service Request') && (((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier') && (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) || (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='No')))}">
                    <apex:outputField value="{!case.Supplier_ID__c}"/>
                    <apex:outputField value="{!case.LOB_Function__c}"/>
                    <!--apex:inputField value="{!case.Issue_Category__c}" rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')}" /-->
                    <apex:outputField value="{!case.Supplier_Name__c}"/>
                    <apex:outputField value="{!case.Supplier_Sub_LOB__c}"/>                        
                    <apex:outputField value="{!case.Supplier_Services__c}"/>
                    <apex:outputField value="{!case.Business_Owner__c}"/>
                    <apex:outputField value="{!case.Archer_ID__c}"/>
                    <apex:outputField value="{!case.Supplier_Manager__c}"/>
                    <apex:outputField value="{!case.Compliance_SME__c}"/>
                    <apex:outputField value="{!case.Service_Manager__c}"/>  
                    <apex:outputField value="{!case.Supplier_Service_Provided__c}"/>
                </apex:pageBlockSection>
            </apex:outputpanel>
       
            <!-- Dealer Details - US1914433 - (DR-4295) JD.8 - Dealer Section on EDIT Screen --> 
            <apex:outputPanel id="dealerDetailsPanel">                 
                <apex:pageBlockSection columns="2" title="Dealer Details" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Dealer - Regional Acceptance Corp' || case.Is_Feedback_regarding_a_TM_Dept__c='Dealer - Sheffield Financial, LLC') && (case.Dealer_Search__c!=Null && case.Dealer_Search__c!=''))}">
                    <apex:outputField value="{!case.Dealer_Search__r.Name}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Active_Inactive__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Supplier_Dealer_Class__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Location_City__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_LOB_Type__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Location_State__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Number__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Email__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Location_ID__c}"/>
                    <apex:outputField value="{!case.Dealer_Search__r.Dealer_Phone_Number__c}"/>
               </apex:pageBlockSection>
            </apex:outputpanel>     
           
            <apex:actionStatus id="feedbackDetailStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!-- ******************************************* --> 
