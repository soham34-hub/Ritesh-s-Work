            <!--************************************************** --> 
            <!-- *         Compliance Evaluation Summary          * -->
            <!-- ************************************************** -->
            
            <apex:outputPanel styleClass="grey">
                <apex:pageBlockSection id="ComplianceEvaluationSummary" title="Complaint Evaluation Summary" columns="1" collapsible="false">                
                    <apex:actionRegion >                    
                        <apex:pageBlockSection id="litigationFields">
                            <apex:inputField value="{!case.Compliance_Review_of_Letter_Needed__c}"/>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="{!$ObjectType.Case.fields.Litigation__c.label}"></apex:outputLabel>
                                
                                <apex:inputField value="{!case.Litigation__c}">
                                    <apex:actionSupport event="onchange" rerender="litigationFields,complianceOverrideOptIn" status="compOptIn" action="{!nullifyValuesOnLitigationChange}"/>
                                </apex:inputField>
                                
                            </apex:pageBlockSectionItem>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="{!$ObjectType.Case.fields.Was_The_Resolution_Letter_Reviewed__c.label}"></apex:outputLabel>                            
                                <apex:inputField value="{!case.Was_The_Resolution_Letter_Reviewed__c}">
                                    <apex:actionSupport event="onchange" rerender="litigationFields" status="compOptIn"/>
                                </apex:inputField>                            
                            </apex:pageBlockSectionItem> 
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Reference__c.label}"></apex:outputLabel>
                                <apex:inputField value="{!case.Legal_Reference__c}"/>
                            </apex:pageBlockSectionItem>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="{!$ObjectType.Case.fields.Letter_Review_Comments__c.label}"></apex:outputLabel>
                                
                                
                                <apex:inputField value="{!case.Letter_Review_Comments__c}" style="width:300px;height:45px"/>
                                
                                
                            </apex:pageBlockSectionItem>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Resource__c.label}"></apex:outputLabel>
                                <apex:inputField value="{!case.Legal_Resource__c}"/>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>                                    
                        <div style="margin-top:-1.25%">
                            <apex:pageBlockSection id="complianceOverrideOptIn"> 
                                <!--Start-- Added "Compliance Exception LOB(s) Assigned?" Field for MOEM03 2021 Release-->
                                <!--apex:inputField style="min-width: fit-content" value="{!case.Compliance_Exception_LOB_s_Assigned__c}" rendered="{!case.C_L_Investigation_Disposition__c = 'Exception'}" /-->
                                
                                <!--End-- Added "Compliance Exception LOB(s) Assigned?" Fields for MOEM03 2021 Release-->
                                <!--Changes start for October 2023 -- Removed from Pagelayout, Workflow, Flow-->
                                <!--apex:inputField value="{!case.Sales_Practice_SME_Review_Disposition__c}"/-->
                                <br/>
                                <!--Changes start for October 2023 -- Removed from Pagelayout, Workflow, Flow-->
                                <!--apex:pageBlockSectionItem rendered="{!AND($ObjectType.Case.fields.Sales_Practice_SME_Review_Disposition__c.Accessible)}">
<br/>
</apex:pageBlockSectionItem-->
                                <!-- Added below Field for JAN22 Release -->
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Legal Review of Case Needed?" />
                                    <apex:inputField value="{!case.Legal_Review_of_Case_Needed__c}" >
                                        <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn" status="compOptIn" action="{!legalReviewDepToNone}"/> 
                                    </apex:inputField>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem > 
                                    <apex:outputLabel value="Compliance Override Reason" />  
                                    <apex:inputField value="{!case.Compliance_Override_Reason__c}">
                                        <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn" status="compOptIn"/> 
                                    </apex:inputField>                  
                                </apex:pageBlockSectionItem>
                                
                                <!--Start-- Added below Fields for MOEM03 2021 Release-->
                                
                                
                                <apex:pageBlockSectionItem rendered="{!case.Legal_Review_of_Case_Needed__c == 'Yes'}"> 
                                    <apex:outputLabel value="Legal Review Disposition?"/>                
                                    <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                            <div  class="{!IF((case.Legal_Review_of_Case_Needed__c == 'Yes'),'requiredBlock','')}"></div>     
                                            <apex:inputField value="{!case.Legal_Review_Disposition__c}" />
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                <apex:pageBlockSectionItem rendered="{!case.Legal_Review_of_Case_Needed__c == 'Yes'}">
                                    <br/>
                                </apex:pageBlockSectionItem>
                                <!--apex:inputField value="{!case.Legal_Review_Disposition__c}" required="{!(case.Legal_Review_of_Case_Needed__c=='Yes')}" --/><br/>
<!-- Added below Field for JAN22 Release -->
                                <apex:inputField value="{!case.RTC_Form_Number__c}" />
                                
                                <!--End-- Added Fields for MOEM03 2021 Release-->
                                </apex:pageBlockSection>
                              </div>
                         <!-- Mohan Changes US1654410 changed the Width in input field separate the pageblocksections -->
                        <!-- US1900228 - (DR-4317) M.4 - Referral Override/Opt In Comments AND Referrall Opt In Alignment
                        <apex:pageBlockSection columns="2" collapsible="false"> -->
                        <div style="margin-top:-1.5%">
                            <apex:pageBlockSection collapsible="false">                
                                <apex:pageBlockSectionItem > 
                                    <apex:outputLabel value="Referral Override/Opt In Comments" style="display:block;width:147px;margin-left:6px"/>                
                                    <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                            <div  class="{!IF(OR(case.Compliance_Opt_In__c,case.Compliance_Override_Reason__c != null,case.Referral_Opt_In__c!=null),'requiredBlock','')}"></div>     
                                            <apex:inputField value="{!case.Compliance_Override_Comments__c}" style="width:900px;height:45px;font-size:12px; margin-left:0px"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                        
                        <div style="margin-top:-1.5%">
                            <apex:pageblocksection >
                                <apex:pageBlockSectionItem > 
                                    <apex:outputLabel value="Referral Opt In" />
                                    <apex:inputField value="{!case.Referral_Opt_In__c}">
                                        <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn,Comments,referralButton,referralButton1,referrals,FunctionalArea" status="compOptIn" action="{!checkOptInAndNullifyReferralDisposition}"/> 
                                    </apex:inputField>                            
                                </apex:pageBlockSectionItem>
                            </apex:pageblocksection>
                        </div>
                        
                    </apex:actionRegion>            
                    
                    <apex:actionStatus id="compOptIn">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                    <apex:pageBlockSection id="overallReview" columns="2">
                        <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!case.Compliance_Opt_In__c}"/>
                        <apex:outputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!!case.Compliance_Opt_In__c}"/>                    
                    </apex:pageBlockSection>
                    
                    <div style="margin-Top:-2%">    
                        <apex:pageBlockSection id="CLInvestigation" columns="2">
                            <!--apex:inputField value="{!case.C_L_Investigation_Disposition__c}">
<apex:actionSupport event="onchange" rerender="complianceOverrideOptIn,CLInvestigation" status="RegLawStatus4"/> 

</apex:inputField-->
                            <apex:pageBlockSectionItem >                        
                                <apex:outputLabel value="Compliance SME Review Disposition"/>
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.C_L_Investigation_Disposition__c}">
                                        <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn,CLInvestigation,MonitoringResult" status="RegLawStatus4"/> 
                                        
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>                            
                            <br/>
                            <!--apex:inputField style="min-width: fit-content" value="{!case.Compliance_Exception_LOB_s_Assigned__c}" rendered="{!case.C_L_Investigation_Disposition__c = 'Exception'}" required="{!case.C_L_Investigation_Disposition__c = 'Exception'}" /-->
                            <apex:inputField style="min-width: fit-content" value="{!case.Compliance_Exception_LOB_s_Assigned__c}" rendered="{!showSection='section1'}" required="{!(case.C_L_Investigation_Disposition__c = 'Exception' || case.C_L_Investigation_Disposition__c = 'Non-Reg Exception')}" />
                            <!--April 2024 Make field output field-->
                            <apex:outputField value="{!case.Compliance_Exception_LOB_s_Assigned__c}" rendered="{!showSection='section2'}" />
                        </apex:pageBlockSection>
                    </div>
                    <!-- changes start for June 2022-->
                    <apex:actionRegion >
                        <div >   
                            <apex:pageBlockSection id="MonitoringResult">
                                <apex:pageBlockSectionItem >
                                    <!--August chnages Start>
                                    <apex:outputLabel value="Reported in Archer" style="display:block;width:220px;" /-->
                                    <apex:outputLabel value="Reported in Archer"/>
                                    <!--August changes End-->
                                    
                                    <!--apex:inputField value="{!case.Reported_in_IRM__c}" required="{!(case.C_L_Investigation_Disposition__c = 'Exception' || case.Status='Closed')}">
-->                            
                                    <apex:inputField value="{!case.Reported_in_IRM__c}" required="{!makeArcherRequired}">
                                        <apex:actionSupport event="onchange" rerender="MonitoringResult" status="RegLawStatus4" action="{!clearDependentFields}"/>
                                    </apex:inputField>                        
                                </apex:pageBlockSectionItem>
                                <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
                                
                                <!-- February 2025 - US1527769 - (DR-4209) Z.1 and US1531384 - (DR-4209) Z.2 Redress Record in Reported in Archer Workflow Logic 
                                <apex:inputField value="{!case.IRM__c}" rendered="{!((CONTAINS(case.Reported_in_IRM__c,'No Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Incident/Issue - Tracked outside of Archer') || CONTAINS(case.Reported_in_IRM__c,'Under Review With LOB/BU')) && !(CONTAINS(case.Reported_in_IRM__c,'New Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Existing Archer Issue' ) || CONTAINS(case.Reported_in_IRM__c,'Risk Accepted in Archer')) )}"/> -->            
                                <apex:inputField value="{!case.IRM__c}" rendered="{!((CONTAINS(case.Reported_in_IRM__c,'No Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Incident/Issue - Tracked outside of Archer') || CONTAINS(case.Reported_in_IRM__c,'Under Review With LOB/BU') || CONTAINS(case.Reported_in_IRM__c,'Redress Record in Archer') || CONTAINS(case.Reported_in_IRM__c,'Potential New Redress (Monitoring Impacts)')) && !(CONTAINS(case.Reported_in_IRM__c,'New Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Existing Archer Issue' ) || CONTAINS(case.Reported_in_IRM__c,'Risk Accepted in Archer')) )}"/>             
                                
                                <apex:pageBlockSectionItem rendered="{!CONTAINS(case.Reported_in_IRM__c,'New Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Existing Archer Issue' ) || CONTAINS(case.Reported_in_IRM__c,'Risk Accepted in Archer')}"> 
                                    <apex:outputLabel value="Archer Issue #"/>                
                                    <apex:define name="requiredArcherIssue">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:inputField value="{!case.IRM__c}"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:inputField value="{!case.Other_IRM_s__c}"  rendered="{!(case.Reported_in_IRM__c != null && case.Reported_in_IRM__c != '' && !CONTAINS(case.Reported_in_IRM__c,'Incident/Issue - Tracked outside of Archer'))}"/>
                                
                                <apex:pageBlockSectionItem rendered="{!(CONTAINS(case.Reported_in_IRM__c,'Incident/Issue - Tracked outside of Archer') && case.Reported_in_IRM__c != null && case.Reported_in_IRM__c != '' )}"> 
                                    <apex:outputLabel value="Non-Archer Tracking #(s)"/>                
                                    <apex:define name="requiredNonArcherIssue">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:inputField value="{!case.Other_IRM_s__c}"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <!-- February 2025 - US1527769 - (DR-4209) Z.1 Redress Record in Reported in Archer Workflow Logic 
                                <apex:inputField value="{!case.Control__c}"  rendered="{!((CONTAINS(case.Reported_in_IRM__c,'No Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Incident/Issue - Tracked outside of Archer') || CONTAINS(case.Reported_in_IRM__c,'Under Review With LOB/BU')) && !(CONTAINS(case.Reported_in_IRM__c,'New Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Existing Archer Issue' ) || CONTAINS(case.Reported_in_IRM__c,'Risk Accepted in Archer')) )}"/> -->          
                                <apex:inputField value="{!case.Control__c}"  rendered="{!(!(CONTAINS(case.Reported_in_IRM__c,'Redress Record in Archer')) && (case.Reported_in_IRM__c != null && case.Reported_in_IRM__c != '' ))}"/>            
                                
                                <!--M10 October 2024 Changes US1405115 (DR-4159) E.1 - Archer Control # field /-->
                                <!-- February 2025 - US1527769 - (DR-4209) Z.1 Redress Record in Reported in Archer Workflow Logic
                                <apex:pageBlockSectionItem rendered="{!CONTAINS(case.Reported_in_IRM__c,'New Archer Issue Opened') || CONTAINS(case.Reported_in_IRM__c,'Existing Archer Issue' ) || CONTAINS(case.Reported_in_IRM__c,'Risk Accepted in Archer')}"> -->
                                <apex:pageBlockSectionItem rendered="{!(CONTAINS(case.Reported_in_IRM__c,'Redress Record in Archer') && (case.Reported_in_IRM__c != null && case.Reported_in_IRM__c != '' ))}">
                                    <!-- February 2025 - US1527769 - (DR-4209) Z.1 and US1531384 - (DR-4209) Z.2 Redress Record in Reported in Archer Workflow Logic                  
                                    <apex:outputLabel value="Archer Control #(s)"/> -->               
                                    <apex:outputLabel value="Archer Redress #(s)"/>                   
                                    <apex:define name="requiredControllIssue"> <!-- /-->
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div> <!-- /-->
                                            <apex:inputField value="{!case.Control__c}"/>
                                        </div> <!-- /-->
                                    </apex:define> <!-- /-->
                                </apex:pageBlockSectionItem>
                                
                            </apex:pageBlockSection>
                        </div>
                    </apex:actionRegion>
                    
                    <!-- changes end for June 2022-->       
                    
                    
                    <apex:actionStatus id="RegLawStatus4">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>    
                    
                    <apex:pageBlockSectionItem rendered="false">
                        <apex:outputPanel id="RegLawLabel">
                            <apex:outputLabel value="Reg/Law Potential Exception" for="RegLawField"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="RegLaw">                   
                            <apex:inputField id="RegLawField" style="min-width: fit-content" value="{!case.Reg_Law_Potential_Exception__c}" required="{!case.Deposit_Others_Investigation_Disposition__c='Exception' || case.Fair_Banking_Investigation_Disposition__c='Exception' || case.Fair_Credit_Investigation_Disposition__c='Exception' || case.Lending_Saving_Investigation_Disposition__c='Exception' || case.Mortgage_CL_Investigation_Disposition__c='Exception' || case.SCRA_Investigation_Disposition__c='Exception' || case.PWM_Investigation_Disposition__c='Exception' || case.WHL_Investigation_Disposition__c='Exception' }"/>
                        </apex:outputPanel>                   
                    </apex:pageBlockSectionItem>
                    <!--apex:pageBlockSection id="ComplianceExceptionLOB">
<apex:inputField style="min-width: fit-content" value="{!case.Compliance_Exception_LOB_s_Assigned__c}" rendered="{!case.C_L_Investigation_Disposition__c = 'Exception'}" />
</apex:pageBlockSection-->
                    <apex:outputPanel >
                        <apex:pageBlockSectionItem rendered="false">
                            <apex:outputPanel id="RegLawLabel">
                                <apex:outputLabel value="Compliance Referral:Reg/Law Trigger: " for="RegLawField1"/>
                            </apex:outputPanel>
                            <apex:outputPanel id="RegLaw">                   
                                <apex:outputText value="{!SUBSTITUTE(case.Compliance_Referral_Reg_Law_Trigger__c,';','<br/>')}"/>
                            </apex:outputPanel>                   
                        </apex:pageBlockSectionItem>
                    </apex:outputPanel>
                    
                    <apex:inputField style="min-width: fit-content" value="{!case.ComplianceSMEReview_Reg_Law_Trigger__c}" rendered="false"/>
                    <apex:inputField style="min-width: fit-content" value="{!case.Reg_Law_Risk_SME_Review_Completed__c}" rendered="false"/>
                    <apex:inputField style="min-width: fit-content" value="{!case.Compliance_SME_Review_No_Reg_Law_Trigger__c}" rendered="false"/>
                    
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <apex:actionStatus id="RegLawStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>    
            
            <br/>                
            <apex:actionRegion >
                <apex:outputPanel >
                    
                    <apex:outputPanel id="referrals">
                        
                        <apex:outputPanel rendered="{!showSection='section1'}">
                            <div style="margin-Left:2%">
                                <div style="margin-Top:-2%">
                                    
                                    <apex:outputText Style="font-weight:bold;color:red" value="Reminder: As each reg/law SME review is completed, the Compliance SME Review Comments should be updated with review findings."/>
                                </div>
                            </div>
                            <br/>
                        </apex:outputPanel>
                        
                        <apex:pageBlockTable value="{!assignComplianceReferralRecord}"  rendered="{!showSection='section1'}"  var="CR">
                            
                            <apex:column headerValue="Delete">               
                                <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" />                                                      
                                <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && !$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" disabled="true"/>                            
                            </apex:column>  
                            
                            <apex:column id="RegLaw" headerValue="Reg/Law" >
                                <apex:outputText value="{!CR.assignRegLawName}" rendered="{!CR.assignRegLawName!=null && CR.assignRegLawName!=''}"/>                          
                                <apex:selectList value="{!CR.assignRegLawName}" multiselect="False"
                                                 size="1"  rendered="{!CR.assignRegLawName=null || CR.assignRegLawName=''}" >
                                    <apex:selectOptions value="{!regLawValues}" />
                                    <apex:actionSupport event="onchange" action="{!actionOnRegLaw}" status="ReferralStatus" reRender="referrals"/>
                                </apex:selectList> 
                            </apex:column>
                            
                            <!--Manoj added researching for M042024-->
                            <!--<apex:column id="AssignedSME" headerValue="SMEAssigned" >
<apex:inputField value="{!CR.assignSMEAssigned.SME_Assigned__c}"/>                                                          
</apex:column>-->
                            <!--Manoj added researching for M042024-->
                            
                            <apex:column id="SMENeeded" headerValue="SME Review Needed?">                                        
                                <apex:outputText value="{!CR.assignSMEReviewNeeded}"  rendered="{!!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                                <apex:define name="requiredSelectAccount">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>                            
                                        <apex:selectList multiselect="false" size="1" value="{!CR.assignSMEReviewNeeded}" rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName!='No Reg/Law Exception Found'}" >                
                                            <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                            <apex:selectOption itemValue="No" itemLabel="No"/>
                                            <apex:selectOption itemValue="Yes" itemLabel="Yes"/>                                                                     
                                        </apex:selectList>
                                    </div>
                                </apex:define>                                                          
                            </apex:column>
                            
                            <apex:column headerValue="Reg/Law Exception">
                                <apex:outputText value="{!CR.assignRegLawExceptionValue}" rendered="{!!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                                <apex:outputPanel rendered="{!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName!='No Reg/Law Exception Found' && CR.assignRegLawName !='Non Reg Policy/Procedure'}">
                                    <apex:selectList multiselect="false" size="1" value="{!CR.assignRegLawExceptionValue}" > 
                                        <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                        <apex:selectOption itemValue="Exception" itemLabel="Exception"/>
                                        <apex:selectOption itemValue="NoException" itemLabel="No Exception"/>
                                        <apex:actionSupport event="onchange" action="{!actionOnRegLawException}" status="ReferralStatus" reRender="referrals"/>                    
                                    </apex:selectList>
                                </apex:outputPanel>
                                <!--Chnages start for Jan 2024: Added below column for new REG/LAW value -->
                                <apex:outputPanel rendered="{!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName ='Non Reg Policy/Procedure'}">
                                    <apex:selectList multiselect="false" size="1" value="{!CR.assignRegLawExceptionValue}" > 
                                        <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                        <apex:selectOption itemValue="NoException" itemLabel="No Exception"/>
                                        <apex:selectOption itemValue="Non-RegException" itemLabel="Non-Reg Exception"/>
                                        <apex:actionSupport event="onchange" action="{!actionOnRegLawException}" status="ReferralStatus" reRender="referrals"/>                    
                                    </apex:selectList>
                                </apex:outputPanel>
                            </apex:column>                  
                            
                            <apex:column headerValue="SME Review Completed">                        
                                <apex:inputCheckbox value="{!CR.assignSMEReviewCompleted}" disabled="true"/>                                                                                                                                        
                            </apex:column>                                                            
                            
                        </apex:pageBlockTable>
                        
                        <apex:outputPanel id="referralButton">
                            <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name='Compliance & Risk Specialist' && !disableAddButtonValue && showSection='section1' && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')) && (case.CE_Submission_Reassignment__c==case.CE_Submission_Process__c || case.CE_Submission_Reassignment__c==null)}">
                                <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="ReferralStatus"/>                
                                <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name!='Compliance & Risk Specialist' && !disableAddButtonValue && showSection='section1' && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')) && (case.CE_Submission_Reassignment__c==case.CE_Submission_Process__c || case.CE_Submission_Reassignment__c==null)}">
                                <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="reassignment,reassignment1,ReferralStatus"/>                
                                <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="reassignment,reassignment1,ReferralStatus"/>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!(!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && showSection='section1') ||((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) && showSection='section1' && !((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')}">
                                <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                            </apex:outputPanel>
                            
                            
                            <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && showSection='section1' && $Profile.Name!='Compliance & Risk Specialist'}">
                                <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="ReferralStatus"/>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && showSection='section1' && $Profile.Name='Compliance & Risk Specialist'}">
                                <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && (case.CE_Submission_Reassignment__c!=case.CE_Submission_Process__c && showSection='section1' && case.CE_Submission_Reassignment__c!=null )}">
                                <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                            </apex:outputPanel>
                        </apex:outputPanel>
                        
                        <br/>
                        <br/>
                        <!--Manoj research on new compliance table-->
                        <apex:outputPanel rendered="{!showSection='section2'}">
                            <div style="margin-Left:2%">
                                <div style="margin-Top:-2%">
                                    
                                    <apex:outputText Style="font-weight:bold;color:red" value="Reminder: As each reg/law SME review is completed, the Compliance SME Review Comments should be updated with review findings."/>
                                </div>
                            </div>
                            <br/>
                        </apex:outputPanel>
                        <apex:pageBlockTable value="{!assignCESummary}"  rendered="{!showSection='section2'}" var="CES"  >
                            
                            <apex:column >
                                <div id="mydata" style="display:none">
                                    <apex:inputField value="{!CES.Reg_Law_Name__c}"/>
                                </div>
                            </apex:column>
                            
                            
                            <apex:column headerValue="Delete" rendered="{!$ObjectType.Compliance_Evaluation_Summary__c.fields.Reg_Law_Name__c.Updateable}" > 
                                
                                <apex:inputCheckbox value="{!CES.Remove__c}"/>
                                
                                <!--<apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && !$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" disabled="true"/>-->                           
                            </apex:column>
                            
                            <!--apex:column id="RegLaw" headerValue="Reg/Law" >

<apex:actionRegion >
<apex:inputField value="{!CES.Reg_Law_Name__c}">
<apex:actionSupport event="onchange" action="{!actionOnRegLaw1}" status="ReferralStatus" reRender="referrals,referralButton1,SubTopic"/>   
</apex:inputField>
</apex:actionRegion>
</apex:column-->
                            <!--Amit changes for reg/law-->
                            <apex:column id="RegLaw" headerValue="Reg/Law" >
                                
                                <apex:outputText value="{!CES.Reg_Law_Name__c}" rendered="{!CES.Reg_Law_Name__c!=null && CES.Reg_Law_Name__c!='' && CES.Reg_Law_Name__c!='--None--'}"/>                          
                                
                                <apex:actionRegion >
                                    <apex:selectList value="{!CES.Reg_Law_Name__c}" multiselect="False"
