                            </apex:pageblock>
                            <div align='center'><apex:commandButton action="{!selectPartyAndAssignValues}" immediate="true" status="jointAccStatus" reRender="authorizedPartyPanel,accts,clientDetails,renderAccountDetails,accountSearch,nameSearch,accountSearch5,nameSearch5,accountSearch4,nameSearch4,LOBAccountDetailsPanel,accountSearch3,nameSearch3,accountSearch2,nameSearch2,accountSearch1,nameSearch1,accountDetailsAdded, ClientInfoPanelForComplaint, clientfollowupsection, ClientFollowUpSection, clientFollowUpSection, contactMethodFields, ClientSectionAfterBypassingSearchClient, ClientSectionAfterBypassingSearchClient1, ClientSectionAfterBypassingSearchClient2, ClientSectionAfterBypassingSearchClient3,renderAccountDetailsForCreateClient,ClientInfoPanel,ClientInfoPanel1,ClientInfoPanel2,ClientInfoPanel3,ClientInfoPanel4,LOBAccountDetailsPanel,lobAccountDetailsPanel,LobAccountDetailsPanel,accountFields,nameSearch,cisVerifyResults,nameSearch,cisVerifyResults,jointAccountComponent" value="Select & Return To Case"/></div>                 
                            
