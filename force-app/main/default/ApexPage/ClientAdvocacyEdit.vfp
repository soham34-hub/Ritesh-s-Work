        <apex:pageBlock title="Client Advocacy Case" id="CRTPage">
            
            <apex:pageBlockButtons location="top" id="TopButton">
                <div align='center' style="margin-left:-43%">
                    <apex:commandButton action="{!save}" value="Save" onclick="return checkDoubleSubmit(this);"/>
                    <apex:commandButton action="{!cancel}" value="Cancel" onclick="return checkDoubleSubmit(this);"/>
                </div>
            </apex:pageBlockButtons>
            
            <div style="text-align:center;display:none" id="spinner" >
                <img src="{!$Resource.SaveLightningSpinner}" width="62px" height="62px"/>                            
            </div>   
            
            <apex:pageBlockButtons location="bottom" id="BottomButton">
                
                <apex:commandButton action="{!save}" value="Save" onclick="return checkDoubleSubmit(this);"/>
                <apex:commandButton action="{!cancel}" value="Cancel" onclick="return checkDoubleSubmit(this);"/>
                
                <div style="text-align:center;display:none" id="spinner1" >
                    <img src="{!$Resource.SaveLightningSpinner}" width="62px" height="62px"/>                            
                </div>
                
            </apex:pageBlockButtons>
            
            
            
            <!-- *************************************** -->
            <!-- *   C A S E   I N F O R M A T I O N   * -->
            <!-- *************************************** -->
            <apex:outputPanel styleClass="grey" id="CaseInfo">
                <apex:pageBlockSection title="Case Information" columns="2" collapsible="false">
                    <apex:facet name="header">
                        <table width="100%">
                            <tr>
                                <td align="left"><h3>Case Information</h3></td>
                                <td align="right" style="color:red;">*=Required Information</td>
                            </tr>
                        </table>
                    </apex:facet>
                    
                    <apex:inputField value="{!case.CaseNumber}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.CaseNumber}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    <apex:outputField value="{!case.OwnerId}" />
                    <!-- ********************************************* -->
                    <!-- *   DR-2656 September 2018 monthy Release   * -->
                    <!-- ********************************************* -->
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Case Origin" />
                        <apex:actionRegion >
                            <!-- Disabling AWS Stories removed this check from origin field,NOT(AND(case.Origin=='CMIAWSAugmentation',case.createdby.Name = 'Informatica integrationatlas')) -->
                            <!-- Enable previous disabled AWS code above - Story- US2004414-->
                            
                            <apex:inputField value="{!case.Origin}" required="TRUE"
                                             rendered="{!AND((NOT(CRTQualityAssuranceSpecialist)), case.Origin!='CMI Pilot', case.Origin!='CMI',NOT(AND((case.Origin=='CMIAWSAugmentation'),NOT($Permission.Allow_Augumentation_Access))))}">
                                <apex:actionSupport event="onchange" reRender="ThirdClientDetails,SubmitterChannel1,SubmitterChannel2,ResearchRequest,ResearchRequest1,ClientIndicator" status="MainStatus,ResearchRequestStatus"/>
                            </apex:inputField>
                            <!--US1725342 Mohan Changes M10-->
                             
                           <!-- Enable previous disabled AWS code above - Story- US2004414-->
                                <apex:outputField value="{!case.Origin}"
                                      rendered="{!AND(case.Origin=='CMIAWSAugmentation',NOT($Permission.Allow_Augumentation_Access))}"/>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Origin}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist, case.Origin='CMI Pilot', case.Origin='CMI')}"/>
                    
                    <!--apex:pageBlockSectionItem id="submitterNotRequired"
rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Call_Source__c!='Internal', case.Call_Source__c!='Mortgage Client Service', case.Call_Source__c!='Private Wealth', case.Call_Source__c!='Legal', case.Call_Source__c!='Retail Branch')}">
<apex:outputlabel value="Submitter" />
<apex:inputField value="{!Case.Submitter__c}"/>
</apex:pageBlockSectionItem-->
                    
                    <apex:pageBlockSectionItem >
                        <apex:outputPanel id="submitterSOF">        
                            <apex:outputLabel value="Submitter"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="submitterSOF1">
                            <apex:actionRegion >
                                <!-- April 2025 - US1567681 - (DR-4233) J.1 - Submitter Required for SOF = Social Media
                                <apex:inputField value="{!Case.Submitter__c}" required="{!(NOT(case.Call_Source__c="Social Media") && (case.Origin <> 'Third Party' && case.Source_System__c = Null))}"/> -->   
                                <apex:inputField value="{!Case.Submitter__c}" required="{!(case.Origin <> 'Third Party' && case.Source_System__c = Null)}"/>   
                            </apex:actionRegion>   
                        </apex:outputPanel>
                    </apex:pageBlockSectionItem>
                    
                    <apex:inputField value="{!case.Case_Association_Type__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Case_Association_Type__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <!--apex:pageBlockSectionItem >
<apex:outputPanel id="SubmitterChannel1">
<apex:outputPanel rendered="{!(case.Origin = 'Standalone Research' || case.Origin = 'CMITruistBankStandalone')}">
<apex:outputlabel value="Submitter Channel" />
</apex:outputPanel>
</apex:outputPanel>
<apex:outputPanel id="SubmitterChannel2">
<apex:outputPanel rendered="{!(case.Origin = 'Standalone Research' || case.Origin = 'CMITruistBankStandalone')}">
<apex:inputField value="{!case.Submitter_Channel__c}">
