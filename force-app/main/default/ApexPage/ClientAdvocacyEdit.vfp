                        <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCIFModalDialog}" reRender="accountCIFSearch,nameSearch,LOBAccountDetailsPanel,ClientInfoPanel1,authorisedThirdParty" value="Search Client" disabled="{!((case.BypassSearchProcess__c && case.Origin!='CMI WHL Standalone' && case.Origin!='CMI WHL Salesforce') || (CACPRManagerProfile))}"/>                           
                        <apex:commandButton style="margin-left:25%" action="{!verifyCISClient}"  immediate="true" value="Verify CIS Client" reRender="nameSearch,cisVerifyResults,jointAccountComponent"  status="VerifyCISClientStatus" rendered="{!(case.Origin='CMI WHL Standalone' || case.Origin='CMI WHL Salesforce') }"/>
                        
                        <!--<c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
