            <apex:outputpanel id="ComplianceEvaluationPanel" > 
                <apex:outputpanel id="ComplianceEvaluation" >             
                    <apex:outputPanel styleClass="grey">
                        <apex:pageBlockSection title="Complaint Designation" collapsible="false" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}" id="ComplaintDesignationSection"> 
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Discrimination Concern?" for="allegedDiscri"/><!--outputLabel changed for CMI 2014-->                       
                                <apex:define name="requiredallegedDiscri">
                                    <apex:actionRegion > 
                                        <apex:inputField value="{!case.Alleged_Discrimination__c}" id="allegedDiscri" required="true" >
                                            <apex:actionSupport event="onchange"  reRender="allegedDisc" status="ComplianceEvaluationStatus"/>                                            
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </apex:define>
                            </apex:pageBlockSectionItem> 
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputPanel id="FromAnAttorney">
                                    <apex:outputPanel >
                                        <apex:outputlabel value="FROM an Attorney?" />
                                    </apex:outputPanel>
                                </apex:outputPanel>
                                <apex:outputPanel id="FromAnAttorney1">
                                    <apex:outputPanel >
                                        <apex:inputfield value="{!case.FROM_an_Attorney__c}" required="true" />
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputPanel id="allegedDisc">
                                    <apex:outputPanel >
                                        <apex:outputText value="Please describe in detail the allegations, including if client identifies as part of a protected group." rendered="{!case.Alleged_Discrimination__c = "Yes"}" style="color:red;font-weight:bold;"/>
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </apex:pageBlockSectionItem>
                            <br/>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="UDAAP, Fair Banking & Fair Lending Concern?"/>
                                <apex:actionRegion >   
                                    <apex:inputField value="{!case.Alleged_UDAAP_Issue__c}" required="true" >
                                        <apex:actionSupport event="onchange" action="{!resetPPQue}"  reRender="followUpQuestion" status="werePoliciesfollowed"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputPanel id="FromRegAgency">
                                    <apex:outputPanel >
                                        <apex:outputlabel value="FROM a Regulator/Govt Agency/Agency?" />
                                    </apex:outputPanel>
                                </apex:outputPanel>
                                <apex:outputPanel id="FromRegAgency1">
                                    <apex:outputPanel >
                                        <apex:inputfield value="{!case.FROM_a_Regulator_Govt_Agency_Agency__c}" required="true" />
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </apex:pageBlockSectionItem>
                            <!-- Amit -->
                            <!--Changes start for June 2023-->
                        </apex:pageBlockSection>
                        
                        <!--Changes start for June 2023 : Relocated below question under UDAAP-->
                        <div style="margin-top:-1.25%">
                            <apex:pageBlockSection id="followUpQuestion">
                                <apex:pageBlockSectionItem rendered="{!(case.Alleged_UDAAP_Issue__c = 'Yes' && case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                                    <apex:outputLabel value="Were Policies and Procedures Followed?"/>
                                    <apex:inputField value="{!case.Policies_Procedures_Working_as_Designed__c}" required="true" />
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                        
                        <apex:actionStatus id="werePoliciesfollowed"> 
                            <apex:facet name="start"> 
                                <div style="text-align:center;"> 
                                    <img src="{!$Resource.SpinIcon}"/> 
                                </div> 
                            </apex:facet> 
                        </apex:actionStatus>
                        <!--Changes end for June 2023-->
                        <div style="margin-top:-1.5%">
                            <apex:pageBlockSection columns="2" collapsible="false" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}" id="ComplaintDesignationSection2">  
                                <!--Changes End for June 2023-->
                                <!--Amit-->
                                
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Sales Practice Concern?"/>
                                    <apex:actionRegion >          
                                        <apex:inputField value="{!case.Alleged_Improper_Sales_Bus_Practice__c}" required="true" >
                                            <apex:actionSupport event="onchange" action="{!resetPPQue}"  reRender="doesResearchSupport" status="doesResearchSupportStatus"/>
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                
                                <apex:inputField value="{!case.Business_Impact__c}"/>
                                <!--Amit-->
                            </apex:pageBlockSection> 
                        </div>
                        <!--Changes start for June 2023 : Relocated below question under UDAAP-->
                        <div style="margin-top:-1.25%">
                            <apex:pageBlockSection id="doesResearchSupport">
                                <apex:pageBlockSectionItem rendered="{!(case.Alleged_Improper_Sales_Bus_Practice__c = 'Yes')}">
                                    <apex:outputLabel value="Research Denotes Sales Practice Concern"/>
                                    <apex:inputField value="{!case.Research_Supports_SalesBus_Concern__c}" required="true" />
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                        
                        <apex:actionStatus id="doesResearchSupportStatus"> 
                            <apex:facet name="start"> 
                                <div style="text-align:center;"> 
                                    <img src="{!$Resource.SpinIcon}"/> 
                                </div> 
                            </apex:facet> 
                        </apex:actionStatus>
                        <!--Changes end for June 2023-->
                        <div style="margin-top:-1.5%">
                            <apex:pageBlockSection columns="2" collapsible="false" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}" id="ComplaintDesignationSection3"> 
                                
                                <!--amit-->
                                <apex:inputField value="{!case.Identified_as_Miltary_Service__c}" required="true" />
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputlabel value="Law/Regulation Cited or Implied?" />
                                    <!--changes made as per sprint 4/12/22-->
                                    <!--<apex:inputfield value="{!case.PCQ_Q2_A__c}" required="true" />-->
                                    <apex:actionRegion >
                                        <apex:inputfield value="{!case.PCQ_Q2_A__c}" required="true">
                                            <apex:actionSupport event="onchange" action="{!changeRegLawCited}" reRender="Quest2ADependentQuestionsSection2" status="regLawStatus1"/>
                                        </apex:inputfield>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                
                                <apex:inputField value="{!case.Identified_as_Elder_Disabled__c}" required="true" />
                                <!--Commented below Field for JAN22 Release-->
                                <!--apex:inputField value="{!case.Legal_Review_of_Case_Needed__c}" /--> 
                            </apex:pageBlockSection>
                        </div>
                        <!--div style="margin-top:-1.25%">
<apex:pageBlockSection id="followUpQuestion">
<apex:pageBlockSectionItem rendered="{!(case.Alleged_UDAAP_Issue__c = 'Yes' || case.Alleged_Improper_Sales_Bus_Practice__c = 'Yes')}">
<apex:outputLabel value="Were Policies and Procedures Followed?"/>
<apex:inputField value="{!case.Policies_Procedures_Working_as_Designed__c}"/>
</apex:pageBlockSectionItem>
</apex:pageBlockSection>
</div-->

                        <apex:actionStatus id="regLawStatus1"> 
                            <apex:facet name="start"> 
                                <div style="text-align:center;"> 
                                    <img src="{!$Resource.SpinIcon}"/> 
                                </div> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div style="margin-top:-1.25%">
                            <apex:pageBlockSection id="Quest2ADependentQuestionsSection2" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null )}"> 
                                <apex:pageBlockSectionItem > 
                                    <apex:outputLabel value="Select All Reg/Law Cited or Implied" for="quest4" />     
                                    <apex:define name="requiredLawOrRegSection2">
                                        <!--<div class="requiredInput"  >-->
                                        <div class="{!IF(case.PCQ_Q2_A__c=='Yes','requiredInput','')}">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion > 
                                                <apex:inputField style="min-width: fit-content" value="{!case.Law_or_Regulation_Violated__c}" id="quest4Section2">
                                                    <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestionsSection2" status="ComplianceEvaluationStatus" /> 
                                                </apex:inputField> 
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem> 
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/> 
                                    <apex:inputField style="min-width: fit-content" value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                       
                                </apex:pageBlockSectionItem>                         
                            </apex:pageBlockSection> 
                        </div>
                        <div style="margin-top:-1.25%">                                     
                            <apex:pageBlockSection id="Question2BDependentQuestionsSection2" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                                <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                    <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7Section2"/>
                                    <apex:define name="requiredHighRisk">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField style="min-width: fit-content" value="{!case.High_Risk_Terms__c}" id="quest7Section2">
                                                    <apex:actionSupport event="onchange" rerender="Question2BDependentQuestionsSection2" status="ComplianceEvaluationStatus" action="{!renderOtherHighRiskTerms}"/>
                                                </apex:inputField> 
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                    <apex:inputField style="min-width: fit-content" value="{!case.Other_High_Risk_Terms__c}" id="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                       
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                    </apex:outputPanel> 
                    
                    <apex:actionRegion >
                        <div style="margin-top:-1.25%">
                            <apex:pageBlockSection id="feedbackdet">
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel style="font-weight:bold" value="Submitter Feedback"/>
                                    <apex:inputField style="min-width: fit-content" value="{!case.Submitter_Feedback__c}" >
                                        <apex:actionSupport event="onchange" rerender="feedbackSub,feedbackdet" status="MainStatusSub"/>
                                    </apex:inputfield>
                                </apex:pageBlockSectionItem>
                                <br/>
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Submitter Feedback Details"/>
                                    <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                            <div  class="{!IF(OR(CONTAINS(case.Submitter_Feedback__c,'Other'),CONTAINS(case.Submitter_Feedback__c,'Allegation Tracking'),CONTAINS(case.Submitter_Feedback__c,'Client/Case Profile'),CONTAINS(case.Submitter_Feedback__c,'Comments'),CONTAINS(case.Submitter_Feedback__c,'Resolved at POC')),'requiredBlock','')}"></div>    
                                           <apex:inputField style="min-width: fit-content" value="{!case.Submitter_Feedback_Details__c}" >
                                        <apex:actionSupport event="onchange" rerender="feedbackSub" status="MainStatusSub"/>
                                    </apex:inputField>
                                            </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                        
                        <!-- US1900226 - (DR-4317) M.2 - Submitter Feedback Comments Alignment
                        <div style="margin-top:-1.00%"> -->
                        <div style="margin-top:-1.75%"> 
                            <apex:pageBlockSection id="feedbackSub" >         
                                <apex:pageBlockSectionItem >
                                    <!--Mohan Changes as part of US1654408 (M10) -->
                                    <!-- US1900226 - (DR-4317) M.2 - Submitter Feedback Comments Alignment
                                    <apex:outputLabel value="Submitter Feedback Comments" style="display:block;width:200px;"/> -->
                                    <apex:outputLabel value="Submitter Feedback Comments" style="display:block;width:110px;" />
                                    <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">        
                                            <div  class="{!IF(OR(CONTAINS(case.Submitter_Feedback__c,'Other'),CONTAINS(case.Submitter_Feedback__c,'Allegation Tracking'),CONTAINS(case.Submitter_Feedback__c,'Client/Case Profile'),CONTAINS(case.Submitter_Feedback__c,'Comments'),CONTAINS(case.Submitter_Feedback__c,'Resolved at POC'),NOT(ISNULL(case.Submitter_Feedback_Details__c))),'requiredBlock','')}"></div>      
                                            <apex:inputfield value="{!case.Submitter_Feedback_Comments__c}" style="width:950px;height:55px;" />
                                        </div>
                                    </apex:define>   
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </div>
                        
                    </apex:actionRegion>
                    
                    <br/> 
                    <apex:actionStatus id="MainStatusSub"> 
                        <apex:facet name="start"> 
                            <div style="text-align:center;"> 
                                <img src="{!$Resource.SpinIcon}"/> 
                            </div> 
                        </apex:facet> 
                    </apex:actionStatus>
                    
                    <apex:actionStatus id="ComplianceEvaluationStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputpanel>
            </apex:outputpanel>
            
            <div style="margin-top:-2%">
                
                <apex:pageBlockSection id="ResearchRequest">
                    <apex:inputField value="{!case.Research_Request_Type__c}" rendered="{!(case.Origin = 'Standalone Research')}"/>
                    <apex:inputField value="{!case.Research_Request_SubType__c}" rendered="{!(case.Origin = 'Standalone Research')}"/>
                </apex:pageBlockSection>
                
            </div>
            
            
            
            <apex:pageBlockSection id="ResearchRequest1">
                <apex:outputField value="{!case.Research_Request_Type__c}" rendered="{!(case.Origin = 'CMITruistBankStandalone' || case.Origin = 'CMITruistBankClientCentral')}"  />
                <apex:outputField value="{!case.Research_Request_SubType__c}" rendered="{!(case.Origin = 'CMITruistBankStandalone' || case.Origin = 'CMITruistBankClientCentral')}" />
            </apex:pageBlockSection>
            
            <apex:actionStatus id="ResearchRequestStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            
            <!-- ******************************************* -->
            <!-- *    F E E D B A C K   C A T E G O R Y    * -->
            <!-- ******************************************* -->
            <apex:outputPanel id="CategoryPanel" rendered="{!AND(NOT(CACPRManagerProfile))}" styleClass="grey">
                <apex:pageBlockSection title="Feedback Category" id="fbcat" collapsible="false">
                    
                    
                    <!-- ******************************************* -->
                    <!-- *           C A T E G O R I E S           * -->
                    <!-- ******************************************* -->
                    
                    <apex:pageBlockSectionItem id="catButton">
                        <apex:outputLabel value="Search Category"/>
                        <apex:actionRegion >                              
                            <apex:inputText value="{!searchTextValue}" onkeypress="return noenter(event);" rendered="{!$ObjectType.Category__c.Accessible}"/>
                            <apex:commandButton value="Search" action="{!categorySearch}"  rerender="CategoryPanel" status="CategoryStatus" id="catSearchButton"/>
                            <br/>
                            <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!searchTextValue != null}" style="color:red;font-weight:bold;"/>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <br/>
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Cat Level 3" for="level3choice" />
                        <apex:define name="requiredSubmitterCategoryLevel3">
                            <div class="requiredInput">
                                <div class="requiredBlock"></div>
                                <apex:actionRegion >
                                    <apex:selectList value="{!Level3Choice}" multiselect="False" size="10" id="level3choice">
                                        <apex:selectOptions value="{!SubmitterLevel3Choices}"/>
                                        <apex:actionSupport event="onchange" action="{!updateLists}" reRender="CategoryPanel" status="CategoryStatus"/>
                                    </apex:selectList>
                                </apex:actionRegion>
                            </div>
                        </apex:define>                        
                    </apex:pageBlockSectionItem>
                    <br/>
                    <apex:outputPanel style="color:red;font-weight:bold;margin-left:230px;" rendered="{!NOT(ErrorDisplayCatLevel3='')}">{!ErrorDisplayCatLevel3}</apex:outputPanel>
                    <apex:pageBlockSectionItem rendered="{!NOT(ErrorDisplayCatLevel3='')}">
                        <br/>
                    </apex:pageBlockSectionItem>   
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Cat Level 4" for="level4choice" />
                        
                        <apex:define name="requiredSubmitterCategory">
                            <div class="requiredInput">
                                <div class="requiredBlock"></div>
                                
                                <apex:actionRegion >
                                    <apex:selectList value="{!Level4Choice}" multiselect="False"
                                                     size="10" id="level4choice">
                                        <apex:selectOptions value="{!Level4Choices}" />
                                        <apex:actionSupport event="onchange" action="{!updateLists}"
                                                            reRender="CategoryPanel" status="CategoryStatus" />
                                    </apex:selectList>
                                </apex:actionRegion>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    <br/>
                    <apex:outputPanel style="color:red;font-weight:bold;margin-left:230px;" rendered="{!NOT(ErrorDisplaySubmitterCategory='')}">{!ErrorDisplaySubmitterCategory}</apex:outputPanel>    
                    <apex:pageBlockSectionItem rendered="{!NOT(ErrorDisplaySubmitterCategory='')}">
                        <br/>
                    </apex:pageBlockSectionItem>
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Cat Level 5" for="level5choice" />
                        <apex:define name="requiredSubmitterCategory">
                            <div class="requiredInput">
                                <div class="requiredBlock"></div>
                                <apex:actionRegion >
                                    <apex:selectList value="{!Level5Choice}" multiselect="False"
                                                     size="10" id="level5choice">
                                        <apex:selectOptions value="{!Level5Choices}" />
                                        <apex:actionSupport event="onchange" action="{!updateLists}"
                                                            reRender="CategoryPanel" status="CategoryStatus" />
                                    </apex:selectList>
                                </apex:actionRegion>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    <br/>
                    <apex:outputPanel style="color:red;font-weight:bold;margin-left:230px;" rendered="{!NOT(ErrorDisplaySubmitterSubCategory='')}">{!ErrorDisplaySubmitterSubCategory}</apex:outputPanel>
                    
            <br/>
            
                    
                    
                    <apex:actionStatus id="CategoryStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}" />
                            </div>    
                        </apex:facet>
                    </apex:actionStatus>
                    
                    
                    
                    <apex:outputPanel id="CategoryPanel2" rendered="{!OR(CRTQualityAssuranceSpecialist)}">
                        <apex:pageBlockSection >
                            <apex:inputField value="{!case.Cat_Level_1__c}" />
                            <apex:inputField value="{!case.Cat_Level_2__c}" />
                            <apex:inputField value="{!case.Cat_Level_3__c}" />
                            <apex:inputField value="{!case.Cat_Level_4__c}" />
                            <apex:inputField value="{!case.Cat_Level_5__c}" />
                            <!--apex:inputField value="{!case.Cat_Level_6__c}" /-->
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                </apex:pageBlockSection>
                <br/>
                
            </apex:outputPanel>
            <!--Mohan Changes as part of US1882494,US1882502 (M-02) Start -->
            <!-- US2030622 - (DR-4354) 1.6 - Expand Field Text Box
            <apex:pageBlockSection columns="2"> -->
             <apex:pageBlockSection >
                    <apex:pageBlockSectionItem >
                <!-- Start-- Added "Cat Level 6" field for Feb 2021 Release-->
                        <apex:outputLabel value="Cat Level 6" />
                <apex:inputField value="{!case.Cat_Level_6__c}" style="display:block;width:900px;height:82px;" />
                <!-- End-- Added "Cat Level 6" field for Feb 2021 Release-->
            </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                 <apex:pageBlockSection columns="2" >
                
               <apex:inputField value="{!case.Issue_Category__c}"/>
                
             </apex:pageBlockSection>
             <apex:pageBlockSection columns="2" >
                <apex:inputField value="{!case.Single_Use_Promo_Code__c}"/>
                </apex:pageblocksection>
            <apex:pageBlockSection columns="2">
                    <apex:inputField value="{!case.Initiative_Tracking__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                </apex:pageBlockSection>
             <apex:pageBlockSection columns="2">
                    <apex:outputField value="{!case.Initiative_Tracking__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" /> 
            </apex:pageBlockSection>
            <!--Mohan Changes as part of US1882494,US1882502 (M-02) End -->
            <apex:outputPanel rendered="{!OR(CACPRManagerProfile)}">
                <apex:pageBlockSection > 
                    <apex:outputField value="{!case.Cat_Level_3__c}" />
                    <apex:outputField value="{!case.Cat_Level_4__c}" />
                    <apex:outputField value="{!case.Cat_Level_5__c}" />
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <apex:outputPanel styleclass="grey"> 
                <apex:pageBlockSection title="SLA" id="FRBExtension" columns="2" collapsible="false">
                    <apex:outputField value="{!case.Was_Mandated_Acknowledgement_SLA_Met__c}"/>
                    <apex:outputField value="{!case.Was_Mandated_Response_SLA_Met__c}"/>
                    <apex:inputField value="{!case.Acknowledgement_Method__c}" />
                    <apex:outputField value="{!case.Mandated_Response_SLA_Date__c}" /> 
                    <apex:outputField value="{!case.Mandated_Acknowledgement_SLA_Date__c}" />
                    <apex:inputField value="{!case.Response_Date_Time_Sent__c}" />
                    <apex:inputField value="{!case.Acknowledgement_Date_Time_Sent__c}" /><br/>
                    <!--Added Resolution Method Field for JAN22 Release-->
                    <apex:inputField value="{!case.Resolution_Method__c}" /><br/>
                    <!--<apex:inputField value="{!case.Acknowledgement_Date_Time_Sent__c}" />-->
                    <apex:outputField value="{!case.Mandated_Response_Extension_SLA_Date__c}" />
                    
                    <br/><apex:inputField value="{!case.Extension_Notification_Date_Time_Sent__c}" />
                    
                    <br/>
                    <!--June 2025 - US1609565 Add new Dealer-Related 30/60 checkbox />-->
                    <apex:inputField value="{!case.Dealer_Related_30_60__c}" />
                    <!--Changes start for Jan 2024 : Added source feedback values (FDIC Follow-Up, NCCOB Follow-Up) in if condition -->
                    <!-- December 2024 - US1456435 and US1456439 Added source feedback values (FDIC Appeal, FDIC Congressional) in if condition -->
                    <apex:inputField value="{!case.FRB_Extension_Approved_Date__c}" rendered="{! (case.Call_Source__c='FRB' || case.Call_Source__c='FRB Congressional' || case.Call_Source__c='Congressional Non-Fed' || case.Call_Source__c='Attorney General' || case.Call_Source__c='BBB' || case.Call_Source__c='NCCOB' || case.Call_Source__c='FDIC' || case.Call_Source__c='Agency' || case.Call_Source__c='FDIC Follow Up' || case.Call_Source__c='NCCOB Follow Up' || case.Call_Source__c == 'FDIC Appeal' || case.Call_Source__c == 'FDIC Congressional') && NOT(CRTQualityAssuranceSpecialist)}"/>                                                
                    <apex:outputField value="{!case.FRB_Extension_Approved_Date__c}"  rendered="{! (case.Call_Source__c='FRB' || case.Call_Source__c='FRB Congressional' || case.Call_Source__c='Congressional Non-Fed' || case.Call_Source__c='Attorney General' || case.Call_Source__c='BBB' || case.Call_Source__c='NCCOB' || case.Call_Source__c='FDIC' || case.Call_Source__c='Agency' || case.Call_Source__c='FDIC Follow Up' || case.Call_Source__c='NCCOB Follow Up' || case.Call_Source__c == 'FDIC Appeal' || case.Call_Source__c == 'FDIC Congressional') && CRTQualityAssuranceSpecialist}" />
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <div style="margin-top:-1.25%">     
                <apex:pageBlockSection >
                    <apex:inputField style="min-width: fit-content" value="{!case.If_SLA_Missed_Provide_Reason_s__c}"/>
                    </apex:pageBlockSection>
                    <br/>
                    <apex:pageBlockSection >
                <apex:pageblocksectionitem >
                <!--Mohan Changes as part of US1654409 (M10) -->
                <!-- US1900227 - (DR-4317) M.3 - If SLA Missed, Provide Reason(s) AND SLA Missed Comments Alignment
                <apex:outputLabel value="SLA Missed Comments" style="display:block;width:200px;" /> -->
                <apex:outputLabel value="SLA Missed Comments" style="display:block;width:167px;" />
                <apex:inputField value="{!case.SLA_Missed_Comments__c}" style="width:900px;height:100px"/> 
                </apex:pageblocksectionitem>
                </apex:pageBlockSection> 
                    <apex:inputField value="{!case.ClosedDate}" rendered="false" />               
                  
            </div>            
            
            <!-- ******************************************* -->
            <!-- *   R E S O L U T I O N   D E T A I L S   * -->
            <!-- ******************************************* -->
            
            <apex:outputPanel styleclass="grey">
                <apex:pageBlockSection id="ResolvedByPointPOC" title="Resolution Details">
                    <apex:pageBlockSectionItem rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}">
                        <apex:outputLabel value="Resolved by Point of Contact?" for="quest1Section2"/> 
                        <apex:define name="requiredQ1"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div> 
                                <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1Section2"/> 
                            </div> 
                        </apex:define> 
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                <div style="margin-top:-1.50%" >
                    
                    <apex:pageBlockSection id="refund" collapsible="false"> 
                        
                        <apex:pageblocksectionitem >
                            <apex:outputlabel value="Relief Provided?"/>
                            <apex:actionRegion > 
                                <apex:inputField value="{!case.Refund__c}"
                                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                                    <apex:actionSupport event="onchange" reRender="refund,typeOfRelief" status="resolutionDetailsStatus" /> 
                                </apex:inputField> 
                            </apex:actionRegion> 
                        </apex:pageblocksectionitem>
                        
                        <apex:outputField value="{!case.Refund__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        
                        <apex:inputField value="{!case.Remediation__c}"
                                         required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                        <apex:outputField value="{!case.Remediation__c}"
                                          rendered="{!AND(CRTQualityAssuranceSpecialist,case.Refund__c='Closed With Monetary Relief')}" />
                        
                    </apex:pageBlockSection>
                    
                    
                </div>
            </apex:outputPanel>
            <div style="margin-top:-1.50%" class="fitContent">
                <apex:pageBlockSection id="typeOfRelief" >
                    <apex:inputField value="{!case.Type_of_Refund__c}"
                                     required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                    <apex:outputField value="{!case.Type_of_Refund__c}"
                                      rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}" />
                    <apex:inputField value="{!case.Type_of_Refund__c}"
                                     required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Non-Monetary Relief' , case.Refund__c='Non-Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->        
                    <apex:inputField value="{!case.Type_of_Refund__c}"
                                     required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Refund__c='Closed With Explanation')}"/>            
                    <apex:outputField value="{!case.Type_of_Refund__c}"
                                      rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Non-Monetary Relief' , case.Refund__c='Non-Monetary Relief' ,case.Refund__c='Closed With Explanation'))}" />   
                </apex:pageBlockSection>
            </div>
            <div style="margin-top:-1.00%">
                <apex:pageBlockSection id="rootCauseRenderPanel1">
                    <!--apex:inputField value="{!case.Root_Cause__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"  id="id3" onchange="hidefieldsrootCauseDetail();"/-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Root Cause"/>
                        <apex:actionRegion > 
                            <apex:inputField value="{!case.Root_Cause__c}">
                                <apex:actionSupport action="{!clearRootCause}" event="onchange" reRender="rootCauseRenderPanel1,rootCauseDetails" status="resolutionDetailsStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Root_Cause__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                </apex:pageBlockSection>
            </div>
            
            <div style="margin-top:-1.50%" class="fitContent">
                <apex:pageBlockSection id="rootCauseDetails" >
                    <apex:inputField value="{!case.Root_Cause_Detail__c}" rendered="{!case.Root_Cause__c='Truist Impact'}" required="true" />
                    <apex:inputField value="{!case.Root_Cause_Detail__c}" rendered="{!case.Root_Cause__c='Undetermined'}" required="true" />
                </apex:pageBlockSection>
            </div>
            <apex:outputField value="{!case.Root_Cause_Detail__c}" rendered="{!AND((CRTQualityAssuranceSpecialist),OR(case.Root_Cause__c='Non Truist Impact'), case.Status = 'Closed' )}"/>
            
            <div style="margin-top:-1.00%">
                <apex:pageBlockSection columns="2">
                    
                    <apex:inputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    <br/>
                    <apex:pageBlockSectionItem >
                        <!--<apex:outputLabel value="Client Acknowledgement Requested ($)"></apex:outputLabel>-->
                        <apex:outputPanel >
                                <apex:outputLabel value="Client Acknowledgement Requested ($)"/>
                                <img src="/s.gif" alt="Help" class="helpIcon" title="{!$Label.Client_Acknowledgement_Requested}"/>   
                        </apex:outputPanel>
                        <apex:actionRegion >
                            
                            <apex:inputField value="{!case.Client_Acknowledgement_Requested__c}" rendered="{!$Permission.CapCardFieldPermission}">
                                <apex:actionSupport event="onchange" reRender="CapFulFillmentFields" action="{!nullifyCAP}" status="resolutionDetailsStatus"/>
                            </apex:inputField>
                            <apex:outputField value="{!case.Client_Acknowledgement_Requested__c}" rendered="{!NOT($Permission.CapCardFieldPermission)}"/>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    
                    
                    <!--br/>
<apex:inputField value="{!case.CAP_Card_Fulfillment_Number__c}"/><br/>
<apex:inputField value="{!case.CAP_Card_Fulfillment_Date__c}"/-->
                    
                </apex:pageBlockSection>
            </div>
            <div style="margin-top:-1.50%">
                <apex:pageBlockSection id="CapFulFillmentFields">
                    <apex:inputField value="{!case.CAP_Card_Fulfillment_Number__c}" rendered="{!(case.Client_Acknowledgement_Requested__c != Null && case.Client_Acknowledgement_Requested__c != '' && case.Client_Acknowledgement_Requested__c != 'N/A' && $Permission.CapCardFieldPermission)}"/>
                    <apex:outputField value="{!case.CAP_Card_Fulfillment_Number__c}" rendered="{!(case.Client_Acknowledgement_Requested__c != Null && case.Client_Acknowledgement_Requested__c != '' && case.Client_Acknowledgement_Requested__c != 'N/A' && (NOT($Permission.CapCardFieldPermission)))}"/><br/>
                    <apex:inputField value="{!case.CAP_Card_Fulfillment_Date__c}" rendered="{!(case.Client_Acknowledgement_Requested__c != Null && case.Client_Acknowledgement_Requested__c != '' && case.Client_Acknowledgement_Requested__c != 'N/A' && $Permission.CapCardFieldPermission)}"/> 
                    <apex:outputField value="{!case.CAP_Card_Fulfillment_Date__c}" rendered="{!(case.Client_Acknowledgement_Requested__c != Null && case.Client_Acknowledgement_Requested__c != '' && case.Client_Acknowledgement_Requested__c != 'N/A' && (NOT($Permission.CapCardFieldPermission)))}"/>
                </apex:pageBlockSection>
            </div>
            
            <!-- Added below Fields for CMI JAN22 Release-->
            <apex:pageBlockSection >
                <apex:inputField value="{!case.CAP_Card_Exception_Approved_By__c}" rendered="{!$Permission.CapCardFieldPermission}" />
                <apex:outputField value="{!case.CAP_Card_Exception_Approved_By__c}" rendered="{!NOT($Permission.CapCardFieldPermission)}"/><br/>
                <apex:inputField value="{!case.CAP_Card_Return_Receipt_Concern__c}" rendered="{!$Permission.CapCardFieldPermission}" />
                <apex:outputField value="{!case.CAP_Card_Return_Receipt_Concern__c}" rendered="{!NOT($Permission.CapCardFieldPermission)}"/>
            </apex:pageBlockSection>    
            
            <apex:actionStatus id="resolutionDetailsStatus"> 
                <apex:facet name="start"> 
                    <div style="text-align:center;"> 
                        <img src="{!$Resource.SpinIcon}"/> 
                    </div> 
                </apex:facet> 
            </apex:actionStatus>
            
            <!-- ******************************************* -->
            <!-- *   C L O S E   C A S E   D E T A I L S   * -->
            <!-- ******************************************* -->
            
            <apex:outputPanel styleclass="grey">
                <apex:pageBlockSection title="Close Case Details" collapsible="false">                
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <apex:pageBlockSection id="CloseCasePanel" columns="2">
                <apex:pageBlockSectionItem rendered="{!AND(NOT(CACPRManagerProfile))}">
                    <apex:outputLabel value="{!$ObjectType.Case.fields.Status.label}"
                                      for="statusIn" />
                    <apex:actionRegion >
                        <apex:inputField id="statusIn" value="{!case.Status}"
                                         required="True">
                            <apex:actionSupport event="onchange" rerender="statusReason, jsPanel, SPOCTeammate,thisIsClient,ComplianceLOB,MonitoringResult" />
                        </apex:inputField>
                        <apex:outputPanel id="jsPanel">
                            <script>
                            var s = document.getElementById('{!$Component.statusIn}');
                            var sText = s.options[s.selectedIndex].text;
                            
                            if (sText == 'Send to Quality Assurance') {
                                document.getElementById('{!$Component.statusReason}').options[1].selected = 'true';
                            }                               
                            </script>
                        </apex:outputPanel>
                        
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.Status}" rendered="{!CACPRManagerProfile}" />
                <apex:inputField id="statusReason" value="{!case.Status_Reason__c}"
                                 required="TRUE"
                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Status_Reason__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                
                
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Auto Closed & Monitoring Review" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Auto_Closed_Review__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                            <apex:actionSupport event="onchange"  reRender="thisIsClient,SPOCTeammate,loanInfo,pageblockSection_show" status="closeCaseDetailsStatus"/> <!--*** -->
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                
                <apex:outputField value="{!case.Auto_Closed_Review__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                
                <apex:inputField value="{!case.Priority}" required="TRUE"
                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Priority}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                
                <apex:pageBlockSectionItem rendered="{!(NOT($ObjectType.Case.fields.Priority.Accessible))}">
                    <br/>
                </apex:pageBlockSectionItem>
                
                <apex:inputField value="{!case.Advanced_Search_Results_Intake__c}"  style="width:250px;height:70px;" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                <apex:outputField value="{!case.Advanced_Search_Results_Intake__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                
                <apex:inputField value="{!case.Advanced_Search_Results_Case_Owner__c}"  style="width:250px;height:70px;" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                <apex:outputField value="{!case.Advanced_Search_Results_Case_Owner__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                
                <apex:inputField value="{!case.Case_Comments_Reviewed__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                <apex:outputField value="{!case.Case_Comments_Reviewed__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/> 
                </apex:pageBlockSection>
                <br/>
  
            <!-- October 2025 - US1725364 and US1725365 New Augment Feedback Fields --> 
            <!--Diabaling AWS Stories-->
            <apex:pageBlockSection >
                <apex:inputField value="{!case.Amazon_Augment_Feedback__c}"/> 
                
                
            </apex:pageBlockSection> 
            <br/>
            
             

            <apex:pageBlockSection columns="2" collapsible="false">
                     <apex:pageBlockSectionItem >
                              <apex:pageBlockSection columns="1" >
                                  <apex:pageBlockSectionItem >
                 <apex:outputLabel value="Amazon Augment Feedback Comments" style="display:block;width:150px;" />
                 <apex:inputField value="{!case.Amazon_Augment_Feedback_Comments__c}" style="width:1000px;height:100px;"/>
                 </apex:pageBlockSectionItem>
                                  <br/>
                                  <apex:pageblocksectionitem >
                                    <apex:outputLabel value="Case Status Summary" style="display:block;width:150px;" />
                <apex:inputField value="{!case.Case_Status_Summary__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Case_Association_Type__c != 'Transfer to CARRT', case.Case_Association_Type__c != 'Transfer to CRT',case.Case_Association_Type__c != 'Transfer to MERT', case.Case_Association_Type__c != 'Escalated to OOP')}" style="width:1000px;height:100px;"/>
                                    </apex:pageblocksectionitem>
                <apex:outputField value="{!case.Case_Status_Summary__c}" rendered="{!OR((CRTQualityAssuranceSpecialist), case.Case_Association_Type__c = 'Transfer to CARRT', case.Case_Association_Type__c = 'Transfer to CRT',case.Case_Association_Type__c = 'Transfer to MERT', case.Case_Association_Type__c = 'Escalated to OOP')}" />
                                      
                <br/>
                <apex:pageBlockSectionItem >
                   <!--Mohan Changes as part of US1654404 (M10) -->
                   <apex:outputLabel value="Analysis Comments" style="display:block;width:150px;" />
                  <apex:inputField value="{!case.Analysis_Comments__c}"
                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"
                                 style="width:1000px;height:180px;" />
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.Analysis_Comments__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}"  />
                <!--apex:pageBlockSectionItem rendered="{!($Profile.Name!='MERT Workflow Coordinator')}"--> 
                <apex:pageBlockSectionItem rendered="{!$ObjectType.Case.fields.Analysis_Comments__c.Accessible}">
                    <br/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <!--Mohan Changes as part of US1654405 (M10) -->
                    <apex:outputLabel value="Resolution Comments" style="display:block;width:150px;" />
                    <apex:inputField value="{!case.Resolution_Comments__c}"
                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"
                                 style="width:1000px;height:180px;" />
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.Resolution_Comments__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                <br/>
                <apex:pageBlockSectionItem >
                    <!--Mohan Changes as part of US1654406 (M10) -->
                    <apex:outputLabel value="Additional Comments" style="display:block;width:150px;" />
                    <apex:inputField value="{!case.CPR_Additional_Comments__c}"
                                 rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"
                                 style="width:1000px;height:100px;" />
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.CPR_Additional_Comments__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                                  </apex:pageBlockSection>
                                     </apex:pageBlockSectionItem>
                
            </apex:pageBlockSection>
                   
            <apex:actionStatus id="closeCaseDetailsStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <div style="margin-top:-1.00%;margin-left:-2.50%">
                <apex:pageBlockSection id="clientCaseResponse">
                    
                    <apex:inputField value="{!case.Client_Response_Approved_By__c}" rendered="{!case.Type = "Complaint" || case.Type="Service Request" }" />
                    <apex:inputField value="{!case.Client_Response_Approval_Comments__c}"  style="width:200px; height:100px" rendered="{!case.Type = "Complaint" || case.Type="Service Request" }" />
                </apex:pageBlockSection>    
            </div>
            <div style="margin-left:-2.50%">
                <apex:pageBlockSection >
                    <!--apex:inputField value="{!case.Abusive_Contact__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/-->
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"> 
                        <apex:outputlabel value="Abusive Contact" /> 
                        <apex:actionRegion > 
                            <apex:inputField style="min-width: fit-content" value="{!case.Abusive_Contact__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"> 
                                <apex:actionSupport event="onchange" action="{!nullifyAbusiveContactType}" rerender="AbusiveContactType,AbusiveDisposition" status="CloseCaseDetailsStatus"/> 
                            </apex:inputField> 
                        </apex:actionRegion> 
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Abusive_Contact__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>                    
                    
                </apex:pageBlockSection>
            </div>
            <div style="margin-top:-1.00%">
                <apex:pageBlockSection id="AbusiveContactType">
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist) && case.Abusive_Contact__c = 'Yes')}">
                        <apex:outputLabel value="Abusive Contact Type?"/>
                        <apex:actionRegion >
                            <apex:inputField style="min-width: fit-content" value="{!case.Abusive_Contact_Type__c}">
                                <apex:actionSupport event="onchange" rerender="AbusiveDisposition" status="CloseCaseDetailsStatus"/> 
                            </apex:inputField>
                        </apex:actionRegion>   
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Abusive_Contact_Type__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>   
                </apex:pageBlockSection>
            </div>
            
            <!-- Added below Field for JAN22 Release -->
            <apex:pageBlockSection id="AbusiveDisposition">
                <apex:inputField value="{!case.Abusive_Contact_Disposition__c}" required="{!(case.Abusive_Contact_Type__c != '' && case.Abusive_Contact_Type__c !=null && case.Abusive_Contact_Type__c != 'N/A')}" /> 
            </apex:pageBlockSection>
            <apex:outputPanel id="SupportInfo">
                <apex:pageBlockSection columns="2"  rendered="{!(((case.Is_Feedback_regarding_a_TM_Dept__c == 'Supplier' || case.Is_Feedback_regarding_a_TM_Dept__c == 'Third Party')&& case.Origin = 'Third Party' && case.Source_System__c != Null && case.Source_System__c != '') || (case.Origin != 'Third Party'))}">
                    <apex:inputField value="{!case.Support_Info_1__c}" style="width:500px;height:100px;"/>
                    <br/>
                    <apex:inputField value="{!case.Support_Info_2__c}" style="width:500px;height:100px;"/>
                    <br/>
                    <apex:inputField value="{!case.Support_Info_3__c}" style="width:500px;height:100px;"/><br/>
                    <apex:inputField value="{!case.Support_Info_4__c}" style="width:500px;height:100px;"/><br/>
                    <apex:inputField value="{!case.Support_Info_5__c}" style="width:500px;height:100px;"/>
                </apex:pageBlockSection>
            </apex:outputPanel>
            <!-- ******************************************* --> 
            <!-- *      C F P B Updates                    * -->
            <!-- ******************************************* --> 
            <apex:outputPanel id="CFPBPanel">
                <apex:outputPanel rendered="{!case.Call_Source__c=='CFPB' || case.Call_Source__c=='CFPB Follow Up'}" styleClass="grey">                 
                    <apex:pageBlockSection title="CFPB Information" columns="2" collapsible="false">
                        <!-- September 2022 added required condition for third party -->
                        <apex:InputField value="{!case.CFPB_Case_Number__c}" required="{!(case.Origin !='Third Party' && case.Source_System__c == Null)}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                        <apex:OutputField value="{!case.CFPB_Case_Number__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />
                        
                        <apex:InputField value="{!case.CFPB_Product__c}" required="{!(case.Origin !='Third Party' && case.Source_System__c == Null)}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>                          
                        <apex:OutputField value="{!case.CFPB_Product__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />
                        
                        <apex:InputField value="{!case.CFPB_Company_Status__c}" required="{!(case.Origin !='Third Party' && case.Source_System__c == Null)}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                        <apex:OutputField value="{!case.CFPB_Company_Status__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />                         
                        
                        <apex:InputField value="{!case.CFPB_Respond_by_Date__c}" required="{!(case.Origin !='Third Party' && case.Source_System__c == Null)}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>        
                        <apex:OutputField value="{!case.CFPB_Respond_by_Date__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />
                    </apex:pageBlockSection>
                    
                    <apex:actionRegion >                
                        <apex:pageBlockSection columns="2" id="publicResponse" >                          
                            <apex:inputField value="{!case.Consumer_Narrative_Made_Public__c}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                            <apex:pageBlockSectionItem rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up'}">
                                <apex:outputLabel value="{!$ObjectType.Case.fields.SunTrust_Public_Response__c.label}"></apex:outputLabel>
                                <apex:define name="requiredPubResponse">
                                    <div class="requiredInput">
                                        <div class="{!IF((case.CFPB_Status__c != 'In Progress' && case.CFPB_Status__c != Null && $ObjectType.Case.fields.SunTrust_Public_Response__c.Updateable) ,'requiredBlock','')}"></div>                                         
                                        <apex:inputField value="{!case.SunTrust_Public_Response__c}"/>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection> 
                        
                        <apex:pageBlockSection >                         
                            <apex:InputField value="{!case.CFPB_Issue__c}" required="{!(case.Origin !='Third Party' && case.Source_System__c == Null)}" style="width:500px;height:140px;" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                            <apex:OutputField value="{!case.CFPB_Issue__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />                          
                        </apex:pageBlockSection>
                        
                        <apex:actionStatus id="cfpbStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>                
                        
                        <apex:pageBlockSection rendered="{!Case.Call_Source__c == 'CFPB'}">                    
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="CFPB Status" rendered="{!Case.Call_Source__c == 'CFPB'}"></apex:outputLabel>
                                <apex:inputField value="{!case.CFPB_Status__c}" rendered="{!Case.Call_Source__c == 'CFPB'}">
                                    <apex:actionSupport event="onchange" rerender="publicResponse,publicResponse1" />
                                </apex:inputField>                        
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
                            
                            <apex:inputField value="{!case.CFPB_Relief_Amount__c}"/>
                            
                        </apex:pageBlockSection>
                    </apex:actionRegion>
                    
                    <apex:pageBlockSection rendered="{!Case.Call_Source__c == 'CFPB'}">
                        <apex:inputField value="{!case.CFPB_Relief_Description__c}" style="width:500px;height:140px;"/>
                    </apex:pageBlockSection>
                    
                </apex:outputPanel>  
            </apex:outputPanel>
            
            <!-- *************************************************************** -->
            <!-- *   C A   D E F A U L T   A S S I G N M E N T   G R O U P   * -->
            <!-- *************************************************************** -->
            <apex:outputPanel styleClass="grey">
                <apex:pageBlockSection title="Client Advocacy Default Group Assignment" collapsible="false">
                    
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="{!$ObjectType.Case.fields.Primary_Default_Group__c.label}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"></apex:outputLabel>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Primary_Default_Group__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                                <apex:actionSupport event="onchange" rerender="litigationFields" status="primaryDefaultGroup"/>
                            </apex:inputField> 
                        </apex:actionRegion>                       
                    </apex:pageBlockSectionItem>                
                    
                    <apex:outputField value="{!case.Primary_Default_Group__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <apex:inputField value="{!case.Investor_Type__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Investor_Type__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    <apex:inputField value="{!case.Retention_or_Liquidation__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Retention_or_Liquidation__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <apex:inputField value="{!case.Bankruptcy_Type__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Bankruptcy_Type__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <apex:inputField value="{!case.Is_Foreclosure_Due_in_48_Hours__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Is_Foreclosure_Due_in_48_Hours__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <!--Added below Field for JAN22 Release-->
                    <apex:inputField value="{!case.Foreclosure_Sale_Date__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.Foreclosure_Sale_Date__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <apex:actionStatus id="primaryDefaultGroup">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            
            <!-- ********************************************************** -->
            <!-- *            Q U A L I T Y   A S S U R A N C E           * -->
            <!-- ********************************************************** -->
            
            <apex:outputPanel styleClass="grey">
                <apex:pageBlockSection title="Quality Assurance" collapsible="false"> 
                    <apex:inputField value="{!case.Quality_Assurance_Specialist__c}" />
                    
                    <apex:inputField value="{!case.Quality_Assurance_Status__c}" />
                    <apex:inputField value="{!case.Quality_Assurance_Comments__c}"
                                     style="width:500px;height:140px;" />
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <apex:outputPanel styleClass="grey">
                <apex:pageBlockSection title="System Assigned Fields"
                                       rendered="false" collapsible="false">
                    
                    <apex:inputField value="{!case.CreatedDate}" />
                    <apex:inputField value="{!case.Closed_Date__c}" />
                    <apex:inputField value="{!case.LastModifiedById}" />
                    <apex:inputField value="{!case.LastModifiedDate}" />
                    <apex:inputField value="{!case.Contact_Name__c}" />
                    <apex:inputField value="{!case.Age_Days__c}" />
                    <apex:inputField value="{!case.Age_Hours__c}" />
                    <br />
                </apex:pageBlockSection>
            </apex:outputPanel>
            <br />
            
            <!-- *************************************************************** -->
            <!-- *   R E P U T A T I O N    R I S K    S U M M A R Y   * -->
            <!-- *************************************************************** --> 
            <!--apex:outputPanel styleClass="grey">
<apex:pageblocksection title="Reputational Risk Summary" columns="2" collapsible="false">

<apex:pageBlockSectionItem > 
<apex:outputLabel value="Reputational Risk Disposition"/>
<apex:inputField value="{!case.Reputational_Risk_Disposition__c}">
<apex:actionSupport event="onchange" rerender="ReputationalRiskSummary" status="ReputationalRisk"/> 
</apex:inputField>                             
</apex:pageBlockSectionItem>
<br/>
<apex:pageBlockSectionItem > 
