
<apex:page standardController="Case" action="{!retrieveArrangementSummariesList}"  extensions="ClientAdvocacyEdit_ControllerExtension,CMIClientManagement_ControllerExtension,CategoryLists_ControllerExtension" lightningStylesheets="true" id="id1">
    <apex:messages style="color:red;font-weight:bold;background-color:white;" />
    
    <script type="text/javascript" >  
    
    
    var originalOnload = window.onload;
    window.onload = f1;
    
    
    
    function f1() 
    {
        originalOnload();
        /*if(document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Non Truist Impact')
        { 
            document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='none';
        }*/        
    } 
    
    function hidefieldsrootCauseDetail()
    {
        
        if(document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Non Truist Impact')
        {
            
            document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='none';
        }
        else
        {
            document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='block';
        }
    }
    
    <!--start changes for CMI 2016 December release-->
        <!--Complaint From or About A Supplier is nullified on selecting supplier search-->
        function vendorsearch()
                              {
                                  document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.clientFeedbackDetails.SupplierBlock.Field}').value='';      
                              }
                                  
                                  <!--End changes for CMI 2016 December release-->
                                  function noenter(e)
                                  {
                                  if(window.event)
                                  {
                                  key = window.event.keyCode; 
                              } 
                                  else
                                  {
                                  key = e.which; 
                              }
                                  if(key == 13) 
                                  {
                                  var ele=document.getElementById('id1:CRTEditForm:CRTPage:fbcat:catButton:catSearchButton');
                                  ele.click();
                                  return false;
                              } 
                                  else
                                  {
                                  return true;
                              }
                              }
                                  
                                  <!-- The below script is called on save button to disable once clicked. This is to avoid creation of duplicate records-->
                                  var isClicked = false;
                                  function checkDoubleSubmit(obj)
                                  {
                                  if (isClicked) 
                                  {                                  
                                  return false;
                              }
                                  else  
                                  {
                                  document.getElementById('spinner').style.display = "block";
                                  document.getElementById('spinner1').style.display = "block";
                                  isClicked = true;
                                  obj.className = 'btnDisabled';//only shows the button as disabled.
                              }
                              }
                                  
                                  function showToast() {
                                  sforce.one.showToast({
                                  "title": "Success!",
                                  "message": "Record saved successfully !",
                                  "type": "success"
                              });
    }
    
    </script>
    <style>
        body .bPageBlock .pbBody .grey .pbSubheader{
        background-color:#D3D3D3;
        }
        document.getElementById('Cat3'){
        background-color:#D3D3D3;
        }
        
        .myFormStyle {
        background-color:#D3D3D3 !important;
        }
        
        
    </style>
    <Style>
        .requiredBlock{
        width: 0 !important;
        top: -18px !important;
        bottom: 1px !important;
        color: white;
        font-size: 34px !important;
        left: -8px !important;
        position: absolute !important;
        }
        
        .fitContent select{
        min-width: fit-content !important;
        }  
        
    </Style>
    
    <Script>
        function chagneRequiredBlockToStar() {
        var allRequiredBlock = document.getElementsByClassName('requiredBlock');
        if (allRequiredBlock != null) {
        for (var intI = 0;intI < allRequiredBlock.length; intI++) {
        if (allRequiredBlock[intI] != null && allRequiredBlock[intI].innerHTML != null 
        && allRequiredBlock[intI].innerHTML.indexOf('*') == -1) {
        allRequiredBlock[intI].innerHTML = '*';
        }
        }
        }
        }
    </Script>
    <apex:form id="CRTEditForm" >
        <!--February 2023-->
        <apex:outputField value="{!case.Alert_Type__c}" rendered="FALSE" />
        <apex:outputField value="{!case.ProjectDB__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Source_Case_ID__c}" rendered="FALSE"/>
