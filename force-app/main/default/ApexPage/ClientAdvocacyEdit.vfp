</apex:inputField>
</apex:outputPanel>
</apex:outputPanel>

</apex:pageBlockSectionItem-->
                    <apex:inputField value="{!case.Promotion_Escalation__c}"  />
                    
                    <apex:inputField value="{!case.Case_Group_Assignment__c}" required="true" />
                </apex:pageBlockSection>
                
                
                
                
            </apex:outputPanel>
            
            
            <apex:pageBlockSection >
                <apex:outputField value="{!case.Submitter__c}"
                                  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
            </apex:pageBlockSection>
            <div style="margin-top:-3.1%">
                <apex:pageBlockSection >
                    <apex:pageblocksectionitem >
                        <apex:outputLabel value="Case Type" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />               
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Type}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="True" >
                                <apex:actionSupport event="onchange" action="{!clearAndAssignValueOnCaseTypeChange}" rerender="MandatedSLADate,supplierDetailsPanel,ResolvedByPointPOC,ComplianceEvaluation,AccountDetails,authorisedThirdParty,clientFeedbackDetails,Description,serviceStandardType,clientFeedbackDetails,clientCaseResponse,SOF,ServicingChallengesReported" status="MainStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageblocksectionitem>
                    <apex:outputField value="{!case.Type}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                </apex:pageBlockSection>
            </div>
            
            
            
            
            <div style="margin-top:-1.05%">
                <apex:outputPanel id="SOF">
                    <apex:pageBlockSection columns="2"> 
                        
                        
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                            <apex:outputlabel value="Source of Feedback" />
                            <apex:actionRegion >
                                <!--For CMI 2014 Release 3 FRBExtension is added in rerender attribute-->
                                <!-- Disabling AWS Stories Removed  rendered="{!NOT(AND(case.Call_Source__c == 'AWS Augmentation',case.createdby.Name = 'Informatica integrationatlas'))}" -->
                                <!-- Enable AWS code - US1725342
                                  rendered="{!NOT(AND(case.Call_Source__c == 'AWS Augmentation',case.createdby.Name = 'Informatica integrationatlas'))}"-->
                                <apex:inputField value="{!case.Call_Source__c}" rendered="{!NOT(AND((case.Call_Source__c == 'AWS Augmentation'),NOT($Permission.Allow_Augumentation_Access)))}" required="True"   >
                                    <!--Mohan Removed submitterSOF1,submitterSOF from rerender as part of US1585522 -->
                                    <apex:actionSupport event="onchange" action="{!SourceOfFeedbackChanges}" rerender="SMFields,nameSearch,socialWebSource,SOF,FieldsOnBypassingSearchProcess,CFPBPanel,agState,FRBExtension,Agency,ClientSectionAfterBypassingSearchClient,authorizedClientDetailsBypass,CIFField,FromAnAttorney,FromAnAttorney1,FromRegAgency,FromRegAgency1" status="MainStatus" />
                                </apex:inputField>
                               <!-- Disabling AWS Stories <apex:outputField value="{!case.Call_Source__c}" rendered="{!AND(case.Call_Source__c == 'AWS Augmentation',case.createdby.Name = 'Informatica integrationatlas')}"/> -->
                               <!-- Enable AWS code - US1725342-->
                               <apex:outputField value="{!case.Call_Source__c}" rendered="{!AND(case.Call_Source__c == 'AWS Augmentation',NOT($Permission.Allow_Augumentation_Access))}"/>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField value="{!case.Call_Source__c}"  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <apex:inputField value="{!case.AG_State__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Attorney General',case.Call_Source__c='Agency'))}"/>
                        <apex:pageblocksectionitem rendered="{!Case.Call_Source__c='Counseling Agency'}"> </apex:pageBlockSectionItem>
                        <apex:inputField value="{!case.Agency_Name__c}" rendered="{!OR(AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Attorney General',case.Call_Source__c='Agency')),AND(OR(case.Type='Complaint',case.Type='Service Request'), OR(case.Call_Source__c='Agency',case.Call_Source__c='Counseling Agency')))}" required="{!AND(OR(case.Type='Complaint',case.Type='Service Request'), OR(case.Call_Source__c='Agency',case.Call_Source__c='Counseling Agency'))}"/>
                        <!--March 2023-->
                        
                        <apex:pageBlockSectionItem rendered="{!case.Alerts_Number__c <>null}">
                            <apex:outputLabel value="Alert Number"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink id="theLink1"  reRender="" status="LOBDetailStatus" value="{!AlertNumber}" action="{!redirectToAlert}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <!--March 2023-->
                    </apex:pageBlockSection>
                </apex:outputPanel> 
            </div>
            
            <div style="margin-top:-1.5%">
                <apex:pageBlockSection id="socialWebSource">
                    <apex:inputField value="{!case.Social_Web_Source__c}" required="true" rendered="{!(case.Call_Source__c = 'Social Media')}"/>            
                    
                </apex:pageBlockSection>
            </div>
            
            <div style="margin-top:-1.00%">                                     
                <apex:pageBlockSection id="serviceStandardType" >    
                    
                    <apex:pageBlockSectionItem rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'),(SRDEditable))}">
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:inputField value="{!case.Source_Received_Date_Time__c}" required="{!(case.Type='Complaint')}" rendered="{!SRDEditable}"/>
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'),NOT(SRDEditable))}">  
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!!SRDEditable}"/>
                    </apex:pageBlockSectionItem>
                    
                                                                             
                </apex:pageBlockSection>
                </div>
                <apex:pageBlockSection rendered="{!case.Amazon_Contact_ID_URL__c!=Null && case.Amazon_Contact_ID_URL__c!=''}">  
                        <!--<apex:outputlabel value="Amazon Contact ID"/>-->
                        <!--<apex:outputField value="{!case.Amazon_Contact_ID__c}"/>
                        Amazon_Contact_ID_URL__c-->
                        <apex:outputField value="{!case.Amazon_Contact_ID_URL__c}"/>
               </apex:pageBlockSection>
            <!--Diabaling AWS Stories-->
             <apex:pageBlockSection >
                   <apex:outputField value="{!case.Amazon_Segment_Contact_ID_URL__c}"/>
            </apex:pageBlockSection> 
            
            
            <apex:pageBlockSection >               
                <apex:actionStatus id="MainStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                
            </apex:pageBlockSection>
            
            <!--September 2022 -->
            <apex:outputPanel id="ThirdClientDetails">
                <apex:pageBlocksection title="Client Details" rendered="{!(case.Origin='Third Party' && case.Source_System__c != Null && case.Source_System__c != '')}">
                    <apex:outputField value="{!case.Client_Prospect_Name__c}"/>
                    <apex:outputField value="{!case.Historic_CIN__c}"/>
                    <apex:outputField value="{!case.Client_Prospect_Address__c}"/> <br/>
                    <apex:outputField value="{!case.Co_Signer_Name__c}"/> <br/>
                    <!--apex:inputField value="{!case.Loan_Account_or_Client_Identifier__c}" required="true" rendered="{!}"/-->
                    <apex:outputField value="{!case.Loan_Account_or_Client_Identifier__c}"/>
                </apex:pageBlocksection>
            </apex:outputPanel>
            <!-- End September 2022 -->
            
            <!-- ******************************************* -->
            <!-- *   C L I E N T   I N F O R M A T I O N   * -->
            <!-- ******************************************* -->
            <apex:outputPanel styleClass="grey">
                <apex:pageBlockSection id="authorisedThirdParty" title="Client Information" collapsible="false">
                    
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Is this a client?" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> 
                        <apex:actionRegion >                           
                            <apex:inputField value="{!case.Is_this_a_Client__c}" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" >
                                <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="thisIsClient,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,authorisedThirdParty,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,accountFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="MainStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    
                    <apex:outputField value="{!case.Is_this_a_Client__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
