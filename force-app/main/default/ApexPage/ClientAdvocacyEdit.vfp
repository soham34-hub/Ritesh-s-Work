                </apex:outputPanel>
                
            </div>
            <!--div style="margin-top:-1.50%">
<apex:pageBlockSection id="ClientIndicator">
<apex:inputField value="{!case.Client_Indicator__c}" html-disabled="true" rendered="{!(case.Origin = 'Standalone Research' || case.Origin = 'CMITruistBankStandalone')}"/>
</apex:pageBlockSection>
</div-->
            <div style="margin-top:-2.0%">
                <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient"> 
                    <apex:outputPanel rendered="{!((((assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'))  || (case.Call_Source__c = 'Social Media') || (case.Is_this_a_Client__c='No')) || case.BypassSearchProcess__c || case.Is_this_a_Client__c='Yes')}"> 
                        <apex:pageBlockSection >                         
                            <apex:pageBlockSectionItem rendered="{!((((assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'))  || (case.Call_Source__c = 'Social Media')) || (case.BypassSearchProcess__c && case.Is_this_a_Client__c='Yes') || case.Is_this_a_Client__c='Yes')}">    
                                <apex:outputlabel value="Bypass Client Search"/> 
                                <apex:actionRegion > 
                                    <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                        <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="authorisedThirdParty,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,accountFields,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="ClientStatus"/>
                                        <!--apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" onsubmit="alert();" oncomplete="alert();" event="onClick" rerender="authorisedThirdParty,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,accountFields,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="ClientStatus"/>
-->
                                        
                                    </apex:inputCheckbox> 
                                </apex:actionRegion> 
                            </apex:pageblocksectionitem>
                            
                            <apex:pageBlockSectionItem rendered="{!(case.Is_this_a_Client__c='No')}">    
                                <apex:outputlabel value="Bypass Client Search"/> 
                                <!--apex:actionRegion > 
<apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
<apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="authorisedThirdParty,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,accountFields,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="ClientStatus"/>
<!--apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" onsubmit="alert();" oncomplete="alert();" event="onClick" rerender="authorisedThirdParty,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,accountFields,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="ClientStatus"/>
-->
                                
                                <!--/apex:inputCheckbox> 
</apex:actionRegion-->
                                <apex:outputField value="{!case.BypassSearchProcess__c}"/>
                            </apex:pageblocksectionitem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (NOT(CRTQualityAssuranceSpecialist)) && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection rendered="{!!case.BypassSearchProcess__c}">                         
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Reason for Bypass"/>
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}"/> 
                                </apex:actionRegion> 
                            </apex:pageblocksectionitem>                             
                        </apex:pageBlockSection>
                        <apex:pageBlockSection rendered="{!case.BypassSearchProcess__c}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:21%" value="If the system is unavailable please try after sometime. If the client cannot be verified in both CRS and CIS, please create an observer."/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!(case.Reason_for_Overriding_Search_Process__c != null && !case.BypassSearchProcess__c && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection >  
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Reason for Bypass"/> 
                                <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && CRTQualityAssuranceSpecialist)}">                         
                        <apex:pageblockSection >  
                            <apex:outputField value="{!case.BypassSearchProcess__c}" />
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Reason for Bypass"/>
                                <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                            </apex:pageBlockSectionItem>
                            <apex:outputField value="{!case.Contact_Name__c}"/>
                            <apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}"/> 
                            <apex:outputField value="{!case.Account_Number__c}"/>
                            <apex:actionRegion > 
                                <apex:outputField value="{!case.Account_Type__c}"> 
                                    <apex:actionSupport event="onchange" reRender="loanInfo,thisIsClient"/>
                                </apex:outputField>
                            </apex:actionRegion>
                            <apex:outputField value="{!case.Contact_Method__c}"/>
                            <apex:outputField value="{!case.Alternate_Phone_Number__c}"/>
                            <apex:outputField value="{!case.Alternate_Address__c}"/>
                            <apex:outputField value="{!case.Alternate_Email__c}"/>
                        </apex:pageblockSection>
                    </apex:outputPanel>
                </apex:outputPanel>
            </div>
            <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                <apex:outPutPanel rendered="{!case.BypassSearchProcess__c && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}">                            
                    <apex:pageBlockSection >                              
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Reason for Bypass"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                    <apex:actionSupport event="onchange" rerender="CINField,authorisedThirdParty,CIFField"  status="ClientStatus" action="{!bypassReasonFunction}"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>                             
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="authorizedClientDetailsBypass">
                        <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Service Request'))}" required="{!NOT(case.Call_Source__c = 'Social Media')}" value="{!case.Contact_Name__c}"/>
                        <br/>
                        <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Service Request'))}" required="{!NOT(case.Call_Source__c = 'Social Media')}" value="{!case.Contact_Phone__c}"/>
                    </apex:pageBlockSection>
                    
                    <div style="margin-top:-1.50%">
                        <apex:pageBlockSection id="CINField" >                              
                            <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available'}"/>
                        </apex:pageBlockSection>
                    </div>
                    
                    <div style="margin-top:-1.50%">
                        <apex:pageBlockSection id="CIFField" >
                            <apex:inputField value="{!case.CIF__c}" required="false" rendered="{!case.BypassSearchProcess__c}"/> 
                        </apex:pageBlockSection> 
                    </div>
                    
                    <div style="margin-top:-0.75%">
                        <apex:pageBlockSection >                              
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Is This A Private Wealth Client?" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                        <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <br/>
                            <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>
                            <br/>
                            
                            <apex:pageBlockSectionItem rendered="{!case.BypassSearchProcess__c && case.Call_Source__c = 'BBT Internal'}">
                                <br/>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem rendered="{!case.BypassSearchProcess__c=False}">
                                <br/>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Is This An Authorized Third Party" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}">
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <br/>
                            <apex:inputField value="{!case.Account_Number__c}" required="true"/>
                            <br/>
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Account Type"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Account_Type__c}" required="true">
                                        <apex:actionSupport event="onchange" reRender="thisIsClient,AlternateAddress,AlternateAddressForRR, AcctTypeDetail-1,acctTypeHidden,loanInfo,CategoryPanel" action="{!defaultAccountTypeDetailField}"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection> 
                    </div>
                    <!--Added new Account Types rendered conditions which are added in JAN22 Release-->
                    <div style="margin-top:-1%">
                        <apex:pageBlockSection id="AcctTypeDetail-1"> 
                            <apex:pageBlockSectionItem rendered="{!case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card'  || case.Account_Type__c='Consumer Loan' || case.Account_Type__c = 'Treasury & Payment Solutions' || case.Account_Type__c = 'Affiliate/Subsidiary' || case.Account_Type__c = 'Trust Account (Fiduciary)' || case.Account_Type__c = 'Corporate and Institutional Group (CIG)' || case.Account_Type__c = 'Debit Card' || case.Account_Type__c = 'Deposit' || case.Account_Type__c = 'Merchant Services' || case.Account_Type__c = 'Mortgage Loan'|| case.Account_Type__c = 'Wholesale Other'}">
                                <apex:outputLabel value="Account Type Detail" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!(case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' ||  case.Account_Type__c='Consumer Loan' || case.Account_Type__c = 'Treasury & Payment Solutions' || case.Account_Type__c = 'Affiliate/Subsidiary' || case.Account_Type__c = 'Trust Account (Fiduciary)'|| case.Account_Type__c = 'Corporate and Institutional Group (CIG)' || case.Account_Type__c = 'Debit Card' || case.Account_Type__c = 'Deposit' || case.Account_Type__c = 'Merchant Services' || case.Account_Type__c = 'Mortgage Loan'|| case.Account_Type__c = 'Wholesale Other')}" required="true">
                                        <apex:actionSupport action="{!counterPartyvalueChange}" event="onchange" reRender="AcctTypeDetail-1" status="isThisaNonTruistCounterParty1" />
                                    </apex:inputfield>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:inputField value="{!case.Is_this_a_Non_Truist_Counterparty__c}"/>
                        </apex:pageBlockSection>
                    </div>
                </apex:outPutPanel>
                
            </apex:outPutPanel>
            <apex:actionStatus id="isThisaNonTruistCounterParty1">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <div style="margin-top:-0.75%">
                <apex:outputPanel id="nameSearch">
                    <apex:pageblockSection rendered="{!(case.CIN__c!=Null || case.CIF__c != Null) && (NOT(case.BypassSearchProcess__c)|| case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" columns="2" >
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Select Account" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}"/>
                            <apex:define name="requiredSelectAccount">
                                <apex:actionRegion >                                    
                                    <apex:selectList size="1" value="{!case.Assign_Select_Account__c}" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}" disabled="{!CACPRManagerProfile}">
                                        <apex:selectOptions value="{!accountsList}"/>
                                        <!--accountTypeDetail is added in the rerender attribute for CMI 2014 release 2-->
                                        <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails1}"  reRender="nameSearch,selectAccountModal,SADsection, AcctTypeDetail-2,accountFields,relationshipManagedBySAD,loanInfo,CategoryPanel" status="selectAccountStatus"/>
                                    </apex:selectList>                                               
                                </apex:actionRegion>
                            </apex:define>
                        </apex:pageBlockSectionItem>                                
                        <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null}">
                            <apex:outputLabel value="Client Name"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink id="theLink1"  reRender="" status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!((stProductId!=null && stProductId!='') && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!='')}">
                            <apex:outputLabel value="Account Number"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(OR(stProductId=null,stProductId="") && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!='')}" />
                        
                        <apex:inputField rendered="{!(case.RenderAccountType__c || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')&& selectedAccountInformation!='--NONE--' }" value="{!case.Account_Number__c}" />                                 
                        <apex:outputField rendered="{!(case.CIN__c<>null)}" value="{!case.CIN__c}"/>
                        <apex:outputField rendered="{!(case.CIF__c!=Null)}" value="{!case.CIF__c}"/>  
                        <apex:outputField rendered="{!case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type__c}" >
                            <apex:actionSupport event="onchange" reRender="thisIsClient,loanInfo"/>
                        </apex:outputField>
                        
                        <apex:pageblockSectionItem rendered="{!(case.RenderAccountType__c || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}">
                            <apex:outputLabel rendered="{!(case.RenderAccountType__c  || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="Account Type" />
                            <apex:actionRegion >
                                <apex:inputField rendered="{!(case.RenderAccountType__c  || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Type__c}" >
                                    <apex:actionSupport event="onchange" reRender="thisIsClient,SADsection,relationshipManagedBySAD,loanInfo,CategoryPanel"  status="selectAccountStatus" action="{!defaultAccountTypeDetailField}"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageblockSectionItem>
                        <apex:outputField rendered="{!case.Client_Name__c<>null}" value="{!case.Business_or_Personal__c}"/>
                        <!--September 2022 
<apex:pageBlockSectionItem rendered="{!case.Client_Servicing_Code__c<>null && case.Client_Servicing_Code__c!=''}"/> 
<apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>
-->
                        <apex:pageBlockSectionItem /> 
                        <apex:OutputField value="{!case.Segment_Code__c}"/>
                        
                        <apex:pageBlockSectionItem /> 
                        <apex:OutputField value="{!case.Segment_Description__c}"/>
                        <!--September 2022-->
                    </apex:pageBlockSection>
                    <!--Added new Account Types rendered conditions which are added in JAN22 Release-->
                    <apex:pageblockSection id="SADsection" rendered="{!((case.CIN__c!=Null || case.CIF__c!=Null) && NOT(case.BypassSearchProcess__c))}"  columns="2" >
                        <apex:pageBlockSectionItem rendered="{!((case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c='Consumer Loan' ||case.Account_Type__c = 'Treasury & Payment Solutions' || case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Affiliate/Subsidiary' || case.Account_Type__c = 'Trust Account (Fiduciary)' || case.Account_Type__c = 'Corporate and Institutional Group (CIG)'|| case.Account_Type__c = 'Debit Card' || case.Account_Type__c = 'Deposit' || case.Account_Type__c = 'Merchant Services' || case.Account_Type__c = 'Mortgage Loan' || case.Account_Type__c = 'Wholesale Other') && !makeAccTypeDetailOutput && case.AccTypeDetailRender__c!=true)}">
                            <apex:outputLabel value="Account Type Detail" />
                            <apex:define name="requiredSelectAccount">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                            <apex:selectOptions value="{!acctTypeDetailFieldValue}"/> 
                                            <apex:actionSupport action="{!counterPartyvalueChange}" event="onchange" reRender="SADsection" status="isThisaNonTruistCounterParty" />
                                        </apex:selectList>
                                    </apex:actionRegion>
                                </div>
                            </apex:define> 
                        </apex:pageBlockSectionItem>
                        
                        <!--manoj added for account type detail mapping Jan 2023 requirement-->    
                        <apex:pageBlockSectionItem rendered="{!((case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c='Consumer Loan' ||case.Account_Type__c = 'Treasury & Payment Solutions' || case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Affiliate/Subsidiary' || case.Account_Type__c = 'Trust Account (Fiduciary)' ||  case.Account_Type__c = 'Corporate and Institutional Group (CIG)' || case.Account_Type__c = 'Debit Card' || case.Account_Type__c = 'Deposit' || case.Account_Type__c = 'Merchant Services' || case.Account_Type__c = 'Mortgage Loan'|| case.Account_Type__c = 'Wholesale Other') && (makeAccTypeDetailOutput || case.AccTypeDetailRender__c=true))}">
                            <apex:outPutlabel value="Account Type Detail"/>
                            <apex:outputfield value="{!case.Account_Type_Detail__c}"/>    
                        </apex:pageBlockSectionItem>
                        
                        <apex:inputField value="{!case.Is_this_a_Non_Truist_Counterparty__c}"/>
                        
                    </apex:pageblockSection>
                    
                    <apex:actionStatus id="isThisaNonTruistCounterParty">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                    
                    <div style="margin-left:-4.75%;margin-top:-1%">
                        
                        
                        <apex:pageBlockSection id="SMFields" rendered="{!(case.Call_Source__c='Social Media')}">
                            <apex:inputField value="{!case.Name_Handle__c}"/><br/>
                            <apex:inputField value="{!case.Number_of_Followers__c}"/><br/>
                            <apex:inputField value="{!case.Sentiment__c}"/><br/>
                        </apex:pageBlockSection>
                    </div>
                    <!--July 2023 CHanges for Service Finance -->
                    <!-- this section is available only for service finance cases when bypasssearch is unchecked and client was not serched using client search button-->
                    <apex:pageBlockSection id="serviceFInanceClientDetails" rendered="{!(case.Origin ='CMIServiceFinanceStandalone' && NOT(case.BypassSearchProcess__c) && case.CIF__c = Null && case.CIF__c = '')}">
                        <!--    <apex:outputField value="{!case.Client_Name__c}" />
<br/>

<apex:outputField value="{!case.Account_Number__c}" />
<apex:outputField label="CIFNO" value="{!case.Historic_CIN__c}" />

<apex:outputField value="{!case.Account_Type__c}"/>
<apex:outputField value="{!case.Business_or_Personal__c}" />

<apex:pageBlockSectionItem /> 
<apex:OutputField value="{!case.Segment_Code__c}"/>

<apex:pageBlockSectionItem /> 
<apex:OutputField value="{!case.Segment_Description__c}"/>

<apex:outputField value="{!case.Account_Type_Detail__c}" />-->
                        <apex:pageBlockSectionItem /> 
                        <apex:inputField value="{!case.Is_this_a_Non_Truist_Counterparty__c}"/>
                    </apex:pageBlockSection>
                    
                    <!--July 2023 CHanges for Service Finance -->
                    
                    
                    
                    <apex:pageBlockSection id="thisIsClient">
                        <apex:inputField value="{!case.State_Client_Resides_In__c}" required="{!((AND(case.Is_this_a_Client__c='Yes', case.Case_Association_Type__c != 'Transferred from CLEAR',OR(!case.Auto_Closed_Review__c,case.Status!='Closed')))&&(case.Account_Type__c = 'Mortgage Loan'))}"
                                         rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                        <apex:outputField value="{!case.State_Client_Resides_In__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" /> 
                        
                        <!--September 2022-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Counterparty"></apex:outputLabel>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Counter_Party__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                                    <apex:actionSupport action="{!counterPartyvalueChange}" event="onchange" reRender="SADsection,AcctTypeDetail-1,serviceFInanceClientDetails" status="isThisaNonTruistCounterParty" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputField value="{!case.Counter_Party__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <!--September 2022-->
                    </apex:pageBlockSection> 
                    <!--Added below Field for JAN22 Release-->
                    <apex:pageBlockSection id="loanInfo">
                        <apex:inputField value="{!case.State_Collateral_Resides_In__c}"
                                         rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="{!(case.Account_Type__c="Mortgage Loan")}" />
                        <apex:outputField value="{!case.State_Collateral_Resides_In__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        
                        <!--September 2022-->
                        <apex:inputField value="{!case.Dealer_Name__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                        <apex:outputField value="{!case.Dealer_Name__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
                        <!--June 2023 CHanges start-->
                        <apex:inputField value="{!case.Dealer_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                        <apex:outputField value="{!case.Dealer_Number__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
                        <!--June 2023 changes end -->
                        
                        <!--March 2026-->
                         <!--<apex:inputField value="{!case.Dealer_Search__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                        <apex:outputField value="{!case.Dealer_Search__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>  -->    
                        
                        <apex:inputField value="{!case.Pre_Acquisition__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                        <apex:outputField value="{!case.Pre_Acquisition__c}"
                                          rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <!--September 2022-->
                    </apex:pageBlockSection>
                    <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                        <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                        <br/>
                    </c:Modal_Dialog>
                    <apex:actionStatus id="selectAccountStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </div>
            
            <apex:outputPanel id="accountFields"> 
                <apex:pageblockSection rendered="{!(case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Client_Name__c == '' && selectedAccountInformation!='Other'}">
                    <apex:pageBlockSectionItem rendered="{!stProductId!=null && stProductId!=''}">
                        <apex:outputLabel value="Account Number"/>
                        <apex:actionRegion >                                                                                                    
                            <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputfield value="{!case.Account_Number__c}" rendered="{!OR(stProductId=null,stProductId='')}" />
                    <apex:actionRegion > 
                        <apex:outputField value="{!case.Account_Type__c}"> 
                            <apex:actionSupport event="onchange" reRender="thisIsClient,loanInfo"/>
                        </apex:outputField>
                    </apex:actionRegion>
                </apex:pageblockSection> 
                <apex:outputPanel rendered="{! NOT(case.BypassSearchProcess__c) || case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'}" >
                </apex:outputPanel>
                
            </apex:outputPanel>
            
            
            <div style="margin-top:-1.00%">                    
                <apex:pageBlockSection id="AccountDetails" >                                             
                    <apex:pageBlockSectionItem id="FunctionalArea">
                        <apex:outputLabel value="Functional Area" for="funcArea" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                        <apex:inputField value="{!case.Functional_Area__c}" id="funcArea" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="{!IF(((case.Type="Complaint" || case.Type="Service Request") && $ObjectType.Case.fields.Functional_Area__c.Updateable && case.Special_Initiatives__c!=Null),true,false)}"/>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Functional_Area__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                    <apex:pageBlockSectionItem rendered="{!AND(case.Is_this_a_Client__c='Yes',$Profile.Name!='CFS & MH Phone/Research Manager',$Profile.Name!='CFS Phone/Research Manager',$Profile.Name!='CFS Phone/Research User')}">
                        <br/>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Investor__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    <apex:inputField value="{!case.Investor__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                </apex:pageBlockSection>
            </div>
            <apex:outputPanel id="bypassClientContactMethodFields" >
                <apex:outputPanel rendered="{!case.BypassSearchProcess__c && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}">
                    <div style="margin-top:-0.5%">
                        <apex:pageBlockSection >
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Client Follow Up Needed?"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                        <apex:actionSupport event="onchange" action="{!clientFollowUpChanges}" reRender="bypassClientContactMethodFields" status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Contact Method" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Contact_Method__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" required="true">
                                        <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="bypassClientContactMethodFields,AlternateAddressForRR" status="ClientStatus" />
                                    </apex:inputField>
                                </apex:actionRegion> 
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}"/>  
                                <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}" required="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>                                                                    
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}">
                                <apex:outputLabel value="Best Time To Call" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>  
                                <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}" required="true"/>                                                                    
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Alternate Email" rendered="{!(case.Contact_Method__c='Email')}"/>                                           
                                <apex:inputField value="{!case.Alternate_Email__c}" rendered="{!(case.Contact_Method__c='Email')}" required="true"/>                                    
                            </apex:pageblocksectionItem>
                        </apex:pageblocksection>
                    </div>
                    
                    <apex:pageBlockSection id="AlternateAddress">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Alternate Address" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}"/>  
                            <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}" required="true"/>                                                                    
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    
                </apex:outputPanel>
            </apex:outputPanel>  
            
            <apex:outputPanel id="ClientFollowUpSection">
                <div style="margin-top:-0.5%">
                    <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" >                   
                        <apex:outputField value="{!case.Client_Follow_Up_Needed__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>      
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Client Follow Up Needed?"/>
                            <apex:actionRegion >                        
                                <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="True">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection> 
                </div> 
                
                <div style="margin-top:-0.75%">
                    <apex:pageBlockSection rendered="{!case.Client_Follow_Up_Needed__c='Yes' && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">  
                        <apex:outputField value="{!case.Contact_Method__c}" rendered="{!AND(CRTQualityAssuranceSpecialist,case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}"/>                
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Contact Method" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Contact_Method__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}" required="True">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="AlternateAddressForRR,ClientFollowUpSection,authorizedPartyPanel" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                </div>
                
                <div style="margin-top:-0.5%">
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Phone') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        
                        <apex:pageblockSectionItem rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}">
                            <apex:outputlabel value="Client Phone"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>         
                        </apex:pageblockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null,NOT(OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone')))}">
                            <apex:outputlabel value="Client Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null)}"/>
                            <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null)}" required="True"/>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',OR((case.Is_this_a_Client__c='Yes'),(AND(OR(case.Origin = 'CMITruistBankStandalone',case.Origin = 'CMITruistBankClientCentral'), case.Is_this_a_Client__c='No'))),case.Client_Contact_Number__c!=null,NOT(OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone')))}">
                            <apex:outputlabel value="Client Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',OR((case.Is_this_a_Client__c='Yes'),(AND(OR(case.Origin = 'CMITruistBankStandalone',case.Origin = 'CMITruistBankClientCentral'), case.Is_this_a_Client__c='No'))),case.Client_Contact_Number__c!=null)}"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',OR((case.Is_this_a_Client__c='Yes'),(AND(OR(case.Origin = 'CMITruistBankStandalone',case.Origin = 'CMITruistBankClientCentral'), case.Is_this_a_Client__c='No'))),case.Client_Contact_Number__c!=null)}"/>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!(AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone')))}">
                            <apex:outputlabel value="Contact Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>
                            <apex:inputField value="{!case.Contact_Phone__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField value="{!case.Alternate_Phone_Number__c}" rendered="{!AND(CRTQualityAssuranceSpecialist,case.Client_Follow_Up_Needed__c='Yes',case.Contact_Method__c='Phone',case.Is_this_a_Client__c!=Null)}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Phone Number" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}" required="{!(case.Is_this_a_Client__c="No" && (case.Origin <> 'CMITruistBankStandalone' ||case.Origin <> 'CMITruistBankClientCentral'))}"/>
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField value="{!case.Best_Time_To_Call__c}" rendered="{!(AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', OR((case.Is_this_a_Client__c='Yes'),(AND(OR(case.Origin = 'CMITruistBankStandalone',case.Origin = 'CMITruistBankClientCentral'), case.Is_this_a_Client__c='No')))))}"/>                    
                        <apex:pageBlockSectionItem rendered="{!(AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', OR((case.Is_this_a_Client__c='Yes'),(AND(OR(case.Origin = 'CMITruistBankStandalone', case.Origin = 'CMITruistBankClientCentral'), case.Is_this_a_Client__c='No')))))}">
                            <apex:outputlabel value="Best Time To Call" />
                            <apex:inputField value="{!case.Best_Time_To_Call__c}" required="True"/>
                        </apex:pageblocksectionItem>
                    </apex:pageBlockSection>
                </div>   
                <div style="margin-top:-0.5%">
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Mail') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        <apex:outputField value="{!case.Contact_Address__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail',case.Is_this_a_Client__c='Yes')}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}">
                            <apex:outputlabel value="Contact Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}"/>
                            <apex:inputField value="{!case.Contact_Address__c}" style="width:200px; height:100px" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}" />
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}">
                            <apex:outputlabel value="Contact Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}"/>
                            <apex:outputField value="{!case.Contact_Address__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}" />
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField value="{!case.Alternate_Address__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}" style="width:200px; height:100px" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                </div>    
                <div style="margin-top:-0.5%">
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Email') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">               
                        <apex:outputField value="{!case.Client_Email__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Email', case.Is_this_a_Client__c!=Null)}"/>                                                
                        <apex:pageBlockSectionItem rendered="{!(!CRTQualityAssuranceSpecialist && case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}">
                            <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}"/>                                           
                            <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}" required="True"/>                                    
                        </apex:pageblocksectionItem>
                        
                    </apex:pageBlockSection>
                </div>
            </apex:outputPanel>
            
            <apex:outputPanel id="AlternateAddressForRR" >
                <apex:pageBlockSection rendered="{!((case.Origin = 'Standalone Research'  && case.Alternate_Address__c != Null && case.Alternate_Address__c != '') && NOT((case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card') && (case.BypassSearchProcess__c && (NOT(CRTQualityAssuranceSpecialist))) ) && NOT(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail') )}">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Alternate Address"/>  
                        <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px"/>                                                                    
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
            </apex:outputPanel>
            
            <div style="margin-top:-0.75%">
                <apex:pageBlockSection id="SPOCTeammate" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Single Point of Contact" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Single_Point_of_Contact__c}"
                                             rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                                <apex:actionSupport event="onchange" reRender="SPOCTeammate" status="ClientStatus"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Single_Point_of_Contact__c}"
                                      rendered="{!OR(CRTQualityAssuranceSpecialist)}" />   
                    
                    <apex:inputField value="{!case.SPOC_Teammate__c}"
                                     rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Single_Point_of_Contact__c = 'Yes')}" required="{!case.Case_Association_Type__c != 'Transferred from CLEAR'}" />
                    <apex:outputField value="{!case.SPOC_Teammate__c}"
                                      rendered="{!AND(OR(CRTQualityAssuranceSpecialist),case.Single_Point_of_Contact__c = 'Yes')}" />
                    
                </apex:pageBlockSection>
            </div>
            
            <apex:outputPanel id="authorizedPartyPanel">
                <div style="margin-top:-0.75%">
                    <apex:pageBlockSection rendered="{!AND(OR(case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone',NOT(case.BypassSearchProcess__c)),OR(case.Type='Complaint',case.Type='Service Request'))}">    
                        <apex:pageBlockSectionItem rendered="{!AND(OR(case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone',NOT(case.BypassSearchProcess__c)),OR(case.Type='Complaint',case.Type='Service Request'))}">
                            <apex:outputLabel value="Is This An Authorized Third Party"/>                       
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!AND(NOT(case.BypassSearchProcess__c))}">
                                    <apex:actionSupport event="onchange" reRender="authorizedPartyPanel" status="ClientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputField value="{!case.Is_This_An_Authorized_Third_Party__c}"
                                          rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint'))))}" />
                        
                        <br/>
                        <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),NOT(case.BypassSearchProcess__c),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Service Request'),NOT(case.BypassSearchProcess__c)))}" required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}"/>
                        <br/>
                        <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Service Request'),NOT(case.BypassSearchProcess__c),OR((case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'),((case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Contact_Method__c != 'Phone' ))))}" value="{!case.Contact_Phone__c}"/>
                    </apex:pageBlockSection>
                </div>   
            </apex:outputPanel> 
            
            
            <apex:actionStatus id="ClientStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>           
            
