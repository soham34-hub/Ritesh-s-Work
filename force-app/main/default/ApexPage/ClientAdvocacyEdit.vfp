                            </apex:actionStatus>
                        </c:Modal_Dialog>-->                                                             
                    </apex:pageBlockSection>
                    <apex:outputPanel id="cisVerifyResults">
                        <apex:pageBlockSection rendered="{!(assignInfoMessage!=Null && assignInfoMessage!='')}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:15%" value="{!assignInfoMessage}"/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>    
                    <apex:actionStatus id="VerifyCISClientStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                                <span class="waitingDescription">Verifying.Please wait...</span>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                    
                    <!-- Commented Created Observer button for JAN'22 Release as we need Bypass Search option when Is this Client = No
