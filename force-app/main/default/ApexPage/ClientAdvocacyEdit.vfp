        <apex:outputField rendered="false" value="{!case.Account_For_Closed_Cases__c}"/>
        
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Product_Code__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Alert_Type__c}" rendered="FALSE"/>
