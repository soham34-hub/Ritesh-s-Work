<apex:page standardController="Case" extensions="StdModelEdit_ControllerExtension,CMIClientManagement_ControllerExtension,CategoryLists_ControllerExtension" action="{!retrieveArrangementSummariesList}">
    <apex:messages style="color:red;font-weight:bold;" />

    <apex:form id="StdModelEditForm">
        <apex:outputField value="{!case.Cat_Ref_Name__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_1__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_2__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_3__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_4__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_5__c}" rendered="FALSE" />

        <apex:pageBlock title="Standard Model Case" mode="edit">
            <apex:pageBlockButtons location="both">
                <apex:commandButton action="{!save}" value="Save" />
                <apex:commandButton action="{!cancel}" value="Cancel" />
            </apex:pageBlockButtons>

            <!-- *************************************** -->
            <!-- *   C A S E   I N F O R M A T I O N   * -->
            <!-- *************************************** -->
            <apex:pageBlockSection title="Case Information" columns="1">
            
                <apex:outputField value="{!case.CaseNumber}" />
                <apex:outputField value="{!case.OwnerId}" />
                <apex:inputField value="{!case.Origin}" required="true" />

                <c:CustomLookup value="{!Case.Submitter__c}" 
                                object="Contact"
                                objectName="Case" 
                                fieldName="Submitter__c"
                                displayFields="Email,Title,Phone,Cost_Center__c,Department__c" 
                                required="true" />
                                
                <!--Commented for CMI 2014. As rendering of some sections is dependent on Case Type-->
                <!--<apex:inputField value="{!case.Type}" required="True" />-->

                <!--Start Changes For CMI 2014--> 
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Case Type"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Type}" required="True">
                            <!--clientInformation is added in rerender attribute for CMI 2014.1 break/fixes-->
                            <apex:actionSupport event="onchange" rerender="supplierDetailsPanel,ComplianceEvaluation,clientInformation" status="MainStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End changes for CMI 2014-->
                
                <apex:inputField value="{!case.Call_Source__c}" required="True" />
                
                <!--Start changes for CMI 2014-->
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Source Received Date/Time"/>
                    <apex:inputField value="{!case.Source_Received_Date_Time__c}"/>
                </apex:pageBlockSectionItem>
                <!--End changes for CMI 2014-->
                
                <apex:inputField value="{!case.Month_Year_Problem_Started__c}" />
            </apex:pageBlockSection>
             
            <apex:actionStatus id="MainStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes For CMI 2014--> 


            <!-- ******************************************* -->
            <!-- *   C L I E N T   I N F O R M A T I O N   * -->
            <!-- ******************************************* -->
            <apex:pageBlockSection title="Client Information" columns="2" id="clientInformation">
                <!--Commented for CMI 2014 because some fields are dependent on it. A pageBlockSectionItem is added for the same field-->
                <!--<apex:inputField value="{!case.Is_this_a_Client__c}" />-->
                <!--Start Changes for CMI 2014-->
                <apex:pageblocksectionitem >
                    <apex:outputlabel value="Is this a Client?"/>
                    <apex:actionRegion >
                        <!--The field is made required for CMI 2014-->
                        <apex:inputField value="{!case.Is_this_a_Client__c}" required="{!case.Special_Initiatives__c<>null}">
                            <!--In rerender modalDialog,nameSearch,renderAccountDetails,renderAccountDetailsForCreateClient is added for CIS Search in CMI 2014 and clientInformation for CMI 2014 break/fixes-->
                            <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="clientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,renderAccountDetailsForCreateClient,clientInformation" status="clientStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageblocksectionitem>
                <!--End Changes for CMI 2014-->
                
                <!--rendered condition added for CMI 2014 break/fixes-->
                <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only')))}"/>
                
                <!--Business or Personal Commented for autopopulation of CISSearch for CMI 2014-->   
                <!--<apex:inputField value="{!case.Business_or_Personal__c}" />-->
                
                <!--rendered condition added for CMI 2014 break/fixes-->
                <apex:inputField value="{!case.Contact_Name__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only')))}"/>
                
                <!--ClientName commented for autopopulation of CISSearch for CMI 2014-->
                <!--<apex:inputField value="{!case.Client_Name__c}" />-->
                
                <!--rendered condition added for CMI 2014 break/fixes-->
                <apex:inputField value="{!case.Contact_Phone__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only')))}" />
            </apex:pageBlockSection>
            
            <!--Start changes for CIS Search for CMI 2014-->
            <apex:outputPanel id="modalDialog">
                <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='Yes'}">
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch" value="Search Client"/>                                                   
                    <!--<c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                        <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>
                        <!--<div style="text-align:center">
                            <apex:commandButton immediate="true" action="{!hideModalDialog}" reRender="accountSearch,nameSearch" value="Return To Case"/>
                        </div>-->
                        <!--<br/>                                           
                    </c:Modal_Dialog>-->                           
                </apex:pageBlockSection>
                
                <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='No'}">                        
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>                        
                    <!--<c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                         <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase" />                                                      
                         <div style="text-align:center">
                             <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetailsForCreateClient" value="Return To Case"/>
                         </div>
                         <br/>                   
                    </c:Modal_Dialog>-->                    
                </apex:pageblockSection> 
            </apex:outputPanel>
                                              
            <apex:pageblockSection id="nameSearch" columns="1" >
                <apex:outputField rendered="{!case.Client_Name__c<>null}" value="{!case.Client_Name__c}"/> 
                <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                <apex:outputField rendered="{!case.Client_Name__c<>null}" value="{!case.Business_or_Personal__c}"/>
                <!--Fields for HH Information-->
                <apex:outputField rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}" value="{!case.HH_Info__c}"/>
                <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>
                <apex:outputField rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}" value="{!case.Client_Segmentation_Code__c}"/>
                <!--Fields for HH Information-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                    <apex:actionRegion >
                        <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                            <apex:selectOptions value="{!accountsList}"/>
                            <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="selectAccountModal, renderAccountDetails, renderAccountDetailsForCreateClient" status="selectAccountStatus"/>
                        </apex:selectList>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                    <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                    <br/>
                </c:Modal_Dialog>
            </apex:pageblockSection>
            
            <apex:actionStatus id="selectAccountStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            
            <apex:pageblockSection id="renderAccountDetails" columns="1">
                <!--<apex:outputField rendered="{!case.Account_Type__c<>null && selectedAccountInformation!='Other' &&  case.CIN__c!=Null &&  case.Is_this_a_Client__c='Yes'}" value="{!case.Account_Number__c}" />-->
                <apex:outputField rendered="{!case.Account_Number__c<>null && selectedAccountInformation!='Other' && !comingAfterCreatingClient &&  case.CIN__c!=Null &&  case.Is_this_a_Client__c='Yes' && case.Special_Initiatives__c='CMI'}" value="{!case.Account_Number__c}" />
                <apex:outputField rendered="{!case.Account_Type__c<>null && selectedAccountInformation!='Other' && !comingAfterCreatingClient &&  case.CIN__c!=Null &&  case.Is_this_a_Client__c='Yes' && case.Special_Initiatives__c='CMI'}" value="{!case.Account_Type__c}" />
            </apex:pageblockSection>
    
            <apex:pageblockSection id="renderAccountDetailsForCreateClient" columns="1">
                <apex:inputField rendered="{!(((selectedAccountInformation=='Other' && case.Is_this_a_Client__c="Yes" ) ||  (comingAfterCreatingClient && case.Is_this_a_Client__c="No"))||case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Number__c}" />
                <!--rendering condition for the below input field is changed for CMI 2014.1 break/fixes-->
                <!--<apex:inputField rendered="{!(((selectedAccountInformation=='Other' && case.Is_this_a_Client__c="Yes" ) ||  (comingAfterCreatingClient && case.Is_this_a_Client__c="No"))||case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Type__c}" />-->
                <apex:inputField rendered="{!(((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c!=Null ))||case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Type__c}" />                                
            </apex:pageblockSection>
            <!--End changes for CIS Search for CMI 2014-->

            <apex:pageBlockSection columns="1">
                <!--CIN commented for autopopulation of CIS Search for CMI 2014-->
                <!--<apex:inputField value="{!case.CIN__c}" />-->
                
                <!--<apex:inputField value="{!case.Account_Number__c}" />-->
                
                <!--AccountType commented for autopopulation of CIS Search for CMI 2014-->
                <!--<apex:inputField value="{!case.Account_Type__c}"/>-->
                
                <!--Start Changes for CMI 2014-->
                <apex:inputField value="{!case.Functional_Area__c}" required="{!case.Special_Initiatives__c!=Null}"/>
                <!--End Changes for CMI 2014-->
                
                <!--Commented for CMI 2014. A new section clientFollowUpSection is added.-->
                <!--<apex:inputField value="{!case.Client_Follow_Up_Needed__c}"/>
                <apex:inputField value="{!case.Client_Contact_Number__c}" />
                <apex:inputField value="{!case.Best_Time_To_Call__c}" />-->
            </apex:pageBlockSection>
                        
            <!--Start Changes for CMI 2014-->
            <apex:pageBlockSection id="clientFollowUpSection" columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Follow Up Needed?"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Client_Follow_Up_Needed__c}">
                            <!--action attribute applied for CMI 2014-->
                            <apex:actionSupport event="onchange" action="{!nullifyFieldsForClientFollowUpChanges}" rerender="clientFollowUpSection" status="clientStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                
                <!--Contact Method added for CMI 2014-->
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Contact Method" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Is_this_a_Client__c!=Null)}"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Contact_Method__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Is_this_a_Client__c!=Null)}" >
                            <apex:actionSupport event="onchange" action="{!nullifyFieldsForClientFollowUpChanges}" reRender="clientFollowUpSection" status="clientStatus" />
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                            
                <!--<apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Contact Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}"/>
                    <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}" />                                        
                </apex:pageBlockSectionItem>-->
                <apex:pageBlockSectionItem >
                    <!-- Rendering condtion changed for CMI 2014 -->
                    <apex:outputlabel value="Client Contact Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null)}"/>
                    <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null)}" required="True"/>
                </apex:pageBlockSectionItem>
                
                <!-- Client contact number output field added for CMI 2014 -->
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Contact Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null)}"/>
                    <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null)}" />                                        
                </apex:pageBlockSectionItem>
                        
                <!--Alternate Phone Number added for CMI 2014-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}"/>  
                    <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                </apex:pageBlockSectionItem>
                            
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Best Time To Call" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}"/>                                           
                    <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}" />                                    
                </apex:pageblocksectionItem>
                        
                <!--Contact Address added for CMI 2014-->
                <!--<apex:pageBlockSectionItem >-->
                    <!--inputField changed to outputField,required attribute is removed for CIS Search for CMI 2014-->
                    <!--<apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes')}"/>
                    <apex:inputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes')}" required="True"/>                                        
                </apex:pageBlockSectionItem>-->
                <apex:pageBlockSectionItem >                            
                    <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}"/>
                    <apex:inputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}" style="width:200px; height:100px" required="True"/>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >                            
                    <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                    <apex:outputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                </apex:pageBlockSectionItem>
                        
                <!--Alternate Address added for CMI 2014-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Alternate Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}"/>  
                    <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}" style="width:200px; height:100px" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                </apex:pageBlockSectionItem>
                            
                <!--Client Email added for CMI 2014-->
                <!--<apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}"/>                                           
                    <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}" required="True"/>                                    
                </apex:pageblocksectionItem>-->
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}"/>                                           
                    <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}" required="True"/>                                    
                </apex:pageblocksectionItem>
                <!--<apex:pageBlockSectionItem >
                    <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null && case.Client_Email__c!=null)}"/>                                           
                    <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null && case.Client_Email__c!=null)}"/>                                    
                </apex:pageblocksectionItem>-->
            </apex:pageblocksection>
            <!--end of ClientFollowUpSection-->
                        
            <apex:actionStatus id="clientStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>          
            <!--End Changes for CMI 2014-->


            <!-- **************************************************** -->
            <!-- *   C L I E N T   F E E D B A C K   D E T A I L S  * -->
            <!-- **************************************************** -->
    
            <!--Id added for CMI 2014-->
            <apex:pageBlockSection id="clientFeedbackDetails" title="Client Feedback Details" columns="2">
                <!--Commented for CMI 2014 because Supplier Search needs to be rendered when Is Feedback field is equal to Supplier.-->
                <!--<apex:inputField value="{!case.Is_Feedback_regarding_a_TM_Dept__c}" />-->
                <!--Start Changes for CMI 2014-->
                <apex:pageblocksectionitem >
                    <apex:outputlabel value="Is Feedback regarding a TM/ Dept/ Supplier?"/>
                    <apex:actionRegion >                           
                        <apex:inputField value="{!case.Is_Feedback_regarding_a_TM_Dept__c}">
                            <apex:actionSupport event="onchange" rerender="clientFeedbackDetails, supplierDetailsPanel" status="complaintDetailStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageblocksectionitem>
                <!--End Changes for CMI 2014-->
    
                <c:CustomLookup id="DeptSearch"
                    value="{!Case.Department_Search__c}" object="Org_Unit__c"
                    objectName="Case" fieldName="department_search__c"
                    displayFields="RecordType.Name,Cost_Center__c,Address__c,City__c,State__c" />
                <br />
    
                <c:CustomLookup value="{!Case.Teammate_Search__c}" object="Contact"
                                objectName="Case" fieldName="Teammate_Search__c"
                                displayFields="Email,Title,Phone,Cost_Center__c,Department__c" />
                <br />
                    
                <!--Start Changes for CMI 2014-->
                <apex:pageBlockSectionItem rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')}">
                    <apex:outputlabel value="Supplier Search"/>
                    <apex:actionRegion >
                        <!--Start Changes for CMI 2014 break/fixes-->
                        <!--Added onkeypress to supress the Enter and Any other input-->
                        <apex:inputField value="{!case.Vendor_Search__c}" onkeypress="return false;" onkeydown="return false;" required="True">
                        <!--End Changes for CMI 2014 break/fixes-->
                            <apex:actionSupport event="onchange" action="{!populateSupplierRelatedFields}" reRender="supplierDetailsPanel" status="complaintDetailStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End Changes for CMI 2014-->
                
                <apex:inputField value="{!case.Other_Department_List__c}" />
                
                <!--Start Changes for CMI 2014-->
                <!--<apex:inputField value="{!case.Servicing_Challenges_Reported__c}"/>-->
                
                <apex:pageBlockSectionItem rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate') || (case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate') || (case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate'))}">                        
                    <apex:outputLabel value="Servicing Challenges Reported"/>
                    <apex:define name="requiredServicing">
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7"/>
                        </div>
                    </apex:define>
                </apex:pageBlockSectionItem>
                <!--End changes for CMI 2014-->                
            </apex:pageBlockSection>
                
            <apex:pageBlockSection columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Client Feedback"/>
                    <apex:define name="requiredInputDiv">
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputTextArea value="{!case.Description}" cols="80" rows="7" required="True" />
                        </div>
                    </apex:define>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <!--Start Changes for CMI 2014-->
            <apex:actionStatus id="complaintDetailStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->
            
            <!--Start Changes for CMI 2014-->
            <!-- ******************************************* --> 
            <!-- *        SUPPLIER DETAILS SECTION         * -->
            <!-- ******************************************* --> 
                    
            <!--Start of SupplierDetailsPanel-->
            <apex:outputPanel id="supplierDetailsPanel">
                <apex:pageBlockSection title="Supplier Details" columns="2" rendered="{!((case.Type='Complaint' || case.Type='Positive Feedback/Compliment') && (case.Is_Feedback_regarding_a_TM_Dept__c='Supplier') && (case.Vendor_Search__c!=Null && case.Vendor_Search__c!=''))}">
                    <apex:outputField value="{!case.Business_Owner__c}"/>
                    <apex:outputField value="{!case.Service_Manager__c}"/>
                    <apex:outputField value="{!case.Supplier_Manager__c}"/>
                    <apex:inputField value="{!case.Supplier_Services__c}"/>
                </apex:pageBlockSection>
            </apex:outputpanel>
            <!--End of SupplierDetailsPanel"-->
            <!--End Changes for CMI 2014-->

            <!-- ******************************************* -->
            <!-- *    F E E D B A C K   C A T E G O R Y    * -->
            <!-- ******************************************* -->
    
            <apex:pageBlockSection title="Feedback Category" columns="2">
                <apex:outputField id="caseFbCat" value="{!case.Submitter_Category__c}" />
                <apex:inputField value="{!case.Initiative_Tracking__c}" />
                
                <apex:outputField id="caseFbSubCat" value="{!case.Submitter_Sub_Category__c}" />
                <br />
                
                <apex:outputField id="subRootCause" value="{!case.Submitter_s_Root_Cause__c}" />
                <br />
            </apex:pageBlockSection>
        
            <apex:pageBlockSection columns="1">

                <!-- ******************************************* -->
                <!-- *           C A T E G O R I E S           * -->
                <!-- ******************************************* -->
                                                
                <apex:outputPanel id="CategoryPanel" >
                    <div style="margin-left: 14%;">
                        <apex:outputLabel value="Level 1" for="level1choice" />
                        &nbsp;
                        <apex:actionStatus id="level1choiceStatus">
                            <apex:facet name="start">
                                <img src="{!$Resource.SpinIcon}" />
                            </apex:facet>
                        </apex:actionStatus>
                        &nbsp;
                        <apex:actionRegion >
                            <apex:selectList value="{!Level1Choice}" multiselect="False"
                                size="5" id="level1choice">
                                <apex:selectOptions value="{!Level1Choices}" />
                                <apex:actionSupport event="onchange" action="{!updateLists}"
                                    reRender="CategoryPanel" status="level1choiceStatus" />
                            </apex:selectList>
                        </apex:actionRegion>

                        <br />
                        <br />

                        <apex:outputLabel value="Level 2" for="level2choice" />
                        &nbsp;
                        <apex:actionStatus id="level2choiceStatus">
                            <apex:facet name="start">
                                <img src="{!$Resource.SpinIcon}" />
                            </apex:facet>
                        </apex:actionStatus>
                        &nbsp;
                        <apex:actionRegion >
                            <apex:selectList value="{!Level2Choice}" multiselect="False"
                                size="5" id="level2choice">
                                <apex:selectOptions value="{!Level2Choices}" />
                                <apex:actionSupport event="onchange" action="{!updateLists}"
                                    reRender="CategoryPanel" status="level2choiceStatus" />
                            </apex:selectList>
                        </apex:actionRegion>

                        <br />
                        <br />

                        <apex:outputLabel value="Level 3" for="level3choice" />
                        &nbsp;
                        <apex:actionStatus id="level3choiceStatus">
                            <apex:facet name="start">
                                <img src="{!$Resource.SpinIcon}" />
                            </apex:facet>
                        </apex:actionStatus>
                        &nbsp;
                        <apex:actionRegion >
                            <apex:selectList value="{!Level3Choice}" multiselect="False"
                                size="5" id="level3choice">
                                <apex:selectOptions value="{!Level3Choices}" />
                                <apex:actionSupport event="onchange" action="{!updateLists}"
                                    reRender="CategoryPanel" status="level3choiceStatus" />
                            </apex:selectList>
                        </apex:actionRegion>

                        <br />
                        <br />

                        <apex:outputLabel value="Level 4" for="level4choice" />
                        &nbsp;
                        <apex:actionStatus id="level4choiceStatus">
                            <apex:facet name="start">
                                <img src="{!$Resource.SpinIcon}" />
                            </apex:facet>
                        </apex:actionStatus>
                        &nbsp;
                        <apex:actionRegion >
                            <apex:selectList value="{!Level4Choice}" multiselect="False"
                                size="5" id="level4choice">
                                <apex:selectOptions value="{!Level4Choices}" />
                                <apex:actionSupport event="onchange" action="{!updateLists}"
                                    reRender="CategoryPanel" status="level4choiceStatus" />
                            </apex:selectList>
                        </apex:actionRegion>

                        <br />
                        <br />

                        <apex:outputLabel value="Level 5" for="level5choice" />
                        &nbsp;
                        <apex:actionStatus id="level5choiceStatus">
                            <apex:facet name="start">
                                <img src="{!$Resource.SpinIcon}" />
                            </apex:facet>
                        </apex:actionStatus>
                        &nbsp;
                        <apex:actionRegion >
                            <apex:selectList value="{!Level5Choice}" multiselect="False"
                                size="5" id="level5choice">
                                <apex:selectOptions value="{!Level5Choices}" />
                                <apex:actionSupport event="onchange" action="{!updateLists}"
                                    reRender="CategoryPanel" status="level5choiceStatus" />
                            </apex:selectList>
                        </apex:actionRegion>

                        <br />
                        <br />

                    </div>

                    <apex:actionStatus id="CategoryStatus">
                        <apex:facet name="start">
                            <img src="{!$Resource.SpinIcon}" />
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>

<!--
                <apex:outputPanel id="CategoryPanel2" rendered="{!OR(CRTQualityAssuranceSpecialist)}" >
                       <apex:pageBlockSection columns="1">
                            <apex:inputField value="{!case.Cat_Level_1__c}" />
                            <apex:inputField value="{!case.Cat_Level_2__c}" />
                            <apex:inputField value="{!case.Cat_Level_3__c}" />
                            <apex:inputField value="{!case.Cat_Level_4__c}" />
                            <apex:inputField value="{!case.Cat_Level_5__c}" />
                            <apex:inputField value="{!case.Cat_Level_6__c}" />
                        </apex:pageBlockSection>
                </apex:outputPanel>
-->                
                <!-- 
                
                <c:CRTCaseCategory id="categories" caseRecord="{!case}"  isReadOnly="false" groupName="CRT" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                <c:CRTCaseCategory id="categoriesRead" caseRecord="{!case}"  isReadOnly="true" groupName="CRT" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                 -->
            </apex:pageBlockSection>



            <!-- ******************************************* -->
            <!-- *   R E S O L U T I O N   D E T A I L S   * -->
            <!-- ******************************************* -->

            <apex:pageBlockSection title="Resolution Details" id="refund"><!--id attribute in pageBlockSection added for CMI 2014 break/fixes-->
                <!--For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
                <apex:pageblocksectionitem >
                    <apex:outputlabel value="Relief Provided?"/>
                    <apex:actionRegion > 
                        <apex:inputField value="{!case.Refund__c}"> 
                            <apex:actionSupport event="onchange" reRender="refund" status="resolutionDetailsStatus" /> 
                        </apex:inputField> 
                    </apex:actionRegion> 
                </apex:pageblocksectionitem>
                <apex:inputField value="{!case.Refund_Amount__c}" required="true" rendered="{!case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
                <!--Start Changes for CMI 2014-->
                <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
                <!--End Changes for CMI 2014-->
            </apex:pageBlockSection>
            
            <apex:pageBlockSection ><!--This field is added in new pageblocksection for proper alignment for CMI 2014 breaks/fixes-->
                <apex:inputField value="{!case.Client_Flight_Risk__c}" />
            </apex:pageBlockSection>
            
            <!--Start Changes for CMI 2014 break/fixes-->
            <apex:actionStatus id="resolutionDetailsStatus"> 
                <apex:facet name="start"> 
                    <div style="text-align:center;"> 
                        <img src="{!$Resource.SpinIcon}"/> 
                    </div> 
                </apex:facet> 
            </apex:actionStatus>
            <!--End Changes for CMI 2014 break/fixes-->

            <!-- ******************************************* -->
            <!-- *   C L O S E   C A S E   D E T A I L S   * -->
            <!-- ******************************************* -->

            <apex:pageBlockSection title="Close Case Details">

                <!--Start Changes for CMI 2014-->
                <!--Commented for CMI 2014-->
                <!--As some rendering conditions need to be applied on this field-->
                <!--<apex:inputField value="{!case.Status}" required="True">-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Status}" required="True">
                            <apex:actionSupport event="onchange" action="{!openCaseStatusSummaryPopup}" reRender="caseStatusSummaryPopup"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End Changes for CMI 2014-->
                
                <apex:inputField value="{!case.Priority}" required="True" />
                
                <apex:inputField value="{!case.Status_Reason__c}" required="True" />
                <br />
                
                <!--Start Changes for CMI 2014-->
                <apex:inputField value="{!case.Case_Status_Summary__c}" style="width:300px;height:45px"/>
                <br/>
                <apex:inputField value="{!case.Case_Comments_Reviewed__c}"/>
                <!--End Changes for CMI 2014-->
                
                <!--Commented for CMI 2014 because Root Cause Details needs to be rendered according to this field values-->
                <!--<apex:inputField value="{!case.Root_Cause__c}" />-->
                
                <!--Start Changes for CMI 2014-->
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Root Cause"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Root_Cause__c}">
                            <apex:actionSupport event="onchange" reRender="rootCauseDetails" status="closeCaseDetailsStatus"/>
                    </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End Changes for CMI 2014-->
                <br />
            </apex:pageBlockSection>
            
            <!--Start Changes for CMI 2014-->
            <apex:pageBlockSection id="rootCauseDetails" columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Root Cause Detail" rendered="{!(case.Root_Cause__c='Bank Error' || case.Root_Cause__c='Internal' || case.Root_Cause__c='Combined Error' || case.Root_Cause__c='3rd Party' || case.Root_Cause__c='Undetermined')}"/>
                    <!--This field is rendered for the values of Root Cause when Case Type is Complaint and Case Designation Type is Tier 2 or Tier 3.-->
                    <!--Since it is only rendered for some of the values of Root Cause, so the conditions "Case Type is Complaint and Case Designation Type is Tier 2 or Tier 3" are not checked.-->
                    <apex:inputField value="{!case.Root_Cause_Detail__c}" rendered="{!(case.Root_Cause__c='Bank Error' || case.Root_Cause__c='Internal' || case.Root_Cause__c='Combined Error' || case.Root_Cause__c='3rd Party' || case.Root_Cause__c='Undetermined')}" />
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:actionStatus id="closeCaseDetailsStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->
            
            <apex:pageBlockSection columns="1" >               
                <apex:inputField value="{!case.Resolution_Comments__c}" style="width:500px;height:140px;" />
                <br />
                <apex:inputField value="{!case.CPR_Additional_Comments__c}" style="width:500px;height:140px;" />
           </apex:pageBlockSection>

            <!-- ********************************************************** -->
            <!-- *                 S Y S T E M   F I E L D S              * -->
            <!-- ********************************************************** -->

            <apex:pageBlockSection title="System Assigned Fields"
                rendered="false">

                <apex:inputField value="{!case.CreatedDate}" />
                <apex:inputField value="{!case.Closed_Date__c}" />
                <apex:inputField value="{!case.LastModifiedById}" />
                <apex:inputField value="{!case.LastModifiedDate}" />
                <apex:inputField value="{!case.Contact_Name__c}" />
                <apex:inputField value="{!case.Age_Days__c}" />
                <apex:inputField value="{!case.Age_Hours__c}" />
                <br />
            </apex:pageBlockSection>

            <br />
                        
            <!--Start Changes for CMI 2014-->

            <!-- ************************************************** --> 
            <!-- *   C O M P L I A N C E   E V A L U A T I O N    * -->
            <!-- ************************************************** --> 
            <!--Start of "ComplianceEvaluationPanel"-->
            <apex:outputpanel id="ComplianceEvaluationPanel" >
                <apex:outputpanel id="ComplianceEvaluation" >             
                    <apex:pageBlockSection title="Feedback/Complaint Designation" columns="1" collapsible="true" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Resolved by Point of Contact?" for="quest1"/>
                            <apex:define name="requiredQ1">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Allegation of wrongful/unethical conduct?" for="quest2"/>
                            <apex:define name="requiredQ2">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <apex:inputField value="{!case.PCQ_Q2__c}" id="quest2">
                                            <!--Commented for PCQ changes for CMI 2014--> 
                                            <!--<apex:actionSupport event="onchange" rerender="Quest2DependentQuestions,Question2DependentQuestions,Quest2ADependentQuestions,Question2BDependentQuestions" status="ComplianceEvaluationStatus" />-->
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
    
                    <apex:pageBlockSection id="Quest2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                        <apex:pageBlockSectionItem >
                            <!--rendered attribute removed for CMI 2014-->
                            <apex:outputLabel value="Reg/Law Cited?" for="quest3"/>
                            <apex:define name="requiredQ2A">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <!--rendered attribute removed for CMI 2014-->
                                        <apex:inputField value="{!case.PCQ_Q2_A__c}" id="quest3">
                                            <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>

                    <apex:pageBlockSection id="Quest2ADependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" rendered="{!(case.PCQ_Q2_A__c='Yes')}"/>
                            <apex:define name="requiredLawOrReg">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4" rendered="{!(case.PCQ_Q2_A__c='Yes')}">  
                                            <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/>
                            <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                        
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="Question2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">                        
                        <apex:pageBlockSectionItem >
                            <!--rendered attribute removed for CMI 2014-->
                            <apex:outputLabel value="High Risk Terms?" for="quest6" />
                            <apex:define name="requiredQ2B">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <!--rendered attribute removed for CMI 2014-->                        
                                        <apex:inputField value="{!case.PCQ_Q2_B__c}" id="quest6" >
                                            <apex:actionSupport event="onchange" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="Question2BDependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Select specific High Risk Terms" for="quest7" rendered="{!(case.PCQ_Q2_B__c='Yes')}"/>                        
                            <apex:define name="requiredHighRisk">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>
                                    <apex:actionRegion >
                                        <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7" rendered="{!(case.PCQ_Q2_B__c='Yes')}">
                                            <apex:actionSupport event="onchange" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Other High Risk Terms" for="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other'))}"/>                        
                            <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other'))}" required="true"/>                       
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>

                    <apex:actionStatus id="ComplianceEvaluationStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputpanel>
            </apex:outputpanel>
            <!--End of "ComplianceEvaluationPanel"-->
            
            <!--************************************************** --> 
            <!-- *         Compliance Evaluation Summary          * -->
            <!-- ************************************************** -->
            <!--Start of "ComplianceEvaluationSummary"-->
            <apex:pageBlockSection id="ComplianceEvaluationSummary" title="Compliance Evaluation Summary" columns="1">
                <apex:pageBlockSection id="depositInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Deposit/Other Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Deposit_Others_C_L_Disposition__c}" required="{!IF((case.Deposit_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="depositInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Deposit_Others_Investigation_Disposition__c}" required="{!IF((case.Deposit_Others_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Deposit_Others_C_L_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Deposit_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.Deposits_Other_Investigation_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Deposit_Others_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="depositInvestigation" columns="1">
                    <apex:inputField value="{!case.Deposit_Others_Investigation_Disposition__c}" required="{!IF((case.Deposit_Others_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Deposits_Other_Investigation_Comments__c}" style="width:500px;height:140px" required="{!IF((case.Deposit_Others_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection id="fairBankingInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Fair Banking Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Fair_Banking_C_L_Disposition__c}" required="{!IF((case.Fair_Banking_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="fairBankingInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Fair_Banking_Investigation_Disposition__c}" required="{!IF((case.Fair_Banking_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Banking_C_L_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Fair_Banking_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Banking_Investigation_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Fair_Banking_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="fairBankingInvestigation" columns="1">
                    <apex:inputField value="{!case.Fair_Banking_Investigation_Disposition__c}" required="{!IF((case.Fair_Banking_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Banking_Investigation_Comments__c}" style="width:500px;height:140px" required="{!IF((case.Fair_Banking_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection id="fairCreditInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Fair Credit Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Fair_Credit_C_L_Disposition__c}" required="{!IF((case.Fair_Credit_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="fairCreditInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Fair_Credit_Investigation_Disposition__c}" required="{!IF((case.Fair_Credit_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Credit_C_L_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Fair_Credit_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Credit_Investigation_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Fair_Credit_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="fairCreditInvestigation" columns="1">
                    <apex:inputField value="{!case.Fair_Credit_Investigation_Disposition__c}" required="{!IF((case.Fair_Credit_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Fair_Credit_Investigation_Comments__c}" style="width:500px;height:140px" required="{!IF((case.Fair_Credit_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection id="lendingSavingsInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Lending/Savings Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Lending_Savings_C_L_Disposition__c}" required="{!IF((case.Lending_Savings_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="lendingSavingsInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Lending_Saving_Investigation_Disposition__c}" required="{!IF((case.Lending_Savings_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Lending_Savings_C_L_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Lending_Savings_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.Lending_Savings_Investigation_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Lending_Savings_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="lendingSavingsInvestigation" columns="1">
                    <apex:inputField value="{!case.Lending_Saving_Investigation_Disposition__c}" required="{!IF((case.Lending_Savings_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Lending_Savings_Investigation_Comments__c}" style="width:500px;height:140px" required="{!IF((case.Lending_Savings_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection id="mortgageCLInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Mortgage/CL Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Other_Mortgage_CL_Only_C_L_Disposition__c}" required="{!IF((case.Mortgage_Consumer_Loan_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="mortgageCLInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Mortgage_CL_Investigation_Disposition__c}" required="{!IF((case.Other_Mortgage_CL_Only_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Other_Mortgage_CL_Only_C_L_Comments__c}" style="width:300px;height:45px;" required="{!IF((case.Mortgage_Consumer_Loan_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.Mortgage_CL_Other_Investigation_Comments__c}" style="width:300px;height:45px;" required="{!IF((case.Other_Mortgage_CL_Only_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="mortgageCLInvestigation" columns="1">
                    <apex:inputField value="{!case.Mortgage_CL_Investigation_Disposition__c}" required="{!IF((case.Other_Mortgage_CL_Only_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.Mortgage_CL_Other_Investigation_Comments__c}" style="width:500px;height:140px;" required="{!IF((case.Other_Mortgage_CL_Only_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection id="scraInvestigation" columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="SCRA Exception Disposition"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.SCRA_C_L_Disposition__c}" required="{!IF((case.SCRA_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}">
                                <apex:actionSupport event="onchange" rerender="scraInvestigation"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.SCRA_Investigation_Disposition__c}" required="{!IF((case.SCRA_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.SCRA_C_L_Comments__c}" style="width:300px;height:45px;" required="{!IF((case.SCRA_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>
                    <apex:inputField value="{!case.SCRA_Investigation_Comments__c}" style="width:300px;height:45px;" required="{!IF((case.SCRA_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>
                <!--<apex:pageBlockSection id="scraInvestigation" columns="1">
                    <apex:inputField value="{!case.SCRA_Investigation_Disposition__c}" required="{!IF((case.SCRA_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                    <apex:inputField value="{!case.SCRA_Investigation_Comments__c}" style="width:500px;height:140px;" required="{!IF((case.SCRA_C_L_Disposition__c='Investigation Required'),true,false)}"/>
                </apex:pageBlockSection>-->
                
                <apex:pageBlockSection columns="2">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Was PCQ Information Sufficient/Accurate?"/>
                        <apex:inputField value="{!case.Was_TM_Information_Sufficient_Accurate__c}"/>
                    </apex:pageBlockSectionItem>
                    <!--<br/>-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="C&L Exception Review Disposition"/>
                        <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}"/>
                    </apex:pageBlockSectionItem>
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="PCQ Information Comments"/>
                        <apex:inputField value="{!case.TM_Information_Comments__c}" style="width:300px;height:45px;"/>
                    </apex:pageBlockSectionItem>
                    <!--<br/>-->
                    <!--<apex:pageBlockSectionItem >
                        <apex:outputLabel value="C&L Exception Review Disposition"/>
                        <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}"/>
                    </apex:pageBlockSectionItem>-->
                    <!--<br/>-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="C&L Exception Review Comments"/>
                        <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:300px;height:45px;"/>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
            </apex:pageBlockSection>
            <!--End of "ComplianceEvaluationSummary"-->
            <!--End Changes for CMI 2014-->
            
            <!--Start Changes for CMI 2014-->
            <apex:outputPanel id="caseStatusSummaryPopup">
                <apex:outputPanel styleClass="popupBackground" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}"/>
                <apex:outputPanel styleClass="custPopup" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}">
                    <div align="center" style="height:70%">
                        <apex:outputText style="font-weight:800;" value="{!messageBody}"/>
                    </div>
                    <div style="height:35%">
                        <apex:actionRegion >
                            <apex:commandButton style="margin-left:45%" value="OK" action="{!closeCaseStatusSummaryPopup}" reRender="caseStatusSummaryPopup"/>
                        </apex:actionRegion>
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>
            <!--End Changes for CMI 2014-->
        </apex:pageBlock>
    </apex:form>
    
    <!--Start Changes for CMI 2014-->
    <style type="text/css">
        .custPopup
        {
            background-color: white;
            border-width: 2px;
            border-style: solid;
            z-index: 9999;
            left: 35%;
            padding:1%;
            position: fixed;
            width: 58%;
            margin-left: -15%;
            top:45%;
            height:11%;
        }
        .popupBackground
        {
            background-color:black;
            opacity: 0.20;
            filter: alpha(opacity = 20);
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 9998;
        }
    </style>
    <!--End Changes for CMI 2014-->
</apex:page>