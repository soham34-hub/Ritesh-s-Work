                                <div style="border : solid 2px #000000; padding : 4px; height : '200px'; overflow : auto;">    
                                    <apex:dataTable value="{!assignSearchResultsForJointAccount}" var="result" rowClasses="odd,even" styleClass="list">
                                        <apex:column >
                                            <apex:facet name="header">Select</apex:facet>
                                            <input type="radio" name="Selected" value="{!result.PartyId}"/>
                                            <apex:param name="Selected" value="{!result.PartyId}"/>                        
                                        </apex:column>
                                        <apex:column value="{!result.Name}">
                                            <apex:facet name="header">Name</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.TIN}">
                                            <apex:facet name="header">TIN</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column >
                                            <apex:facet name="header">DOB</apex:facet>
                                            <apex:outputText value="{0,date,MM'-'dd'-'yyyy}"><apex:param value="{!result.DOB}"/></apex:outputText>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.AddressLine1}">
                                            <apex:facet name="header">Address Line1</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.City}">
                                            <apex:facet name="header">City</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.State}">
                                            <apex:facet name="header">State</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.Zip}">
                                            <apex:facet name="header">Zip</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.Country}">
                                            <apex:facet name="header">Country</apex:facet>
                                        </apex:column>
                                    </apex:dataTable>
                                </div>                                                    
                            </apex:pageblock>-->
                            <!--<div align='center'><apex:commandButton action="{!selectPartyAndAssignValues}" immediate="true" status="jointAccStatus" reRender="authorizedPartyPanel,accts,clientDetails,renderAccountDetails,accountSearch,nameSearch,accountSearch5,nameSearch5,accountSearch4,nameSearch4,LOBAccountDetailsPanel,accountSearch3,nameSearch3,accountSearch2,nameSearch2,accountSearch1,nameSearch1,accountDetailsAdded, ClientInfoPanelForComplaint, clientfollowupsection, ClientFollowUpSection, clientFollowUpSection, contactMethodFields, ClientSectionAfterBypassingSearchClient, ClientSectionAfterBypassingSearchClient1, ClientSectionAfterBypassingSearchClient2, ClientSectionAfterBypassingSearchClient3,renderAccountDetailsForCreateClient,ClientInfoPanel,ClientInfoPanel1,ClientInfoPanel2,ClientInfoPanel3,ClientInfoPanel4,LOBAccountDetailsPanel,lobAccountDetailsPanel,LobAccountDetailsPanel,accountFields,nameSearch,cisVerifyResults,nameSearch,cisVerifyResults,jointAccountComponent" value="Select & Return To Case"/></div>                 
                            <br/>
                            <apex:actionStatus id="jointAccStatus">
                                <apex:facet name="start">
                                    <div style="text-align:center;">
                                        <img src="{!$Resource.SpinIcon}"/>
                                        <span class="waitingDescription">Please wait...</span>
                                    </div>
                                </apex:facet>
                            </apex:actionStatus>
                        </c:Modal_Dialog>-->                                                             
                    </apex:pageBlockSection>
                    <!-- Start Changes for CMI 2014 Release 3 -->
                    <apex:outputPanel id="cisVerifyResults">
                        <apex:pageBlockSection columns="1" rendered="{!(assignInfoMessage!=Null && assignInfoMessage!='')}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:15%" value="{!assignInfoMessage}"/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>    
                    <apex:actionStatus id="VerifyCISClientStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                                <span class="waitingDescription">Verifying.Please wait...</span>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                    <!-- End Changes for CMI 2014 Release 3 -->

                    
                    <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='No' && case.Client_Indicator__c = 'hST'}">                    
                        <apex:commandButton style="margin-left:45%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>                            
                        <!--<c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                            <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase" />
                            <div style="text-align:center">
                                <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetailsForCreateClient" value="Return To Case" />                   
                            </div>
                            <br/>
                        </c:Modal_Dialog>-->                                                 
                    </apex:pageblockSection>
                </apex:outputPanel>
                
                <!--Start Changes  for CMI 2014 Release 2-->
                <!--This section is added to bypass the client search when it is not displaying any results -->                
               
                <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient"> 
                    <!--For CMI 2014 Release 3, case origin is checked in rendered condition-->  
                    <!--Start changes for CMI BBT Pilot M07 2020 - Rendered condition checked for BBT Internal-->              
                    <apex:outputPanel rendered="{!((assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone') ||  (case.Call_Source__c = 'BBT Internal' && case.Is_this_a_Client__c = 'Yes'))}">                         
                    <!--End changes for CMI BBT Pilot M07 2020 -->    
                        <apex:pageBlockSection >                         
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Bypass Client Search"/> 
                                <apex:actionRegion > 
                                    <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                       <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="authorisedThirdParty,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,accountFields,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel,authorizedPartyPanel" status="ClientStatus"/>
                                    </apex:inputCheckbox> 
                                </apex:actionRegion> 
                             </apex:pageblocksectionitem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (NOT(CRTQualityAssuranceSpecialist)) && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection columns="1" rendered="{!!case.BypassSearchProcess__c}">                         
                            <apex:pageBlockSectionItem >    
                                <!-- Start changes for CMI 2014 Release 3 -->
                                <apex:outputlabel value="Reason for Bypass"/>
                                <!-- End Changes for CMI 2014 Release 3 --> 
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}"/> 
                                </apex:actionRegion> 
                             </apex:pageblocksectionitem>                             
                        </apex:pageBlockSection>
                        <apex:pageBlockSection columns="1" rendered="{!case.BypassSearchProcess__c}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:21%" value="If the system is unavailable please try after sometime. If the client cannot be verified in both CRS and CIS, please create an observer."/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!(case.Reason_for_Overriding_Search_Process__c != null && !case.BypassSearchProcess__c && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection >  
                            <apex:pageBlockSectionItem >    
                                <!-- Start changes for CMI 2014 Release 3 -->
                                <apex:outputlabel value="Reason for Bypass"/> 
                                <!-- End changes for CMI 2014 Release 3 -->                      
                                <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <!-- End changes for CMI 2014 Release 3 -->
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && CRTQualityAssuranceSpecialist)}">                         
                      <apex:pageblockSection >  
                        <apex:outputField value="{!case.BypassSearchProcess__c}" />
                        <apex:pageBlockSectionItem >    
                            <!-- Start changes for CMI 2014 Release 3 -->
                            <apex:outputlabel value="Reason for Bypass"/>
                            <!-- End changes for CMI 2014 Release 3 -->
                            <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                        </apex:pageBlockSectionItem>
                        <apex:outputField value="{!case.Contact_Name__c}"/>
                        <apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}"/> 
                        <apex:outputField value="{!case.Account_Number__c}"/>
                        <apex:actionRegion > 
                            <apex:outputField value="{!case.Account_Type__c}"> 
                            <apex:actionSupport event="onchange" reRender="loanInfo"/>
                        </apex:outputField>
                        </apex:actionRegion>
                        <apex:outputField value="{!case.Contact_Method__c}"/>
                        <apex:outputField value="{!case.Alternate_Phone_Number__c}"/>
                        <apex:outputField value="{!case.Alternate_Address__c}"/>
                        <apex:outputField value="{!case.Alternate_Email__c}"/>
                      </apex:pageblockSection>
                    </apex:outputPanel>
                </apex:outputPanel>
                
                <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                    <!-- For CMI 2014 Release 3, origin is checked in rendered condition -->
                    <apex:outPutPanel rendered="{!((case.BypassSearchProcess__c || (case.Client_Indicator__c = 'hBBT' && case.Is_this_a_Client__c = 'No')) && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}">                            
                        <apex:pageBlockSection columns="1" rendered="{!(case.BypassSearchProcess__c)}">                              
                            <apex:pageBlockSectionItem >
                                <!-- Start Changes for CMI 2014 Release 3 -->                            
                                <apex:outputlabel value="Reason for Bypass"/>
                                <!-- End Changes for CMI 2014 Release 3 -->
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                        <apex:actionSupport event="onchange" rerender="CINField"  status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>                             
                        </apex:pageBlockSection>
                         
                         
                         <apex:pageBlockSection columns="1" id="authorizedClientDetailsBypass">
                             <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c,(case.Client_Indicator__c = 'hBBT' && case.Is_this_a_Client__c = 'No')),OR(case.Type='Complaint',case.Type='ES Tracking Only',case.Type='Service Request'))}" required="true" value="{!case.Contact_Name__c}"/>
                             <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c,(case.Client_Indicator__c = 'hBBT' && case.Is_this_a_Client__c = 'No')),OR(case.Type='Complaint',case.Type='ES Tracking Only',case.Type='Service Request'))}" required="true" value="{!case.Contact_Phone__c}"/>
                        </apex:pageBlockSection>
                         
                        <apex:pageBlockSection id="CINField" columns="1">                              
                            <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available' && case.Client_Indicator__c = 'hST'}"/>
                            <apex:inputField value="{!case.CIF__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available' && case.Client_Indicator__c = 'hBBT'}"/>
                            <!--Commented For CMI 2014 Release 3.TIN Field is not needed-->
                            <!--<apex:inputField value="{!case.TIN__c}" required="true" />-->
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection columns="1" >                              
                             <!--<apex:inputField value="{!case.Contact_Name__c}" required="true"/>-->
                             <!--Below Field is added for CMI 2014 Release 3-->                             
                             <!--<apex:inputField value="{!case.Contact_Phone__c}" required="true"/>-->
                             
                             <!--Start changes for CMI 2014 Release 3-->
                             <apex:pageBlockSectionItem >
                             <apex:outputlabel value="Is This A Private Wealth Client?" />
                             <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                    <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            
                             <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>
                             
                                 <!--Start changes for CMI BBT Pilot M07 2020 -->
                                 <apex:inputField value="{!case.CIF__c}" required="false" rendered="{!case.BypassSearchProcess__c && case.Call_Source__c = 'BBT Internal'}"/> 
                                 <apex:outputField value="{!case.CIF__c}" rendered="{!case.BypassSearchProcess__c=False && case.Client_Indicator__c != 'hBBT' && case.Is_this_a_Client__c != 'No'}"/>                                 
                                 <!--End changes for CMI BBT Pilot M07 2020 -->
                                  

                            <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Account Type"/>
                                 <apex:actionRegion >
                                     <apex:inputField value="{!case.Account_Type__c}" required="true">
                                         <apex:actionSupport event="onchange" reRender="AlternateAddress, AcctTypeDetail-1,acctTypeHidden,loanInfo" action="{!defaultAccountTypeDetailField}"/>
                                     </apex:inputField>
                                 </apex:actionRegion>
                             </apex:pageBlockSectionItem>
                            <!--End changes for CMI 2014 Release 3-->


                             <!--Below Field is added for CMI 2014 Release 3-->
                             <!--<apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>-->
                             <apex:inputField value="{!case.Account_Number__c}" required="true"/> 
                             
                             <!--<apex:pageBlockSection id="isThisAuthThirdParty">-->
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Is This An Authorized Third Party" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}">
                                       <!-- <apex:actionSupport event="onchange"  reRender="authorizedClientDetailsBypass" status="ClientStatus"/>-->
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                       <!-- </apex:pageBlockSection> -->
                             
                             
                        </apex:pageBlockSection>   
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <apex:pageBlockSection rendered="{!case.Account_Type__c = 'Credit Card' || case.Account_Type__c='Consumer Loan'}" id="AcctTypeDetail-1"> 
                            <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c ='Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c='Consumer Loan'}" required="true"/>
                        </apex:pageBlockSection>
                        
                        
                                              
                        
                        <!-- End changes for CMI 2014 Release 3 -->                    
                    </apex:outPutPanel>
                </apex:outPutPanel>
                <!--End Changes  for CMI 2014 Release 2-->
                
                <!--For CMI 2014 Release 2, the below outputPanel is added-->
                <apex:outputPanel id="nameSearch">
                    <!--<apex:outputPanel rendered="{!NOT(case.BypassSearchProcess__c)}">-->   
                        <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added-->             
                        <!--For CMI 2014 Release 3, origin is checked in rendered condition -->
                        <apex:pageblockSection rendered="{!(case.CIN__c!=Null || case.CIF__c != Null) && (NOT(case.BypassSearchProcess__c)|| case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" columns="2" >
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Select Account" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}"/>
                                    <apex:define name="requiredSelectAccount">
                                        <apex:actionRegion >                                    
                                            <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}">
                                                <apex:selectOptions value="{!accountsList}"/>
                                                <!--accountTypeDetail is added in the rerender attribute for CMI 2014 release 2-->
                                                <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}"  reRender="nameSearch,selectAccountModal,SADsection, AcctTypeDetail-2,accountFields,relationshipManagedBySAD,loanInfo" status="selectAccountStatus"/>
                                            </apex:selectList>                                               
                                        </apex:actionRegion>
                                    </apex:define>
                                </apex:pageBlockSectionItem>                                
                                <!--Start changes for CMI 2016 April release.Client Name is displayed as a link to open the Related Account Record-->
                                <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null}">
                                    <apex:outputLabel value="Client Name"/>
                                    <apex:actionRegion >                                                                                                    
                                        <apex:commandLink id="theLink1"  reRender="" status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                <!--End changes for CMI 2016 April release.-->
                                
                                <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                                <apex:pageBlockSectionItem rendered="{!((stProductId!=null && stProductId!='') && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!='')}">
                                    <apex:outputLabel value="Account Number"/>
                                    <apex:actionRegion >                                                                                                    
                                        <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(OR(stProductId=null,stProductId="") && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!='')}" />
                                <!--End changes for CMI 2016 June Release.-->
                                                                
                                <apex:inputField rendered="{!(renderAccountType|| comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')&& selectedAccountInformation!='--NONE--' }" value="{!case.Account_Number__c}" />                                 
                                <!-- commented for CMI 2014 -->
                                <!--<apex:pageBlockSectionItem rendered="{!case.CIN__c<>null && case.Is_This_a_client__c='No' && selectedAccountInformation!='Other' }"/>--> 
                                <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                                <apex:outputField rendered="{!case.CIF__c<>null}" value="{!case.CIF__c}"/>
                                <apex:outputField rendered="{!case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type__c}" >
                                    <apex:actionSupport event="onchange" reRender="loanInfo"/>
                                </apex:outputField>
                                <apex:pageblockSectionItem rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}">
                                    <apex:outputLabel rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="Account Type" />
                                    <apex:actionRegion >
                                        <apex:inputField rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Type__c}" >
                                            <apex:actionSupport event="onchange" reRender="SADsection,relationshipManagedBySAD,loanInfo"  status="selectAccountStatus" action="{!defaultAccountTypeDetailField}"/>
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </apex:pageblockSectionItem>
                                <apex:outputField rendered="{!case.Client_Name__c<>null}" value="{!case.Business_or_Personal__c}"/>
                            <!-- June 2024 - US1138595 - CMI - US1295486 - WE.3 - Add field to MERT Edit -->          
                            <apex:pageblocksectionitem rendered="{!(case.Account_Type__c='Mortgage Loan' && selectedAccountInformation!='Other')}">
                                <apex:outputlabel value="Is this loan FHA insured?" /> 
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Is_this_loan_FHA_insured__c}" required="true"> 
                                    </apex:inputField>
                                </apex:actionRegion> 
                            </apex:pageblocksectionitem>
                                <!--<apex:inputField required="{!case.Business_or_Personal__c = 'Business'}" value="{!case.CRS_Number__c}"/>-->
                                <!--Fields for HH Information-->
                                <!--<apex:pageBlockSectionItem rendered="{!case.HH_Info__c<>null && case.HH_Info__c!=''}"/> 
                                <apex:outputField rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}" value="{!case.HH_Info__c}"/>-->
                                <apex:pageBlockSectionItem rendered="{!case.Client_Servicing_Code__c<>null && case.Client_Servicing_Code__c!=''}"/> 
                                <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>
                                <!--<apex:pageBlockSectionItem rendered="{!case.Client_Segmentation_Code__c<>null && case.Client_Segmentation_Code__c!=''}"/>                                                                         
                                <apex:outputField rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}" value="{!case.Client_Segmentation_Code__c}"/>-->
                                <!--Fields for HH Information-->
                        </apex:pageBlockSection>
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <apex:pageblockSection id="SADsection" rendered="{!(case.CIN__c!=Null || case.CIF__c !=Null) && NOT(case.BypassSearchProcess__c)}"  columns="2" >
                            <!--<apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!case.Account_Type__c = 'Credit Card'}"/>-->
                            <!--<apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c ='Credit Card'}" required="true"/>-->
                            
                            <apex:pageBlockSectionItem rendered="{!(case.Account_Type__c = 'Credit card' || case.Account_Type__c ='Credit Card' || case.Account_Type__c='Consumer Loan')}">
                                    <apex:outputLabel value="Account Type Detail" />
                                    <apex:define name="requiredSelectAccount">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                                <apex:selectOptions value="{!acctTypeDetailFieldValue}"/>                                                    
                                            </apex:selectList>
                                        </div>
                                    </apex:define> 
                            </apex:pageBlockSectionItem>
                            
                            <!-- June 2024 - US1138595 - CMI - US1295487 - WE.4 - Add field to MERT New -->          
                            <apex:pageblocksectionitem rendered="{!(case.Account_Type__c='Mortgage Loan' && selectedAccountInformation='Other')}">
                                <apex:outputlabel value="Is this loan FHA insured?" /> 
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Is_this_loan_FHA_insured__c}" required="true"> 
                                    </apex:inputField>
                                </apex:actionRegion> 
                            </apex:pageblocksectionitem>
                            <!--Fields for HH Information-->
                        </apex:pageblockSection>
                        <!-- End changes for CMI 2014 Release 3 -->
                        <apex:pageBlockSection id="thisIsClient" columns="1">
                            <apex:inputField value="{!case.State_Client_Resides_In__c}" required="{!AND(case.Is_this_a_Client__c='Yes', case.Case_Association_Type__c != 'Transferred from CLEAR',OR(!case.Auto_Closed_Review__c,case.Status!='Closed'))}"
                                rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                            <apex:outputField value="{!case.State_Client_Resides_In__c}"
                                rendered="{!OR(CRTQualityAssuranceSpecialist)}" />                        
                        </apex:pageBlockSection> 
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <!--<apex:pageBlockSection rendered="{!case.Account_Type__c = 'Credit Card'}" id="AcctTypeDetail-2"> 
                            <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c ='Credit Card'}"/>
                        </apex:pageBlockSection>-->
                        <!-- End changes for CMI 2014 Release 3 -->
                            <!--Start changes for for CMI 2014 Release 2.-->
                            <!--<apex:outputField rendered="{!case.LOB_Relationship__c='PWM'}" value="{!case.LOB_Relationship__c}"/>
                            <apex:inputField rendered="{!case.LOB_Relationship__c='PWM'}" value="{!case.Relationship_ID__c}"/>
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel rendered="{!case.LOB_Relationship__c='PWM'}" value="Officer Search"/>
                                <apex:actionRegion >
                                    <apex:inputField rendered="{!case.LOB_Relationship__c='PWM'}" value="{!case.Officer_Search__c}" onkeypress="return false;" onkeydown="return false;" >                                
                                        <apex:actionSupport event="onchange" action="{!populateContactRelatedFields}" status="selectAccountStatus" rerender="officerId"/>                                
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>                            
                        <apex:pageBlockSection id="officerId" rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c)}" >                              
                            <apex:outputField rendered="{!case.Officers_Employee_ID__c!=Null && case.Officers_Employee_ID__c!='' && case.LOB_Relationship__c='PWM'}" value="{!case.Officers_Employee_ID__c}"/>
                        </apex:pageBlockSection>-->                            
                        <!--End changes for for CMI 2014 Release 2.-->
                        <!--<apex:pageBlockSection rendered="{!(case.CIN__c!=Null) && (NOT(case.BypassSearchProcess__c) || case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && !comingAfterCreatingClient}" > 
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Select Account" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}"/>
                                <apex:define name="requiredSelectAccount">
                                    <apex:actionRegion >                                    
                                        <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.Client_Name__c<>null && !comingAfterCreatingClient)}">
                                            <apex:selectOptions value="{!accountsList}"/>-->
                                            <!--accountTypeDetail is added in the rerender attribute for CMI 2014 release 2-->
                                            <!--<apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="selectAccountModal, renderAccountDetails, renderAccountDetailsForCreateClient,accountTypeDetail,accountFields" status="selectAccountStatus"/>
                                        </apex:selectList>                                               
                                    </apex:actionRegion>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>--> 
                        <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                            <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                            <br/>
                        </c:Modal_Dialog>
                    
                    
                        <apex:actionStatus id="selectAccountStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    <!--</apex:outputPanel>-->
                </apex:outputPanel>
                <!--For CMI 2014 Release 2, the two outputPanels below have been added-->
                <apex:outputPanel id="accountFields"> 
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:pageblockSection rendered="{!(case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Client_Name__c == '' && selectedAccountInformation!='Other'}" columns="1">
                        <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                        <apex:pageBlockSectionItem rendered="{!stProductId!=null && stProductId!=''}">
                            <apex:outputLabel value="Account Number"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputfield value="{!case.Account_Number__c}" rendered="{!OR(stProductId=null,stProductId='')}" />
                        <!--End changes for CMI 2016 June Release.-->
                        <apex:actionRegion > 
                            <apex:outputField value="{!case.Account_Type__c}"> 
                            <apex:actionSupport event="onchange" reRender="loanInfo"/>
                        </apex:outputField>
                        </apex:actionRegion>
                    </apex:pageblockSection> 
                    <!-- End changes for CMI 2014 Release 3 -->
                    <!-- case origin is checked for CMI 2014 Release 3 -->
                    <apex:outputPanel rendered="{! NOT(case.BypassSearchProcess__c) || case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'}" >
                        <!--<apex:pageblockSection id="renderAccountDetails" columns="2">-->
                            <!--For CMI 2014 Release 2 case.Is_this_a_Client__c=='Yes' is removed and client name is checked in the rendering condition of both the fields for proper rendering -->
                            <!--<apex:outputField rendered="{!case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Number__c}" />
                            <apex:outputField rendered="{!case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type__c}" />
                        </apex:pageblockSection>-->
                        
                        <!--The below output panel is newly added for CMI 2014 release 2-->
                        <!--<apex:outputPanel id="renderAccountDetailsForCreateClient">
                            <apex:pageblockSection columns="2">
                                <apex:inputField rendered="{!(selectedAccountInformation=='Other' || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Number__c}" />
                                <apex:inputField rendered="{!(selectedAccountInformation=='Other' || comingAfterCreatingClient || case.Special_Initiatives__c<>'CMI')}" value="{!case.Account_Type__c}" />
                            </apex:pageblockSection>
                        </apex:outputPanel>-->   
                        <!--End changes for for CMI 2014 Release 2.-->
                        
                        <!--<apex:pageBlockSection columns="2">-->    
                            <!--Start changes for CMI 2014.1 break/fixes-->
                            <!--<apex:pageBlockSectionItem rendered="{!AND(OR(NOT(case.BypassSearchProcess__c),case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'))}">
                                <apex:outputLabel value="Is This An Authorized Third Party"/>                       
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='CFS Tracking Only',case.type='Tracking Only: Research/Follow Up')))}">
                                        <apex:actionSupport event="onchange" reRender="authorizedPartyPanel" status="ComplaintDetailStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:outputField value="{!case.Is_This_An_Authorized_Third_Party__c}"
                            rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />-->
                        
                     <!-- Start changes for CMI release 3-->                 
                     <!--For CMI 2014 Release 2, NOT(case.BypassSearchProcess__c) has been added in the rendered condition-->
                    <!--</apex:pageBlockSection>--> 
                    <!--<apex:inputField value="{!case.Contact_Name__c}" required="{!OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Business_or_Personal__c = 'Business')}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'),NOT(case.BypassSearchProcess__c)))}"/>-->
                    <!--<apex:outputField value="{!case.Contact_Name__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" /> -->
                
                    <!--<apex:inputField value="{!case.Contact_Phone__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request')))}"/>-->
                   <!-- <apex:outputField value="{!case.Contact_Phone__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" /> -->
                    <!--<apex:pageBlockSection> 
                     <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'),NOT(case.BypassSearchProcess__c)))}" required="true" value="{!case.Contact_Name__c}"/>
                     <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'),NOT(case.BypassSearchProcess__c)))}" value="{!case.Contact_Phone__c}"/>-->

                    <!--End changes for CMI 2014.1 break/fixes-->
                       <!--</apex:pageBlockSection>--> 
                        <!--End changes for CIS Search for CMI 2014-->
                         <!-- End changes for CMI release 3-->                 
                    </apex:outputPanel>
                    
                </apex:outputPanel>
                
                                    
                <apex:pageBlockSection id="AccountDetails" columns="1">                                             
                    <!--<apex:outputfield value="{!case.SuppliedEmail}"/> -->
                                   
                    <!--Start Changes for CMI Pilot-->
                    <!--The required condition changed for CMI 2014-->
                    <!--Earlier Functional Area was required always when rendered. Now, it is only required when Special Initiatives is not Null.-->          
                    <apex:pageBlockSectionItem id="FunctionalArea">
                        <apex:outputLabel value="Functional Area" for="funcArea" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                        <apex:inputField value="{!case.Functional_Area__c}" id="funcArea" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="{!IF(((case.Type="Complaint" || case.Type="Service Request") && $ObjectType.Case.fields.Functional_Area__c.Updateable && case.Special_Initiatives__c!=Null),true,false)}"/>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Functional_Area__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                    <!--End Changes for CMI Pilot-->
                    
                    <apex:outputField value="{!case.Investor__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    <apex:inputField value="{!case.Investor__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                </apex:pageBlockSection>
                
                <apex:outputPanel id="bypassClientContactMethodFields" >
                    <apex:outputPanel rendered="{!case.BypassSearchProcess__c && (NOT(CRTQualityAssuranceSpecialist)) && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}">
                        <apex:pageBlockSection columns="1">
                             <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Client Follow Up Needed?"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                        <apex:actionSupport event="onchange" action="{!clientFollowUpChanges}" reRender="bypassClientContactMethodFields" status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                             </apex:pageBlockSectionItem>
                             
                             <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Contact Method" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" />
                                 <apex:actionRegion >
                                    <apex:inputField value="{!case.Contact_Method__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" required="true">
                                        <apex:actionSupport event="onchange" reRender="bypassClientContactMethodFields" status="ClientStatus" />
                                    </apex:inputField>
                                </apex:actionRegion> 
                             </apex:pageBlockSectionItem>
                            
                             <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}"/>  
                                <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}" required="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>                                                                    
                             </apex:pageBlockSectionItem>
                            
                             <!--<apex:pageBlockSectionItem >
                                <apex:outputLabel value="Alternate Address" rendered="{!(case.Contact_Method__c='Mail')}"/>  
                                <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!(case.Contact_Method__c='Mail')}" required="true"/>                                                                    
                             </apex:pageBlockSectionItem>-->
                             <!--For CMI 2014 Release 3 below field is added-->
                             <apex:pageBlockSectionItem rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}">
                                 <apex:outputLabel value="Best Time To Call" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>  
                                 <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}" required="true"/>                                                                    
                             </apex:pageBlockSectionItem>

                             <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Alternate Email" rendered="{!(case.Contact_Method__c='Email')}"/>                                           
                                <apex:inputField value="{!case.Alternate_Email__c}" rendered="{!(case.Contact_Method__c='Email')}" required="true"/>                                    
                             </apex:pageblocksectionItem>
                        </apex:pageblocksection>
                        <!--For CMI 2014 Release 3,Alternate Address Field is added to a new PageBlockSection.Because it is rendered based on AccountType Field-->
                        <apex:pageBlockSection id="AlternateAddress">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Alternate Address" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}"/>  
                                <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}" required="true"/>                                                                    
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                 </apex:outputPanel>   
                
                <!--For CMI 2014 Release 2, the below outputPanel is added-->
                <apex:outputPanel id="ClientFollowUpSection">
                    <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added for the below section-->                    
                    <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" columns="1">                   
                        <apex:outputField value="{!case.Client_Follow_Up_Needed__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>      
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Client Follow Up Needed?"/>
                            <apex:actionRegion >                        
                                <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="True">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection> 
                     
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!case.Client_Follow_Up_Needed__c='Yes' && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">  
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->
                        <apex:outputField value="{!case.Contact_Method__c}" rendered="{!AND(CRTQualityAssuranceSpecialist,case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}"/>                
                        <apex:pageBlockSectionItem >
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:outputlabel value="Contact Method" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:actionRegion >
                                <!--Rendering conditions changed for CMI 2014-->
                                <!--Is this a Client condition included in rendering condition for CMI 2014-->
                                <!--Contact method is introduce in CMI Pilot-->                 
                                <apex:inputField value="{!case.Contact_Method__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Client_Follow_Up_Needed__c='Yes', case.Is_this_a_Client__c!=Null)}" required="True">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection,authorizedPartyPanel" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                     
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Phone') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->

                        <apex:pageblockSectionItem rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}">
                            <apex:outputlabel value="Client Phone"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>         
                        </apex:pageblockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null,NOT(OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone')))}">
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <!--<apex:outputlabel value="Client Contact Number" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>
                            <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}" required="True"/>-->
                            <apex:outputlabel value="Client Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null)}"/>
                            <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c=null)}" required="True"/>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c!=null,NOT(OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone')))}">
                            <apex:outputlabel value="Client Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c!=null)}"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',case.Client_Contact_Number__c!=null)}"/>
                        </apex:pageBlockSectionItem>
                        
                        <!--Start Changes for CMI 2014 Release 3-->
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes',OR(case.Origin = 'CMI WHL Salesforce',case.Origin = 'CMI WHL Standalone'))}">
                            <apex:outputlabel value="Contact Phone" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>
                            <apex:inputField value="{!case.Contact_Phone__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone',case.Is_this_a_Client__c='Yes')}"/>
                        </apex:pageBlockSectionItem>
                        <!--End Changes for CMI 2014 Release 3-->
                        
                        <!--Start Changes for CMI 2014-->
                        <!--Alternate Phone Number added for CMI 2014-->
                        <apex:outputField value="{!case.Alternate_Phone_Number__c}" rendered="{!AND(CRTQualityAssuranceSpecialist,case.Client_Follow_Up_Needed__c='Yes',case.Contact_Method__c='Phone',case.Is_this_a_Client__c!=Null)}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Phone Number" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c!=Null)}" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>
                        </apex:pageBlockSectionItem>
                        <!--End Changes for CMI 2014-->
                        
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->
                        <apex:outputField value="{!case.Best_Time_To_Call__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c='Yes')}"/>                    
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c='Yes')}">
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:outputlabel value="Best Time To Call" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c='Yes')}"/>
                            <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Phone', case.Is_this_a_Client__c='Yes')}" required="True"/>
                        </apex:pageblocksectionItem>
                    </apex:pageBlockSection>
                       
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Mail') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        <!--Start Changes for CMI 2014-->
                        <!--Contact Address added for CMI 2014-->
                        <apex:outputField value="{!case.Contact_Address__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail',case.Is_this_a_Client__c='Yes')}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}">
                            <!--inputField changed to outputField,required attribute is removed for CIS Search for CMI 2014-->
                            <!--<apex:outputlabel value="Contact Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes')}"/>
                            <apex:inputField value="{!case.Contact_Address__c}" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes')}" />-->
                            <apex:outputlabel value="Contact Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}"/>
                            <apex:inputField value="{!case.Contact_Address__c}" style="width:200px; height:100px" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c=null)}" />
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}">
                            <apex:outputlabel value="Contact Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}"/>
                            <apex:outputField value="{!case.Contact_Address__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c='Yes',case.Contact_Address__c!=null)}" />
                        </apex:pageBlockSectionItem>
                                    
                        <!--Alternate Address added for CMI 2014-->
                        <apex:outputField value="{!case.Alternate_Address__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}"/>
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Address" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}"/>
                            <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Mail', case.Is_this_a_Client__c!=Null)}" style="width:200px; height:100px" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                        
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Email') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">               
                        <!--Client Email added for CMI 2014-->
                        <apex:outputField value="{!case.Client_Email__c}" rendered="{!AND(CRTQualityAssuranceSpecialist, case.Client_Follow_Up_Needed__c='Yes', case.Contact_Method__c='Email', case.Is_this_a_Client__c!=Null)}"/>                                                
                        <!--Start changes for CMI 2017 May Release-->
                        <!--Client Email Field and Alternate Email Field is displayed as optional if the Email Returned from CIS is invalid--> 
                        <apex:pageBlockSectionItem rendered="{!(!CRTQualityAssuranceSpecialist && case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}">
                            <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}"/>                                           
                            <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}" required="True"/>                                    
                        </apex:pageblocksectionItem>

                        <!--End changes for CMI 2017 May Release-->
                        <!--End Changes for CMI 2014-->
                    
                    </apex:pageBlockSection>
                    <!--end of ClientFollowUpSection-->
                </apex:outputPanel>
                
                <!--<apex:pageBlockSection id="thisIsClient" columns="1">
                    <apex:inputField value="{!case.State_Client_Resides_In__c}" required="{!case.Is_this_a_Client__c='Yes'}"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                    <apex:outputField value="{!case.State_Client_Resides_In__c}"
                        rendered="{!OR(CRTQualityAssuranceSpecialist)}" />                        
                </apex:pageBlockSection>-->
                
                 
                <!--End Changes for CMI Pilot-->
                <apex:pageBlockSection id="SPOCTeammate" columns="2">
                    <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Single Point of Contact" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                    <apex:actionRegion >
                    <apex:inputField value="{!case.Single_Point_of_Contact__c}"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="{!case.Case_Association_Type__c != 'Transferred from CLEAR' && (!case.Auto_Closed_Review__c || case.Status!='Closed')}" >
                        <apex:actionSupport event="onchange" reRender="SPOCTeammate" status="ClientStatus"/>
                       </apex:inputField>
                       </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Single_Point_of_Contact__c}"
                        rendered="{!OR(CRTQualityAssuranceSpecialist)}" />   
                   
    
                    <!--
                    <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                    <apex:outputField value="{!case.Best_Time_To_Call__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}"/>
                    -->
                    
                <!--</apex:pageBlockSection>
                
                <apex:pageBlockSection id="SPOCTeammate">-->
                
                     <apex:inputField value="{!case.SPOC_Teammate__c}"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Single_Point_of_Contact__c = 'Yes')}" required="{!case.Case_Association_Type__c != 'Transferred from CLEAR'}" />
                    <apex:outputField value="{!case.SPOC_Teammate__c}"
                        rendered="{!AND(OR(CRTQualityAssuranceSpecialist),case.Single_Point_of_Contact__c = 'Yes')}" />
                
                </apex:pageBlockSection>
                
                
                <apex:outputPanel id="authorizedPartyPanel">
                <apex:pageBlockSection columns="1" rendered="{!AND(OR(case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone',NOT(case.BypassSearchProcess__c)),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'))}">    
                            <!--Start changes for CMI 2014.1 break/fixes-->
                            <apex:pageBlockSectionItem rendered="{!AND(OR(case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone',NOT(case.BypassSearchProcess__c)),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'))}">
                                <apex:outputLabel value="Is This An Authorized Third Party"/>                       
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!AND(NOT(case.BypassSearchProcess__c))}">
                                        <apex:actionSupport event="onchange" reRender="authorizedPartyPanel" status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:outputField value="{!case.Is_This_An_Authorized_Third_Party__c}"
                            rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />
                        
                     <!-- Start changes for CMI release 3-->                 
                     <!--For CMI 2014 Release 2, NOT(case.BypassSearchProcess__c) has been added in the rendered condition-->
                    <!--</apex:pageBlockSection>-->
                    
<!--<apex:pageBlockSection id="authorizedPartyPanel">--> 

                     <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),NOT(case.BypassSearchProcess__c),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'),NOT(case.BypassSearchProcess__c)))}" required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}"/>
                     <apex:inputField rendered="{!OR(case.Is_this_a_Client__c='No',AND(NOT(CRTQualityAssuranceSpecialist),case.Is_this_a_Client__c='Yes',OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No', case.Business_or_Personal__c = 'Business'),OR(case.Type='Complaint',case.Type='Tracking Only: Research/Follow Up',case.Type='Service Request'),NOT(case.BypassSearchProcess__c),OR((case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'),((case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Contact_Method__c != 'Phone' ))))}" value="{!case.Contact_Phone__c}"/>
                     <apex:inputField value="{!case.Functional_Role__c}" rendered="{!case.Functional_Role__c!=null && case.Functional_Role__c!=''}"/>                    
                    <!--End changes for CMI 2014.1 break/fixes-->
                       </apex:pageBlockSection>
                       </apex:outputPanel> 
                         
                             
                      <apex:actionStatus id="ClientStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                </apex:actionStatus>                                               
                 
