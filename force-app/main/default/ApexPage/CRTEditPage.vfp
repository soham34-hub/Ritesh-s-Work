                    </apex:outputPanel>

                    <div style="margin-left:20%">
                        <apex:commandButton action="{!searchWHLClient}" reRender="nameSearch,verifyResults,CRSFields,crsWin" value="Verify WHL Client" status="VerifyClientStatus"/>                                                             
                    </div>
