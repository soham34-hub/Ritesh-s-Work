                        </apex:actionRegion>
                        </div>
                                </apex:define>
                    </apex:pageBlockSectionItem>
                    
                    <apex:outputPanel style="color:red;font-weight:bold;margin-left:230px;" rendered="{!NOT(ErrorDisplaySubmitterCategory='')}">{!ErrorDisplaySubmitterCategory}</apex:outputPanel>    
                    
                    <apex:pageBlockSectionItem >
