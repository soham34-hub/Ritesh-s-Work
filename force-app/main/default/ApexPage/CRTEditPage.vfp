            <!-- *************************************************************** --> 



<apex:pageblocksection title="Reputational Risk Summary" columns="1" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                        
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Disposition"/>
                <apex:inputField value="{!case.Reputational_Risk_Disposition__c}">
                    <apex:actionSupport event="onchange" rerender="ReputationalRiskSummary" status="ReputationalRisk"/> 
                </apex:inputField>                             
            </apex:pageBlockSectionItem>
            
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Evaluation"/>
                <apex:define name="requiredClientFeedback">
                    <div class="requiredInput">
                        <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                        <div class="requiredBlock" style="{!IF(case.Reputational_Risk_Disposition__c='No Investigation Required','background-color:C00','background-color:transparent')}"></div>
                        <apex:inputField value="{!case.Reputational_Risk_Evaluation__c}">
                            <apex:actionSupport event="onchange" rerender="ReputationalRiskSummary" status="ReputationalRisk"/> 
                        </apex:inputField>
                    </div>
                </apex:define>                            
            </apex:pageBlockSectionItem>
           
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Comments"/>
                <apex:define name="requiredClientFeedback">
                    <div class="requiredInput">
                        <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                        <div class="requiredBlock" style="{!IF(OR(case.Reputational_Risk_Disposition__c='No Investigation Required',case.Reputational_Risk_Evaluation__c!=null),'background-color:C00','background-color:transparent')}"></div>
                        <apex:inputTextArea value="{!case.Reputational_Risk_Comments__c}" cols="80" rows="7"/>
                    </div>
                </apex:define>
            </apex:pageBlockSectionItem>
                        
        </apex:pageblocksection>
        
        <apex:actionStatus id="ReputationalRisk">
            <apex:facet name="start">
                <div style="text-align:center;">
                    <img src="{!$Resource.SpinIcon}"/>
                </div>
            </apex:facet>
        </apex:actionStatus>
           
           <br  />
            
            <!--************************************************** --> 
            <!-- *         Compliance Evaluation Summary          * -->
            <!-- ************************************************** -->

            <!--Columns set to 1 for CMI 2014-->
            <apex:pageBlockSection id="ComplianceEvaluationSummary" title="Complaint Evaluation Summary" columns="1">                
                <apex:actionRegion >                    
                    <!--Start changes for for CMI 2015 Iteration 1-->                    
                    <apex:pageBlockSection id="litigationFields">                 
                        <apex:inputField value="{!case.Compliance_Review_of_Letter_Needed__c}"/>
                        <!--Start changes for CMI 2015 Iteration 2-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Litigation__c.label}"></apex:outputLabel>
                            
                                <apex:inputField value="{!case.Litigation__c}">
                                    <apex:actionSupport event="onchange" rerender="litigationFields,complianceOverrideOptIn" status="compOptIn" action="{!nullifyValuesOnLitigationChange}"/>
                                </apex:inputField>
                            
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2015 Iteration 2-->  
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Was_The_Resolution_Letter_Reviewed__c.label}"></apex:outputLabel>                            
                            <apex:inputField value="{!case.Was_The_Resolution_Letter_Reviewed__c}">
                                <apex:actionSupport event="onchange" rerender="litigationFields" status="compOptIn"/>
                            </apex:inputField>                            
                        </apex:pageBlockSectionItem>                                      
                        <!--Start changes for CMI 2015 Iteration 2-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Reference__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLegalRef">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF(case.Litigation__c == 'Yes' && (case.CreatedDate>rel2DeploymentDateValue || (case.CreatedDate<rel2DeploymentDateValue && case.Primary_Default_Group__c != 'Foreclosure'))  && ($ObjectType.Case.fields.Legal_Reference__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Legal_Reference__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        <!--<apex:inputField value="{!case.Legal_Reference__c}" required="{!case.Litigation__c == 'Yes' && case.Litigation__c != Null}"/>-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Letter_Review_Comments__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLetterReview">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF((case.Was_The_Resolution_Letter_Reviewed__c='Approved Without Edits' || case.Was_The_Resolution_Letter_Reviewed__c='Limited Edits Recommended' || case.Was_The_Resolution_Letter_Reviewed__c='Significant Changes Recommended') &&($ObjectType.Case.fields.Letter_Review_Comments__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Letter_Review_Comments__c}" style="width:300px;height:45px"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2015 Iteration 2-->
                        <!--For CMI 2015 Iteration 2, required attribute is added in the below field-->                    
                        <!--<apex:inputField value="{!case.Legal_Resource__c}" required="{!case.Litigation__c == 'Yes'}"/>-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Resource__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLegalResource">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF(case.Litigation__c == 'Yes' && (case.CreatedDate>rel2DeploymentDateValue || (case.CreatedDate<rel2DeploymentDateValue && case.Primary_Default_Group__c != 'Foreclosure')) && ($ObjectType.Case.fields.Legal_Resource__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Legal_Resource__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>                                    
                                
                    <!--Start changes for for CMI 2014 Release 2-->
                    <!--<apex:pageBlockSection >                 
                        <apex:inputField value="{!case.Compliance_Override__c}"/>
                        <apex:inputField value="{!case.Compliance_Override_Comments__c}" style="width:300px;height:45px" />
                    </apex:pageBlockSection>-->
                    <!--End changes for for CMI 2014 Release 2-->
                    
                    <!--Start changes for for CMI 2014 Release 2-->                
                    <apex:pageBlockSection id="complianceOverrideOptIn">  
                        <!--For CMI 2015 Iteration 2, compliance override checkbox is replaced by Compliance override reason and compliance opt in comments field is added-->                                                                          
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Compliance Override Reason"/>  
                            <!--<apex:actionRegion >-->
                                <apex:inputField value="{!case.Compliance_Override_Reason__c}">
                                    <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn" status="compOptIn"/> 
                                </apex:inputField>                  
                            <!--</apex:actionRegion>-->
                        </apex:pageBlockSectionItem> 
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Referral Override/Opt In Comments"/>                
                            <apex:define name="requiredClientFeedback">
                                <div class="requiredInput">
                                    <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                                    <div class="requiredBlock" style="{!IF(OR(case.Compliance_Opt_In__c,case.Compliance_Override_Reason__c != null,case.Referral_Opt_In__c!=null),'background-color:C00','background-color:transparent')}"></div>     
                                    <apex:inputField value="{!case.Compliance_Override_Comments__c}" style="width:300px;height:45px"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        <!-- For CMI 2015 Iteration 3, rendered condition is added as this field should be rendered only for cases created prior to Iteration 3-->                            
                        <apex:pageBlockSectionItem rendered="{!case.createddate <rel3DeploymentDateValue}"> 
                            <apex:outputLabel value="Compliance Opt In" rendered="{!case.createddate <rel3DeploymentDateValue}"/>
                            <apex:inputCheckbox value="{!case.Compliance_Opt_In__c}" rendered="{!case.createddate <rel3DeploymentDateValue}">
                                <apex:actionSupport event="onclick" rerender="complianceOverrideOptIn" status="compOptIn"/> 
                            </apex:inputCheckbox>                            
                        </apex:pageBlockSectionItem>                                               
                    </apex:pageBlockSection>
                    <!--Start changes for CMI 2015 Iteration 3-->
                    <apex:pageblocksection columns="1" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                        <apex:pageBlockSectionItem rendered="{!case.createddate >= rel3DeploymentDateValue}"> 
                            <apex:outputLabel value="Referral Opt In" rendered="{!case.createddate >= rel3DeploymentDateValue}"/>
                            <apex:inputField value="{!case.Referral_Opt_In__c}" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                                <!--For CMI 2016 April Release referralButton is added in rerender attribute-->
                                <!--Close Case Panel has been removed as a part of CMI April 2019 release. To avoid clearing fields in close case section when referral optin is changed-->
                                <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn,Comments,referralButton,FunctionalArea" status="compOptIn" action="{!checkOptInAndNullifyReferralDisposition}"/> 
                            </apex:inputField>                            
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                    
                    
                    <!--End changes for CMI 2015 Iteration 3-->
                    
                </apex:actionRegion>            
                <!--End changes for for CMI 2014 Release 2-->
                
                <apex:actionStatus id="compOptIn">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                
                <apex:pageBlockSection id="overallReview" columns="2">
                    <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!case.Compliance_Opt_In__c}"/>
                    <!--Start changes for CMI 2015 Iteration 2-->
                    <apex:outputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!!case.Compliance_Opt_In__c}"/>                    
                    <!--End changes for CMI 2015 Iteration 2-->
                    <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:500px;height:140px;" required="{!case.CL_Exception_Review_Disposition__c='Pending Review'}"  rendered="{!case.createddate < rel3DeploymentDateValue}"/>
                </apex:pageBlockSection>
                                                
                <apex:pageBlockSection id="CLInvestigation" columns="2">
                    <apex:inputField value="{!case.C_L_Investigation_Disposition__c}"/>
                    <apex:inputField value="{!case.C_L_Investigation_Comments__c}" style="width:500px;height:140px;"  rendered="{!case.createddate < rel3DeploymentDateValue}"/>
                </apex:pageBlockSection>
                
                                
                <!--Start Changes for CMI 2014-->
                <!--<apex:outputPanel rendered="{!IF((case.createddate <7/22/2015 4:57 AM),true,false))}">-->
                <apex:outputPanel rendered="{!case.createddate <rel3DeploymentDateValue}">
                <apex:actionRegion >    
                    <apex:pageBlockSection id="depositInvestigation" columns="2">
