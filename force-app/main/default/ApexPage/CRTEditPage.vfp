                <br/>
                
                <apex:actionStatus id="VerifyClientStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                            <span class="waitingDescription">Verifying.Please wait...</span>
                        </div>
                    </apex:facet>
                </apex:actionStatus> 
                <apex:outputPanel id="CRSFields">
                    <apex:pageBlockSection columns="2" rendered="{!(case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')||((case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone')&& !case.BypassSearchProcess__c)}">
                        <apex:outputField value="{!case.Wholesale_Account_Name__c}" rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}"/>
                        <apex:outputField value="{!case.RelationshipManager__c}" rendered="{!case.RelationshipManager__c != null && case.RelationshipManager__c != ''}"/>   
                        <apex:outputField value="{!case.Rel_Mgr__c}" rendered="{!case.Rel_Mgr__c != null && case.Rel_Mgr__c != ''}"/>                   
                        <apex:outputField value="{!case.CRS_Client_or_Prospect__c}" rendered="{!case.CRS_Client_or_Prospect__c != null && case.CRS_Client_or_Prospect__c != ''}"/>
                        <apex:outputField rendered="{!case.Region__c <> null}" value="{!case.Region__c}" />
                        <apex:outputField rendered="{!case.LOB__c <> null}" value="{!case.LOB__c}" />
                        <apex:outputField rendered="{!case.Sub_LOB__c <> null}" value="{!case.Sub_LOB__c}" />
                        <!--<apex:inputField rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}" value="{!case.Individual_On_Behalf_Of_Entity__c}" />                        
                        <apex:inputField rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}" value="{!case.WHL_Reference_Application_Date__c}" />-->                        
                    </apex:pageBlockSection>
                    <apex:pageBlockSection columns="2" rendered="{!(case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone')&& case.BypassSearchProcess__c}">
                        <apex:outputField value="{!case.BypassSearchProcess__c}"/>
                        <apex:pageBlockSectionItem >    
                            <!-- Start changes for CMI 2014 Release 3 -->
                            <apex:outputlabel value="Reason for Bypass"/>
                            <!-- End changes for CMI 2014 Release 3 -->
                            <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                        </apex:pageBlockSectionItem>
                        <apex:outputField value="{!case.Contact_Name__c}"/>
                        <apex:outPutField value="{!case.Contact_Phone__c}"/>
                        <apex:outputField value="{!case.Is_this_a_Wholesale_Client__c}"/>
                        <apex:outputField value="{!case.Individual_On_Behalf_Of_Entity__c}"/>
                        <apex:outputField value="{!case.WHL_Reference_Application_Date__c}"/>
                    </apex:pageBlockSection>
                </apex:outputPanel>
                <apex:actionStatus id="LOBDetailStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                </apex:actionStatus>
            </apex:outputpanel>
