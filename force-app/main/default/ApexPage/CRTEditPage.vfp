                        </apex:pageBlockSectionItem>
                        <!--For CMI 2014 Release 3, the Investigation Comments field is rendered as required even if the corresponding Investigation Disposition field is 'Exception'-->
                        <!--<apex:inputField value="{!case.PWM_Investigation_Comments__c}" style="width:300px;height:45px" required="{!case.PWM_Exception_Disposition__c='Investigation Required' || case.PWM_Exception_Disposition__c='Pending Review' || case.PWM_Investigation_Disposition__c='Exception'}"/>-->
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="PWM Investigation Comments"/>                   
                        <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(OR(case.PWM_Exception_Disposition__c='Investigation Required',case.PWM_Exception_Disposition__c='Pending Review',case.PWM_Investigation_Disposition__c='Exception'),'background-color:C00','background-color:transparent')}"></div>       
                                        <apex:inputField value="{!case.PWM_Investigation_Comments__c}" style="width:300px;height:45px" />
                                  </div>
                                </apex:define>
                        </apex:pageBlockSectionItem> 
                    </apex:pageBlockSection>
                        
                    <!--Start changes for for CMI 2014 Release 3-->
                    <apex:pageBlockSection id="Wholesale" columns="2">
                        <apex:pageBlockSectionItem helptext="HIPAA Health Insurance Portability, Reg H Flood Biggert-Waters, Reg Y Appraisal FIRREA"> 
                            <apex:outputLabel value="WHL Investigation Disposition"/>
                            <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF((case.WHL_Exception_Disposition__c='Investigation Required'||case.WHL_Exception_Disposition__c='Pending Review')&& $ObjectType.Case.fields.WHL_Investigation_Disposition__c.Updateable,'background-color:C00','background-color:transparent')}"></div>                                                                                 
                            <!--<apex:actionRegion >-->    
                                            <apex:inputField value="{!case.WHL_Investigation_Disposition__c}" >
                                                <apex:actionSupport event="onchange" reRender="Wholesale,RegLaw,RegLawLabel" status="RegLawStatus4"/>
                                            </apex:inputField>
                            <!--</apex:actionRegion>-->
                                        </div>
                            </apex:define>                                                                                                                                             
                            
                        </apex:pageBlockSectionItem>
                        <!--<apex:inputField value="{!case.WHL_Investigation_Comments__c}" style="width:300px;height:45px" required="{!case.WHL_Exception_Disposition__c='Pending Review' || case.WHL_Investigation_Disposition__c='Exception'}"/>-->
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="WHL Investigation Comments"/>                   
                        <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(OR(case.WHL_Exception_Disposition__c='Investigation Required',case.WHL_Exception_Disposition__c='Pending Review',case.WHL_Investigation_Disposition__c='Exception'),'background-color:C00','background-color:transparent')}"></div>       
                                        <apex:inputField value="{!case.WHL_Investigation_Comments__c}" style="width:300px;height:45px" />
                                  </div>
                                </apex:define>
                        </apex:pageBlockSectionItem> 
                    </apex:pageBlockSection>
                </apex:actionRegion>
                </apex:outputPanel>                                                    
                <!--End changes for for CMI 2014 Release 3-->
                 
                 <apex:actionStatus id="RegLawStatus4">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                </apex:actionStatus>    
                <!--End changes for for CMI 2014 Release 3-->
                                
                
                <!--Start changes for CMI 2014 Release 3-->
                                
                    <apex:pageBlockSectionItem rendered="{!case.createddate <rel3DeploymentDateValue}">
                         <apex:outputPanel id="RegLawLabel">
                        <apex:outputLabel value="Reg/Law Potential Exception" for="RegLawField"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="RegLaw">                   
                            <apex:inputField id="RegLawField" value="{!case.Reg_Law_Potential_Exception__c}" required="{!case.Deposit_Others_Investigation_Disposition__c='Exception' || case.Fair_Banking_Investigation_Disposition__c='Exception' || case.Fair_Credit_Investigation_Disposition__c='Exception' || case.Lending_Saving_Investigation_Disposition__c='Exception' || case.Mortgage_CL_Investigation_Disposition__c='Exception' || case.SCRA_Investigation_Disposition__c='Exception' || case.PWM_Investigation_Disposition__c='Exception' || case.WHL_Investigation_Disposition__c='Exception' }"/>
                        </apex:outputPanel>                   
                    </apex:pageBlockSectionItem>
                
                <!--End changes for CMI 2014 Release 3-->
                 <apex:outputPanel rendered="{!case.createddate >=rel3DeploymentDateValue}">
                 <apex:pageBlockSectionItem rendered="false" >
                         <apex:outputPanel id="RegLawLabel">
                        <apex:outputLabel value="Compliance Referral:Reg/Law Trigger: " for="RegLawField1"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="RegLaw">                   
                            <!--<apex:outputField id="RegLawField1" value="{!case.Compliance_Referral_Reg_Law_Trigger__c}"/>-->
                            <apex:outputText escape="false" value="{!SUBSTITUTE(case.Compliance_Referral_Reg_Law_Trigger__c,';','<br/>')}"/>
                        </apex:outputPanel>                   
                    </apex:pageBlockSectionItem>
                    </apex:outputPanel>
                    <!--<apex:pageBlockSectionItem >
                         <apex:outputPanel id="RegLawLabel">
                        <apex:outputLabel value=" ComplianceSMEReviewTrigger" for="RegLawField1"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="RegLaw">                   
                            <apex:outputField id="RegLawField1" value="{!case.Compliance_Referral_Reg_Law_Trigger__c}"/>
                            <apex:inputField value="{!case.ComplianceSMEReview_Reg_Law_Trigger__c}"/>
                        </apex:outputPanel>                   
                    </apex:pageBlockSectionItem>-->
                    
                    <apex:inputField value="{!case.ComplianceSMEReview_Reg_Law_Trigger__c}" rendered="false"/>
                    <apex:inputField value="{!case.Reg_Law_Risk_SME_Review_Completed__c}" rendered="false"/>
                    <apex:inputField value="{!case.Compliance_SME_Review_No_Reg_Law_Trigger__c}" rendered="false"/>
                     
                     <!--<apex:pageBlockSectionItem >
                         <apex:outputPanel id="RegLawLabel">
                        <apex:outputLabel value=" SMEReviewCompleted" for="RegLawField1"/>
                        </apex:outputPanel>
                        <apex:outputPanel id="RegLaw">-->                   
                            <!--<apex:outputField id="RegLawField1" value="{!case.Compliance_Referral_Reg_Law_Trigger__c}"/>-->
                            <!--<apex:inputField value="{!case.Reg_Law_Risk_SME_Review_Completed__c}"/>
                        </apex:outputPanel>                   
                    </apex:pageBlockSectionItem>--> 
                
            </apex:pageBlockSection>
            <!--end of "ComplianceEvaluationSummary"-->
            <!--End Changes for CMI Pilot-->
            
            <apex:actionStatus id="RegLawStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>    <!--end of "ComplianceEvaluationSummary"-->
            <!--End Changes for CMI Pilot-->
            
            <!--Start Changes for CMI 2014 break/fixes-->
            <!--New section added for CMI 2014 break/fixes-->
           <!-- <apex:pageBlockSection title="Legacy Fields" id="legacyFieldsSection">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel style="font-weight:bold" value="C&L Exception Review Disposition"/>
                    <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}" />
                </apex:pageBlockSectionItem>-->
                
                <!--dataStyle attribute removed for CMI 2014-->
               <!-- <apex:pageBlockSectionItem >
                    <apex:outputLabel style="font-weight:bold" value="C&L Exception Review Comments"/>-->
                <!--Commented for CMI 2014-->
                <!--</apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem dataStyle="float:left">-->
              <!--      <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:300px;height:45px;"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>-->
            <!--End Changes for CMI 2014 break/fixes-->
            
            <!--Start Changes for 2017 feb release-->
            <!--When closing a case no pop up should appear-->
            <!--Start Changes for CMI 2014-->
            <!--<apex:outputPanel id="caseStatusSummaryPopup">
                <apex:outputPanel styleClass="popupBackground" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}"/>
                <apex:outputPanel styleClass="custPopup" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}">
                    <div align="center" style="height:70%">
                        <apex:outputText style="font-weight:800;" value="{!messageBody}"/>
                    </div>
                    <div style="height:35%">
                        <apex:actionRegion >
                            <apex:commandButton style="margin-left:45%" value="OK" action="{!closeCaseStatusSummaryPopup}" reRender="caseStatusSummaryPopup"/>
                        </apex:actionRegion>
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>-->
            <!--End Changes for CMI 2014-->
            <!--End Changes for 2017 feb release-->
            
            <br/>                
            <!--Start changes for CMI 2015 Release 3-->
            <apex:actionRegion >
                <apex:outputPanel rendered="{!case.createddate >=rel3DeploymentDateValue}">
                                            
                <apex:outputPanel id="referrals">
        
                <div style="margin-Left:2%">
                    <apex:outputText Style="font-weight:bold;color:red" value="Reminder: As each reg/law SME review is completed, the Compliance SME Review Comments should be updated with review findings."/>
                </div>
                <br/>
               
                <apex:pageBlockTable value="{!assignComplianceReferralRecord}"   var="CR">
          
                      <apex:column headerValue="Delete">               
                          <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" />                                                      
                          <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && !$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" disabled="true"/>                            
                      </apex:column>  
                    
                      <apex:column id="RegLaw" headerValue="Reg/Law" >
                          <apex:outputText value="{!CR.assignRegLawName}" rendered="{!CR.assignRegLawName!=null && CR.assignRegLawName!=''}"/>                          
                          <apex:selectList value="{!CR.assignRegLawName}" multiselect="False"
                                                size="1"  rendered="{!CR.assignRegLawName=null || CR.assignRegLawName=''}" >
                                                <apex:selectOptions value="{!regLawValues}" />
                                                <apex:actionSupport event="onchange" action="{!actionOnRegLaw}" status="ReferralStatus" reRender="referrals"/>
                          </apex:selectList> 
                      </apex:column>
                                                        
                      <apex:column id="SMENeeded" headerValue="SME Review Needed?">                                        
                          <apex:outputText value="{!CR.assignSMEReviewNeeded}"  rendered="{!!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                              <apex:define name="requiredSelectAccount">
                                  <div class="requiredInput">
                                      <div class="requiredBlock"></div>                            
                                      <apex:selectList multiselect="false" size="1" value="{!CR.assignSMEReviewNeeded}" rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName!='No Reg/Law Exception Found'}" >                
                                          <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                          <apex:selectOption itemValue="No" itemLabel="No"/>
                                          <apex:selectOption itemValue="Yes" itemLabel="Yes"/>                                                                     
                                      </apex:selectList>
                                  </div>
                              </apex:define>                                                          
                      </apex:column>
                  
                       <apex:column headerValue="Reg/Law Exception">
                          <apex:outputText value="{!CR.assignRegLawExceptionValue}"  rendered="{!!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                                                    
                      
                          <apex:outputPanel rendered="{!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName!='No Reg/Law Exception Found'}">
                                    
                              <apex:selectList multiselect="false" size="1" value="{!CR.assignRegLawExceptionValue}" > 
                                  <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                  <apex:selectOption itemValue="Exception" itemLabel="Exception"/>
                                  <apex:selectOption itemValue="NoException" itemLabel="No Exception"/>
                                  <apex:actionSupport event="onchange" action="{!actionOnRegLawException}" status="ReferralStatus" reRender="referrals"/>                    
                              </apex:selectList>
                          
                          </apex:outputPanel>
                          
                          
                      </apex:column>                  
                  
                      <apex:column headerValue="SME Review Completed">                        
                          <apex:inputCheckbox value="{!CR.assignSMEReviewCompleted}" disabled="true"/>                                                                                                                                        
                      </apex:column>                                                            
                                                 
                  </apex:pageBlockTable>
                  
                  
                  <!--Start changes for CMI 2016 April Release-->                  
                  <apex:outputPanel id="referralButton">
                      <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name='Compliance & Risk Specialist' && !disableAddButtonValue && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')) && (case.CE_Submission_Reassignment__c==case.CE_Submission_Process__c || case.CE_Submission_Reassignment__c==null)}">
                          <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="ReferralStatus"/>                
                          <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                      </apex:outputPanel>
            
                      <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name!='Compliance & Risk Specialist' && !disableAddButtonValue && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')) && (case.CE_Submission_Reassignment__c==case.CE_Submission_Process__c || case.CE_Submission_Reassignment__c==null)}">
                          <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="reassignment,reassignment1,ReferralStatus"/>                
                          <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="reassignment,reassignment1,ReferralStatus"/>
                      </apex:outputPanel>
            
                      <apex:outputPanel rendered="{!!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable ||((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) && !((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')}">
                          <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                          <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                      </apex:outputPanel>
                                            
                      
                      <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name!='Compliance & Risk Specialist'}">
                          <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                          <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="ReferralStatus"/>
                      </apex:outputPanel>
                      
                      <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name='Compliance & Risk Specialist'}">
                          <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                          <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                      </apex:outputPanel>
                      
                      <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && (case.CE_Submission_Reassignment__c!=case.CE_Submission_Process__c && case.CE_Submission_Reassignment__c!=null )}">
                              <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                              <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                      </apex:outputPanel>
                  </apex:outputPanel>
                  <!--End changes for CMI 2016 April Release--> 
             <apex:pageBlockSection id="reassignment"  rendered="{!assignComplianceReferralRecord.size==0}">
                   <apex:pageBlockSectionItem >
                     <apex:outputPanel > 
                         <apex:pageblocksection >
                             <apex:pageBlockSectionItem >
                                 <apex:outputLabel value="CE Submission Reassignment"  style="display:block;width:150px;font-weight:bold; font-size:11px"/>
                                 <apex:inputField value="{!case.CE_Submission_Reassignment__c}"  >
                                     <apex:actionsupport event="onchange" reRender="referralButton" status="compOptIn"/>
                                 </apex:inputfield>
                             </apex:pageBlockSectionItem>
                          </apex:pageblocksection>
                      </apex:outputPanel>
                      </apex:pageBlockSectionItem>                     
             </apex:pageblocksection> 
             
            <apex:pageBlockSection id="reassignment1"  rendered="{!assignComplianceReferralRecord.size != 0}" >
                   <apex:pageBlockSectionItem >
                     <apex:outputPanel > 
                         <apex:pageblocksection >
                             <apex:pageBlockSectionItem >
                                 <apex:outputLabel value="CE Submission Reassignment"  style="display:block;width:150px;font-weight:bold; font-size:11px"/>
                                 <apex:outputField value="{!case.CE_Submission_Reassignment__c}"  />
                             </apex:pageBlockSectionItem>
                          </apex:pageblocksection>
                      </apex:outputPanel>
                   </apex:pageBlockSectionItem>                     
            </apex:pageblocksection>

                  
                  
              </apex:outputPanel>
          </apex:outputPanel>
         
       
         <apex:actionStatus id="ReferralStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
        </apex:actionRegion>
        
        <!--Start changes for april changes 2017-->
        <!--Added Ce submission Reassignment field-->
        
      <!--  <apex:pageBlockSection >
            <apex:pageBlockSectionItem >
                <apex:outputpanel >
                    <apex:pageblocksection >
                        <apex:pageblocksectionitem >
                            <apex:outputLabel value="CE Submission Reassignment" style="display:block;width:150px;font-weight:bold; font-size:11px"/>
                            <apex:inputField value="{!case.CE_Submission_Reassignment__c}" />
                        </apex:pageblocksectionitem>
                    </apex:pageblocksection>
                </apex:outputpanel>
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>  -->
        <!--End changes for april changes 2017-->
        
        
        <apex:pageBlockSection id="Comments" columns="2" rendered="{!case.createddate >= rel3DeploymentDateValue}">
            <apex:pageBlockSectionItem >
            <apex:outputpanel >
            <apex:pageblocksection columns="1">
            <apex:pageblocksectionitem >
                <apex:outputLabel value="Compliance Referral Comments" style="display:block;width:150px;font-weight:bold; font-size:11px" />
                <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:375px;height:140px;font-size:12px;" required="{!case.CL_Exception_Review_Disposition__c='Investigation Required' || case.CL_Exception_Review_Disposition__c='No Investigation Required' ||  case.CL_Exception_Review_Disposition__c='Pending Review' || case.Referral_Opt_In__c='Monitoring Review'}" />
            </apex:pageblocksectionitem>
            </apex:pageblocksection>
            </apex:outputpanel>
           </apex:pageBlockSectionItem>
           
           <apex:pageBlockSectionItem >
            <apex:outputpanel >
            <apex:pageblocksection columns="1">
            <apex:pageblocksectionitem >
                <apex:outputLabel value="Compliance SME Review Comments" style="display:block;width:150px;" />
                <apex:inputField value="{!case.C_L_Investigation_Comments__c}" style="width:380px;height:140px;" />
            </apex:pageblocksectionitem>
           </apex:pageblocksection>
            </apex:outputpanel>    
            </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <!--Start April 2017--> 
            <apex:actionRegion >    
                <apex:pageblocksection >
                    <apex:pageBlockSectionItem >
                        <apex:outputPanel >
                            <apex:pageblocksection >
                                <apex:pageblocksectionItem >
                                    <apex:outputLabel value="Compliance Review: Case Quality" style="display:block;width:143px;" />
                                    <apex:inputField value="{!Case.Compliance_Review_Case_Quality__c}" styleClass="myMultiClass">
                                        <apex:actionSupport event="onchange" rerender="QualityCommentsField" status="QualityFields"/>
                                    </apex:inputField>
                                </apex:pageblocksectionItem>
                           </apex:pageblocksection>
                        </apex:outputPanel>                 
                   </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
            
                <apex:pageblocksection id="QualityCommentsField" columns="2" >   
                 <apex:pageBlockSectionItem >
                     <apex:outputPanel >
                         <apex:pageblocksection Columns="1">
                             <apex:pageblocksectionItem >
                                    <apex:outputLabel value="Compliance Review: Case Quality Comments" style="display:block;width:143px;" />
                                    <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                                <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                                            <div class="requiredBlock" style="{!IF(OR(case.Compliance_Review_Case_Quality__c!=null),'background-color:C00','background-color:transparent')}"></div>
                                                <apex:inputField value="{!case.Compliance_Case_Comments__c}" style="width:380px;height:140px;"  />
                                        </div>
                                    </apex:define>
                              </apex:pageblocksectionItem>
                          </apex:pageblocksection>
                     </apex:outputPanel>                 
                 </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                <apex:actionStatus id="QualityFields">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
               </apex:actionStatus> 
           </apex:actionRegion>
               <!--End April 2017--> 
               
               
           <!--Start Changes for april 2017 release-->
           <!--Added rendered condition as the SunTrust Impact Identified By Compliance field should appear only for old cases--> 
            <apex:pageBlockSection rendered="{!case.createddate < april2017DeploymentDateValue && case.SunTrust_Impact_Identified_By_Compliance__c!=null}">
                <apex:pageBlockSectionItem >
                      <apex:outputPanel >
                      <apex:pageblocksection >
                      <apex:pageblocksectionItem >            
                        <apex:outputLabel value="SunTrust Impact Identified By Compliance" style="display:block;width:143px;" />
                        <apex:inputField value="{!case.SunTrust_Impact_Identified_By_Compliance__c}"  />
                     </apex:pageblocksectionItem>
                     </apex:pageblocksection>
                     </apex:outputPanel> 
                </apex:pageBlockSectionItem>
            
            </apex:pageBlockSection>          
            <!--End Changes for april 2017 release-->
                    
        <!--End changes for CMI 2015 Release 3--> 
        <!-- Start changes for Feb 2016 Monthly release -->
        <!-- Start changes for Feb 2017 Monthly release -->
        <apex:actionRegion >
        <apex:pageBlockSection id="exempt" columns="2" title="System Assigned fields">                                
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="{!$ObjectType.Case.fields.Exempt_from_CPR_Reporting__c.label}"/>
                
                    <apex:inputField value="{!case.Exempt_from_CPR_Reporting__c}">
                        <apex:actionSupport event="onchange" status="exemptStatus" action="{!exemptFromCAOReportingOverriden}" rerender="exempt,exempt1"/>
                    </apex:inputField>                
            </apex:pageBlockSectionItem>
            
            <apex:pageBlockSectionItem >
            <!--<apex:outputLabel value="ByPass Validation"/>
            <apex:inputcheckbox value="{!case.Bypass_Validation__c}"/>-->
            </apex:pageBlockSectionItem>
                           
            <apex:pageBlockSectionItem id="exemptOverrideForCheck">
                    <apex:outputLabel value="Mandated ACK SLA Met Override" />
                    <apex:inputField value="{!case.Mandated_ACK_SLA_Met__c }">
                        <apex:actionSupport event="onchange" action="{!exemptFromCAOReportingOverridenforACKOverride}" status="exemptStatus" rerender="exempt,exempt1"/>
                    </apex:inputField>
             </apex:pageBlockSectionItem>
                
              <apex:pageblocksectionItem ></apex:pageblocksectionItem> 
                
                <apex:pageBlockSectionItem id="exemptOverrideForResponse">
                    <apex:outputLabel value="Mandated Response SLA Met Override" />
                    <apex:inputField value="{!case.Mandated_Response_SLA_Met_Override__c}">
                        <apex:actionSupport event="onchange" action="{!exemptFromCAOReportingOverridenforRESPoverride}"  status="exemptStatus" rerender="exempt,exempt1"/>
                    </apex:inputField>
                </apex:pageBlockSectionItem>  
                
                      
            </apex:pageBlockSection>
            
            <apex:pageblocksection columns="1" id="exempt1">
             <apex:pageBlockSectionItem id="exemptOverride">
                    <apex:outputLabel value="{!$ObjectType.Case.fields.Exempt_from_CAO_Reporting_Override__c.label}" rendered="{!((assignDisplayExemptOverride)|| (assignDisplayExemptOverrideforACKoverride) || (assignDisplayExemptOverrideforRESPoverride))|| ((case.Exempt_from_CAO_Reporting_Override__c != null && case.Exempt_from_CAO_Reporting_Override__c != '')) || ((case.Exempt_from_CAO_Reporting_Override__c == null || case.Exempt_from_CAO_Reporting_Override__c == '') && (previousValueForExempt))}" />
                    <apex:define name="requiredInputDiv"> 
                        <div class="requiredInput"> 
                            <div class="requiredBlock"></div>
                                <apex:inputField value="{!case.Exempt_from_CAO_Reporting_Override__c}" rendered="{!((assignDisplayExemptOverride)|| (assignDisplayExemptOverrideforACKoverride) || (assignDisplayExemptOverrideforRESPoverride))|| ((case.Exempt_from_CAO_Reporting_Override__c != null && case.Exempt_from_CAO_Reporting_Override__c != '')) || ((case.Exempt_from_CAO_Reporting_Override__c == null || case.Exempt_from_CAO_Reporting_Override__c == '') && (previousValueForExempt))}"  style="width:1000px" />
                       </div>
                    </apex:define>
            </apex:pageBlockSectionItem>
            </apex:pageblocksection>  
            
            </apex:actionRegion>
            
            <apex:pageBlockSection id="activeSupplier">
                <apex:outputField rendered="false" value="{!case.Vendor_Search__r.Active_Inactive__c}"/>
            </apex:pageBlockSection>
            
        <apex:actionStatus id="exemptStatus">
            <apex:facet name="start">
                <div style="text-align:center;">
                    <img src="{!$Resource.SpinIcon}"/>
                </div>
            </apex:facet>
        </apex:actionStatus>
        <!-- End changes for Feb 2016 Monthly release -->                                 
      </apex:pageBlock>       
     <!--<apex:inputField value="{!case.Resolution_Comments__c }" rendered="false"/>
     <apex:inputField value="{!Case.Client_Feedback__c }" rendered="false"/>         -->
    </apex:form>
    
    <!--Start Changes for CMI 2014-->
    <style type="text/css">
        .custPopup{
            background-color: white;
            border-width: 2px;
            border-style: solid;
            z-index: 9999;
            left: 35%;
            padding:1%;
            position: fixed;
            width: 58%;
            margin-left: -15%;
            top:45%;
            height:11%;
        }
        .popupBackground{
            background-color:black;
            opacity: 0.20;
            filter: alpha(opacity = 20);
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 9998;
        }
    </style>
    <!--End Changes for CMI 2014-->
    
   
</apex:page>