            <apex:pageBlockSection id="refund" title="Resolution Details"> <!--id attribute in pageBlockSection added for CMI 2014 break/fixes-->
                <!--For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
                <apex:pageblocksectionitem >
                    <apex:outputlabel value="Relief Provided?"/>
                    <apex:actionRegion > 
                        <apex:inputField value="{!case.Refund__c}"
                            rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                            <apex:actionSupport event="onchange" reRender="refund,typeOfRelief" status="resolutionDetailsStatus" /> 
                        </apex:inputField> 
                    </apex:actionRegion> 
                </apex:pageblocksectionitem>
                
                <apex:outputField value="{!case.Refund__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />

                <apex:inputField value="{!case.Remediation__c}"
                     required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                <apex:outputField value="{!case.Remediation__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,case.Refund__c='Closed With Monetary Relief')}" />
                
                <!--For CMI 2015 Iteration2 the below field is rendered for Non-Monetary Relief also-->
                <!--start changes for CMI 2016 October release-->
                <!--<apex:inputField value="{!case.Type_of_Refund__c}"
                    required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                <!--<apex:outputField value="{!case.Type_of_Refund__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Monetary Relief'))}" />
               <br/><apex:inputField value="{!case.Type_of_Refund__c}"
                    required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Non-Monetary Relief' ,case.Refund__c='Closed With Explanation'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                <!--<apex:outputField value="{!case.Type_of_Refund__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Non-Monetary Relief' ,case.Refund__c='Closed With Explanation'))}" />-->
                <!--end changes for CMI 2016 October release-->
            
            </apex:pageBlockSection>
            
            <apex:pageBlockSection id="typeOfRelief" columns="1">
                <apex:inputField value="{!case.Type_of_Refund__c}"
                    required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->                
                <apex:outputField value="{!case.Type_of_Refund__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Monetary Relief' , case.Refund__c='Monetary Relief'))}" />
                <apex:inputField value="{!case.Type_of_Refund__c}"
                    required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Refund__c='Closed With Non-Monetary Relief' , case.Refund__c='Non-Monetary Relief'))}"/> <!-- Refund__c is added in rendering condition and Required attribute added for CMI 2014 break/fixes in input and output fields-->        
                 <apex:inputField value="{!case.Type_of_Refund__c}"
                    required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Refund__c='Closed With Explanation')}"/>            
                <apex:outputField value="{!case.Type_of_Refund__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Refund__c='Closed With Non-Monetary Relief' , case.Refund__c='Non-Monetary Relief' ,case.Refund__c='Closed With Explanation'))}" />   
            </apex:pageBlockSection>
            
            <apex:pageBlockSection id="rootCauseRenderPanel">
                <!--Start Changes for CMI 2014-->
                <!--Commented for CMI 2014 because Root Cause Details needs to be rendered according to this field values-->
                <!--<apex:inputField value="{!case.Root_Cause__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />-->
                <!--<apex:pageBlockSectionItem >
                    <apex:outputlabel value="Root Cause" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"/>
                    <apex:actionRegion >-->
                        <apex:inputField value="{!case.Root_Cause__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}"  id="id3" onchange="hidefieldsrootCauseDetail();"/>
                            <!--<apex:actionSupport event="onchange" reRender="rootCauseDetails" status="closeCaseDetailsStatus"/>
                    </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>-->
                <!--End Changes for CMI 2014-->
                
                <apex:outputField value="{!case.Root_Cause__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />

            </apex:pageBlockSection>
            
            
            
            <!--Start Changes for CMI 2014-->
            <apex:pageBlockSection id="rootCauseDetails" columns="1">
                <!--<apex:pageBlockSectionItem >
                    <apex:outputlabel value="Root Cause Detail" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist), OR(case.Root_Cause__c='SunTrust Impact',case.Root_Cause__c='Non SunTrust Impact') )}"/>-->
                    <!--This field is rendered for the values of Root Cause when "Case Type is Service Request" or "Case Type is Complaint and Case Designation Type is Tier 2 or Tier 3".-->
                    <!--Since it is only rendered for some of the values of Root Cause, so the conditions "Case Type is Service Request" or "Case Type is Complaint and Case Designation Type is Tier 2 or Tier 3" are not checked.-->
                    <apex:inputField value="{!case.Root_Cause_Detail__c}"  rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <!--</apex:pageBlockSectionItem>-->
            </apex:pageBlockSection>
            <apex:outputField value="{!case.Root_Cause_Detail__c}" rendered="{!AND((CRTQualityAssuranceSpecialist),OR(case.Root_Cause__c='SunTrust Impact',case.Root_Cause__c='Non SunTrust Impact'), case.Status = 'Closed' )}"/>
            
            <apex:pageBlockSection columns="2">
            
                <apex:inputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />

                <!--Start changes for CMI 2016 April release -->    
