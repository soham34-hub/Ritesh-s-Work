
<apex:page standardController="Case" action="{!retrieveArrangementSummariesList}"  extensions="CRTEdit_ControllerExtension,CMIClientManagement_ControllerExtension,CategoryLists_ControllerExtension" id="id1">
    <apex:messages style="color:red;font-weight:bold;" />
    
    <script type="text/javascript" >
    
    var originalOnload = window.onload;
   window.onload = f1;
   
   function f1() 
        {
            originalOnload();
            if(document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Non SunTrust Impact')
            { 
                document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='none';
            }         
        }  
    
    function hidefieldsrootCauseDetail()
        {
         
        if(document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseRenderPanel.id3}').value=='Non SunTrust Impact')
             {
                 
                 document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='none';
             }
             else
             {
                 document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.rootCauseDetails}').style.display='block';
             }
        }
        
        <!--start changes for CMI 2016 December release-->
        <!--Complaint From or About A Supplier is nullified on selecting supplier search-->
        function vendorsearch()
         {
             document.getElementById('{!$Component.id1.CRTEditForm.CRTPage.clientFeedbackDetails.SupplierBlock.Field}').value='';      
         }
         
        <!--End changes for CMI 2016 December release-->
        function noenter(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:CRTEditForm:CRTPage:fbcat:catButton:catSearchButton');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
        
    </script>
    
    
    <apex:form id="CRTEditForm">
        <apex:outputField value="{!case.Cat_Ref_Name__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_1__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_2__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_3__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_4__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_5__c}" rendered="FALSE" />
        <apex:outputField value="{!case.CMI_Deleted_case__c}" rendered="FALSE" />
        <apex:outputField rendered="false" value="{!case.Account_For_Open_Cases__c}"/>
        <apex:outputField rendered="false" value="{!case.Account_For_Closed_Cases__c}"/>
        <apex:outputField value="{!case.Product_Code__c}" rendered="FALSE" />
        
        <!-- B-2078 changes for CMI September 2018 Release--> 
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
         <apex:outputField value="{!case.Assign_Select_Account__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.SearchAccNumberValue__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.SearchAccTypeValue__c}" rendered="FALSE"/>
        <!-- End of B-2078 changes for CMI September 2018 Release-->
         
        <!--<apex:actionRegion >-->
        <apex:pageBlock title="MERT Case" mode="edit" id="CRTPage">
                                                            
            <apex:pageBlockButtons location="both">
                <apex:commandButton action="{!save}" value="Save" />
                <apex:commandButton action="{!cancel}" value="Cancel" />
            </apex:pageBlockButtons>

            <!-- *************************************** -->
            <!-- *   C A S E   I N F O R M A T I O N   * -->
            <!-- *************************************** -->

            <apex:pageBlockSection title="Case Information" columns="2" id="pageblockSection_show">

                <apex:inputField value="{!case.CaseNumber}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.CaseNumber}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                <apex:outputField value="{!case.OwnerId}" />
                <!-- ********************************************* -->
                <!-- *   DR-2656 September 2018 monthy Release   * -->
                <!-- ********************************************* -->
                
                 
                <!-- Start Changes for CMI Pilot -->
                <!-- The Case Origin field's visibility on page is controlled by its value -->
                <!-- <apex:inputField value="{!case.Origin}" required="TRUE"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Origin}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" /> -->
                
                <!--For CMI 2014, rendering condition for Case Origin is added to check for CMI. Earlier it only checked for CMI Pilot-->    
                <apex:inputField value="{!case.Origin}" required="TRUE"
                    rendered="{!AND((NOT(CRTQualityAssuranceSpecialist)), case.Origin!='CMI Pilot', case.Origin!='CMI')}"/>   
                
                <!--For CMI 2014, rendering condition for Case Origin is added to check for CMI. Earlier it only checked for CMI Pilot-->
                
                <apex:outputField value="{!case.Origin}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist, case.Origin='CMI Pilot', case.Origin='CMI')}"/>
                <!-- End Changes for CMI Pilot -->
                
                
                <apex:pageBlockSectionItem id="submitterNotRequired"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),case.Call_Source__c!='Internal', case.Call_Source__c!='Mortgage Client Service', case.Call_Source__c!='Private Wealth', case.Call_Source__c!='Legal', case.Call_Source__c!='Retail Branch')}">
                        <c:CustomLookup value="{!Case.Submitter__c}" object="Contact"
                            objectName="Case" fieldName="Submitter__c"
                            displayFields="Email,Title,Phone" />
                    </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem id="submitterRequired"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Internal', case.Call_Source__c='Mortgage Client Service', case.Call_Source__c='Private Wealth', case.Call_Source__c='Legal', case.Call_Source__c='Retail Branch'))}">
                        <c:CustomLookup value="{!Case.Submitter__c}" object="Contact"
                            objectName="Case" fieldName="Submitter__c"
                            displayFields="Email,Title,Phone" required="True" />
                    </apex:pageBlockSectionItem>

                <apex:inputField value="{!case.Case_Association_Type__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Case_Association_Type__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                    
                    <!----Start changes for DR-2656 for September 2018 Release -->
            <apex:inputField value="{!case.Case_Group_Assignment__c}"/>
                    <!----End changes for DR-2656 for September 2018 Release -->
                
            </apex:pageBlockSection>

            <apex:pageBlockSection columns="2">
                                                  
                <apex:outputField value="{!case.Submitter__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />

            </apex:pageBlockSection>
            <!--<apex:actionRegion >-->
                <apex:pageBlockSection >
            
                    <!--Start changes for CMI Pilot-->
                    <!-- Displaying the field Case Type -->
                    <apex:pageblocksectionitem >
                        <apex:outputLabel value="Case Type" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />               
                            <apex:actionRegion >
                                <!--SpecialInitiativeSection is removed from rerender attribute for CMI 2014-->
                                <!--supplierDetailsPanel is added in rerender attribute for CMI 2014 and authorisedThirdParty for CMI 2014.1 break/fixes-->
                                <apex:inputField value="{!case.Type}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="True" >
                                    
                                    <!--For CMI 2014 Release 3 Description is added in the rerender attribute-->
                                    <!--Start Changes for CMI October 2017 Release-->
                                    <apex:actionSupport event="onchange" rerender="MandatedSLADate,supplierDetailsPanel,ReputationalRiskSummary,ComplianceEvaluation,AccountDetails,authorisedThirdParty,clientFeedbackDetails,Description,serviceStandardType,clientFeedbackDetails,clientCaseResponse,SOF,ServicingChallengesReported,servicingInteractionDispositonFields" status="MainStatus" />
                                    <!--End Changes for CMI October 2017 Release-->
                                </apex:inputField>
                            </apex:actionRegion>
                    </apex:pageblocksectionitem>                
                    <!--<apex:inputField value="{!case.Type}"
                        rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> -->
                    <!--End changes for CMI Pilot-->
                    <apex:outputField value="{!case.Type}"
                        rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                     </apex:pageBlockSection>
                                
                <apex:outputPanel id="SOF">
                    <apex:pageBlockSection columns="2"> 
                        <apex:pageBlockSectionItem rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}">
                            <apex:outputlabel value="Source of Feedback" />
                                <apex:actionRegion >
                                    <!--For CMI 2014 Release 3 FRBExtension is added in rerender attribute-->
                                    <apex:inputField value="{!case.Call_Source__c}"  required="True" >
                                        <apex:actionSupport event="onchange" action="{!SourceOfFeedbackChanges}" rerender="SOF,CFPBPanel,agState,FRBExtension,Agency,ClientSectionAfterBypassingSearchClient" status="MainStatus" />
                                    </apex:inputField>
                                </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField value="{!case.Call_Source__c}"  rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                        <apex:inputField value="{!case.AG_State__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Attorney General',case.Call_Source__c='Agency'))}"/>
                       <apex:pageblocksectionitem rendered="{!Case.Call_Source__c='Counseling Agency'}"> </apex:pageBlockSectionItem>
                        <!--Start changes for CMI 2016 December release-->
                        <!--Agency name rendered as required when source of feedback=counseling agency-->
                        <apex:inputField value="{!case.Agency_Name__c}" rendered="{!OR(AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Attorney General',case.Call_Source__c='Agency')),AND(OR(case.Type='Complaint',case.Type='Service Request',case.Type='Tracking Only: Research/Follow Up'), OR(case.Call_Source__c='Agency',case.Call_Source__c='Counseling Agency')))}" required="{!AND(OR(case.Type='Complaint',case.Type='Service Request',case.Type='Tracking Only: Research/Follow Up'), OR(case.Call_Source__c='Agency',case.Call_Source__c='Counseling Agency'))}"/>
                        <!--End changes for CMI 2016 December release-->
                    </apex:pageBlockSection>
                </apex:outputPanel> 
            

                <!-- Start Changes For CMI 2014 Release 2 -->
                <!-- Mandated SLA Date should be displayed as ediatble for few profiles and editable for few.-->
                <apex:pageBlockSection id="MandatedSLADate"  > 
                    <apex:inputField value="{!case.Mandated_SLA_Date__c}" rendered="{!case.Type='Tracking Only: Research/Follow Up'}" required="True"/>
                </apex:pageBlockSection> 
                <!-- End Changes For CMI 2014 Release 2 -->
                
                <!--<apex:outputPanel id="agState" >
                <apex:outputPanel rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Call_Source__c='Attorney General',case.Call_Source__c='Agency'))}">
                 <apex:pageBlockSection >
                    <apex:inputField value="{!case.AG_State__c}"/>-->
                    <!--<apex:outputField value="{!case.AG_State__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />-->
                    <!--<apex:inputField value="{!case.Agency_Name__c}" />-->
                    <!--<apex:outputField value="{!case.Agency_Name__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />-->
                    <!--</apex:pageBlockSection>
                </apex:outputPanel>
                </apex:outputPanel>-->
                                                      
                <apex:pageBlockSection id="serviceStandardType" >    
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Service Standard Type" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> 
                        <apex:actionRegion >                               
                            <apex:inputField value="{!case.Service_Standard_Type__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" required="{!case.Type='Complaint' || case.Type='Service Request'}">
                                <apex:actionSupport event="onchange" rerender="loanInfo" status="MainStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputField value="{!case.Service_Standard_Type__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                   <!-- Start Changes for CMI 2014 Release 3 -->
                   <apex:pageBlockSectionItem rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'),OR(SRDEditable,$Profile.Name =='Written Escalation Workflow Coordinator'))}">
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock" style="{!IF(case.Type='Complaint','background-color:C00','background-color:transparent')}" ></div>
                                <apex:inputField value="{!case.Source_Received_Date_Time__c}" rendered="{!OR(SRDEditable,$Profile.Name =='Written Escalation Workflow Coordinator')}"/>
                            </div>
                        </apex:define>
                
                   </apex:pageBlockSectionItem>
                   
                   <apex:pageBlockSectionItem rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'),NOT(OR(SRDEditable,$Profile.Name =='Written Escalation Workflow Coordinator')))}">  
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!!OR(SRDEditable,$Profile.Name =='Written Escalation Workflow Coordinator')}"/>
                       <!-- ********************************************* -->
                
                    </apex:pageBlockSectionItem>
                        
                    <!--<apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'), MERTManager=false , MERTWorkflowCoordinator=false)}" />-->
                    <!--<apex:inputField value="{!case.Source_Received_Date_Time__c}" rendered="{!AND(OR(case.Type='Complaint', case.Type='Service Request'), OR(MERTManager=true, MERTWorkflowCoordinator=true))}" />-->
                   <!--End Changes for CMI 2014 Release 3 --> 
                
                </apex:pageBlockSection>
            <!--</apex:actionRegion>-->
            <apex:pageBlockSection columns="1">
                <!--<apex:inputField value="{!case.Mandated_SLA_Date__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Mandated_SLA_Date__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                <br />-->
                <!--<apex:inputField value="{!case.Month_Year_Problem_Started__c}" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Month_Year_Problem_Started__c}" rendered="{!OR(CRTQualityAssuranceSpecialist)}" />-->
                
                
                <!--Start Changes for CMI Pilot-->
                
                <!--Start changes for CMI 2014-->
                <!--Special Initiative Section is Commented for CMI 2014-->
                <!--For CMI Pilot, Special Initiative Section is included for Special Initiative field. This field is rendered on the basis of Case Type & Case Origin -->
                <!--<apex:pageBlockSection id="SpecialInitiativeSection" columns="1"> 
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Special Initiatives" rendered="{!(case.Type='Complaint' && case.origin!='CMI Pilot')}"/> 
                            <apex:actionRegion >                           
                                <apex:inputField value="{!case.Special_Initiatives__c}" rendered="{!(case.Type='Complaint' && case.origin!='CMI Pilot')}">
                                    <apex:actionSupport event="onchange" rerender="ComplianceEvaluation,ReputationalRiskSummary" status="MainStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                    </apex:pageBlockSectionItem> 
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel style="margin-left:38px" value="Special Initiatives" rendered="{!(case.Type='Complaint' && case.origin='CMI Pilot')}"/> 
                        <apex:outputField value="{!case.Special_Initiatives__c}" rendered="{!(case.Type='Complaint' && case.origin='CMI Pilot')}"/>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>-->
                
                <!--End changes for CMI 2014-->
                 
               
                <apex:actionStatus id="MainStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                <!--End Changes for CMI Pilot-->

            </apex:pageBlockSection>

            <!-- ******************************************* -->
            <!-- *   C L I E N T   I N F O R M A T I O N   * -->
            <!-- ******************************************* -->
            <!--id attribute added for CMI 2014 break/fixes-->
            <apex:pageBlockSection id="authorisedThirdParty" title="Client Information">
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Client Indicator" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> 
                    <apex:actionRegion >                           
                        <apex:inputField value="{!case.Client_Indicator__c}" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" >
                            <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="thisIsClient,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,authorisedThirdParty,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields" status="MainStatus" />
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <br/>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Is this a client?" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> 
                    <apex:actionRegion >                           
                        <apex:inputField value="{!case.Is_this_a_Client__c}" required="true" rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" >
                            <!--For CMI 2014, ClientFollowUpSection is added in rerender attribute.-->
                            <!--In rerender modalDialog is added for CIS Search in CMI 2014,authorisedThirdParty is added for CMI 2014 break/fixes -->
                            <!--For CMI 2014 Release 2, ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields are added in the rerender attribute-->
                            <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="thisIsClient,ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetails,authorisedThirdParty,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields" status="MainStatus" />
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                
                <!--<apex:inputField value="{!case.Is_this_a_Client__c}" required="TRUE"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />-->
                <apex:outputField value="{!case.Is_this_a_Client__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />
                
                <!--rendered condition added for CMI 2014.1 break/fixes--> 
               <!-- <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}"/>
                <apex:outputField value="{!case.Is_This_An_Authorized_Third_Party__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />
                -->
                <!--Business or personal commented for autopopulation in CIS search for CMI 2014-->
                <!--<apex:inputField value="{!case.Business_or_Personal__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Business_or_Personal__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />-->
                
                <!--rendered condition added for CMI 2014.1 break/fixes--> 
               <!-- <apex:inputField value="{!case.Contact_Name__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Is_this_a_Client__c='No',ANDHi(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}"/>
                <apex:outputField value="{!case.Contact_Name__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />
                -->
                <!--client name commented for autopopulation in CIS search for CMI 2014-->
                <!--<apex:inputField value="{!case.Client_Name__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" />
                <apex:outputField value="{!case.Client_Name__c}"
                    rendered="{!OR(CRTQualityAssuranceSpecialist)}" />-->
                
                <!--rendered condition added for CMI 2014.1 break/fixes--> 
               <!-- <apex:inputField value="{!case.Contact_Phone__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist),OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />
                <apex:outputField value="{!case.Contact_Phone__c}"
                    rendered="{!AND(CRTQualityAssuranceSpecialist,OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='Tracking Only: Misdirected Call',case.Type='Tracking Only: Research/Follow Up'))))}" />
                
                -->
                <!-- Start Changes for CMI Pilot -->
                <!-- <apex:inputField value="{!case.Account_Type__c}"
                    rendered="{!AND(NOT(CRTQualityAssuranceSpecialist))}" /> -->
                <!-- End Changes for CMI Pilot -->
                                
                   
                <!-- Start Changes for CMI Pilot -->
                </apex:pageBlockSection>
                
                <!--Start changes for CIS Search for CMI 2014-->
                <apex:outputPanel id="modalDialog">
                    <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='Yes'}">
                        <!--For CMI 2014 Release 2, the disabled attribute has been added in the below button-->
                        <apex:commandButton style="margin-left:25%" action="{!verifyCISClient}"  immediate="true" value="Verify CIS Client" reRender="nameSearch,cisVerifyResults,jointAccountComponent"  status="VerifyCISClientStatus" rendered="{!(case.Origin='CMI WHL Standalone' || case.Origin='CMI WHL Salesforce') }"/>
                        <!--changes start for JULY 2022: to render CIF Search for Client Indicator = "hST"-->
                        <!--apex:pageBlockSectionItem rendered="{!(case.Is_this_a_Client__c='Yes' && case.Client_Indicator__c = 'hST')}">
                            <apex:commandButton style="margin-left:88%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch,LOBAccountDetailsPanel" value="Search Client" rendered="{!case.Client_Indicator__c = 'hST'}" disabled="{!case.BypassSearchProcess__c && case.Origin!='CMI WHL Standalone' && case.Origin!='CMI WHL Salesforce' && case.Client_Indicator__c != 'hST'}"/>                           
                            -->
                        <!-- Start Changes for CMI 2014 Release 3 -->
                        <!-- A new button is added for Wholesale flow to verify the client in CIS -->
                        
                        <!-- End Changes for CMI 2014 Release 3 -->
                        <!--c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                            <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>
                                -->
                                <!--<div style="text-align:center">
                                <apex:commandButton immediate="true" action="{!hideModalDialog}" reRender="accountSearch,nameSearch" value="Return To Case"/>
                            </div>-->
                            <!--br/>                   
                        </c:Modal_Dialog>
                        </apex:pageBlockSectionItem--> 
                       <!--Amit-->
                        <apex:pageBlockSectionItem rendered="{!(case.Is_this_a_Client__c='Yes' && (case.Client_Indicator__c != '' && case.Client_Indicator__c != Null))}">
                        <apex:commandButton style="margin-left:88%" immediate="true" action="{!showCIFModalDialog}" reRender="accountSearch1,nameSearch,LOBAccountDetailsPanel" value="Search Client" rendered="{!(case.Client_Indicator__c != '' && case.Client_Indicator__c != Null)}" disabled="{!case.BypassSearchProcess__c && case.Origin!='CMI WHL Standalone' && case.Origin!='CMI WHL Salesforce' && case.Client_Indicator__c != 'hBBT'}"/>                           
                        
                        <c:Modal_Dialog id="accountSearch1" visible="{!assignArrangement.assignIsModalOpenCIF}">
                            <c:CIFSearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/> 
                            <br/>                   
                        </c:Modal_Dialog>
                        </apex:pageBlockSectionItem>
                        <!--Amit-->
                        <!--<c:Modal_Dialog id="jointAccountComponent" visible="{!openAccountList}" height="35%" top="30%">
