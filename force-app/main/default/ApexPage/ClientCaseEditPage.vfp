
<!--CMI 2014 Release 2,in the below line CategoryLists_ControllerExtension is added and CodependentLists_ControllerExtension is removed for proper SubmitterCategory and SubmitterSubCategory values while creating Case-->
<apex:page standardController="Case" extensions="ClientCaseEdit_ControllerExtension,CMIClientManagement_ControllerExtension,CategoryLists_ControllerExtension" action="{!retrieveArrangementSummariesList}" id="id1">
    
    <apex:messages style="color:red;font-weight:bold;" />
    
    <script type="text/javascript" >

    var originalOnload = window.onload;
   window.onload = f1;
   
   function f1() 
        {
            originalOnload();
            if(document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='Non SunTrust Impact')
            { 
                document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCauseDetails}').style.display='none';
            }         
        }  
    
    function hidefieldsrootCauseDetail()
        {
         
        if(document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCausePanel.id3}').value=='Non SunTrust Impact')
             {
                 
                 document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCauseDetails}').style.display='none';
             }
             else
             {
                 document.getElementById('{!$Component.id1.editForm.CFSEdit.rootCauseDetails}').style.display='block';
             }
        }
        
        
     function f2()
     {
         document.getElementById('{!$Component.id1.editForm.SMCase.rootCauseDetails}').style.display='none';   
     }
     <!--start changes for CMI 2016 December release-->
     <!--Complaint From or About A Supplier is nullified on selecting supplier search-->
     function vendorsearch()
     {
         document.getElementById('{!$Component.id1.editForm.CFSEdit.clientFeedbackDetails.Supplierblock.SupplierField}').value='';       
     }         
     <!--End changes for CMI 2016 December release-->
     function noenter1(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:CFSEdit:Feedback_Category:catSearch1:catSearchButton1');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
          function noenter2(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:CFSEdit:Feedback_Category:catSearch2:catSearchButton2');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
         function noenter3(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:CFSEdit:catButton:catsearch3:catSearchButton3');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
         function noenter4(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:CFSEdit:catButton:catsearch4:catSearchButton4');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
    
    </script>
    
    
    <apex:form id="editForm">
        <apex:outputField value="{!case.Product_Code__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Cat_Level_1__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Cat_Level_2__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Cat_Level_3__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Cat_Level_4__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Cat_Level_5__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.CMI_Deleted_case__c}" rendered="FALSE" />
        <apex:outputField rendered="false" value="{!case.Account_For_Open_Cases__c}"/>
        <apex:outputField rendered="false" value="{!case.Account_For_Closed_Cases__c}"/>
        <!-- B-2078 changes for CMI September 2018 Release--> 
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
        <!-- End of B-2078 changes for CMI September 2018 Release-->
        <!-- Start changes for CMI 2014 Release 3 -->
        <!-- The below line is added as its value is required in the controller -->
        <apex:outputField value="{!case.Verify_Client_Check__c}" rendered="FALSE"/>
        <!-- End changes for CMI 2014 Release 3 -->
        <img src="{!$Resource.SunTrustLogo}"/>
        <apex:pageBlock title="Case Edit" mode="edit" id="CFSEdit">
            <apex:pageBlockButtons location="both">
                <apex:commandButton action="{!save}" value="Save"/>
                <apex:commandButton action="{!cancel}" value="Cancel"/>
            </apex:pageBlockButtons>
            
            <apex:pageBlockSection title="Case Information" id="callInfo">
                <apex:outputField value="{!case.CaseNumber}"/>
                <apex:outputField value="{!case.RecordTypeId}"/>
                <apex:outputField value="{!case.OwnerId}"/>
                <!-- ********************************************* -->
                <!-- *   DR-2656 September 2018 monthy Release   * -->
                <!-- ********************************************* -->
                <!----Start changes for DR-2656 for September 2018 Release -->
                <apex:inputField value="{!case.Case_Group_Assignment__c}"
                                 rendered="{!AND((case.Auto_Closed_Review__c==true), case.Case_Group_Assignment__c=='CAO')}"/>
                <apex:outputField value="{!case.Case_Group_Assignment__c}"
                                 rendered="{!AND((case.Auto_Closed_Review__c==false), case.Case_Group_Assignment__c=='CAO')}"/>
                
                <!----End changes for DR-2656 for September 2018 Release -->
<!--                
                <apex:inputField value="{!case.Date_Time_Sent_to_Research__c}"/>
-->
                <br/>                
                <!--<apex:inputField value="{!case.Origin}" required="TRUE"/>-->
                <!--Start Changes for CMI Pilot-->
                <!--Case Origin should be read only when the case is coming from PCQ form, i.e. Case Origin=CMI Pilot-->
                <!--For CMI 2014, rendering condition for Case Origin is added to check for CMI. Earlier it only checked for CMI Pilot-->
                <!--<apex:inputField value="{!case.Origin}" required="TRUE" rendered="{!(case.origin!='CMI Pilot' && case.origin!='CMI')}"/>-->
                <apex:outputPanel id="orgPanel" layout="block" style="padding-left:21%;"> 
                <apex:pageblockSection >
                <apex:pageblocksectionitem rendered="{! case.Account_Type__c != 'Mortgage Loan' }">
                    <apex:outputLabel value="Case Origin" />               
                    <apex:actionRegion >                
                        <apex:inputField required="true" value="{!case.Origin}">
                            <apex:actionSupport event="onchange" action="{!updateLists}" rerender="FeedbackPanel,CatLevel" status="MainStatus" />
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageblocksectionitem>
               <!-- </apex:outputPanel>   -->
                
                 <apex:pageblocksectionitem rendered="{! case.Account_Type__c = 'Mortgage Loan' && case.origin='Survey' }">
                    <apex:outputLabel value="Case Origin" />               
                    <apex:actionRegion >                
                        <apex:inputField required="true" value="{!case.Origin}">
                            <apex:actionSupport event="onchange" action="{!updateLists}" rerender="FeedbackPanel,CatLevel" status="MainStatus" />
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageblocksectionitem>
                
                <!--October--> 
                <!-- <apex:outputPanel id="caseOriginDisable">    -->              
                           <apex:pageblocksectionitem rendered="{!case.Account_Type__c = 'Mortgage Loan' && case.origin!='Survey' }"  >
                                <apex:outputLabel value="Case Origin "  />               
                                <apex:actionRegion >             
                                <apex:outPutField value="{!case.Origin}" />                                    
                                </apex:actionRegion>
                           </apex:pageblocksectionitem>
                   </apex:pageblockSection>        
                </apex:outputPanel> 
                
                <!--For CMI 2014, rendering condition for Case Origin is added to check for CMI. Earlier it only checked for CMI Pilot-->
                <apex:outputField value="{!case.Origin}" rendered="{!(case.origin='CMI Pilot' || case.origin='CMI')}"/>
                <!--End changes for CMI Pilot-->
               
          <!--  <apex:inputField value="{!case.Submitter__c}" required="TRUE"/>  -->
                
                <!--Start changes for CMI 2014 Release 3-->
                <apex:outputPanel id="submitter" >
                    <apex:pageblocksectionitem rendered="{!case.Call_Source__c='Escalated' || case.Call_Source__c='Internal' || case.Call_Source__c='Email' || case.Call_Source__c='Supplier/Vendor'}">                
                        <c:CustomLookup value="{!Case.Submitter__c}" object="Contact" objectName="Case" fieldName="Submitter__c" displayFields="Email,Title,Phone,Cost_Center__c,Department__c" required="true"/>
                    </apex:pageblocksectionitem>
                    <apex:pageblocksectionitem rendered="{!case.Call_Source__c!='Escalated' && case.Call_Source__c!='Internal' && case.Call_Source__c!='Email' && case.Call_Source__c!='Supplier/Vendor'}">                
                        <c:CustomLookup value="{!Case.Submitter__c}" object="Contact" objectName="Case" fieldName="Submitter__c" displayFields="Email,Title,Phone,Cost_Center__c,Department__c"/>
                    </apex:pageblocksectionitem>
                </apex:outputPanel>
                <!--End changes for CMI 2014 Release 3-->
                
                <!--Start changes for CMI Pilot-->
                <!--The below code was commented as Special Initiatives field was to be rendered when case type="Complaint"-->
                <!--<apex:inputField value="{!case.Type}" required="TRUE"/>-->                
                
                <apex:pageblocksectionitem >
                    <apex:outputLabel value="Case Type"/>               
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Type}" required="True">
                            <!--SpecialInitiativeSection is removed from rerender attribute for CMI 2014-->
                            <!--supplierDetailsPanel,ClientFollowUpSection added for CMI 2014-->
                            <!--For CMI 2016 April release closeCaseDetails is added in rerender attribute to rerender Select the Client Issue Type on changing Case Type-->
                            <!--Start Changes for CMI October 2017 Release-->
                            <apex:actionSupport event="onchange" rerender="misdirectedCallPanel,supplierDetailsPanel,ComplianceEvaluation,clientInfo,ClientFollowUpSection,clientFeedback,FeedbackPanel,CatLevel,clientFeedbackDetails,closeCaseDetails,FunctionalArea,servicingInteractionDispositonFields" status="MainStatus" />
                            <!--End Changes for CMI October 2017 Release-->
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageblocksectionitem> <br/>               
                <!--End changes for CMI Pilot-->
                
                <!--For CMI 2014 Release 3 action support is added for the below field-->
                <apex:pageblocksectionitem >
                    <apex:outputLabel value="Source of Feedback" />               
                    <apex:actionRegion >                
                        <apex:inputField value="{!case.Call_Source__c}" required="True">
                            <apex:actionSupport event="onchange" rerender="submitter" status="MainStatus" />
                         </apex:inputField>                       
                    </apex:actionRegion>
                </apex:pageblocksectionitem>            
                <br/>
                
                <!--Start changes for CMI 2014-->
                
                
                    <apex:pageBlockSectionItem rendered="{!(SRDEditable)}">
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock" style="{!IF(case.Type='Complaint','background-color:C00','background-color:transparent')}" ></div>
                                <apex:inputField value="{!case.Source_Received_Date_Time__c}" rendered="{!SRDEditable}"/>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem rendered="{!NOT(SRDEditable)}">  
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!!SRDEditable}"/>
                    </apex:pageBlockSectionItem>
                    <!--<apex:outputlabel value="Source Received Date/Time"/>
                    <apex:inputField value="{!case.Source_Received_Date_Time__c}"/>-->
                
                <!--End changes for CMI 2014-->
            </apex:pageBlockSection>            
            
            <!--Start changes for CMI 2014-->
            <!--Special Initiative Section is Commented for CMI 2014-->
                       
            <!--Start Changes for CMI Pilot-->
            <!--Special Initiative Section is included for Special Initiative field. This field gets rendered when Case Type is Complaint-->
            <!--<apex:pageBlockSection id="SpecialInitiativeSection" columns="1">
                <apex:pageBlockSectionItem >         
                    <apex:outputLabel value="Special Initiatives" rendered="{!(case.Type='Complaint' && case.origin!='CMI Pilot')}"/> 
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Special_Initiatives__c}" rendered="{!(case.Type='Complaint' && case.origin!='CMI Pilot')}">
                                <apex:actionSupport event="onchange" rerender="ComplianceEvaluation" status="MainStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.Special_Initiatives__c}" rendered="{!(case.Type='Complaint' && case.origin='CMI Pilot')}"/>
            </apex:pageBlockSection>-->
            <!--End changes for CMI 2014-->
            
            <apex:actionStatus id="MainStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI Pilot-->
            
            <apex:outPutPanel id="clientInfo">
                <!--Commented for CMI 2014 because some fields are dependent on it. A pageBlockSectionItem is added for the same field-->
                <!--<apex:inputField value="{!case.Is_this_a_Client__c}" />-->
                <apex:pageBlockSection title="Client Information" >
                    <!--Start Changes for CMI 2014-->
                    <apex:pageblocksectionitem >
                        <apex:outputlabel value="Is this a Client?"/>
                        <apex:actionRegion >
                            <!--The field is made required for CMI 2014-->
                            <apex:inputField value="{!case.Is_this_a_Client__c}" required="{!case.Type='Complaint' && case.Special_Initiatives__c='CMI'}">
                                <!--action attribute and modalDialog,nameSearch,renderAccountDetailsForCreateClient added in rerender attribute for rerendering these sections for CMI 2014 and clientInfo is added for CMI 2014.1 break/fixes-->
                                <apex:actionSupport event="onchange" action="{!clearClientInformationFields}"  rerender="ClientFollowUpSection,modalDialog,nameSearch,renderAccountDetailsForCreateClient,clientInfo,bypassClientContactMethodFields" status="ComplaintDetailStatus"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageblocksectionitem>
                    <!--End Changes for CMI 2014-->
                </apex:pageBlockSection>
                
                <apex:outputPanel id="modalDialog">
                    <apex:pageblockSection id="searchModal" rendered="{!case.Is_this_a_Client__c='Yes'}">
                        <!--For CMI 2014 Release 2, the disabled attribute has been added in the below button-->
                        <apex:commandButton style="margin-left:37%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch,renderAccountDetailsForCreateClient,LOBAccountDetailsPanel" value="Search Client" disabled="{!case.BypassSearchProcess__c}"/>                                       
                        <!--<c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                            <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>
                            <!--<div style="text-align:center">
                                <apex:commandButton immediate="true" action="{!hideModalDialog}" reRender="accountSearch,nameSearch" value="Return To Case"/>
                            </div>-->
                            <!--<br/>                   
                        </c:Modal_Dialog>-->               
                    </apex:pageBlockSection>
                    
                    <apex:pageblockSection id="createModal" rendered="{!case.Is_this_a_Client__c='No'}">                        
                        <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>                            
                        <!--<c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                            <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase"/>
                            <div style="text-align:center">
                                <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetailsForCreateClient" value="Return To Case" />
                            </div>
                            <br/>                                          
                        </c:Modal_Dialog>-->                    
                    </apex:pageblockSection>
                </apex:outputPanel>
               
                
                <!--End change for october relese-->   
                     
                <!--Start Changes  for CMI 2014 Release 2-->
                <!--This section is added to bypass the client search when it is not displaying any results -->
                <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient"> 
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes')}">                         
                        <apex:pageBlockSection >                         
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Bypass Client Search"/> 
                                <apex:actionRegion > 
                                    <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                       <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="clientInfo,nameSearch,authorizedClientDetailsBypass,renderAccountDetailsForCreateClient,ClientFollowUpSection,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields,LOBAccountDetailsPanel"  status="ClientStatus"/>
                                    </apex:inputCheckbox> 
                                </apex:actionRegion> 
                             </apex:pageblocksectionitem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                </apex:outputPanel>
                
                <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                    <apex:outPutPanel rendered="{!case.BypassSearchProcess__c}">                            
                        <apex:pageBlockSection columns="1" >                              
                             <apex:pageBlockSectionItem >
                                 <!-- Start Changes for CMI 2014 Release 3 -->
                                 <apex:outputlabel value="Reason for Bypass"/>
                                 <!-- End Changes for CMI 2014 Release 3 -->
                                 <apex:actionRegion >
                                     <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                         <apex:actionSupport event="onchange" rerender="CINField"  status="ClientStatus"/>
                                     </apex:inputField>
                                 </apex:actionRegion>
                             </apex:pageBlockSectionItem>                             
                         </apex:pageBlockSection>
                   <apex:pageBlockSection columns="1" id="authorizedClientDetailsBypass1">
                             <apex:inputField value="{!case.Contact_Name__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='CFS Tracking Only'),(case.BypassSearchProcess__c)))}" required="true"/>
                             <apex:inputField value="{!case.Contact_Phone__c}" required="True"  rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='CFS Tracking Only'),(case.BypassSearchProcess__c)))}"/>
                          </apex:pageBlockSection>
                    <apex:pageBlockSection id="CINField" columns="1">                              
                             <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available'}"/>
                             <!--Commented For CMI 2014 Release 3.TIN Field is not needed-->
                             <!--<apex:inputField value="{!case.TIN__c}" required="true" />-->                                                          
                         </apex:pageBlockSection>
                         
                         <apex:pageBlockSection columns="1">
                             <!--<apex:inputField value="{!case.Contact_Name__c}" required="true"/>-->
                             <!--Below Field is added for CMI 2014 Release 3-->                             
                             <!--<apex:inputField value="{!case.Contact_Phone__c}" required="true"/>-->
                             
                             <!--Start changes for CMI 2014 Release 3-->
                             <apex:pageBlockSectionItem >
                             <apex:outputlabel value="Is This A Private Wealth Client?" />
                             <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                    <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!--End changes for CMI 2014 Release 3-->

                             <!--Below Field is added for CMI 2014 Release 3-->
                             <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>
                             
                             <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Account Type"/>
                                 <apex:actionRegion >
                                     <apex:inputField value="{!case.Account_Type__c}" required="true">
                                         <apex:actionSupport event="onchange" reRender="accTypeDetail,AlternateAddress,orgPanel,callInfo" status="AccountTypeStatus" action="{!defaultAccountTypeDetailField}"/>
                                     </apex:inputField>
                                 </apex:actionRegion>
                             </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <!--For CMI 2014 Release 3 required condition is added-->
                        <apex:pageBlockSection id="AccountNumber">
                            <apex:inputField id="AccountNumber" value="{!case.Account_Number__c}" required="{!case.Account_Type__c!="Treasury & Payment Solutions" && case.Account_Type__c!="Wholesale Other"}"/> 
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection id="accTypeDetail">
                             <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. -->
                             <!--Start changes for feb 2017 release-->
                             <!--Added account type detail for commercial loan-->
                             <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{! case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Wholesale Other' || case.Account_Type__c = 'Consumer Loan' || case.Account_Type__c = 'Commercial Loan'}" required="true"/>
                             <!-- For CMI 2014 Release 3 the below field is added -->
                             <!--End changes for feb 2017 release-->
                             <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Is This An Authorized Third Party" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" >
                                       <!-- <apex:actionSupport event="onchange"  reRender="authorizedClientDetailsBypass" status="AccountTypeStatus"/>-->
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            
                             <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card'}"/>
                        </apex:pageBlockSection>
                                               
                    </apex:outPutPanel>
                </apex:outPutPanel>
                <!--End Changes  for CMI 2014 Release 2-->
                
                 <!--Start changes for CMI 2014 Release 3-->
                    <apex:actionStatus id="AccountTypeStatus">
                       <apex:facet name="start">
                           <div style="text-align:center;">
                               <img src="{!$Resource.SpinIcon}"/>
                           </div>
                       </apex:facet>
                   </apex:actionStatus>
                <!--End changes for CMI 2014 Release 3-->

                
                <!--Start changes for CIS Search for CMI 2014--> 
                <!--For CMI 2014 Release 2, the below outputPanel have been added-->
                <apex:outPutPanel id="nameSearch"> 
                <!--<apex:outputPanel rendered="{!NOT(case.BypassSearchProcess__c)}">-->          
                    <!--For CMI 2014 release 2rendered attribute is added in the below pageBlockSection for proper rendering of fields-->            
                    <apex:pageblockSection rendered="{!(case.CIN__c!=Null || case.Client_Name__c<>null) && NOT(case.BypassSearchProcess__c)}" columns="2">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                            <apex:define name="requiredSelectAccount">                            
                                <apex:actionRegion >                                    
                                    <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                                        <apex:selectOptions value="{!accountsList}"/>
                                        <!--For CMI 2014 Release 2 in the rerender attribute nameSearch is removed and accNumAndType is added because only AccountNumber and AccountType are rerendered when Select Account is changed-->
                                        <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="selectAccountModal, renderAccountDetailsForCreateClient, accNumAndType,nameSearch,accountTypeDetail,relationshipManagedBySAD,orgPanel,FeedbackPanel,CatLevel" status="selectAccountStatus"/>
                                    </apex:selectList>                                               
                                </apex:actionRegion>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        
                        <apex:outputField rendered="{!case.Client_Name__c<>null &&(case.Account_For_Open_Cases__c=null || case.Account_For_Open_Cases__c='')&&(case.Account_For_Closed_Cases__c=null || case.Account_For_Closed_Cases__c='')}" value="{!case.Client_Name__c}"/>
                        <!--Start changes for CMI 2016 April release.Client Name is displayed as a link to open the Related Account Record-->
                        <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null && ((case.Account_For_Open_Cases__c!=null && case.Account_For_Open_Cases__c!='') || (case.Account_For_Closed_Cases__c!=null && case.Account_For_Closed_Cases__c!=''))}">
                            <apex:outputLabel value="Client Name"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2016 April release.-->
                        
                        <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                        <apex:pageBlockSectionItem rendered="{!((stProductId!=null && stProductId!='') && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient))}">
                            <apex:outputLabel value="Account Number"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(OR(stProductId=null,stProductId="") && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient))}" />
                        <!--End changes for CMI 2016 June Release.-->
                        <apex:inputField rendered="{!((renderAccountType || comingAfterCreatingClient ) && case.CIN__c<>null && selectedAccountInformation!='--NONE--' )|| case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Number__c}"/>    
                        
                        <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                        <apex:outputfield value="{!case.Account_Type__c}" rendered="{!(case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI'  && (selectedAccountInformation!='Other' || comingAfterCreatingClient))}"/>
                        <apex:pageBlockSectionItem rendered="{!((renderAccountType || comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}">
                            <apex:outputlabel value="Account Type" rendered="{!((renderAccountType|| comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}"/>
                            <apex:actionRegion >
                                <apex:inputField rendered="{!((renderAccountType || comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Type__c}" >
                                    <apex:actionSupport status="selectAccountStatus" event="onchange" rerender="accountTypeDetail,orgPanel,relationshipManagedBySAD,acctTypeHidden,FeedbackPanel,CatLevel" action="{!defaultAccountTypeDetailField}"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>                    
                        <!--<apex:pageBlockSectionItem rendered="{!case.Business_or_Personal__c<>null && selectedAccountInformation!='Other' }"/>--> 
                        <apex:outputField rendered="{!case.Business_or_Personal__c<>null}" value="{!case.Business_or_Personal__c}"/>
                        <!--Fields for HH Information-->
                        <!--<apex:pageBlockSectionItem rendered="{!case.HH_Info__c<>null}"/> 
                        <apex:outputField rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}" value="{!case.HH_Info__c}"/>-->
                        <apex:pageBlockSectionItem rendered="{!case.Client_Servicing_Code__c<>null}"/> 
                        <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>
                        <!--<apex:pageBlockSectionItem rendered="{!case.Client_Segmentation_Code__c<>null}"/>                                                                         
                        <apex:outputField rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}" value="{!case.Client_Segmentation_Code__c}"/>-->
                        <!--Fields for HH Information-->
                        <!--<apex:inputField value="{!case.CRS_Number__c}" required="{!case.Business_or_Personal__c = 'Business'}"/>-->
                        <!--Start changes for for CMI 2014 Release 2.-->
                        <!--<apex:outputField rendered="{!case.LOB_Relationship__c='PWM'}" value="{!case.LOB_Relationship__c}"/>
                        <apex:inputField rendered="{!case.LOB_Relationship__c=='PWM'}" value="{!case.Relationship_ID__c}"/>
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel rendered="{!case.LOB_Relationship__c='PWM'}" value="Officer Search"/>
                            <apex:actionRegion >
                                <apex:inputField rendered="{!case.LOB_Relationship__c='PWM'}" value="{!case.Officer_Search__c}" onkeypress="return false;" onkeydown="return false;">                                
                                    <apex:actionSupport event="onchange" action="{!populateContactRelatedFields}" status="selectAccountStatus" rerender="officerId"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>-->
                    </apex:pageBlockSection>
                        
                   <!-- <apex:pageBlockSection id="officerId" rendered="{!NOT(case.BypassSearchProcess__c)}" >
                        <apex:outputField rendered="{!case.Officers_Employee_ID__c!=Null && case.Officers_Employee_ID__c!='' && case.LOB_Relationship__c='PWM'}" value="{!case.Officers_Employee_ID__c}"/>
                    </apex:pageBlockSection>-->
                    <!--End changes for for CMI 2014 Release 2.-->
                    
                    <!--For CMI 2014 release 2 rendered attribute is added in the below pageBlockSection for proper rendering of fields-->
                    <!--<apex:pageblockSection rendered="{!(case.CIN__c!=Null && case.Client_Name__c<>null && case.Client_Name__c<>'') && NOT(case.BypassSearchProcess__c)}" >--> 
                        <!--<apex:pageBlockSectionItem >
                            <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                            <apex:define name="requiredSelectAccount">                            
                                <apex:actionRegion >                                    
                                    <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                                        <apex:selectOptions value="{!accountsList}"/>-->
                                        <!--For CMI 2014 Release 2 in the rerender attribute nameSearch is removed and accNumAndType is added because only AccountNumber and AccountType are rerendered when Select Account is changed-->
                                        <!--<apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="selectAccountModal, renderAccountDetailsForCreateClient, accNumAndType" status="selectAccountStatus"/>
                                    </apex:selectList>                                               
                                </apex:actionRegion>
                            </apex:define>
                        </apex:pageBlockSectionItem>-->
                    <!--</apex:pageblockSection>-->
                    <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                        <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                        <br/>
                    </c:Modal_Dialog>
                    
                    <apex:actionStatus id="selectAccountStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                   
                   <!--pageBlockSection is added for the below two fields for CMI 2014 Release 2-->     
                   <!--<apex:pageBlockSection id="accNumAndType" rendered="{!(case.CIN__c!=Null && case.Client_Name__c<>null && case.Client_Name__c<>'') && NOT(case.BypassSearchProcess__c)}"  Columns="2"> 
                        <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && (selectedAccountInformation!='Other' || comingAfterCreatingClient))}" />    
                        <apex:outputfield value="{!case.Account_Type__c}" rendered="{!(case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI'  && (selectedAccountInformation!='Other' || comingAfterCreatingClient))}"/>                    
                   </apex:pageBlockSection>-->
                <!--</apex:outputPanel>-->
                </apex:outputPanel>    
            
                <!--Start changes for CIS Search for CMI 2014--> 
                <!--For CMI 2014 Release 2, the below outputPanel has been added-->
                <!--<apex:outPutPanel id="renderAccountDetailsForCreateClient" >-->          
                    <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added for the below section-->
                    <!--<apex:pageblockSection rendered="{! NOT(case.BypassSearchProcess__c)}" columns="2">
                        <apex:inputField rendered="{!((selectedAccountInformation=='Other' || comingAfterCreatingClient ) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Number__c}">-->
                            <!--<apex:actionSupport status="selectAccountStatus" event="onchange" rerender="renderAccountDetailsForCreateClient"/>-->
                        <!--</apex:inputField>-->
                        <!--Start changes for for CMI 2014 Release 2.pageBlockSectionItem,outputLabel,actionRegion are added-->
                        <!--<apex:pageBlockSectionItem rendered="{!((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}">
                            <apex:outputlabel value="Account Type" rendered="{!((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}"/>
                            <apex:actionRegion >
                                <apex:inputField rendered="{!((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c<>null)|| case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Type__c}" >
                                    <apex:actionSupport status="selectAccountStatus" event="onchange" rerender="accountTypeDetail"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageblockSection>-->
                    <apex:pageblockSection id="accountTypeDetail" rendered="{! NOT(case.BypassSearchProcess__c)}" > 
                        <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. -->                   
                        <apex:inputField rendered="{!((case.Account_Type__c='Private Wealth Mgmt')  || (case.Business_or_Personal__c = 'Business' && case.Account_Type__c = 'Wholesale Other')) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type_Detail__c}" required="true"/>
                        <!--Start changes for feb 2017 release-->
                        <!--Added account type detail=Commercial Loan-->
                        <apex:pageBlockSectionItem rendered="{!(case.Account_Type__c = 'Credit card' ) || (case.Account_Type__c = 'Credit Card') || (case.Account_Type__c = 'Consumer Loan') || case.Account_Type__c = 'Commercial Loan'}">
                                <apex:outputLabel value="Account Type Detail" />
                                <apex:define name="requiredSelectAccount">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                            <apex:selectOptions value="{!acctTypeDetailFieldValue}"/>                                                    
                                        </apex:selectList>
                                    </div>
                                </apex:define> 
                        </apex:pageBlockSectionItem>
                        <!--End changes for feb 2017 release-->
                        <!-- For CMI 2014 Release 3 the below field is added -->
                        <!--<apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!case.Client_Name__c<>null && case.Client_Name__c<>'' && (case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card')}"/>-->
                    </apex:pageblockSection>
                    <!--End changes for for CMI 2014 Release 2.-->
                <!--</apex:outputPanel>-->
                <!--End changes for CIS Search for CMI 2014-->
            
                
            </apex:outputPanel> 
                        
            <!--AccountDetails Id added for CMI Pilot-->    
           <!-- <apex:pageBlockSection id="AccountDetails" columns="2" >
                <apex:outputfield value="{!case.SuppliedName}"/>
                <apex:outputfield value="{!case.SuppliedEmail}"/>-->
                <!--Start Changes for CMI Pilot-->
                <!--The required condition changed for CMI 2014-->
                <!--Earlier Functional Area was required always when rendered. Now, it is only required when Special Initiatives is not Null.-->
                
                <!--End Changes for CMI Pilot-->                      
          <!--  </apex:pageBlockSection> -->
            
            <apex:outputPanel id="bypassClientContactMethodFields">
                <apex:outputPanel rendered="{!case.BypassSearchProcess__c}">
                    <apex:pageBlockSection columns="1">
                         <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Client Follow Up Needed?"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                    <apex:actionSupport event="onchange" action="{!clientFollowUpChanges}" reRender="bypassClientContactMethodFields" status="ClientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                         </apex:pageBlockSectionItem>
                         
                         <apex:pageBlockSectionItem rendered="{!case.Client_Follow_Up_Needed__c='Yes'}">
                             <apex:outputlabel value="Contact Method" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" />
                             <apex:actionRegion >
                                <apex:inputField value="{!case.Contact_Method__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" required="true">
                                    <apex:actionSupport event="onchange" reRender="bypassClientContactMethodFields" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion> 
                         </apex:pageBlockSectionItem>
                        
                         <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}">
                            <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}"/>  
                            <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}" required="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>                                                                    
                         </apex:pageBlockSectionItem>
                         
                         <!--For CMI 2014 Release 3 below field is added-->
                         <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Phone'}">
                             <apex:outputLabel value="Best Time To Call" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>  
                             <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}" required="true"/>                                                                    
                         </apex:pageBlockSectionItem>
                        
                         <!--<apex:pageBlockSectionItem rendered="{!(case.Contact_Method__c='Mail')}">
                            <apex:outputLabel value="Alternate Address" rendered="{!(case.Contact_Method__c='Mail')}"/>  
                            <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!(case.Contact_Method__c='Mail')}" required="true"/>                                                                    
                         </apex:pageBlockSectionItem>-->
                        
                         <apex:pageBlockSectionItem rendered="{!(case.Contact_Method__c='Email')}">
                            <apex:outputlabel value="Alternate Email" rendered="{!(case.Contact_Method__c='Email')}"/>                                           
                            <apex:inputField value="{!case.Alternate_Email__c}" rendered="{!(case.Contact_Method__c='Email')}" required="true"/>                                    
                         </apex:pageblocksectionItem>
                    </apex:pageblocksection>
                    
                    <!--For CMI 2014 Release 3,Alternate Address Field is added to a new PageBlockSection.Because it is rendered based on AccountType Field-->
                    <apex:pageBlockSection id="AlternateAddress">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Alternate Address" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}"/>  
                            <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}" required="true"/>                                                                    
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                </apex:outputPanel>
            </apex:outputPanel>
            
            <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c)}" id="FunctionalArea" >
                <apex:inputField value="{!case.Name_of_Caller__c}"/>
                <apex:inputField value="{!case.Functional_Role__c}"/>
                <apex:inputField value="{!case.Functional_Area__c}" required="{!case.Special_Initiatives__c!=Null && case.Type=='Complaint'}"/>
            </apex:pageBlockSection>
             <apex:pageBlockSection id="authorizedPartyPanel" columns="1" rendered="{!AND(NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='CFS Tracking Only'))}">    
                    <!--Start changes for CMI 2014.1 break/fixes-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Is This An Authorized Third Party"/>                       
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!OR(case.Is_this_a_Client__c='No',AND(case.Is_this_a_Client__c='Yes',OR(case.Type='Complaint',case.Type='CFS Tracking Only')))}">
                                <apex:actionSupport event="onchange" reRender="authorizedPartyPanel,authorizedClientDetailsBypass" status="ComplaintDetailStatus"/>
                                </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    
                   
                    <!--For CMI 2014 Release 2, NOT(case.BypassSearchProcess__c) has been added in the rendered condition-->
                    <br/>
                    
                    <!--End changes for CMI 2014.1 break/fixes-->
                                                                                            
                    <!--Business or personal commented for autopopulation in CIS search for CMI 2014-->
                    <!--<apex:inputField value="{!case.Business_or_Personal__c}"/>-->
                    
                    <!--Name Of Caller commented for autopopulation in CIS search for CMI 2014-->
                    <!--<apex:inputField value="{!case.Name_of_Caller__c}"/>-->
                    
                    <!--client name commented for autopopulation in CIS search for CMI 2014-->
                    <!--<apex:inputField value="{!case.Client_Name__c}"/>-->
                    
                    <!--<apex:inputField value="{!case.Client_Type__c}"/> -->
                    
                    <!--CIN commented for autopopulation in CIS search for CMI 2014-->
                    <!--<apex:inputField value="{!case.CIN__c}"/>-->
                </apex:pageBlockSection>
                 <apex:pageBlockSection id="authorizedClientDetailsBypass">
                    <!--Start change for October-->
                   <!-- this two fileds are moved up when it is a bypass scenario. On selection of bypass checkbox, this two fields
                   will be rendered.
                   if it is not a bypass scenario, fields will rendered on selection 'Is this a third party' field-->
                 
                             <apex:inputField rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}" required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}"/><br/>
                             <apex:inputField rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}"   value="{!case.Contact_Phone__c}"/>
                 </apex:pageBlockSection>
            <!--For CMI 2014 Release 2, the below outputPanel is added-->
            <apex:outputPanel id="ClientFollowUpSection">
                <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added for the below section-->
                <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c)}" Columns="1">
                    <!-- Case type checked in required attribute of functional area for CMI 2014 -->
                    <!--<apex:inputField value="{!case.Name_of_Caller__c}"/>
                    <apex:inputField value="{!case.Functional_Role__c}"/>
                    <apex:inputField value="{!case.Functional_Area__c}" required="{!case.Special_Initiatives__c!=Null && case.Type=='Complaint'}"/>-->
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Client Follow Up Needed?"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="true">
                                <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection" status="ComplaintDetailStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!case.Client_Follow_Up_Needed__c='Yes' && NOT(case.BypassSearchProcess__c)}" Columns="1">   
                    <apex:pageBlockSectionItem >
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->
                        <apex:outputlabel value="Contact Method" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Is_this_a_Client__c!=Null)}"/>
                        <apex:actionRegion >
                            <!--Contact method is introduce in CMI Pilot-->
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:inputField value="{!case.Contact_Method__c}" rendered="{!(case.Client_Follow_Up_Needed__c=='Yes' && case.Is_this_a_Client__c!=Null)}" required="true">
                                <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection" status="ComplaintDetailStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection> 
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Phone') && NOT(case.BypassSearchProcess__c)}" Columns="2">      
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null)}">                    
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->
                        <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null)}"/>
                        <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null)}" required="true"/>
                    </apex:pageBlockSectionItem>
                    
                    <!-- Client contact number output field added for CMI 2014 -->
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null)}">
                            <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null)}"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null)}" />                                        
                        </apex:pageBlockSectionItem>                
                    
                    <!--Start changes for CMI 2014-->
                    <!--Alternate Phone Number added for CMI 2014-->
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}">
                        <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}"/>  
                        <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                    </apex:pageBlockSectionItem>
                    <!--End changes for CMI 2014-->
                    
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}">
                        <!--Rendering conditions changed for CMI 2014-->
                        <!--Is this a Client condition included in rendering condition for CMI 2014-->
                        <apex:outputlabel value="Best Time To Call" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}"/>                                           
                        <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}" required="True"/>                                    
                    </apex:pageblocksectionItem>
                </apex:pageBlockSection>
                 
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Mail') && NOT(case.BypassSearchProcess__c)}" Columns="2">                      
                    <!--Start changes for CMI 2014-->
                    <!--Contact Address added for CMI 2014-->
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}">
                        <!--inputField changed to outputField,required attribute is removed for CIS Search for CMI 2014-->
                        <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}"/>
                        <apex:inputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}" style="width:200px; height:100px" required="True"/>                                        
                    </apex:pageBlockSectionItem>
                    
                     <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}">                            
                        <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                        <apex:outputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                    </apex:pageBlockSectionItem>
                            
                    <!--Alternate Address added for CMI 2014-->
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}">
                        <apex:outputLabel value="Alternate Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}"/>  
                        <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}" style="width:200px; height:100px" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                 
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Email') && NOT(case.BypassSearchProcess__c)}" Columns="1">               
                    <!--Client Email added for CMI 2014-->
                    
                    <!--Start changes for CMI 2017 May Release-->
                    <!--Client Email Field and Alternate Email Field is displayed as optional if the Client Email is invalid from CIS--> 
                    <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}">
                        <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}"/>                                           
                        <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}" required="True"/>                                    
                    </apex:pageblocksectionItem>

                    <!--Start changes for CMI 2017 May Release-->                    
                    <!--End changes for CMI 2014-->
    
                </apex:pageblocksection>
                <!--End Changes for CMI Pilot-->               
    
                <!--end of ClientFollowUpSection-->
            </apex:outputPanel> <!--ClientFollowUpSection-->        
            
            <apex:actionStatus id="ComplaintDetailStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            
            
             <!-- ************************************************** --> 
             <!-- *   LOB ACCOUNT DETAILS SECTION    * -->
             <!-- ************************************************** --> 

            <!-- Start changes for CMI 2014 Release 3 -->
            <!-- Start changes for CMI 2015 Iteration 2 -->
            <apex:outputpanel id="LOBAccountDetailsPanel" title="LOB Account Details">
                <apex:pageBlockSection title="LOB Account Details" />
                <div style="Margin-Left:2%">
                        <apex:outputText Style="font-weight:bold;" value="Private Wealth Client Details" rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c) && (case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c == 'PWM') && case.Type == 'Complaint'}" />
                </div>
                <apex:pageBlockSection id="IsThisPrivateWealthClient" rendered="{!NOT(case.BypassSearchProcess__c)}">
                <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Is This A Private Wealth Client?" rendered="{!NOT(case.BypassSearchProcess__c)}"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!NOT(case.BypassSearchProcess__c)}">                                
                                <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="lob,officerId"/>                                
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <!--<apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!case.Case_Association_Type__c='Related Case'}"/>-->
                </apex:pageBlockSection>
                <apex:outputPanel id="lob">
                <apex:outputPanel rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}">  
                <apex:pageBlockSection columns="2" >
                    <apex:outputField value="{!case.LOB_Relationship__c}" rendered="{!(case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c == 'PWM' )}"/>
                    <apex:inputField rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Relationship_ID__c}"/>
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel rendered="{!(case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes') }" value="Officer Search"/>
                        <apex:actionRegion >
                            <apex:inputField rendered="{!(case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Officer_Search__c}" onkeypress="return false;" onkeydown="return false;">                                
                                <apex:actionSupport event="onchange" action="{!populateContactRelatedFields}" status="LOBDetailStatus" rerender="officerId"/>                                
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                </apex:outputPanel>
                </apex:outputPanel>
                <apex:outputPanel id="officerId">
                <apex:outputPanel rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}">
                 <apex:pageBlockSection columns="2" > 
                    <!--<apex:pageblockSection id="officerId" rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c)}" >-->                            
                        <apex:outputField rendered="{!case.Officers_Employee_ID__c!=Null && case.Officers_Employee_ID__c!='' && (case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c == 'PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Officers_Employee_ID__c}"/>                            
                    <!--</apex:pageblockSection>-->
                    <!--<apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true" rendered="{!case.Case_Association_Type__c!='Related Case'}"/> 
                    <apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!case.Case_Association_Type__c='Related Case'}"/>-->
                    
                </apex:pageBlockSection>
                </apex:outputPanel>
                </apex:outputPanel>
                <!-- End changes for CMI 2015 Iteration 2 -->
                <br/> 
           <!--     <div style="margin-Left:2%">
                    <apex:outputText Style="font-weight:bold;" value="Wholesale Client Details" />
                </div>    -->
               <apex:actionRegion >
                 <!--   <div style="margin-left:24%">                  
                        <apex:commandLink id="theLink" action="{!displayCRSSearchWindow}" reRender="crsSearchWindow,crsSearchWindow1,crsWin" status="LOBDetailStatus" value="CRS Search" immediate="true"/>                                           
                    </div>  -->
              <!--       <apex:pageBlockSection columns="2" id="crsWin">                    
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="CRS#"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.CRS_Number__c}">
                                    <apex:actionSupport event="onchange"  rerender="relationshipManagedBySAD" status="LOBDetailStatus" />                                
                                </apex:inputField>
                            </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                       <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This a Wholesale Client?" rendered="{!!case.BypassSearchProcess__c }" />
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" rendered="{!!case.BypassSearchProcess__c }" >                                
                                    <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="relationshipManagedBySAD"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        

                    </apex:pageBlockSection> -->
                    
                    <apex:outputPanel id="relationshipManagedBySAD">                                 
                        <apex:pageBlockSection rendered="{! (case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card') && ((case.CRS_Number__c != '' && case.CRS_Number__c != null) || case.Is_this_a_Wholesale_Client__c='Yes' )&& !case.BypassSearchProcess__c }"> 
                            <apex:pageBlockSectionItem />
                            <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" />   
                        </apex:pageBlockSection>                         
                    </apex:outputPanel>
              <!--      <div style="margin-left:21%">
                        <apex:commandButton action="{!searchWHLClient}" reRender="nameSearch,verifyResults,CRSFields" value="Verify WHL Client" status="VerifyClientStatus"/>                                                             
                    </div> -->
                </apex:actionRegion>
                <div style="text-align:center">
                    <apex:outputText Style="font-weight:bold;color:red;" value="{!verifyClientMessage}" id="verifyResults"/>
                </div>
                <c:Modal_Dialog id="crsSearchWindow" visible="{!openSearchWindow}" >
                    <div style="text-align:center">
                        <apex:actionRegion >
                            <apex:commandButton value="Close" action="{!hideCRSSearchWindow}" reRender="crsWin,crsSearchWindow" status="ComplaintDetailStatus" style="align:center"/>                                     
                        </apex:actionRegion>
                    </div>
                    <apex:iframe src="http://crs.suntrust.com/FindEntity.aspx" scrolling="true" id="theIframe"/> 
                    <div style="text-align:center">
                        <apex:actionRegion >
                            <apex:commandButton value="Close" action="{!hideCRSSearchWindow}" reRender="crsWin,crsSearchWindow" status="ComplaintDetailStatus" style="align:center"/>                                     
                        </apex:actionRegion>
                    </div>
                </c:Modal_Dialog>
                <br/>
                
                <apex:actionStatus id="VerifyClientStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                            <span class="waitingDescription">Verifying.Please wait...</span>
                        </div>
                    </apex:facet>
                </apex:actionStatus> 
                <apex:outputPanel id="CRSFields">
                <apex:pageBlockSection columns="2">
                    <apex:outputField value="{!case.Wholesale_Account_Name__c}" rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}"/>
                    <apex:outputField value="{!case.RelationshipManager__c}" rendered="{!case.RelationshipManager__c != null && case.RelationshipManager__c != ''}"/>   
                    <apex:outputField value="{!case.Rel_Mgr__c}" rendered="{!case.Rel_Mgr__c != null && case.Rel_Mgr__c != ''}"/>                   
                    <apex:outputField value="{!case.CRS_Client_or_Prospect__c}" rendered="{!case.CRS_Client_or_Prospect__c != null && case.CRS_Client_or_Prospect__c != ''}"/>
                    <apex:outputField rendered="{!case.Region__c <> null}" value="{!case.Region__c}" />
                    <apex:outputField rendered="{!case.LOB__c <> null}" value="{!case.LOB__c}" />
                    <apex:outputField rendered="{!case.Sub_LOB__c <> null}" value="{!case.Sub_LOB__c}" />
                    <apex:outputField rendered="{!case.Individual_On_Behalf_Of_Entity__c <> null}" value="{!case.Individual_On_Behalf_Of_Entity__c}" />                        
                </apex:pageBlockSection>
                </apex:outputPanel>
                <apex:actionStatus id="LOBDetailStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                </apex:actionStatus>
            </apex:outputpanel>
            <!-- End changes for CMI 2014 Release 3 --> 
            
            <apex:outputPanel id="clientFeedback" >
                <apex:outputPanel layout="block" rendered="{!case.Type='Complaint' || case.Type='Positive Feedback/Compliment' || case.Type='Tracking Only: Feedback' }"> 
                    <!--Start changes for CMI 2015 Iteration 2-->
                    <apex:actionRegion >     
                        <!--Id attribute added for CMI 2014-->
                        <apex:pageBlockSection title="Client Feedback Details" id="clientFeedbackDetails" columns="2">
                            <!--Commented for CMI 2014 because Supplier Search needs to be rendered when Is Feedback field is equal to Supplier.-->                        
                            <!--Start Changes for CMI 2014-->
                            <apex:pageblocksectionitem >
                                <apex:outputlabel value="Is Feedback regarding a TM/ Dept/ Supplier?" />                                
                                    <apex:inputField required="{!case.Type = 'Complaint'}" value="{!case.Is_Feedback_regarding_a_TM_Dept__c}">
                                        <apex:actionSupport event="onchange" rerender="clientFeedbackDetails,supplierDetailsPanel,servicingChallenges,clientFeedback,servicingInteractionDispositonFields" status="ClientFeedbackStatus"/>
                                    </apex:inputField>                                
                            </apex:pageblocksectionitem>
                            <!--End Changes for CMI 2014-->
                    
                            <apex:outputpanel id="ComplaintTeammateSearch" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}" >                                                                
                               <c:CustomLookup value="{!Case.Teammate_Search__c}" object="Contact" objectName="Case" fieldName="Teammate_Search__c" displayFields="Email,Title,Phone,Cost_Center__c,Department__c" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate'|| case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate'}"/>                                                              
                            </apex:outputpanel>
                            <br/>
                              
                             <!--The rendering condition modified for CMI 2014. So, that it should not render for Supplier.-->
                             <apex:outputpanel id="DeptSearch" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}" >                               
                                 <c:CustomLookup value="{!Case.Department_Search__c}" object="Org_Unit__c" objectName="Case" fieldName="department_search__c" displayFields="RecordType.Name,Cost_Center__c,Address__c,City__c,State__c" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI'}"/> 
                             </apex:outputpanel>
                             <br/>
                    
                              <!--Start Changes for CMI 2014-->
                              <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}">
                                    <apex:outputlabel value="Supplier Search"/>                                    
                                        <!--Start Changes for CMI 2014 break/fixes-->
                                        <!--Added onkeypress to supress the Enter and Any other input-->
                                        <apex:define name="requiredSupplier">
                                            <div class="requiredInput">
                                                <div class="requiredBlock" style="{!IF(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>                                  
                                                <!--start changes for CMI 2016 December release-->
                                                <!--Added onclick function-->
                                                <apex:inputField value="{!case.Vendor_Search__c}" onclick="vendorsearch();">
                                                <!--start changes for CMI 2016 December release-->
                                                <!--End Changes for CMI 2014 break/fixes-->
                                                    <apex:actionSupport event="onchange" action="{!populateSupplierRelatedFields}" reRender="supplierDetailsPanel,clientFeedback" status="ClientFeedbackStatus"/>
                                                </apex:inputField>
                                    
                                            </div>
                                        </apex:define>
                               </apex:pageBlockSectionItem>
                               <!--End Changes for CMI 2014-->
                               
                                <apex:pageBlockSectionItem rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='') }" />
                                
                                <!--Start Changes for CMI 2014 release 3-->                
                                <apex:pageBlockSectionItem id="Supplierblock" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) && case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c!='' }">
                                    <apex:outputlabel value="Complaint from or about a Supplier?"/>
                                        <apex:define name="requiredComplaintFromSupplier">
                                            <div class="requiredInput">
                                                <div class="requiredBlock" style="{!IF((case.Vendor_Search__c!=Null&&case.Vendor_Search__c!='')|| case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>  
                                                <apex:inputField value="{!case.Complaint_From_or_About_A_Supplier__c}" id="SupplierField"></apex:inputField>
                                            </div>
                                        </apex:define>
                                </apex:pageBlockSectionItem>
                                </apex:pageBlockSection>
                                <!--End Changes for CMI 2014 release 3-->
                                <apex:pageBlockSection columns="1">

                                <apex:pageBlockSectionItem rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c=='Other Department',case.Is_Feedback_regarding_a_TM_Dept__c <>'')}">
                                    <apex:outputlabel value="Other Department List"/>
                                    <apex:define name="otherDepartment">
                                         <div class="requiredInput">
                                            <div class="requiredBlock"/>   
                                            <apex:inputField value="{!case.Other_Department_List__c}"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                </apex:pageBlockSection>
                               
                               <!--Start Changes for CMI September 2017 Release-->
                               <apex:outputPanel id="servicingInteractionDispositonFields">
                                   <!--Start Changes for CMI October 2017 Release-->
                                   <!--Start Changes for CMI April 2018 Release-->
                                   <!--Servicing interaction fields to display when Tracking only:Feedback condition--> 
                                   <apex:pageblockSection columns="1" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate' && (case.type=='Complaint' || case.type=='Tracking Only: Feedback')}">
                                   <!--End Changes for CMI April 2018 Release-->
                                   <!--End Changes for CMI October 2017 Release-->     
                                        <apex:pageBlockSectionItem >
                                            <apex:outputLabel value="Servicing Interaction Disposition"/>
                                            <apex:inputField value="{!case.Srvc_Interaction_Disposition__c}"/> 
                                        </apex:pageBlockSectionItem> 
                                        <br/>  
                                        <apex:pageBlockSectionItem rendered="{!OR(($Profile.Name =='CFS & MH Phone/Research Manager'),($Profile.Name =='CFS Phone/Research User'),($Profile.Name =='CFS Phone/Research Manager'),($Profile.Name =='CLEAR Manager'),($Profile.Name =='CARRT Manager'),($Profile.Name =='MERT Manager'),($Profile.Name =='Social Media Manager'),($Profile.Name =='Operations Managers'),($Profile.Name =='CPR Manager'),($Profile.Name =='System Administrator'))}">
                                            <apex:outputLabel value="Servicing Interaction Comments"/>
                                            <apex:inputTextarea value="{!case.Srvc_Interaction_Comments__c}" cols="80" rows="7"/>
                                        </apex:pageBlockSectionItem>
                                        <apex:pageBlockSectionItem rendered="{!AND(($Profile.Name !='CFS & MH Phone/Research Manager'),($Profile.Name !='CFS Phone/Research User'),($Profile.Name !='CFS Phone/Research Manager'),($Profile.Name !='CLEAR Manager'),($Profile.Name !='CARRT Manager'),($Profile.Name !='MERT Manager'),($Profile.Name !='Social Media Manager'),($Profile.Name !='Operations Managers'),($Profile.Name !='CPR Manager'),($Profile.Name !='System Administrator'))}">
                                            <apex:outputLabel value="Servicing Interaction Comments" />
                                            <apex:outputfield value="{!case.Srvc_Interaction_Comments__c}" />
                                        </apex:pageBlockSectionItem>                                 
                                  </apex:pageblockSection>
                              </apex:outputPanel>
                              <!--End Changes for CMI September 2017 Release-->
                               
                               
                               <apex:pageBlockSection columns="1">                                
                                <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.CreatedDate>rel2DeploymentDateValue && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && (case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback')}" > 
                                    <apex:outputLabel value="Servicing Challenges Category"/>
                                    <apex:define name="requiredServicingCategory">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>  
                                            <apex:inputfield value="{!case.Servicing_Challenges_Category__c}"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>  
                            </apex:pageBlockSection>                                                     
    
                  <!--Start Change Feb 2017-->
                    <apex:pageBlockSection columns="1" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.CreatedDate>rel2DeploymentDateValue && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && (case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback')}" > 
                        <apex:pageBlockSectionItem > 
                             <apex:outputLabel value="Servicing Challenges Reported"/>                          
                             <apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7" />                            
                        </apex:pageBlockSectionItem> 
                    </apex:pageBlockSection> 
                    <!--End Change Feb 2017--> 
    
    
                        </apex:actionRegion>
                        <!--End Changes for CMI 2014-->
                        <!--End changes for CMI 2015 Iteration 2-->
            
            
                        <apex:pageblocksection columns="1" >                
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Client Feedback"/>
                                <apex:define name="requiredQ2">
                                            <div class="requiredInput">
                                                <div class="requiredBlock"></div>
                                <apex:inputTextArea required="{!case.Type = 'Complaint'}" value="{!case.Description}" cols="80" rows="7"/>
                                </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            <br/>
                        </apex:pageblocksection>
                        
                        <!--Start changes for CMI 2016 April Release.Prior Contacts and Prior Contacts Utilized fields are displayed-->
                        <apex:pageBlockSection columns="1" id="priorContacts" rendered="{!case.CreatedDate>bugAprilDeploymentDateValue}">
                            <apex:pageBlockSectionItem helpText="Include the number of contacts client stated and/or contacts discovered during research.">                        
                                <apex:outputLabel value="# of Prior Contacts"/>
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Number_of_Prior_Contacts__c}">
                                        <apex:actionSupport event="onchange"  reRender="priorContacts" status="ClientFeedbackStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:inputField value="{!case.Prior_Contacts_Utilized__c}" required="{!case.Number_of_Prior_Contacts__c!='No Prior Contacts Noted' && case.Number_of_Prior_Contacts__c!=Null}"/> 
                            <apex:pageBlockSectionItem helpText="In addition to teammate identified in teammate search, list all other persons identified in the complaint. Include RACF IDs for teammates where appropriate.">                        
                            <apex:outputLabel value="Other Persons Identified in Complaint"/> 
                            <!--Start Changes for CMI Pilot--> 
                            <!--<apex:define name="requiredClientFeedback"> 
                                <div class="requiredInput"> 
                                    <div class="requiredBlock"></div> -->
                                    <!-- Removed the Required= "True" attribute to display our custom error message --> 
                                    <apex:inputTextArea value="{!case.Other_Persons_Identified_in_Complaint__c}" cols="80" rows="7" /> 
                                <!--</div> 
                            </apex:define>-->
                        </apex:pageBlockSectionItem>   
                        </apex:pageBlockSection>
                        <!--End changes for CMI 2016 April Release-->
                        
                        <apex:actionStatus id="ClientFeedbackStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    
                        <!--Start Changes for CMI 2014-->
                        <!-- ******************************************* --> 
                        <!-- *        SUPPLIER DETAILS SECTION         * -->
                        <!-- ******************************************* --> 
                                
                        <!--Start of SupplierDetailsPanel-->
                        <apex:outputPanel id="supplierDetailsPanel">
                            <apex:pageBlockSection title="Supplier Details" columns="2" rendered="{!((case.Type='Complaint' || case.Type='Positive Feedback/Compliment') && (((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier') && (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) || (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='No')))}">
                                <apex:outputField value="{!case.Business_Owner__c}"/>
                                <apex:outputField value="{!case.Service_Manager__c}"/>
                                <apex:outputField value="{!case.Supplier_Manager__c}"/>
                                <apex:inputField value="{!case.Supplier_Services__c}"/>
                            </apex:pageBlockSection>
                        </apex:outputpanel>
                        <!--End of SupplierDetailsPanel"-->
                        <!--End Changes for CMI 2014-->
                    </apex:outputpanel>
             </apex:outputpanel>         
             <!-- ************************************************** --> 
            <!-- *   C O M P L I A N C E   E V A L U A T I O N    * -->
            <!-- ************************************************** --> 

            <apex:outputpanel id="ComplianceEvaluationPanel" >
                <apex:outputpanel id="ComplianceEvaluation" >
                    <!--The below output panel is added for CMI 2015 Iteration 2 as it should render for old cases only-->
                    <apex:outputpanel rendered="{!case.CreatedDate<rel2DeploymentDateValue}">

                        <!--Start changes for CMI 2014-->
                        <!--For CMI 2014, the labels of the Questions have been changed along with the alignment.-->
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->               
                        <apex:pageBlockSection title="Feedback/Complaint Designation" columns="2" collapsible="true" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Resolved by Point of Contact?" for="quest1"/><!--outputLabel changed for CMI 2014-->
                                <apex:define name="requiredQ1">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1"/>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Allegation of wrongful/unethical conduct?" for="quest2"/><!--outputLabel changed for CMI 2014-->
                                <apex:define name="requiredQ2">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.PCQ_Q2__c}" id="quest2">
                                                <!--Commented for CMI 2014,PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c--> 
                                                <!--<apex:actionSupport event="onchange" rerender="Quest2DependentQuestions,Question2DependentQuestions,Quest2ADependentQuestions,Question2BDependentQuestions" status="ComplianceEvaluationStatus" />-->
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>                   
                        </apex:pageBlockSection>
                        
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->  
                        <apex:pageBlockSection id="Quest2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <!--rendered attribute is removed for CMI 2014,PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Reg/Law Cited?" for="quest3"/><!--outputLabel changed for CMI 2014-->
                                <apex:define name="requiredQ2A">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.PCQ_Q2_A__c}" id="quest3">  
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->                    
                        <apex:pageBlockSection id="Quest2ADependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}"/><!--outputLabel changed for CMI 2014-->                       
                                <apex:define name="requiredLawOrReg">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}">  
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/>                         
                                <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                        
                            </apex:pageBlockSectionItem>                        
                        </apex:pageBlockSection>
                        
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->  
                        <apex:pageBlockSection id="Question2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">                        
                            <apex:pageBlockSectionItem >
                                <!--rendered attribute is removed for CMI 2014,PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="High Risk Terms" for="quest6"/><!--outputLabel changed for CMI 2014-->
                                <apex:define name="requiredQ2B">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >                        
                                            <apex:inputField value="{!case.PCQ_Q2_B__c}" id="quest6">
                                                <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}"  rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->  
                        <apex:pageBlockSection id="Question2BDependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Select specific High Risk Terms" for="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}"/><!--outputLabel changed for CMI 2014-->                        
                                <apex:define name="requiredHighRisk">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}">
                                                <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}"  rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <!--Other High Risk Terms field added for CMI 2014-->
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                       
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    <!--End changes for CMI 2014-->        
                    </apex:outputpanel>
                    <!-- Start Changes for CMI 2014 Release 3 -->
                    
                    <!--Start changes for CMI 2105 Iteration 2-->
                    <!--The below section should be rendered for cases created after CMI 2015 Iteration 2--> 
                    <apex:outputPanel rendered = "{!case.CreatedDate>rel2DeploymentDateValue}">
                        <apex:pageBlockSection title="Feedback/Complaint Designation" columns="2" collapsible="true" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Resolved by Point of Contact?" for="quest1Section2"/> 
                                <apex:define name="requiredQ1"> 
                                    <div class="requiredInput"> 
                                        <div class="requiredBlock"></div> 
                                        <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1Section2"/> 
                                    </div> 
                                </apex:define> 
                            </apex:pageBlockSectionItem>                                                                                          
                        </apex:pageBlockSection>    
                        <!--Start changes for CMI 2016 June Release-->                      
                        <apex:pageBlockSection id="Quest2RegLawCited" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Reg/Law Cited?" for="questReg"/>
                                <apex:define name="requiredQ2A">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.PCQ_Q2_A__c}" id="questReg">  
                                                <apex:actionSupport event="onchange" action="{!nullifyPCQ2RelatedFields}" rerender="Quest2ADependentQuestionsSection2" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        <!--End changes for CMI 2016 June Release--> 
                        <apex:pageBlockSection id="Quest2ADependentQuestionsSection2" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null )}"> 
                            <apex:pageBlockSectionItem rendered="{!case.PCQ_Q2_A__c ='Yes'}"> 
                                <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" />     
                                <apex:define name="requiredLawOrRegSection2">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion > 
                                            <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4Section2">
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestionsSection2" status="ComplianceEvaluationStatus" /> 
                                            </apex:inputField> 
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem> 
                            
                            <apex:pageBlockSectionItem rendered="{!case.PCQ_Q2_A__c ='Yes'}">
                                <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/> 
                                <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                       
                            </apex:pageBlockSectionItem>                         
                        </apex:pageBlockSection> 
                        
                                                             
                        <apex:pageBlockSection id="Question2BDependentQuestionsSection2" columns="1" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                            <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7Section2"/>
                                <apex:define name="requiredHighRisk">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7Section2">
                                                <apex:actionSupport event="onchange" rerender="Question2BDependentQuestionsSection2" status="ComplianceEvaluationStatus" action="{!renderOtherHighRiskTerms}"/>
                                            </apex:inputField> 
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <!--For CMI 2015 Iteration 2 rendered="{!case.PCQ_Q2_B__c='Yes'}" is removed from the output label and input field-->
                                <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                       
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel> 
                    <!--End changes for CMI 2015 Iteration 2-->
                    
                    <apex:actionRegion >
            <!--    <apex:pageBlockSection columns="1" >
                        <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                            <apex:outputLabel style="font-weight:bold" value="Submitter Feedback"/>

                            
                                <apex:inputField value="{!case.Submitter_Feedback__c}">
                                    <apex:actionSupport event="onchange" rerender="feedbackSub" status="MainStatusSub"/>
                                </apex:inputfield>
                           
                        </apex:pageBlockSectionItem>
                        
                         <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                            <apex:outputLabel value="Submitter Feedback Details"/>
                          
                           <apex:inputField value="{!case.Submitter_Feedback_Details__c}" >
                               <apex:actionSupport event="onchange" rerender="feedbackSub" status="MainStatusSub"/>
                          </apex:inputField>
                         
                        </apex:pageBlockSectionItem>
                            
               </apex:pageBlockSection>  
                
               
                <apex:pageBlockSection id="feedbackSub" >         
                        <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                        <apex:outputLabel value="Submitter Feedback Comments"/>
                        <apex:define name="requiredClientFeedback">
                        <div class="requiredInput">        
                        <div class="requiredBlock" style="{!IF(OR(CONTAINS(case.Submitter_Feedback__c,'Other'),NOT(ISNULL(case.Submitter_Feedback_Details__c))),'background-color:C00','background-color:transparent')}"></div>    
                         
                           <apex:inputfield value="{!case.Submitter_Feedback_Comments__c}" style="width:300px;height:55px;" />
                       
                        </div>
                        </apex:define>   
                        </apex:pageBlockSectionItem>
                            
                </apex:pageBlockSection>  -->
               </apex:actionRegion>
               
               <br/> 
                 <apex:actionStatus id="MainStatusSub"> 
                    <apex:facet name="start"> 
                        <div style="text-align:center;"> 
                            <img src="{!$Resource.SpinIcon}"/> 
                        </div> 
                    </apex:facet> 
                </apex:actionStatus>
                        
                    
                    
                    <apex:pageBlockSection columns="2" rendered="{!case.Type='Complaint'}">
                        <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}" >
                            <apex:outputLabel style="font-weight:bold" value="Was PCQ Information Sufficient/Accurate?"/>
                            <apex:inputField value="{!case.Was_TM_Information_Sufficient_Accurate__c}"/>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}">
                            <apex:outputLabel style="font-weight:bold" value="PCQ Information Comments"/>
                            <apex:inputField value="{!case.TM_Information_Comments__c}" style="width:300px;height:45px;"/>
                        </apex:pageBlockSectionItem>   
                    </apex:pageBlockSection>                 
                    <!-- End Changes for CMI 2014 Release 3 -->
                    
                    <apex:actionStatus id="ComplianceEvaluationStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputpanel>
            </apex:outputpanel>
            <!--end of "ComplianceEvaluationPanel"-->
                                                                  
            <apex:outputPanel id="FeedbackPanel">
            <apex:outputPanel rendered="{!case.Type!='CFS Tracking Only'}">
                <apex:pageBlockSection id="Feedback_Category" title="Feedback Category" columns="1" >
                   <!-- <apex:outputField value="{!case.Submitter_Category__c}"/>
                    <apex:outputField value="{!case.Submitter_Sub_Category__c}"/>    -->
                    
                            <!--Start changes for CMI 2016 July Release.Filtering of Categories using Search Text implemented-->
                            <apex:pageBlockSectionItem rendered="{!case.Origin != 'CFS Mortgage'}" id="catSearch1">
                                    <apex:outputLabel value="Search Category"/>
                                    <apex:actionRegion >                              
                                        <apex:inputText value="{!textValue}" onkeypress="return noenter1(event);"/>
                                        <apex:commandButton value="Search" action="{!searchCattrue}"  rerender="FeedbackPanel" status="FeedbackCategoryStatus" id="catSearchButton1"/>
                                        <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!displaytheValue = true}" style="color:red;font-weight:bold;"/>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem rendered="{!case.Origin = 'CFS Mortgage'}" id="catSearch2">
                                    <apex:outputLabel value="Search Category"/>
                                    <apex:actionRegion >                              
                                        <apex:inputText value="{!textValue}" onkeypress="return noenter2(event);"/>
                                        <apex:commandButton value="Search" action="{!searchCattrue}"  rerender="FeedbackPanel" status="FeedbackCategoryStatus" id="catSearchButton2"/>
                                        <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!displaytheValue = true}" style="color:red;font-weight:bold;"/>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                
                                <!--End changes for CMI 2016 July Release-->
                                
                                <!--Start changes for CMI 2016 June Release-->
                       
                              <apex:outputPanel rendered="{!case.Origin != 'CFS Mortgage'}">
                              <apex:pageblocksection columns="1">
                              <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Cat Level 3" for="level3choice"/>
                                    <apex:define name="requiredSubmitterCategoryLevel3">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <!--<apex:selectList value="{!Level3Choice}" multiselect="False" size="10" id="level3choice">
                                                    <apex:selectOptions value="{!SubmitterLevel3Choices}"/>
                                                    <apex:actionSupport event="onchange" action="{!updateLists}" reRender="FeedbackPanel" status="FeedbackCategoryStatus"/>-->
                                                    <apex:selectList value="{!case.Cat_Level_3__c}" multiselect="False" size="10" id="level3choice">
                                                    <apex:selectOptions value="{!PlvForCatLevel3}"/>
                                                    <apex:actionSupport event="onchange"  action="{!searchCatLevelFalse}" reRender="FeedbackPanel"  status="FeedbackCategoryStatus"/>

                                                </apex:selectList>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                <!--End changes for CMI 2016 June Release-->
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Cat Level 4" for="level4choice"/>
                                    <!--Start Changes for CMI Pilot-->
                                    <apex:define name="requiredSubmitterCategory">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <!--End Changes for CMI Pilot-->
                                          <apex:actionRegion >
                                                <!--<apex:selectList value="{!Level4Choice}" multiselect="False" size="10" id="level4choice">
                                                    <apex:selectOptions value="{!SubmitterLevel4Choices}"/>
                                                    <apex:actionSupport event="onchange" action="{!updateLists}" reRender="FeedbackPanel" status="FeedbackCategoryStatus"/>-->
                                                    <apex:selectList value="{!case.Cat_Level_4__c}" multiselect="False" size="10" id="level3choice">
                                                    <apex:selectOptions value="{!PlvForCatLevel4}"/>
                                                    <apex:actionSupport event="onchange"  action="{!searchCatLevelFalse}" reRender="FeedbackPanel"  status="FeedbackCategoryStatus"/>

                                                </apex:selectList>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                    <!--End Changes for CMI Pilot-->
                               </apex:pageBlockSectionItem>
                                
                                
                                    <apex:pageBlockSectionItem >
                                        <apex:outputLabel value="Cat Level 5" for="level5choice"/>
                                        <!--Start Changes for CMI Pilot-->
                                       <apex:define name="requiredSubmitterSubCategory">
                                            <div class="requiredInput">
                                                <div class="requiredBlock"></div>
                                                <!--End Changes for CMI Pilot-->
                                                <apex:actionRegion >
                                                    <!--<apex:selectList value="{!Level5Choice}" multiselect="False" size="10" id="level5choice">
                                                        <apex:selectOptions value="{!SubmitterLevel5Choices}"/>
                                                        <apex:actionSupport event="onchange" action="{!updateLists}" reRender="FeedbackPanel" status="FeedbackCategoryStatus"/>-->
                                                        <apex:selectList value="{!case.Cat_Level_5__c}" multiselect="False" size="10" id="level3choice">
                                                    <apex:selectOptions value="{!PlvForCatLevel5}"/>
                                                    <apex:actionSupport event="onchange"  action="{!searchCatLevelFalse}" reRender="FeedbackPanel"  status="FeedbackCategoryStatus"/>

                                                    </apex:selectList>
                                                </apex:actionRegion>
                                            <!--Start Changes for CMI Pilot-->
                                            </div>
                                        </apex:define>
                                        <!--End Changes for CMI Pilot-->
                                    </apex:pageBlockSectionItem>
                                    </apex:pageblocksection>
                                </apex:outputPanel>    
                                    
                                    
                                                                                                  
                              <apex:outputPanel rendered="{!case.Origin = 'CFS Mortgage'}"> 
                               <apex:pageblocksection columns="1">
                                    <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Cat Level 3" for="level3choice"/>
                                    <apex:define name="requiredSubmitterCategoryLevel3">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:selectList value="{!case.Cat_Level_3__c}" multiselect="False" size="10" id="level3choice">
                                                    <apex:selectOptions value="{!PlvForCatLevel3}"/>
                                                    <apex:actionSupport event="onchange"  action="{!searchCatLevelFalse}" reRender="FeedbackPanel"  status="FeedbackCategoryStatus"/>
                                                </apex:selectList>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Cat Level 4" for="level4choice"/>
                                    <!--Start Changes for CMI Pilot-->
                                    <apex:define name="requiredSubmitterCategory">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <!--End Changes for CMI Pilot-->
                                            <apex:actionRegion >
                                                <apex:selectList value="{!case.Cat_Level_4__c}" multiselect="False" size="10" id="level4choice">
                                                    <apex:selectOptions value="{!PlvForCatLevel4}"/>
                                                    <apex:actionSupport event="onchange" action="{!searchCatLevelFalse}" reRender="FeedbackPanel"  status="FeedbackCategoryStatus"/>
                                                </apex:selectList>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                    <!--End Changes for CMI Pilot-->
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                        <apex:outputLabel value="Cat Level 5" for="level5choice"/>
                                        <!--Start Changes for CMI Pilot-->
                                        <apex:define name="requiredSubmitterSubCategory">
                                            <div class="requiredInput">
                                                <div class="requiredBlock"></div>
                                                <!--End Changes for CMI Pilot-->
                                                <apex:actionRegion >
                                                    <apex:selectList value="{!case.Cat_Level_5__c}" multiselect="False" size="10" id="level5choice">
