
<!--For CMI2014 Release 2,in the below line CategoryLists_ControllerExtension is added and CodependentLists_ControllerExtension is removed for proper SubmitterCategory and SubmitterSubCategory values while creating Case-->
<apex:page standardController="Case" action="{!retrieveArrangementSummariesList}" extensions="CategoryLists_ControllerExtension,CMIClientManagement_ControllerExtension,ExecutiveServiceEdit_ControllerExtension" showHeader="True" sidebar="False" id="id1">
    <apex:messages style="color:red;font-weight:bold;"/>
    
  
   <script type="text/javascript" > 
    
    var originalOnload = window.onload;
   window.onload = f1;
   
   function f1() 
        {
            originalOnload();
            if(document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='Non SunTrust Impact')
            { 
                document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseDetails}').style.display='none';
            }         
        }  
    
    function hidefieldsrootCauseDetail()
        {
         
        if(document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='' || document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseFields.id3}').value=='Non SunTrust Impact')
             {
                 
                 document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseDetails}').style.display='none';
             }
             else
             {
                 document.getElementById('{!$Component.id1.editForm.ESEdit.rootCauseDetails}').style.display='block';
             }
        }
        <!--start changes for CMI 2016 December release-->
       <!--Complaint From or About A Supplier is nullified on selecting supplier search--> 
     function vendorsearch()
     {
         document.getElementById('{!$Component.id1.editForm.ESEdit.clientFeedbackDetails.SupplierBlock.SupplierField}').value='';    
     }
     <!--End changes for CMI 2016 December release-->   
        function noenter(e)
         {
            if(window.event)
            {
                key = window.event.keyCode; 
            } 
            else
            {
                key = e.which; 
            }
            if(key == 13) 
            {
                var ele=document.getElementById('id1:editForm:ESEdit:fbcat:fbcat1:catButton:catSearchButton');
                ele.click();
                return false;
            } 
            else
            {
                return true;
            }
         }
    
    </script>
    
    <apex:form id="editForm">
        <!-- B-2078 changes for CMI September 2018 Release--> 
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
        <!-- End of B-2078 changes for CMI September 2018 Release-->
        <apex:pageBlock title="CARRT Case" mode="edit" id="ESEdit">
        
        
            
            
            <apex:pageBlockButtons location="both">
                <apex:commandbutton action="{!save}" value="Save"/>
                <apex:commandbutton action="{!cancel}" value="Cancel"/>
            </apex:pageBlockButtons>
            
            <!-- *************************************** --> 
            <!-- *   C A S E   I N F O R M A T I O N   * -->
            <!-- *************************************** -->
            <apex:actionRegion > 
                <apex:pageBlockSection title="Case Information" columns="2" >
                    <apex:outputField value="{!case.CaseNumber}"/>
                    <apex:outputField value="{!case.RecordTypeId}"/>
                    <apex:outputField value="{!case.OwnerId}"/>
                <!-- ********************************************* -->
                <!-- *   DR-2656 September 2018 monthy Release   * -->
                <!-- ********************************************* -->
                <!----Start changes for DR-2656 for September 2018 Release -->
                   <apex:inputField value="{!case.Case_Group_Assignment__c}" />
                <!----End changes for DR-2656 for September 2018 Release -->
                </apex:pageBlockSection>
                
                <apex:pageBlockSection columns="2">
                
                    <apex:pageBlockSectionItem > 
                        <apex:outputlabel value="Case Origin" /> 
                            <apex:define name="requiredInputDiv"> 
                                <div class="requiredInput"> 
                                    <div class="requiredBlock"></div>    
                                    <apex:inputField value="{!case.Origin}"/>
                                </div> 
                            </apex:define> 
                    </apex:pageBlockSectionItem> 
                
                    <!-- Start Changes for CMI 2014 Release 3 -->
                    <c:CustomLookup value="{!Case.Submitter__c}" object="Contact" objectName="Case" fieldName="Submitter__c" displayFields="Email,Title,Phone" rendered="{!AND(NOT(LossMitigationManagerProfile), NOT(LossMitigationManagerSpecialist), NOT(LossMitigationManagerWFC))}" />                
                    <!-- End Changes for CMI 2014 Release 3 -->
                    <!--Start Changes for CMI 2014-->
                    <!--Commented for CMI 2014, as Supplier Details section and Feedback/Complaint Designation section have to be rendered on basis of Case Type-->
                    <!--A pageBlockSectionItem has been included for Case Type.-->
                    <apex:pageblocksectionitem >
                        <apex:outputLabel value="Case Type"/>               
                        <!--<apex:actionRegion >-->
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div>  
                                <apex:inputField value="{!case.Type}">
                                <!--clientRelatedFields added in rerender attribute for CMI 2014.1 break/fixes-->
                                <!--Start Changes for CMI October 2017 Release-->
                                    <apex:actionSupport event="onchange" rerender="MandatedSLADate,supplierDetailsPanel,SourceBlock,ComplianceEvaluation,clientRelatedFields,sourceReceivedDateTime,misdirectedCallPanel,clientFeedbackDetails,clientCaseResponse,servicingInteractionDispositonFields" status="MainStatus"/>
                                <!--End Changes for CMI October 2017 Release-->
                                </apex:inputField>
                             </div> 
                         </apex:define> 

                        <!--</apex:actionRegion>-->
                    </apex:pageblocksectionitem>
                    <!--End Changes for CMI 2014-->
                    
                </apex:pageBlockSection> 
                    
                <apex:pageBlockSection id="SourceBlock" columns="2">  
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Source of Feedback?" />
                        <!--<apex:actionRegion >-->
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div>   
                            <!--For CMI 2014 Release 3, FRBExtension is added in the rerender attribute of the below field-->
                                    <apex:inputField value="{!case.Call_Source__c}">
                                            <apex:actionSupport event="onchange" action="{!assignToSuntrustResponse}" rerender="SourceBlock, CFPBPanel,FRBExtension,ClientSectionAfterBypassingSearchClient" status="MainStatus"/>
                                    </apex:inputField>
                            </div> 
                        </apex:define>                         
                        <!--</apex:actionRegion>-->
                    </apex:pageBlockSectionItem>
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:pageBlockSectionItem rendered="{!case.Call_Source__c == 'Attorney General'}">
                        <apex:outputLabel value="AG State" />   
                            <apex:define name="requiredInputDiv"> 
                                <div class="requiredInput"> 
                                    <div class="requiredBlock"></div> 
                                    <apex:inputField value="{!case.AG_State__c}" rendered="{!case.Call_Source__c == 'Attorney General'}"/>
                                </div> 
                            </apex:define> 
                    </apex:pageBlockSectionItem>              
            
                    <apex:pageBlockSectionItem rendered="{!case.Call_Source__c == 'Agency'}"> 
                        <apex:outputLabel value="Agency Name" />   
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div> 
                                    <apex:inputText value="{!Case.Agency_Name__c}" maxLength="50"/>                             
                                </div> 
                        </apex:define> 
                    </apex:pageBlockSectionItem>             
                    <!-- End changes for CMI 2014 Release 3 -->
                </apex:pageBlockSection>
     
                <!-- Start Changes for CMI 2014 Release 2 -->
                <!-- Mandated SLA date field has been moved from Legacy section to Case Information section for release 2 -->
                <apex:pageBlockSection id="MandatedSLADate" columns="1" rendered="{!$ObjectType.Case.fields.Mandated_SLA_Date__c.Updateable}">
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Mandated SLA Date" rendered="{!case.Type='ES Tracking Only'}" />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div>    
                                    <apex:inputField value="{!case.Mandated_SLA_Date__c}" rendered="{!case.Type='ES Tracking Only'}" />
                            </div> 
                        </apex:define>
                    </apex:pageBlockSectionItem> 
                    <!--<apex:outputField value="{!case.Mandated_SLA_Date__c}" rendered="{!(case.Type='ES Tracking Only' && (userProfile!='Executive Services Manager' && userProfile!='Executive Services WFC'))}" />-->
                </apex:pageBlockSection>
                <!-- End Changes for CMI 2014 Release 2 -->
                
                                                             
                <apex:pageBlockSection columns="2" id="sourceReceivedDateTime">                           
                    <!--<apex:inputField value="{!case.QWR_Type__c}"/>
                    <br/>--><!--Commented for CMI 2014-->
            <!--        <apex:inputField value="{!case.Received_Date_Time__c}" required="True" />  -->
                    
                    <!--Start Changes for CMI 2014-->
                    
                    <!--Before CMI 2014, Source Recieved Date field was always rendered.-->
                    <!--For CMI 2014, Source Recieved Date/Time field got introduced.-->
                    <!--Due to which, the Source Recieved Date is rendered when the Case Edited had some data in the Source Recieved Date field.-->
                    <!--If the Edited Case, does not have any data in the Source Recieved Date, Source Recieved Date/Time field is rendered instead of Source Recieved Date field.-->
                    <!--In the controller, if the Source Recieved Date/Time is not Null, then its value is populated in Source Recieved Date field.-->
                    <!--This is done to ensure that there is no change required on Reports which are using the Source Recieved Date field-->
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:pageBlockSectionItem rendered="{!AND(AND(NOT(ISNULL(case.Source_Received_Date__c)), ISNULL(case.Source_Received_Date_Time__c)))}">
                        <apex:outputlabel value="Source Received Date/Time"/>
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock" style="{!IF(case.Type='Complaint','background-color:C00','background-color:transparent')}"></div>
                                <apex:inputField value="{!case.Source_Received_Date__c}"/>
                                
                            </div> 
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    
                    <!--Start changes for CMI 2015 Iteration 2.SRD Editable is added in the rendering condition for SourceReceivedDateTime-->
                    <apex:pageBlockSectionItem rendered="{!AND(OR(ISNULL(case.Source_Received_Date__c), NOT(ISNULL(case.Source_Received_Date_Time__c))),(SRDEditable))}">
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock" style="{!IF(case.Type='Complaint','background-color:C00','background-color:transparent')}" ></div>
                                <apex:inputField value="{!case.Source_Received_Date_Time__c}" rendered="{!SRDEditable}"/>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    <!--End changes for CMI 2015 Iteration 2.-->
                    
                    <apex:pageBlockSectionItem rendered="{!AND(OR(ISNULL(case.Source_Received_Date__c), NOT(ISNULL(case.Source_Received_Date_Time__c))),NOT(SRDEditable))}">  
                            <apex:outputlabel value="Source Received Date/Time"  />
                            <apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!!SRDEditable}"/>
                    </apex:pageBlockSectionItem>
                    
                
                                    <!-- Start Changes for CMI Pilot -->
                    <apex:outputField value="{!case.Special_Initiatives__c}" rendered="false" />
                    <apex:outputField value="{!case.Account_For_Open_Cases__c}" rendered="false" />
                    <apex:outputField value="{!case.Account_For_Closed_Cases__c}" rendered="false" />
                    <apex:inputField value="{!case.Owner.name}" rendered="false" />
                    <!-- End Changes for CMI Pilot -->
    
                </apex:pageBlockSection>
            </apex:actionRegion>
            
            <!--Start Changes for CMI 2014-->
            <apex:actionStatus id="MainStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->

            <!-- ******************************************* --> 
            <!-- *   C L I E N T   I N F O R M A T I O N   * -->
            <!-- ******************************************* --> 
          
            <apex:outputPanel id="ClientInfoPanel">

                <apex:pageBlockSection title="Client Information" columns="1">
                    <!--Commented for CMI 2014 because some fields are dependent on it. A pageBlockSectionItem is added for the same field-->
                     <!--Start Changes for CMI 2014-->
                    <apex:pageblocksectionitem >
                        <apex:outputlabel value="Is this a Client?"/>
                        <apex:actionRegion >
                            <!--The field is made required for CMI 2014-->
                            <apex:inputField value="{!case.Is_this_a_Client__c}" required="{!IF(case.Special_Initiatives__c=='CMI',true,false)}">
                                <!--In rerender modalDialog is added for CIS Search in CMI 2014 and ClientInfoPanel for CMI 2014 break/fixes-->
                                <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="ClientFollowUpSection,nameSearch,modalDialog,renderAccountDetails,ClientInfoPanel" status="ComplaintDetailStatus"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageblocksectionitem>
                    <!--End Changes for CMI 2014-->
                    
                    <!--Business or personal commented for autopopulation in CIS search for CMI 2014-->
                    <!--<apex:inputField value="{!case.Business_or_Personal__c}" />-->
                </apex:pageBlockSection>
                
                <!--Start changes for CIS Search for CMI 2014-->
                <apex:outputPanel id="modalDialog">
                    <apex:pageblockSection columns="2" rendered="{!case.Is_this_a_Client__c='Yes'}">
                        <!--For CMI 2014 Release 2, the disabled attribute has been added in the below button-->
                        <apex:commandButton style="margin-left:44%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch,LobAccountDetailsPanel" value="Search Client" disabled="{!case.BypassSearchProcess__c && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}"/>                                                                               
                        <apex:commandButton action="{!verifyCISClient}" style="margin-left:25%" immediate="true" value="Verify CIS Client" reRender="nameSearch,cisVerifyResults,jointAccountComponent"  status="VerifyCISClientStatus" rendered="{!(case.Origin='CMI WHL Standalone' || case.Origin='CMI WHL Salesforce') }"/>
                        <!--<c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                            <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>
                            <br/>                   
                        </c:Modal_Dialog>-->
                        <!--<c:Modal_Dialog id="jointAccountComponent" visible="{!openAccountList}" height="40%" top="30%">
                            <!--<c:JointAccountComponent caseReference="{!case}" searchResults="{!assignSearchResultsForJointAccount}"/>
                            <br/>-->
                            <!--<apex:pageblock >
                                <div style="border : solid 2px #000000; padding : 4px; height : '200px'; overflow : auto;">    
                                    <apex:dataTable value="{!assignSearchResultsForJointAccount}" var="result" rowClasses="odd,even" styleClass="list">
                                        <apex:column >
                                            <apex:facet name="header">Select</apex:facet>
                                            <input type="radio" name="Selected" value="{!result.PartyId}"/>
                                            <apex:param name="Selected" value="{!result.PartyId}"/>                        
                                        </apex:column>
                                        <apex:column value="{!result.Name}">
                                            <apex:facet name="header">Name</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.TIN}">
                                            <apex:facet name="header">TIN</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column >
                                            <apex:facet name="header">DOB</apex:facet>
                                            <apex:outputText value="{0,date,MM'-'dd'-'yyyy}"><apex:param value="{!result.DOB}"/></apex:outputText>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.AddressLine1}">
                                            <apex:facet name="header">Address Line1</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.City}">
                                            <apex:facet name="header">City</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.State}">
                                            <apex:facet name="header">State</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.Zip}">
                                            <apex:facet name="header">Zip</apex:facet>
                                        </apex:column>
                                        
                                        <apex:column value="{!result.Country}">
                                            <apex:facet name="header">Country</apex:facet>
                                        </apex:column>
                                    </apex:dataTable>
                                </div>                                                
                        </apex:pageblock>-->
                        <!--<div align='center'><apex:commandButton action="{!selectPartyAndAssignValues}" immediate="true" status="jointAccStatus" reRender="authorizedPartyPanel,accts,clientDetails,renderAccountDetails,accountSearch,nameSearch,accountSearch5,nameSearch5,accountSearch4,nameSearch4,LOBAccountDetailsPanel,accountSearch3,nameSearch3,accountSearch2,nameSearch2,accountSearch1,nameSearch1,accountDetailsAdded, ClientInfoPanelForComplaint, clientfollowupsection, ClientFollowUpSection, clientFollowUpSection, contactMethodFields, ClientSectionAfterBypassingSearchClient, ClientSectionAfterBypassingSearchClient1, ClientSectionAfterBypassingSearchClient2, ClientSectionAfterBypassingSearchClient3,renderAccountDetailsForCreateClient,ClientInfoPanel,ClientInfoPanel1,ClientInfoPanel2,ClientInfoPanel3,ClientInfoPanel4,LOBAccountDetailsPanel,lobAccountDetailsPanel,LobAccountDetailsPanel,accountFields,nameSearch,cisVerifyResults,jointAccountComponent" value="Select & Return To Case"/></div>
                        <apex:actionStatus id="jointAccStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                    <span class="waitingDescription">Verifying.Please wait...</span>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    </c:Modal_Dialog>-->                            
                    </apex:pageBlockSection>
                    <apex:outputPanel id="cisVerifyResults">
                        <!--<div style="text-align:center">
                            <apex:outputText Style="font-weight:bold;color:red;" value="{!assignInfoMessage}" rendered="{!(assignInfoMessage!=Null && assignInfoMessage!='')}"/>
                        </div>-->
                
                        <apex:pageBlockSection columns="1" rendered="{!(assignInfoMessage!=Null && assignInfoMessage!='')}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:21%;" value="{!assignInfoMessage}"/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>    
                    <apex:actionStatus id="VerifyCISClientStatus">
                        <apex:facet name="start">
                            <div style="margin-left:26%">
                                <img src="{!$Resource.SpinIcon}"/>
                                <span class="waitingDescription">Verifying.Please wait...</span>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                    <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='No'}">                        
                        <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>
                        <!--<c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                            <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase" />
                            <div style="text-align:center">
                                <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetailsForCreateClient" value="Return To Case" />
                            </div>
                            <br/>
                        </c:Modal_Dialog>-->                   
                    </apex:pageblockSection> 
                </apex:outputPanel>
                
                <!--Start Changes  for CMI 2014 Release 2-->
                <!--This section is added to bypass the client search when it is not displaying any results -->
                <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient">
                    <!-- For CMI 2014 Release 3, case origin is checked to render the box for bypassing search -->
                    <!--Start changes for CMI BBT Pilot M07 2020 - Rendered condition checked for BBT Internal-->
                    <apex:outputPanel rendered="{!((assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone') || (case.Call_Source__c = 'BBT Internal' && case.Is_this_a_Client__c = 'Yes'))}">                         
                    <!--End changes for CMI BBT Pilot M07 2020 -->
                        <apex:pageBlockSection >                         
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Bypass Client Search"/> 
                                <apex:actionRegion > 
                                    <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                       <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="ClientInfoPanel,LOBAccountDetailsPanel"  status="ClientStatus"/>
                                    </apex:inputCheckbox> 
                                </apex:actionRegion> 
                             </apex:pageblocksectionitem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection rendered="{!!case.BypassSearchProcess__c}">                         
                            <apex:pageBlockSectionItem >    
                                <apex:outputlabel value="Reason for Bypass"/> 
                                <apex:actionRegion > 
                                    <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}"/> 
                                </apex:actionRegion> 
                             </apex:pageblocksectionitem>
                        </apex:pageBlockSection>
                        <apex:pageBlockSection columns="1" rendered="{!assignArrangement.byPassSearchProcess  && case.BypassSearchProcess__c && case.Verify_Client_Check__c && (case.Client_Name__c == '' || case.Client_Name__c == null)}">                            
                            <apex:outputText Style="font-weight:bold;color:red;margin-left:21%" value="If the system is unavailable please try after sometime. If the client cannot be verified in both CRS and CIS, please create an observer."/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!(case.Reason_for_Overriding_Search_Process__c != null && !case.BypassSearchProcess__c && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">                         
                        <apex:pageBlockSection > 
                            <!-- Start Changes for CMI 2014 Release 3 -->
                            <apex:pageblockSectionItem >
                                <apex:outputlabel value="Reason for Bypass"/>
                                <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                            </apex:pageblockSectionItem>
                            <!-- End Changes for CMI 2014 Release 3 -->                        
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    <!-- End changes for CMI 2014 Release 3 -->
                </apex:outputPanel>
                <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                    <apex:outPutPanel rendered="{!case.BypassSearchProcess__c && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}">
                        <apex:pageBlockSection columns="1" >                              
                            <apex:pageBlockSectionItem >
                                <!-- Start Changes for CMI 2014 Release 3 -->
                                <apex:outputlabel value="Reason for Bypass"/>
                                <!-- End Changes for CMI 2014 Release 3 -->
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                        <apex:actionSupport event="onchange" rerender="CINField"  status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>                             
                        </apex:pageBlockSection>
                         
                          <apex:pageBlockSection id="authorizedClientDetailsBypass">
                             <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}" required="true" value="{!case.Contact_Name__c}"/> <br/>
                             <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}" required="true" value="{!case.Contact_Phone__c}"/>
                        </apex:pageBlockSection> 
                         
                        <apex:pageBlockSection id="CINField" columns="1">                              
                            <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available'}"/>
                            <!--Commented For CMI 2014 Release 3.TIN Field is not needed-->
                            <!--<apex:inputField value="{!case.TIN__c}" required="true"/>-->
                        </apex:pageBlockSection>
                            
                        <apex:pageBlockSection columns="1" >                              

                             <!--Start changes for CMI 2014 Release 3-->
                             <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Is This A Private Wealth Client?" />
                                 <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                        <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!--End changes for CMI 2014 Release 3-->

                             <!--Below Field is added for CMI 2014 Release 3-->
                             <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" required="true"/>
                            
                            <!--Start changes for CMI BBT Pilot M07 2020-->
                             <apex:inputField value="{!case.CIF__c}" required="false" rendered="{!(case.BypassSearchProcess__c && case.Call_Source__c = 'BBT Internal')}"/> 
                             <apex:outputField value="{!case.CIF__c}" rendered="{!case.BypassSearchProcess__c=False}"/>                                 
                             <!--End changes for CMI BBT Pilot M07 2020-->
                            
                             <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Account Type"/>
                                 <apex:actionRegion >
                                     <apex:inputField value="{!case.Account_Type__c}" required="true">
                                         <apex:actionSupport event="onchange" reRender="accTypeDetail,AlternateAddress,AccountNumber,ClientStateDetailsSection1,accTypeInput" status="AccountTypeStatus" action="{!defaultAccountTypeDetailField}"/>
                                     </apex:inputField>
                                 </apex:actionRegion>
                             </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <!--For CMI 2014 Release 3 required condition is added-->
                        <apex:pageBlockSection id="AccountNumber">
                            <apex:inputField id="AccountNumber" value="{!case.Account_Number__c}" required="{!case.Account_Type__c!="Treasury & Payment Solutions" && case.Account_Type__c!="Wholesale Other"}"/> 
                        </apex:pageBlockSection>


                        <apex:pageBlockSection id="isThisAuthThirdParty">
                            <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Is This An Authorized Third Party" />
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}">
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>

                        <apex:pageBlockSection id="accTypeDetail">
                            <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. -->
                            <!--Start of changes for feb 2017-->
                            <!--Account type detail should render for account type=Commercial loan-->
                            <apex:pageBlocksectionItem >
                            <apex:outputLabel value="Account Type Detail" rendered="{!case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Wholesale Other' || case.Account_Type__c='Consumer Loan' || case.Account_Type__c='Commercial Loan' || case.Account_Type__c = 'Treasury & Payment Solutions'}"/>
                            <apex:actionRegion >
                            <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Wholesale Other' || case.Account_Type__c='Consumer Loan' || case.Account_Type__c='Commercial Loan' || case.Account_Type__c = 'Treasury & Payment Solutions'}"  required="true">
                            <apex:actionSupport event="onchange" reRender="officeOfSupervisory" status="AccountTypeStatus"/>
                            </apex:inputField>
                            </apex:actionRegion>
                            
                            </apex:pageBlocksectionItem>
                            <!--End of changes for feb 2017-->
                            <!-- For CMI 2014 Release 3 the below field is added -->
                            <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card'}"/>                        
                        </apex:pageBlockSection>
                        
                        
                                           
                    </apex:outPutPanel>
                </apex:outPutPanel>
                <!--End Changes  for CMI 2014 Release 2-->
                <!--Start changes for CMI 2014 Release 3-->
                <apex:actionStatus id="AccountTypeStatus">
                   <apex:facet name="start">
                       <div style="text-align:center;">
                           <img src="{!$Resource.SpinIcon}"/>
                       </div>
                   </apex:facet>
               </apex:actionStatus>
                <!--End changes for CMI 2014 Release 3-->

                
                <!--For CMI 2014 Release 2, the two outPutPanels below have been added-->
                <apex:outPutPanel id="nameSearch"> 
                    <!--<apex:outPutPanel rendered="{!NOT(case.BypassSearchProcess__c)}">-->
                        <!-- Case Origin is checked in rendered condition for CMI 2014 Release 3 -->
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <apex:pageblockSection columns="2" rendered="{!(case.CIN__c!=Null) && (NOT(case.BypassSearchProcess__c) || case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" >
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}"/>
                                <apex:define name="requiredSelectAccount">
                                    <apex:actionRegion >                                    
                                        <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient)}">
                                            <apex:selectOptions value="{!accountsList}"/>
                                            <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="nameSearch,selectAccountModal, renderAccountDetails, renderAccountDetailsForCreateClient,accountFields,accTypeDetail1,relationshipManagedBySAD,crsWin" status="selectAccountStatus"/>
                                        </apex:selectList>                                               
                                   </apex:actionRegion>
                                </apex:define>
                            </apex:pageBlockSectionItem>                        
                            <!--Start changes for CMI 2016 April release.Client Name is displayed as a link to open the Related Account Record-->
                            <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null}">
                                <apex:outputLabel value="Client Name"/>
                                <apex:actionRegion >                                                                                                    
                                    <apex:commandLink status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!--End changes for CMI 2016 April release.--> 
                            <!--<apex:pageblockSectionItem rendered="{!case.CIN__c<>null}"></apex:pageblockSectionItem>-->                            
                            <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                            <apex:pageBlockSectionItem rendered="{!((stProductId!=null && stProductId!='') && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && selectedAccountInformation!='Other' && case.Client_Name__c!=Null && case.Client_Name__c!='')}">
                                <apex:outputLabel value="Account Number"/>
                                <apex:actionRegion >                                                                                                    
                                    <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(OR(stProductId=null,stProductId="") && case.Account_Number__c<>null && case.Special_Initiatives__c=='CMI' && selectedAccountInformation!='Other' && case.Client_Name__c!=Null && case.Client_Name__c!='')}" />
                            <!--End changes for CMI 2016 June Release.-->
                            <apex:inputField rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c!='CMI' || case.Account_Number__c=Null || case.Account_Number__c='' )&& selectedAccountInformation!='--NONE--' }" value="{!case.Account_Number__c}" />
                            <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                            <apex:outputField rendered="{!case.Account_Type__c<>null && case.Special_Initiatives__c=='CMI' && !renderAccountType && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type__c}" />                                                        
                            
                            <apex:pageBlockSectionItem rendered="{!(renderAccountType|| comingAfterCreatingClient || case.Special_Initiatives__c!='CMI')}">
                                <apex:outputlabel value="Account Type" rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c!='CMI')}"/>
                                <apex:actionRegion >                            
                                    <apex:inputField rendered="{!(renderAccountType || comingAfterCreatingClient || case.Special_Initiatives__c!='CMI')}" value="{!case.Account_Type__c}"  required="true">
                                        <apex:actionSupport event="onchange"  reRender="accTypeDetail1,ClientStateDetailsSection1,relationshipManagedBySAD,accTypeInput,lob,LOBAccountDetailsPanel,crsWin" status="selectAccountStatus" action="{!defaultAccountTypeDetailField}"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            
                            <apex:outputField rendered="{!case.Business_or_Personal__c<>null}" value="{!case.Business_or_Personal__c}"/>
                            <!--Fields for HH Information-->
                            <apex:pageblockSectionItem rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}"/>
                            <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>                                                                                    
                           </apex:pageblockSection>
                        
                        <apex:pageblockSection id="accTypeDetail1" rendered="{! NOT(case.BypassSearchProcess__c)}" > 
                            <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. --> 
                            <apex:pageBlockSectionItem rendered="{!((case.Account_Type__c='Private Wealth Mgmt') ) && case.Client_Name__c!=Null && case.Client_Name__c!=''}">   
                            <apex:outputLabel value="Account Type Detail" rendered="{!((case.Account_Type__c='Private Wealth Mgmt')) && case.Client_Name__c!=Null && case.Client_Name__c!=''}"/>
                            <apex:actionRegion >              
                            <apex:inputField rendered="{!((case.Account_Type__c='Private Wealth Mgmt')) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type_Detail__c}" required="true">
                                <apex:actionSupport event="onchange"  reRender="officeOfSupervisory" status="selectAccountStatus"/>
                            </apex:inputField>
                            </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!--Start of changes for feb 2017-->
                            <!--Account type detail should render for account type=Commercial loan-->
                            <apex:pageBlockSectionItem rendered="{!(case.Account_Type__c = 'Credit card' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c='Consumer Loan' || case.Account_Type__c='Commercial Loan') || (case.Business_or_Personal__c = 'Business' && case.Account_Type__c = 'Wholesale Other') ||  (case.Account_Type__c = 'Treasury & Payment Solutions')}">
                                    <apex:outputLabel value="Account Type Detail" />
                                    <apex:define name="requiredSelectAccount">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                                <apex:selectOptions value="{!acctTypeDetailFieldValue}"/> 
                                                <apex:actionSupport event="onchange"  reRender="officeOfSupervisory" status="selectAccountStatus"/>                                                   
                                            </apex:selectList>
                                        </div>
                                    </apex:define> 
                            </apex:pageBlockSectionItem>
                            <!-- For CMI 2014 Release 3 the below field is added -->
                            <!--End of changes for Feb 2017--> 
                            </apex:pageblockSection>
                            
                            
                        <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                            <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                            <br/>
                        </c:Modal_Dialog>
                        <apex:actionStatus id="selectAccountStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    <!--</apex:outPutPanel>-->
                </apex:outPutPanel><!--nameSearch-->

                <!--For CMI 2014 Release 2, the two outPutPanels below have been added-->
                <apex:outPutPanel id="accountFields"> 
                    <!-- Start changes for CMI 2014 Release 3 -->
                    <apex:pageblockSection rendered="{!(case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Client_Name__c == '' && selectedAccountInformation!='Other'}" columns="2">
                        <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                        <apex:pageBlockSectionItem rendered="{!stProductId!=null && stProductId!=''}">
                            <apex:outputLabel value="Account Number"/>
                            <apex:actionRegion >                                                                                                    
                                <apex:commandLink status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputfield value="{!case.Account_Number__c}" rendered="{!OR(stProductId=null,stProductId='')}" />
                        <!--End changes for CMI 2016 June Release.-->
                        <apex:outputField value="{!case.Account_Type__c}"/>
                    </apex:pageblockSection> 
                    <!-- End changes for CMI 2014 Release 3 -->
                    <!-- case origin checked for CMI 2014 Release 3 -->
                    <apex:outPutPanel rendered="{! NOT(case.BypassSearchProcess__c) || case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'}" >
                       
                        
                        <apex:outputPanel id="renderAccountDetailsForCreateClient" >
                        </apex:outputPanel>
                        <!--End changes for for CMI 2014 Release 2.-->                        
                    </apex:outPutPanel>
                </apex:outPutPanel><!--accountFields-->
                <!--End changes for CIS Search for CMI 2014-->                
                     
            <apex:pageBlockSection columns="2" id="clientRelatedFields">
               
               <apex:pageBlockSectionItem rendered="{!AND(OR(NOT(case.BypassSearchProcess__c),case.Origin='CMI WHL Salesforce',case.Origin='CMI WHL Standalone'),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}" >
                    <apex:outputlabel value="Is This An Authorized Third Party" />
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!AND(NOT(case.BypassSearchProcess__c))}" >
                            <apex:actionSupport event="onchange"  reRender="clientRelatedFields" status="ClientStatus"/>
                        </apex:inputField> 
                    </apex:actionRegion> 
               </apex:pageBlockSectionItem>
               <apex:pageblockSectionItem ></apex:pageblockSectionItem>                                                    
               <apex:inputField required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}" rendered="{!AND(OR(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No'),case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}"  />
               <apex:inputField rendered="{!AND(OR(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes', case.Is_This_An_Authorized_Third_Party__c = 'No'),case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'),OR((case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'),((case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone') && case.Contact_Method__c != 'Phone' )))}" value="{!case.Contact_Phone__c}"/>                               

        <!-- End changes for CMI 2014 Release 3 -->   


                </apex:pageBlockSection>

    
                <apex:pageBlockSection columns="2" id="functionalArea">
                   <!-- Start Changes for CMI Pilot -->
                   <!--The required condition is changed for CMI 2014-->
                   <!--For CMI 2014, Functional Area should be mandatory when Special Initiatives!=Null-->
                       <apex:inputField value="{!case.Functional_Role__c}"/>
                   <apex:inputField value="{!case.Functional_Area__c}" required="{!IF(AND(case.Special_Initiatives__c!=Null, $ObjectType.Case.fields.Functional_Area__c.Updateable),true,false)}"/> 
                </apex:pageBlockSection>
            
                <apex:outputPanel id="bypassClientContactMethodFields">
                    <apex:outputPanel rendered="{!case.BypassSearchProcess__c && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone'}">  
                        <!-- For CMI 2014 Release 3, origin is checked in rendered condition -->
                        <apex:pageBlockSection columns="2">
                             <apex:pageBlockSectionItem >
                                <apex:outputlabel value="Client Follow Up Needed?"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                        <apex:actionSupport event="onchange" action="{!clientFollowUpChanges}" reRender="bypassClientContactMethodFields" status="ClientStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                             </apex:pageBlockSectionItem>
                             <!-- Start changes for CMI 2014 Release 3 -->
                             <!-- Below PageBlockSectionItem is added inorder to place the field to COLUMN 2 of page block section -->
                             <!-- End Changes for CMI 2014 Release 3 -->
                             <apex:pageBlockSectionItem rendered="{!case.Client_Follow_Up_Needed__c='Yes'}"></apex:pageBlockSectionItem>
                             <apex:pageBlockSectionItem >
                                 <apex:outputlabel value="Contact Method" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" />
                                 <apex:actionRegion >
                                    <apex:inputField value="{!case.Contact_Method__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" required="true">
                                        <apex:actionSupport event="onchange" reRender="bypassClientContactMethodFields" status="ClientStatus" />
                                    </apex:inputField>
                                </apex:actionRegion> 
                             </apex:pageBlockSectionItem>
                             </apex:pageblocksection>
                            <apex:pageBlockSection columns="2">
                             <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Phone'}">
                                <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}"/>  
                                <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}" required="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>                                                                    
                             </apex:pageBlockSectionItem>
                             
                            
                             <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Phone'}">
                                 <apex:outputLabel value="Best Time To Call" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>  
                                 <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}" required="true"/>                                                                    
                             </apex:pageBlockSectionItem>
                             
                                                     
                             
                             <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Email'}">
                                <apex:outputlabel value="Alternate Email" rendered="{!(case.Contact_Method__c='Email')}"/>                                           
                                <apex:inputField value="{!case.Alternate_Email__c}" rendered="{!(case.Contact_Method__c='Email')}" required="true"/>                                    
                             </apex:pageblocksectionItem>
                        
                        </apex:pageblocksection>
                        <!--For CMI 2014 Release 3,Alternate Address Field is added to a new PageBlockSection.Because it is rendered based on AccountType Field-->
                        <apex:pageBlockSection id="AlternateAddress">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Alternate Address" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}"/>  
                                <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}" required="true"/>                                                                    
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                </apex:outputPanel>
                <!--For CMI 2014 Release 2, the below outputPanel is added-->
                <apex:outputPanel id="ClientFollowUpSection">
                    <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added for the below section-->
                    <!--For CMI 2014 Release 3, origin is checked in rendered condition-->
                    <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')}" Columns="1">
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Client Follow Up Needed?"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection" status="ComplaintDetailStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                       
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!case.Client_Follow_Up_Needed__c='Yes' && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="1">  
                        <apex:pageBlockSectionItem >
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:outputlabel value="Contact Method" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Is_this_a_Client__c!=Null)}"/>
                            <apex:actionRegion >
                                <!--Rendering conditions changed for CMI 2014-->
                                <!--Is this a Client condition included in rendering condition for CMI 2014-->
                                <!--Contact method is introduce in CMI Pilot-->
                                <apex:inputField value="{!case.Contact_Method__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Is_this_a_Client__c!=Null)}" required="true">
                                    <apex:actionSupport event="onchange" action="{!ClientFollowUpChanges}" reRender="ClientFollowUpSection,clientRelatedFields" status="ComplaintDetailStatus" />
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                       
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Phone') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        <!-- Start changes for CMI 2014 Release 3 -->
                         <!-- Below PageBlockSectionItem is added inorder to place the field to COLUMN 2 of page block section -->                        
                        
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}">                    
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}"/>
                            <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}" required="true"/>
                        </apex:pageBlockSectionItem>
                        
                        <!-- Client contact number output field added for CMI 2014 -->
                           <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}">
                            <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}"/>
                            <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && case.Client_Contact_Number__c!=null && case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')}" />                                        
                        </apex:pageBlockSectionItem>                
                        
                        <!--Start changes for CMI 2014 Release 3-->
                         
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}">
                            <apex:outputlabel value="Contact Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}"/>
                            <apex:inputField value="{!case.Contact_Phone__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes' && (case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone'))}" />                                        
                        </apex:pageBlockSectionItem> 
                        <!--End changes for CMI 2014 Release 3-->
                        
                        <!--Start changes for CMI 2014-->
                        
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}"/>  
                            <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c!=Null)}" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2014-->

                        <!-- Start changes for CMI 2014 Release 3 -->
                         
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}">
                            <!--Rendering conditions changed for CMI 2014-->
                            <!--Is this a Client condition included in rendering condition for CMI 2014-->
                            <apex:outputlabel value="Best Time To Call" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}"/>                                           
                            <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Is_this_a_Client__c='Yes')}" required="True"/>                                    
                        </apex:pageblocksectionItem>
                        <!--End changes for CMI 2014-->
                    </apex:pageblocksection>
                                       
                    <!--Start changes for CMI 2014-->
                    <!--Contact Address added for CMI 2014-->
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Mail') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                        
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}">
                            <!--inputField changed to outputField,required attribute is removed for CIS Search for CMI 2014-->
                            <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}"/>
                            <apex:inputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c=null)}" style="width:200px; height:100px" required="True"/>                                        
                        </apex:pageBlockSectionItem>

                        
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}">                            
                            <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                            <apex:outputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c='Yes' && case.Contact_Address__c!=null)}"/>
                        </apex:pageBlockSectionItem>
                            
                        
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}">
                            <apex:outputLabel value="Alternate Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}"/>  
                            <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Is_this_a_Client__c!=Null)}" style="width:200px; height:100px" required="{!IF(case.Is_this_a_Client__c='No',True,False)}"/>                                                                    
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                               
                    <!--Client Email added for CMI 2014-->
                    <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                    <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Email') && (NOT(case.BypassSearchProcess__c) || (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'))}" Columns="2">   
                       
                        <!--Start changes for CMI 2017 May Release-->
                        <!--Client Email Field and Alternate Email Field is displayed as optional if the Client Email is invalid from CIS-->
                        <apex:pageBlockSectionItem rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && case.Is_this_a_Client__c!=Null)}">
                            <apex:outputlabel value="Client Email" />                                           
                            <apex:inputField value="{!case.Client_Email__c}" required="true"/>                                    
                        </apex:pageblocksectionItem>                        
       
                        <!--End changes for CMI 2017 May Release-->
                        <!--End changes for CMI 2014-->                    
                    </apex:pageblocksection>                   
                    <!--end of ClientFollowUpSection-->
                </apex:outputPanel><!--ClientFollowUpSection-->                                   
                
                <!-- Start changes for CMI 2014 Release 3 -->
                <!-- Start changes for CMI 2015 Iteration 2 -->
                <apex:outputpanel id="LOBAccountDetailsPanel" title="LOB Account Details">
                <apex:actionRegion >   
                    <apex:pageBlockSection title="LOB Account Details" />
                    <div style="Margin-Left:2%">
                            <apex:outputText Style="font-weight:bold;" value="Private Wealth Client Details" rendered="{!(case.CIN__c!=Null) && (case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c =='PWM')}" />
                    </div>
                    
                    <apex:pageBlockSection id="IsThisPrivateWealthClient" rendered="{!NOT(case.BypassSearchProcess__c)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This A Private Wealth Client?" rendered="{!NOT(case.BypassSearchProcess__c)}"/>
                            
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!NOT(case.BypassSearchProcess__c)}" required="{!case.LOB_Relationship__c=='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Account_Type__c == 'Private Wealth Mgmt' || case.Account_Type__c == 'Investment Services'}">                                
                                    <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="lob,officerId"/>                                
                                </apex:inputField>
                            
                        </apex:pageBlockSectionItem>
                        <!--<apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!case.Case_Association_Type__c='Related Case'}"/>-->
                    </apex:pageBlockSection>
                    
                    <apex:outputPanel id="lob">
                            <apex:outputPanel rendered="{!(case.LOB_Relationship__c=='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Account_Type__c == 'Private Wealth Mgmt' || case.Account_Type__c == 'Investment Services' || case.Is_This_A_Private_Wealth_Client__c=='Yes')}">  
                                <apex:pageBlockSection columns="2" >
                                    <apex:outputField value="{!case.LOB_Relationship__c}" rendered="{!(case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c =='PWM')}"/>
                                    
                                    <apex:pageBlockSectionItem >
                                        <apex:outputlabel value="Relationship Id" />
                                        <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(case.Is_This_A_Private_Wealth_Client__c == 'Yes','background-color:C00','background-color:transparent')}"></div>
                                            <apex:inputField value="{!case.Relationship_ID__c}"  />
                                        </div>
                                        </apex:define>
                                    </apex:pageBlockSectionItem>
                                    
                                    <apex:pageBlockSectionItem >
                                        <apex:outputlabel value="Officer Search" />                                        
                                        <apex:define name="requiredClientFeedback">
                                        <div class="requiredInput">
                                            <div class="requiredBlock" style="{!IF(case.Is_This_A_Private_Wealth_Client__c == 'Yes','background-color:C00','background-color:transparent')}"></div>
                                                <apex:inputField value="{!case.Officer_Search__c}" onkeypress="return false;" onkeydown="return false;" >                                
                                                    <apex:actionSupport event="onchange" action="{!populateContactRelatedFields}" status="LOBDetailStatus" rerender="officerId"/>                                
                                                </apex:inputField>
                                            </div>
                                        </apex:define>   
                                    </apex:pageBlockSectionItem>
                                </apex:pageBlockSection>
                            </apex:outputPanel>
                        </apex:outputPanel>
                    
                    <apex:outputPanel id="officerId">
                        <apex:outputPanel rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes' || case.Account_Type__c == 'Private Wealth Mgmt' || case.Account_Type__c == 'Investment Services')}">
                             <apex:pageBlockSection columns="2" > 
                               <apex:outputField rendered="{!case.Officers_Employee_ID__c!=Null && case.Officers_Employee_ID__c!=''}" value="{!case.Officers_Employee_ID__c}"/>                            
                           </apex:pageBlockSection>
                        </apex:outputPanel>
                    </apex:outputPanel>
                    </apex:actionRegion>
                    <!-- End changes for CMI 2015 Iteration 2 -->
                    <br/> 

                    <div style="margin-Left:2%">
                        <apex:outputText Style="font-weight:bold;" value="Wholesale Client Details" />
                    </div>
     
                    <apex:actionRegion >
                        <div style="margin-left:19.5%">                  
                            <apex:commandLink id="theLink" action="{!displayCRSSearchWindow}" reRender="crsSearchWindow,crsSearchWindow1,crsWin" status="LOBDetailStatus" value="Click here to search in CRS" immediate="true"/>                                           
                        </div>  
                        <apex:pageBlockSection columns="2" id="crsWin">                    
                           
                            
                            <apex:pageBlockSectionItem >
                            <apex:outputLabel value="CRS#"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.CRS_Number__c}">
                                    <apex:actionSupport event="onchange"  rerender="relationshipManagedBySAD,crsWin" status="LOBDetailStatus" />                                
                                </apex:inputField>
                            </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This a Wholesale Client?" rendered="{!(!case.BypassSearchProcess__c || (case.BypassSearchProcess__c && (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')))}"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_this_a_Wholesale_Client__c}" rendered="{!(!case.BypassSearchProcess__c || (case.BypassSearchProcess__c && (case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone')))}" required="{!case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Merchant Services' || case.Account_Type__c = 'Treasury & Payment Solutions' || case.Account_Type__c = 'Wholesale Other' || case.CRS_Number__c != '' || case.Origin = 'CMI WHL Salesforce' || case.Origin = 'CMI WHL Standalone'}">                                
                                    <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="relationshipManagedBySAD"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>                       
                        </apex:pageBlockSection>
                        <apex:outputPanel id="relationshipManagedBySAD">                                 
                        <apex:pageBlockSection rendered="{! (case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card') && ((case.CRS_Number__c != '' && case.CRS_Number__c != null) || case.Is_this_a_Wholesale_Client__c='Yes' )&& !case.BypassSearchProcess__c }"> 
                            <apex:pageBlockSectionItem />
                            <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" />   
                        </apex:pageBlockSection>                         
                    </apex:outputPanel>
                        <div style="margin-left:20%">
                            <apex:commandButton action="{!searchWHLClient}" reRender="nameSearch,verifyResults,CRSFields,crsWin" value="Verify WHL Client" status="VerifyClientStatus"/>                                                             
                        </div>
                    </apex:actionRegion>
                    <div style="text-align:center">
                        <apex:outputText Style="font-weight:bold;color:red;" value="{!verifyClientMessage}" id="verifyResults"/>
                    </div>
                    <c:Modal_Dialog id="crsSearchWindow" visible="{!openSearchWindow}" >
                        <div style="text-align:center">
                            <apex:actionRegion >
                                <apex:commandButton value="Close" action="{!hideCRSSearchWindow}" reRender="crsWin,crsSearchWindow" status="ComplaintDetailStatus" style="align:center"/>                                     
                            </apex:actionRegion>
                        </div>
                        <apex:iframe src="http://crs.suntrust.com/FindEntity.aspx" scrolling="true" id="theIframe"/> 
                        <div style="text-align:center">
                            <apex:actionRegion >
                                <apex:commandButton value="Close" action="{!hideCRSSearchWindow}" reRender="crsWin,crsSearchWindow" status="ComplaintDetailStatus" style="align:center"/>                                     
                            </apex:actionRegion>
                        </div>
                    </c:Modal_Dialog>
                    <br/>
                    
                    <apex:actionStatus id="VerifyClientStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                                <span class="waitingDescription">Verifying.Please wait...</span>
                            </div>
                        </apex:facet>
                    </apex:actionStatus> 
                    <apex:outputPanel id="CRSFields">
                        <apex:pageBlockSection columns="2" rendered="{!(case.Origin != 'CMI WHL Salesforce' && case.Origin != 'CMI WHL Standalone')||((case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone')&& !case.BypassSearchProcess__c)}">
                            <apex:outputField value="{!case.Wholesale_Account_Name__c}" rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}"/>
                            <apex:outputField value="{!case.RelationshipManager__c}" rendered="{!case.RelationshipManager__c != null && case.RelationshipManager__c != ''}"/>   
                            <apex:outputField value="{!case.Rel_Mgr__c}" rendered="{!case.Rel_Mgr__c != null && case.Rel_Mgr__c != ''}"/>                   
                            <apex:outputField value="{!case.CRS_Client_or_Prospect__c}" rendered="{!case.CRS_Client_or_Prospect__c != null && case.CRS_Client_or_Prospect__c != ''}"/>
                            <apex:outputField rendered="{!case.Region__c <> null}" value="{!case.Region__c}" />
                            <apex:outputField rendered="{!case.LOB__c <> null}" value="{!case.LOB__c}" />
                            <apex:outputField rendered="{!case.Sub_LOB__c <> null}" value="{!case.Sub_LOB__c}" />
                            <apex:inputField rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}" value="{!case.Individual_On_Behalf_Of_Entity__c}" />                        
                            <apex:inputField rendered="{!case.Wholesale_Account_Name__c != null && case.Wholesale_Account_Name__c != ''}" value="{!case.WHL_Reference_Application_Date__c}" />                        
                        </apex:pageBlockSection>
                        <apex:pageBlockSection columns="2" rendered="{!(case.Origin == 'CMI WHL Salesforce' || case.Origin == 'CMI WHL Standalone')&& case.BypassSearchProcess__c}">
                            <apex:outputField value="{!case.BypassSearchProcess__c}"/>
                            <!-- Start Changes for CMI 2014 Release 3 -->
                            <apex:pageblockSectionItem >
                                <apex:outputlabel value="Reason for Bypass"/>
                                <apex:outputField value="{!case.Reason_for_Overriding_Search_Process__c}"/>
                            </apex:pageblockSectionItem>
                            <!-- End Changes for CMI 2014 Release 3 -->
                            <apex:outputField value="{!case.Contact_Name__c}"/>
                            <apex:outPutField value="{!case.Contact_Phone__c}"/>
                            <apex:outputField value="{!case.Is_this_a_Wholesale_Client__c}"/>
                            <apex:outputField value="{!case.Individual_On_Behalf_Of_Entity__c}"/>
                            <apex:outputField value="{!case.WHL_Reference_Application_Date__c}"/>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
    
                    <apex:actionStatus id="LOBDetailStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                    </apex:actionStatus>
                </apex:outputpanel>
                <!-- End changes for CMI 2014 Release 3 -->                 
                <apex:actionStatus id="ComplaintDetailStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                <!-- End Changes for CMI Pilot -->     
                             
            </apex:outputpanel>
            <!-- ClientInfoPanel -->           
                                                                                    
            <apex:outputPanel id="MainPanel">                                                           
                <!-- **************************************************** --> 
                <!-- *   C L I E N T   F E E D B A C K   D E T A I L S  * -->
                <!-- **************************************************** --> 

                <!--Id attribute added for CMI 2014-->
                <!--start changes for CMI 2015 Iteration 2-->
                <apex:actionRegion >
                    <apex:pageBlockSection title="Client Feedback Details" id="clientFeedbackDetails">                       
                        <!--Start Changes for CMI 2014-->
                        <apex:pageblocksectionitem >
                            <apex:outputlabel value="Is Feedback regarding a TM/ Dept/ Supplier?"/>                            
                                <apex:inputField value="{!case.Is_Feedback_regarding_a_TM_Dept__c}" required="{!case.Type = 'Complaint'}">
                                    <apex:actionSupport event="onchange" rerender="clientFeedbackDetails, supplierDetailsPanel,servicingChallengesCategory,ServicingChallengesReported,servicingInteractionDispositonFields" status="ComplaintDetailStatus1"/>
                                </apex:inputField>                            
                        </apex:pageblocksectionitem>
                        
                        <!--End Changes for CMI 2014-->
                        
                
                        <apex:outputPanel rendered="{!AND(NOT(LossMitigationManagerProfile), NOT(LossMitigationManagerSpecialist), NOT(LossMitigationManagerWFC), AND(case.Is_Feedback_regarding_a_TM_Dept__c!='No',case.Is_Feedback_regarding_a_TM_Dept__c!=Null))}" > 
                            <c:CustomLookup value="{!Case.Teammate_Search__c}" object="Contact" objectName="Case" fieldName="Teammate_Search__c" displayFields="Email,Title,Phone"  required="{!case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate'|| case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate'}"/>
                        </apex:outputPanel>
                        <br/>
                        
                        <apex:outputPanel rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}"> 
                            <c:CustomLookup value="{!Case.Department_Search__c}" object="Org_Unit__c" objectName="Case" fieldName="department_search__c" displayFields="RecordType.Name,Cost_Center__c,Address__c,City__c,State__c" required="{!case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI'}"/>  
                        </apex:outputPanel>
                        <br/>
                        
                        <!--Start Changes for CMI 2014-->
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}">
                             <apex:outputlabel value="Supplier Search"/>                                   
                                <!--Start Changes for CMI 2014 break/fixes-->
                                <!--Added onkeypress to supress the Enter and Any other input-->
                                <apex:define name="requiredSupplier">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>                                  
                                        <!--start changes for CMI 2016 December release-->
                                        <!--Added an onclick condition-->
                                        <apex:inputField value="{!case.Vendor_Search__c}" onclick="vendorsearch();">
                                        <!--End changes for CMI 2016 December release-->    
                                            <!--End Changes for CMI 2014 break/fixes-->      
                                            <apex:actionSupport event="onchange" action="{!populateSupplierRelatedFields}" reRender="supplierDetailsPanel,clientFeedbackDetails" status="ComplaintDetailStatus1"/>
                                        </apex:inputField>
                                    </div>
                                </apex:define>                                    
                        </apex:pageBlockSectionItem>
                        <!--End Changes for CMI 2014-->
                        
                        
                        <apex:pageBlockSectionItem rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='') }" />
                        
                        <apex:pageBlockSectionItem id="SupplierBlock" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) && case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c!='' }">
                            <apex:outputlabel value="Complaint from or about a Supplier?"/>
                            <apex:define name="requiredComplaintFromSupplier">
                                 <div class="requiredInput">
                                     <div class="requiredBlock" style="{!IF((case.Vendor_Search__c!=Null&&case.Vendor_Search__c!='')|| case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>  
                                     <apex:inputField value="{!case.Complaint_From_or_About_A_Supplier__c}" id="SupplierField"></apex:inputField>
                                 </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                                                                        
                        <!--End Changes for CMI 2014 release 3-->
                        <apex:pageBlockSectionItem rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c=='Other Department',case.Is_Feedback_regarding_a_TM_Dept__c <>'')}">
                            <apex:outputlabel value="Other Department List"/>
                            <apex:define name="otherDepartment">
                                <div class="requiredInput">
                                    <div class="requiredBlock"/>   
                                    <apex:inputField value="{!case.Other_Department_List__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                     </apex:pageBlockSection>
                     
                     
                     <!--Start Changes for CMI September 2017 Release-->
                     <apex:outputPanel id="servicingInteractionDispositonFields">
                        <!--End Changes for CMI October 2017 Release-->
                        <!--Start Changes for CMI April 2018 Release-->
                        <!--Servicing interaction fields to display when Tracking only:Feedback condition--> 
                        <apex:pageblockSection columns="1" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate' && (case.type=='Complaint' || case.type=='Tracking Only: Feedback')}">
                        <!--End Changes for CMI April 2018 Release-->
                        <!--Start Changes for CMI October 2017 Release-->    
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Servicing Interaction Disposition"/>
                                <apex:inputField value="{!case.Srvc_Interaction_Disposition__c}"/> 
                            </apex:pageBlockSectionItem> 
                            <br/>  
                            <apex:pageBlockSectionItem rendered="{!OR(($Profile.Name =='CFS & MH Phone/Research Manager'),($Profile.Name =='CFS Phone/Research User'),($Profile.Name =='CFS Phone/Research Manager'),($Profile.Name =='CLEAR Manager'),($Profile.Name =='CARRT Manager'),($Profile.Name =='MERT Manager'),($Profile.Name =='Social Media Manager'),($Profile.Name =='Operations Managers'),($Profile.Name =='CPR Manager'),($Profile.Name =='System Administrator'))}">
                                <apex:outputLabel value="Servicing Interaction Comments"/>
                                <apex:inputTextarea value="{!case.Srvc_Interaction_Comments__c}" cols="80" rows="7"/>
                            </apex:pageBlockSectionItem>
                            <apex:pageBlockSectionItem rendered="{!AND(($Profile.Name !='CFS & MH Phone/Research Manager'),($Profile.Name !='CFS Phone/Research User'),($Profile.Name !='CFS Phone/Research Manager'),($Profile.Name !='CLEAR Manager'),($Profile.Name !='CARRT Manager'),($Profile.Name !='MERT Manager'),($Profile.Name !='Social Media Manager'),($Profile.Name !='Operations Managers'),($Profile.Name !='CPR Manager'),($Profile.Name !='System Administrator'))}">
                                <apex:outputLabel value="Servicing Interaction Comments" />
                                <apex:outputfield value="{!case.Srvc_Interaction_Comments__c}" />
                            </apex:pageBlockSectionItem>                                 
                        </apex:pageblockSection>
                     </apex:outputPanel>
                     <!--End Changes for CMI September 2017 Release-->
                     
                       <apex:pageBlockSection id="servicingChallengesCategory" columns="1">
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.CreatedDate>rel2DeploymentDateValue && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && (case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback')}" > 
                            <apex:outputLabel value="Servicing Challenges Category"/>
                            <apex:define name="requiredServicingCategory">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>  
                                        <apex:inputfield value="{!case.Servicing_Challenges_Category__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>  

                    </apex:pageblocksection>
                    
                    <!--Start Change Feb 2017-->
                    <apex:pageBlockSection columns="1" id="ServicingChallengesReported"> 
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && (case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback')}"> 
                             <apex:outputLabel value="Servicing Challenges Reported"/>                          
                             <apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7" />                            
                        </apex:pageBlockSectionItem>  
                    </apex:pageBlockSection> 
                    <!--End Change Feb 2017--> 
                            
                </apex:actionRegion>
                <!--End changes for CMI 2015 Iteration 2-->
                <!--End Changes for CMI 2014 Release 3-->
                                
                <apex:pageblocksection columns="1">
                
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(LossMitigationManagerProfile), NOT(LossMitigationManagerSpecialist), NOT(LossMitigationManagerWFC))}"  >
                        <apex:outputLabel value="Client Feedback"/>
                        <!--Start Changes for CMI Pilot-->
                        <apex:define name="requiredClientFeedback">
                            <div class="requiredInput">
                                <div class="requiredBlock"></div>
                                
                                <apex:inputTextArea value="{!case.Description}" cols="80" rows="7"/>
                            </div>
                        </apex:define>
                        <!--End Changes for CMI Pilot-->
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Description}" rendered="{!OR(LossMitigationManagerProfile, LossMitigationManagerSpecialist, LossMitigationManagerWFC)}"  />

                    
                </apex:pageblocksection>
                
                
                <!--Start changes for CMI 2016 April Release.Prior Contacts and Prior Contacts Utilized fields are displayed-->
                <apex:pageBlockSection columns="1" id="priorContacts" rendered="{!case.CreatedDate>bugAprilDeploymentDateValue}">
                    <apex:pageBlockSectionItem helpText="Include the number of contacts client stated and/or contacts discovered during research."> 
                        <apex:outputLabel value="# of Prior Contacts">
                     </apex:outputlabel>
                        <apex:actionRegion > 
                            <apex:inputField value="{!case.Number_of_Prior_Contacts__c}">
                                <apex:actionSupport event="onchange"  reRender="priorContacts" status="ComplaintDetailStatus1"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:inputField value="{!case.Prior_Contacts_Utilized__c}" required="{!case.Number_of_Prior_Contacts__c!='No Prior Contacts Noted' && case.Number_of_Prior_Contacts__c!=Null}"/>    
                </apex:pageBlockSection>
                <!--End changes for CMI 2016 April Release-->
                
                <apex:pageBlockSection columns="1"  rendered="{!case.Type='Complaint'}">
                        <apex:pageBlockSectionItem helpText="In addition to teammate identified in teammate search, list all other persons identified in the complaint. Include RACF IDs for teammates where appropriate.">                        
                            <apex:outputLabel value="Other Persons Identified in Complaint"/> 
                            <!--Start Changes for CMI Pilot--> 
                            
                                    <!-- Removed the Required= "True" attribute to display our custom error message --> 
                                    <apex:inputTextArea value="{!case.Other_Persons_Identified_in_Complaint__c}" cols="80" rows="7" /> 
                                 
                        </apex:pageBlockSectionItem>
                        
                        
                        <apex:pageBlockSectionItem >                        
                            <apex:outputLabel value="Correspondence Related to Complaint"/> 
                            <!--Start Changes for CMI Pilot--> 
                            
                                    <!-- Removed the Required= "True" attribute to display our custom error message --> 
                                    <apex:inputTextArea value="{!case.Correspondence_Related_to_Complaint__c}" cols="80" rows="7" /> 
                                
                        </apex:pageBlockSectionItem>
                        
                    </apex:pageBlockSection>
                 
                <apex:actionStatus id="ComplaintDetailStatus1">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                                
                <!-- ***************************************************************** --> 
                <!-- ***** NEW COMPLIANCE EVALUATION - For CMI 2013 Pilot Cases  ***** -->
                <!-- ***************************************************************** -->                                                    
                <!-- Start Changes for CMI 2014 Release 3 -->
                <apex:outputpanel id="ComplianceEvaluationPanel" >
                    <apex:outputpanel id="ComplianceEvaluation">             
                        <!--Start Changes for CMI 2014-->
                        <!--Rendering condition case.Type='Complaint' included for CMI 2014-->
                        <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->
                        <!--The below output panel is added for CMI 2015 Iteration 2 as it should render for old cases only-->
                        <apex:outputpanel rendered="{!case.CreatedDate<rel2DeploymentDateValue}">
                            <apex:pageBlockSection title="Feedback/Complaint Designation" columns="2" collapsible="true" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}">
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Resolved by Point of Contact?" for="quest1"/><!--outputLabel changed for CMI 2014-->
                                    <apex:define name="requiredQ1">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Allegation of wrongful/unethical conduct?" for="quest2"/><!--outputLabel changed for CMI 2014-->
                                    <apex:define name="requiredQ2">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField value="{!case.PCQ_Q2__c}" id="quest2">
                                                    <!--commented for changes in CMI 2014--> 
                                                    <!--<apex:actionSupport event="onchange" rerender="Quest2DependentQuestions,Question2DependentQuestions,Quest2ADependentQuestions,Question2BDependentQuestions" status="ComplianceEvaluationStatus" />-->
                                                </apex:inputField>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                
                            <!--Rendering condition case.Type='Complaint' included for CMI 2014-->
                            <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->
                            <apex:pageBlockSection id="Quest2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Reg/Law Cited?" for="quest3"/><!--outputLabel changed for CMI 2014-->
                                    <apex:define name="requiredQ2A">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField value="{!case.PCQ_Q2_A__c}" id="quest3">  
                                                    <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                                </apex:inputField>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
            
                            <!--Rendering condition case.Type='Complaint' included for CMI 2014-->
                            <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->
                            <apex:pageBlockSection id="Quest2ADependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}"/><!--outputLabel changed for CMI 2014-->
                                    <apex:define name="requiredLawOrReg">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}">  
                                                    <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions,otherRegulation" status="ComplianceEvaluationStatus" />
                                                </apex:inputField>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem id="otherRegulation">
                                    <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other')|| CONTAINS(case.Law_or_Regulation_Violated__c,'FINRA Financial Industry Regulatory Authority Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'CFTC Commodity Futures Trading Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'SEC Securities Exchange Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'MSRB Municipal Securities Rulemaking Board Regulation')))}"/>
                                    <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other')|| CONTAINS(case.Law_or_Regulation_Violated__c,'FINRA Financial Industry Regulatory Authority Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'CFTC Commodity Futures Trading Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'SEC Securities Exchange Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'MSRB Municipal Securities Rulemaking Board Regulation')))}" required="{!(case.Law_or_Regulation_Violated__c != null && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other')))}"/>                        
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                                
                            <!--Rendering condition case.Type='Complaint' included for CMI 2014-->
                            <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->
                            <apex:pageBlockSection id="Question2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="High Risk Terms?" for="quest6"/><!--outputLabel changed for CMI 2014-->
                                    <apex:define name="requiredQ2B">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >                        
                                                <apex:inputField value="{!case.PCQ_Q2_B__c}" id="quest6">
                                                    <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                                </apex:inputField>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                                
                            <!--Rendering condition case.Type='Complaint' included for CMI 2014-->
                            <!--rendering condition for specialInitiatives changed from CMI Pilot 2013 to Null for CMI 2014-->
                            <apex:pageBlockSection id="Question2BDependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                                <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                    <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}"/><!--outputLabel changed for CMI 2014-->                        
                                    <apex:define name="requiredHighRisk">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}">
                                                    <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                                </apex:inputField>
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <!--Other High Risk Terms added for CMI 2014-->
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                    <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                       
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        <!--End Changes for CMI 2014-->
                        
                            
                        </apex:outputPanel>
                        
                        
                        
                        <!--Start changes for CMI 2105 Iteration 2-->
                        <!--The below section should be rendered for cases created after CMI 2015 Iteration 2--> 
                        <apex:outputPanel rendered = "{!case.CreatedDate>rel2DeploymentDateValue}">
                            <apex:pageBlockSection title="Feedback/Complaint Designation" columns="2" collapsible="true" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Resolved by Point of Contact?" for="quest1Section2"/> 
                                    <apex:define name="requiredQ1"> 
                                        <div class="requiredInput"> 
                                            <div class="requiredBlock"></div> 
                                            <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1Section2"/> 
                                        </div> 
                                    </apex:define> 
                                </apex:pageBlockSectionItem>                                                                                          
                            </apex:pageBlockSection>                          
                            
                            <apex:pageBlockSection id="Quest2ADependentQuestionsSection2" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null )}"> 
                                <apex:pageBlockSectionItem > 
                                    <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" />     
                                    <apex:define name="requiredLawOrRegSection2">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion > 
                                                <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4Section2">
                                                    <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestionsSection2" status="ComplianceEvaluationStatus" /> 
                                                </apex:inputField> 
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem> 
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other') || CONTAINS(case.Law_or_Regulation_Violated__c,'FINRA Financial Industry Regulatory Authority Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'CFTC Commodity Futures Trading Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'SEC Securities Exchange Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'MSRB Municipal Securities Rulemaking Board Regulation')))}"/> 
                                    <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other') || CONTAINS(case.Law_or_Regulation_Violated__c,'FINRA Financial Industry Regulatory Authority Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'CFTC Commodity Futures Trading Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'SEC Securities Exchange Commission Regulation') || CONTAINS(case.Law_or_Regulation_Violated__c,'MSRB Municipal Securities Rulemaking Board Regulation')))}" required="{!(case.Law_or_Regulation_Violated__c != null && (CONTAINS(case.Law_or_Regulation_Violated__c,'Other')))}"/>                       
                                </apex:pageBlockSectionItem>                         
                            </apex:pageBlockSection> 
                            
                                                                 
                            <apex:pageBlockSection id="Question2BDependentQuestionsSection2" columns="1" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                                <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                    <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7Section2"/>
                                    <apex:define name="requiredHighRisk">
                                        <div class="requiredInput">
                                            <div class="requiredBlock"></div>
                                            <apex:actionRegion >
                                                <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7Section2">
                                                    <apex:actionSupport event="onchange" rerender="Question2BDependentQuestionsSection2" status="ComplianceEvaluationStatus" action="{!renderOtherHighRiskTerms}" />
                                                </apex:inputField> 
                                            </apex:actionRegion>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <!--For CMI 2015 Iteration 2 rendered="{!case.PCQ_Q2_B__c='Yes'}" is removed from the output label and input field-->
                                    <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                    <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                       
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </apex:outputPanel> 
                        <!--End changes for CMI 2015 Iteration 2-->
                        
                        <apex:pageBlockSection id="officeOfSupervisory">
                        
                        <apex:pageBlockSectionItem helpText="Indicate the office of supervisory jurisdiction (i.e. responsible supervisory branch). It not known, enter 'Unknown'." rendered="{!case.Account_Type_Detail__c='CIB Broker Dealer'}">                        
                            <apex:outputLabel value="Office of Supervisory Jurisdiction" rendered="{!case.Account_Type_Detail__c='CIB Broker Dealer'}"/> 
                            <!--Start Changes for CMI Pilot--> 
                            <apex:define name="requiredClientFeedback"> 
                                <div class="requiredInput"> 
                                    <div class="requiredBlock"></div> 
                                    <!-- Removed the Required= "True" attribute to display our custom error message --> 
                                    <apex:inputTextArea value="{!case.Office_of_Supervisory_Jurisdiction__c}" cols="80" rows="7" rendered="{!case.Account_Type_Detail__c='CIB Broker Dealer'}"/> 
                                </div> 
                            </apex:define> 
                        </apex:pageBlockSectionItem>
                        
                   
                        
                    </apex:pageBlockSection>
                        
                        <apex:actionRegion >
                <apex:pageBlockSection columns="1" >
                        <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                            <apex:outputLabel style="font-weight:bold" value="Submitter Feedback"/>

                            
                                <apex:inputField value="{!case.Submitter_Feedback__c}">
                                    <apex:actionSupport event="onchange" rerender="feedbackSub" status="MainStatusSub"/>
                                </apex:inputfield>
                           
                        </apex:pageBlockSectionItem>
                        
                         <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                            <apex:outputLabel value="Submitter Feedback Details"/>
                          
                           <apex:inputField value="{!case.Submitter_Feedback_Details__c}" >
                               <apex:actionSupport event="onchange" rerender="feedbackSub" status="MainStatusSub"/>
                          </apex:inputField>
                         
                        </apex:pageBlockSectionItem>
                            
               </apex:pageBlockSection>
                
               
                <apex:pageBlockSection id="feedbackSub" >         
                        <apex:pageBlockSectionItem rendered="{!case.createddate > bugFebDeploymentDateValue}" >
                        <apex:outputLabel value="Submitter Feedback Comments"/>
                        <apex:define name="requiredClientFeedback">
                        <div class="requiredInput">        
                        <div class="requiredBlock" style="{!IF(OR(CONTAINS(case.Submitter_Feedback__c,'Other'),NOT(ISNULL(case.Submitter_Feedback_Details__c))),'background-color:C00','background-color:transparent')}"></div>    
                         
                           <apex:inputfield value="{!case.Submitter_Feedback_Comments__c}" style="width:300px;height:55px;" />
                       
                        </div>
                        </apex:define>   
                        </apex:pageBlockSectionItem>
                            
                </apex:pageBlockSection>
               </apex:actionRegion>
               
               <br/> 
                 <apex:actionStatus id="MainStatusSub"> 
                    <apex:facet name="start"> 
                        <div style="text-align:center;"> 
                            <img src="{!$Resource.SpinIcon}"/> 
                        </div> 
                    </apex:facet> 
                </apex:actionStatus>
                        
                        
                                       
                        <!-- Start Changes for CMI 2014 Release 3 -->
                        <apex:pageBlockSection columns="2">
                            <!--dataStyle attribute removed for CMI 2014-->
                            
                                <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}">
                                    <apex:outputLabel style="font-weight:bold" value="Was PCQ Information Sufficient/Accurate?"/>
                                    <apex:inputField value="{!case.Was_TM_Information_Sufficient_Accurate__c}"/>
                                </apex:pageBlockSectionItem>                                                        
                            
                            <!--dataStyle attribute removed for CMI 2014-->
                            <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}">
                                <apex:outputLabel style="font-weight:bold" value="PCQ Information Comments"/>
                                <apex:inputField value="{!case.TM_Information_Comments__c}" style="width:300px;height:45px;"/>
                            </apex:pageBlockSectionItem>                          
                        </apex:pageBlockSection>        
                        <!-- End Changes for CMI 2014 Release 3 -->                                
                        
                        <apex:actionStatus id="ComplianceEvaluationStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    </apex:outputpanel>
                </apex:outputpanel>
                <!--end of "ComplianceEvaluationPanel"-->
                <!-- End changes for CMI 2014 Release 3 -->                
                
                <!--Start Changes for CMI 2014-->
                <!-- ******************************************* --> 
                <!-- *        SUPPLIER DETAILS SECTION         * -->
                <!-- ******************************************* --> 
                        
                <!--Start of SupplierDetailsPanel-->
                <apex:outputPanel id="supplierDetailsPanel">
                    <apex:pageBlockSection title="Supplier Details" columns="2" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier' && case.Vendor_Search__c!=Null && case.Vendor_Search__c!='' ) || (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='No'))}">
                        <apex:outputField value="{!case.Business_Owner__c}"/>
                        <apex:outputField value="{!case.Service_Manager__c}"/>
                        <apex:outputField value="{!case.Supplier_Manager__c}"/>
                        <apex:inputField value="{!case.Supplier_Services__c}"/>
                    </apex:pageBlockSection>
                </apex:outputpanel>
                <!--End of SupplierDetailsPanel"-->
                <!--End Changes for CMI 2014-->
           
                <!-- ******************************************* --> 
                <!-- *    F E E D B A C K   C A T E G O R Y    * -->
                <!-- ******************************************* --> 
                        
                <apex:pageBlockSection id="fbcat" title="Feedback Category" columns="1">

                    <!-- ******************************************* --> 
                    <!-- *           C A T E G O R I E S           * -->
                    <!-- ******************************************* --> 

                    <!-- Start changes for CMI 2014 Release 3 -->
                    <!-- Removed Level 1, 2, 3, 6 fields from the layout -->
                    <apex:outputPanel id="CategoryPanel" >
                    
                        <!--Start changes for CMI 2016 July Release.Filtering of Categories using Search Text implemented-->
                        <apex:pageBlockSection id="fbcat1" columns="1">
                            <apex:pageBlockSectionItem id="catButton">
                                <apex:outputLabel value="Search Category"/>
                                <apex:actionRegion >                              
                                    <apex:inputText value="{!searchTextValue}" onkeypress="return noenter(event);"/>
                                    <apex:commandButton value="Search" action="{!categorySearch}"  rerender="CategoryPanel" status="CategoryStatus" id="catSearchButton"/>
                                    <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!searchTextValue != null}" style="color:red;font-weight:bold;"/>
                                </apex:actionRegion>
                                
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        <!--End changes for CMI 2016 July Release-->
                                
                        <div style="margin-left:12%;">
                            <!--Start changes for CMI 2016 June Release-->
                            <!--Cat level 3 is included for the June release-->
                            <apex:outputLabel value="Cat Level 3" for="level3choice"/>
                            &nbsp;
                            <apex:actionStatus id="level3choiceStatus">
                                <apex:facet name="start">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </apex:facet>
                            </apex:actionStatus>
                            &nbsp;
                            <apex:actionRegion >
                                <apex:selectList value="{!Level3Choice}" multiselect="False" size="10" id="level3choice" style="width:40%">
                                    <apex:selectOptions value="{!SubmitterLevel3Choices}"/>
                                    <apex:actionSupport event="onchange" action="{!updateLists}" reRender="CategoryPanel" status="level3choiceStatus"/>
                                </apex:selectList>
                            </apex:actionRegion>
                            <!--End changes for CMI 2016 June Release-->
                            
                            <br /><br />
                            
                            <apex:outputLabel value="Cat Level 4" for="level4choice"/>
                            &nbsp;
                            <apex:actionStatus id="level4choiceStatus">
                                <apex:facet name="start">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </apex:facet>
                            </apex:actionStatus>
                            &nbsp;
                            <apex:actionRegion >
                                <apex:selectList value="{!Level4Choice}" multiselect="False" size="10" id="level4choice" style="width:40%">
                                    <apex:selectOptions value="{!Level4Choices}"/>
                                    <apex:actionSupport event="onchange" action="{!updateLists}" reRender="CategoryPanel" status="level4choiceStatus"/>
                                </apex:selectList>
                            </apex:actionRegion>
                            
                            <br /><br />

                            <apex:outputLabel value="Cat Level 5" for="level5choice"/>
                            &nbsp;
                            <apex:actionStatus id="level5choiceStatus">
                                <apex:facet name="start">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </apex:facet>
                            </apex:actionStatus>
                            &nbsp;
                            <apex:actionRegion >
                                <apex:selectList value="{!Level5Choice}" multiselect="False" size="10" id="level5choice" style="width:40%">
                                    <apex:selectOptions value="{!Level5Choices}"/>
                                    <apex:actionSupport event="onchange" action="{!updateLists}" reRender="CategoryPanel" status="level5choiceStatus"/>
                                </apex:selectList>
                            </apex:actionRegion>                            
                        </div>

                        <apex:actionStatus id="CategoryStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;"> 
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    </apex:outputPanel>
                    <apex:inputField value="{!case.Cat_Level_6__c}"/>
                    <!-- End changes for CMI 2014 Release 3 -->
                    
                    <!--Start changes for CMI 2016 June Release.The field company is added and rendered as required when Initiative Tracking is 'Financial Fitness for Companies (WHL)'-->                        
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Initiative Tracking"/>
                        <apex:actionRegion >                    
                        <apex:inputField value="{!case.Initiative_Tracking__c}">
                            <apex:actionSupport event="onchange" rerender="company" status="companyStatus"/>
                        </apex:inputField>
                        </apex:actionRegion> 
                    </apex:pageBlockSectionItem>                                        
                </apex:pageBlockSection>
                
                <apex:outputPanel id="company">    
                    <apex:pageBlockSection >                   
                        <apex:inputField value="{!case.Company__c}" required="{!case.Initiative_Tracking__c='Financial Fitness for Companies (WHL)'}"/> 
                    </apex:pageblocksection>
                </apex:outputPanel>
                <!--End changes for CMI 2016 June Release--> 
                
                <apex:actionStatus id="companyStatus"> 
                    <apex:facet name="start"> 
                        <div style="text-align:center;"> 
                            <img src="{!$Resource.SpinIcon}"/> 
                        </div> 
                    </apex:facet> 
                </apex:actionStatus>   
                  
                                                          
                    <!-- ******************************************* --> 
                    <!-- *   R E S O L U T I O N   D E T A I L S   * -->
                    <!-- ******************************************* -->
                    <apex:outputPanel > 
                   
                  <!-- <apex:pageBlockSection id="refund" title="Resolution Details" columns="2">
                        For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
                      <!--  <apex:pageblocksectionitem >
                            <apex:outputlabel value="Relief Provided?"/>
                            <apex:actionRegion > 
                                <apex:inputField value="{!case.Refund__c}"> 
                                    <apex:actionSupport event="onchange"  reRender="refund,typeOfRelief" status="resolutionDetailsStatus" /> 
                                </apex:inputField> 
                            </apex:actionRegion> 
                        </apex:pageblocksectionitem>
                        <apex:inputField value="{!case.Remediation__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief' }"/>
                        
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="typeOfRelief" columns="1">
                        <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Closed With Non-Monetary Relief' || case.Refund__c='Closed With Explanation' || case.Refund__c='Monetary Relief' || case.Refund__c='Non-Monetary Relief'}"/>
                    </apex:pageBlockSection> -->
                    
                    
            <apex:pageBlockSection id="refund" title="Resolution Details"><!--id attribute in pageBlockSection added for CMI 2014 break/fixes-->
            <!--For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
            <apex:pageblocksectionitem >
                <apex:outputlabel value="Relief Provided?"/>
                <apex:actionRegion > 
                    <apex:inputField value="{!case.Refund__c}"> 
                        <apex:actionSupport event="onchange" reRender="refund" status="resolutionDetailsStatus" /> 
                    </apex:inputField> 
                </apex:actionRegion> 
            </apex:pageblocksectionitem>
            <apex:inputField value="{!case.Remediation__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
            <!--For CMI 2015 Iteration2 the below field is rendered for Non-Monetary Relief also-->
            <!--start changes for CMI 2016 October release-->
            <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
             <br/><br/><apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Non-Monetary Relief'   || case.Refund__c='Non-Monetary Relief'}"/>
            <!--end changes for CMI 2016 October release-->
            <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Explanation' }"/>
        </apex:pageBlockSection>
                              
                 
                    <!--start changes for CMI 2016 October release-->
                    <!--Fields Shifted-->
                         <apex:pageBlockSection id="rootCauseFields">                             
                             <apex:inputField value="{!case.Root_Cause__c}"  id="id3" onchange="hidefieldsrootCauseDetail();" />                          
                         </apex:pageBlockSection>
                            
                            
                        
                         <apex:pageBlockSection id="rootCauseDetails" columns="1" >
                             <apex:inputField value="{!case.Root_Cause_Detail__c}" />
                         </apex:pageBlockSection>
                            
                         <apex:pageBlockSection >
                            <apex:inputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"/> 
                            <apex:inputField value="{!case.Business_Impact__c}"/>
                         </apex:pageBlockSection>
                     </apex:outputPanel>
                    <!--end changes for CMI 2016 October release-->
                    <!--Start Changes for CMI 2014 break/fixes-->
                    <apex:actionStatus id="resolutionDetailsStatus"> 
                        <apex:facet name="start"> 
                            <div style="text-align:center;"> 
                                <img src="{!$Resource.SpinIcon}"/> 
                            </div> 
                        </apex:facet> 
                    </apex:actionStatus>
                    <!--End Changes for CMI 2014 break/fixes-->
                       
                    
                    <!-- ******************************************* --> 
                    <!-- *   C L O S E   C A S E   D E T A I L S   * -->
                    <!-- ******************************************* --> 
                
                    <apex:outputPanel id="CloseCasePanel">
                        <apex:pageBlockSection title="Close Case Details" columns="2">
                            <!--Start Changes for CMI 2014-->
                            <!--Commented for CMI 2014-->
                            <!--As some rendering conditions need to be applied on this field-->
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Status"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Status}" rendered="{!AND(NOT(LossMitigationManagerProfile), NOT(LossMitigationManagerSpecialist), NOT(LossMitigationManagerWFC))}" required="True">
                                        <!--For CMI 2016 April Release priorContacts added to the reRender attribute in the below line to make # of Prior Contacts field as required when closed--> 
                                        <!--Start changes for feb 2017-->
                                         <!--Removed the pop up when status=Closed-->
                                        <apex:actionSupport event="onchange" reRender="legacyFieldsSection,FRBExtension"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                            <!--End changes for feb 2017-->
                            <!--End Changes for CMI 2014-->
                            
                            <apex:outputField value="{!case.Status}" rendered="{!OR(LossMitigationManagerProfile, LossMitigationManagerSpecialist, LossMitigationManagerWFC)}"  />
                            <apex:inputField value="{!case.Status_Reason__c}" required="True"/>
                            <br/>
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Auto Closed & Monitoring Review"/>
                                <apex:actionRegion >
                                    <apex:inputField value="{!case.Auto_Closed_Review__c}">
                                        <apex:actionSupport event="onchange" reRender="FRBExtension" status="closeCaseDetailsStatus"/>
                                    </apex:inputField>
                                </apex:actionRegion>
                            </apex:pageBlockSectionItem>
                                <!--Start Changes for CMI 2014--> 
                                <!--Start Changes for CMI August 2017 Release-->                           
                                <apex:inputField value="{!case.Case_Status_Summary__c}" style="width:300px;height:45px" rendered="{!AND(case.Case_Association_Type__c != 'Transfer to CARRT', case.Case_Association_Type__c != 'Transfer to CRT',case.Case_Association_Type__c != 'Transfer to MERT', case.Case_Association_Type__c != 'Escalated to OOP')}"/>
                                <apex:outputField value="{!case.Case_Status_Summary__c}" style="width:300px;height:45px" rendered="{!OR(case.Case_Association_Type__c = 'Transfer to CARRT', case.Case_Association_Type__c = 'Transfer to CRT',case.Case_Association_Type__c = 'Transfer to MERT', case.Case_Association_Type__c = 'Escalated to OOP')}"/>
                                <!--End Changes for CMI August 2017 Release-->
                                <!--Start changes for CMI 2016 April release--> 
                               
                
                                <apex:inputField value="{!case.Case_Comments_Reviewed__c}"/> 
                                
                                <!--End changes for CMI 2016 April release--> 
                                                           
                                <!--End Changes for CMI 2014-->
                                <!--Start changes for for CMI 2014 Release 2-->

                                <apex:inputField value="{!case.Advanced_Search_Results_Intake__c}"/>                        
                                <apex:inputField value="{!case.Advanced_Search_Results_Case_Owner__c}"/>
 
                                <!--End changes for for CMI 2014 Release 2-->
                                <apex:inputField value="{!case.Analysis_Comments__c}" style="width:390px;height:140px;" /><br/>
                          
                                <apex:inputField value="{!case.Resolution_Comments__c}"  style="width:390px;height:140px;" /><br/>
                                <apex:inputField value="{!case.ClosedDate}" rendered="false" />
                            </apex:pageBlockSection>
                        
                        
                        
                       
                        
                        <!--Start Changes For CMI 2016 April Release-->
                            <apex:pageBlockSection id="clientCaseResponse">
                                
                                    <apex:inputField value="{!case.Client_Response_Approved_By__c}" rendered="{!case.Type = "Complaint" || case.Type="Tracking Only: Feedback"}" />
                                    <apex:inputField value="{!case.Client_Response_Approval_Comments__c}"  style="width:200px; height:100px" rendered="{!case.Type = "Complaint" || case.Type="Tracking Only: Feedback"}" />
                            </apex:pageBlockSection>
                        <!--End  Changes For CMI 2016 April Release--> 
                         <!--<apex:outputPanel >-->  
                            <apex:actionStatus id="closeCaseDetailsStatus">
                                <apex:facet name="start">
                                    <div style="text-align:center;">
                                        <img src="{!$Resource.SpinIcon}"/>
                                    </div>
                                </apex:facet>
                            </apex:actionStatus>
                             
                            <!--End Changes for CMI 2014-->
                        </apex:outputpanel> <!-- end of CloseCasePanel -->  
                                      
                    <!-- ******************************************* --> 
                    <!-- *      C F P B Updates                    * -->
                    <!-- ******************************************* --> 
                    <apex:outputPanel id="CFPBPanel">                    
                        <apex:pageBlockSection title="CFPB Information" columns="2" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"> 
                            
                            <apex:InputField value="{!case.CFPB_Case_Number__c}" required="true" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                            <!--<apex:OutputField value="{!case.CFPB_Case_Number__c}" rendered="{!Case.Call_Source__c == 'CFPB' && case.Call_Source__c == 'CFPB Follow Up' }" />-->
                            
                            <apex:InputField value="{!case.CFPB_Product__c}" required="true" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>                          
                            <!--<apex:OutputField value="{!case.CFPB_Product__c}" rendered="{!Case.Call_Source__c == 'CFPB' && case.Call_Source__c == 'CFPB Follow Up' }" />-->
                                        
                            <apex:InputField value="{!case.CFPB_Company_Status__c}" required="true" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                            <apex:InputField value="{!case.CFPB_Respond_by_Date__c}" required="true" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>        
                        </apex:pageBlockSection>
                        <apex:actionRegion >
                            <apex:pageBlockSection columns="2" id="publicResponse" >                          
                                <!--The below fields consumer narrative made public and suntrust public response are added for CMI 2015 Iteration 2-->
                                <apex:inputField value="{!case.Consumer_Narrative_Made_Public__c}" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                                <apex:pageBlockSectionItem rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up'}">
                                    <apex:outputLabel value="{!$ObjectType.Case.fields.SunTrust_Public_Response__c.label}"></apex:outputLabel>
                                    <apex:define name="requiredPubResponse">
                                        <div class="requiredInput">
                                            <div class="requiredBlock" style="{!IF((case.CFPB_Status__c != 'In Progress' && case.CFPB_Status__c != Null && $ObjectType.Case.fields.SunTrust_Public_Response__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                            <apex:inputField value="{!case.SunTrust_Public_Response__c}"/>
                                        </div>
                                    </apex:define>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection> 
                            <apex:pageBlockSection >   
                                <apex:InputField value="{!case.CFPB_Issue__c}" required="true" style="width:400px;height:140px;" rendered="{!Case.Call_Source__c == 'CFPB' || case.Call_Source__c == 'CFPB Follow Up' }"/>
                                <!--<apex:OutputField value="{!case.CFPB_Issue__c}" rendered="{!Case.Call_Source__c != 'CFPB' && case.Call_Source__c != 'CFPB Follow Up' }" />  -->                        
                            </apex:pageBlockSection>
                            <apex:actionStatus id="cfpbStatus">
                                <apex:facet name="start">
                                    <div style="text-align:center;">
                                        <img src="{!$Resource.SpinIcon}"/>
                                    </div>
                                </apex:facet>
                            </apex:actionStatus>
                            <apex:pageBlockSection columns="1">                    
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="CFPB Status" rendered="{!Case.Call_Source__c == 'CFPB'}"></apex:outputLabel>                                    
                                    <apex:inputField value="{!case.CFPB_Status__c}" rendered="{!Case.Call_Source__c == 'CFPB'}">
                                        <apex:actionSupport event="onchange" rerender="publicResponse" />
                                    </apex:inputField>                                    
                                </apex:pageBlockSectionItem>
                               <!-- <apex:inputField value="{!case.Without_Relief_Details__c}" rendered="{!Case.Call_Source__c == 'CFPB' />-->
                                
                                <apex:inputField value="{!case.CFPB_Relief_Amount__c}" rendered="{!Case.Call_Source__c == 'CFPB'}"/>
                                
                            </apex:pageBlockSection>
                        </apex:actionRegion>
                        <apex:pageBlockSection columns="1">
                            <apex:inputField value="{!case.CFPB_Relief_Description__c}" rendered="{!Case.Call_Source__c == 'CFPB'}" style="width:500px;height:140px;"/>
                        </apex:pageBlockSection>
                       
                    </apex:outputpanel>   
                    
                    <!-- end of CFPB Updates -->
                  
                    
                    <!-- *********************************************************** --> 
                    <!-- *                          S L A                          * -->
                    <!-- *********************************************************** --> 
                    <!--Start changes for CMI 2014 Release 3-->
                    <!--Start changes for october release 2016-->
                    <!--Fields shifted-->
                    <apex:pageBlockSection title="SLA" id="FRBExtension">
                        <apex:outputField value="{!case.Was_Mandated_Acknowledgement_SLA_Met__c}"/>
                        <apex:outputField value="{!case.Was_Mandated_Response_SLA_Met__c}"/>
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Acknowledgement Method"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Acknowledgement_Method__c}">
                                    <apex:actionSupport event="onchange" reRender="FRBExtension" status="SLAStatus"/>
                            </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem> 
                        <!--For CMI 2014 Release 3 the below Field AcknowledgementMethod is added-->
                        <apex:inputField value="{!case.Resolution_Method__c}" />
                        
                        <apex:outputField value="{!case.Mandated_Acknowledgement_SLA_Date__c}" />
                        <!--<apex:outputField value="{!case.Was_Mandated_Acknowledgement_SLA_Met__c}"/>-->
                        <apex:outputField value="{!case.Mandated_Response_SLA_Date__c}"/>
                        <apex:inputField value="{!case.Acknowledgement_Date_Time_Sent__c}" />
                       
                                              
                        <apex:inputField value="{!case.Response_Date_Time_Sent__c}" />
                         
                        <br/><apex:outputField value="{!case.Mandated_Response_Extension_SLA_Date__c}"/>
                        
                        <!--For CMI 2015 Release 3 AND condition is added for Required attribute in below field-->                                            
                        <br/><apex:inputField value="{!case.Extension_Notification_Date_Time_Sent__c}"/> 
                                            
                                                                       
                        <!--For CMI 2014 Release 3 the below Field is added-->
                        <br/><apex:inputField value="{!case.FRB_Extension_Approved_Date__c}"  rendered="{! case.Call_Source__c='FRB' || case.Call_Source__c='FRB Congressional'}" />                                                
                    </apex:pageBlockSection>
                    <!--End changes for october release 2016-->
                    
                    <apex:pageBlockSection columns="1">   
                        <apex:inputField value="{!case.If_SLA_Missed_Provide_Reason_s__c}"/><br/>
                        <apex:inputField value="{!case.SLA_Missed_Comments__c}" style="width:500px;height:140px;"/>                     
                    </apex:pageBlockSection>  
                    
                    <apex:actionStatus id="SLAStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>            
                    
                    
                    
                      <!-- *************************************************************** -->
            <!-- *   R E P U T A T I O N    R I S K    S U M M A R Y   * -->
            <!-- *************************************************************** --> 



<apex:pageblocksection title="Reputational Risk Summary" columns="1" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                        
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Disposition"/>
                <apex:inputField value="{!case.Reputational_Risk_Disposition__c}">
                    <apex:actionSupport event="onchange" rerender="ReputationalRiskSummary" status="ReputationalRisk"/> 
                </apex:inputField>                             
            </apex:pageBlockSectionItem>
            
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Evaluation"/>
                <apex:define name="requiredClientFeedback">
                    <div class="requiredInput">
                        <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                        <div class="requiredBlock" style="{!IF(case.Reputational_Risk_Disposition__c='No Investigation Required','background-color:C00','background-color:transparent')}"></div>
                        <apex:inputField value="{!case.Reputational_Risk_Evaluation__c}">
                            <apex:actionSupport event="onchange" rerender="ReputationalRiskSummary" status="ReputationalRisk"/> 
                        </apex:inputField>
                    </div>
                </apex:define>                            
            </apex:pageBlockSectionItem>
           
            <apex:pageBlockSectionItem > 
                <apex:outputLabel value="Reputational Risk Comments"/>
                <apex:define name="requiredClientFeedback">
                    <div class="requiredInput">
                        <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                        <div class="requiredBlock" style="{!IF(OR(case.Reputational_Risk_Disposition__c='No Investigation Required',case.Reputational_Risk_Evaluation__c!=null),'background-color:C00','background-color:transparent')}"></div>
                        <apex:inputTextArea value="{!case.Reputational_Risk_Comments__c}" cols="80" rows="7"/>
                    </div>
                </apex:define>
            </apex:pageBlockSectionItem>
                        
        </apex:pageblocksection>
        
        <apex:actionStatus id="ReputationalRisk">
            <apex:facet name="start">
                <div style="text-align:center;">
                    <img src="{!$Resource.SpinIcon}"/>
                </div>
            </apex:facet>
        </apex:actionStatus>

                    
                <!--Start Changes for CMI Pilot-->
                    
                    
           <!--************************************************** --> 
            <!-- *         Compliance Evaluation Summary          * -->
            <!-- ************************************************** -->
    
            <!--<apex:pageBlockSection id="ComplianceEvaluationSummary" title="Compliance Evaluation Summary" columns="1">-->
            
                
                <!--End changes for for CMI 2015 Iteration 1-->
            <apex:pageBlockSection id="ComplianceEvaluationSummary" title="Complaint Evaluation Summary" columns="1">    
                <apex:actionRegion >
                    
                <!--Start changes for for CMI 2015 Iteration 1-->
                    
                    <apex:pageBlockSection id="litigationFields">                 
                        <apex:inputField value="{!case.Compliance_Review_of_Letter_Needed__c}"/>
                        <!--Start changes for CMI 2015 Iteration 2-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Litigation__c.label}"></apex:outputLabel>
                            
                                <apex:inputField value="{!case.Litigation__c}">
                                    <apex:actionSupport event="onchange" rerender="litigationFields,complianceOverrideOptIn" status="compOptIn" action="{!nullifyValuesOnLitigationChange}"/>
                                </apex:inputField>
                            
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2015 Iteration 2-->                                        
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Was_The_Resolution_Letter_Reviewed__c.label}"></apex:outputLabel>
                            <apex:inputField value="{!case.Was_The_Resolution_Letter_Reviewed__c}">
                                <apex:actionSupport event="onchange" rerender="litigationFields" status="compOptIn"/>
                            </apex:inputField>                                
                        </apex:pageBlockSectionItem>
                        <!--Start changes for CMI 2015 Iteration 2-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Reference__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLegalRef">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF(case.Litigation__c == 'Yes' &&($ObjectType.Case.fields.Legal_Reference__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Legal_Reference__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        <!--<apex:inputField value="{!case.Legal_Reference__c}" required="{!case.Litigation__c == 'Yes' && case.Litigation__c != Null}"/>-->
                        <!--The below field is included for CMI 2015 Iteration 4-->
                        <!--<apex:inputField id="letterComments" value="{!case.Letter_Review_Comments__c}" required="{!case.Was_The_Resolution_Letter_Reviewed__c='Approved Without Edits' || case.Was_The_Resolution_Letter_Reviewed__c='Limited Edits Recommended' || case.Was_The_Resolution_Letter_Reviewed__c='Significant Changes Recommended'}" style="width:300px;height:45px"/>-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Letter_Review_Comments__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLetterReview">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF((case.Was_The_Resolution_Letter_Reviewed__c='Approved Without Edits' || case.Was_The_Resolution_Letter_Reviewed__c='Limited Edits Recommended' || case.Was_The_Resolution_Letter_Reviewed__c='Significant Changes Recommended') &&($ObjectType.Case.fields.Letter_Review_Comments__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Letter_Review_Comments__c}" style="width:300px;height:45px"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2015 Iteration 2-->
                        <!--For CMI 2015 Iteration 2, required attribute is added in the below field-->                    
                        <!--<apex:inputField value="{!case.Legal_Resource__c}" required="{!case.Litigation__c == 'Yes'}"/>-->
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="{!$ObjectType.Case.fields.Legal_Resource__c.label}"></apex:outputLabel>
                            <apex:define name="requiredLegalResource">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF(case.Litigation__c == 'Yes' &&($ObjectType.Case.fields.Legal_Resource__c.Updateable) ,'background-color:C00','background-color:transparent')}"></div>                                         
                                    <apex:inputField value="{!case.Legal_Resource__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                                                                                
                    <!--Start changes for for CMI 2014 Release 2-->                
                    <apex:pageBlockSection id="complianceOverrideOptIn">  
                        <!--For CMI 2015 Iteration 2, compliance override checkbox is replaced by Compliance override reason and compliance opt in comments field is added-->                                                                          
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Compliance Override Reason"/>  
                            <!--<apex:actionRegion >-->
                                <apex:inputField value="{!case.Compliance_Override_Reason__c}">
                                    <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn" status="compOptIn"/> 
                                </apex:inputField>                  
                            <!--</apex:actionRegion>-->
                        </apex:pageBlockSectionItem> 
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Referral Override/Opt In Comments"/>                
                            <apex:define name="requiredClientFeedback">
                                <div class="requiredInput">
                                    <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                                    <div class="requiredBlock" style="{!IF(OR(case.Compliance_Opt_In__c,case.Compliance_Override_Reason__c != null,case.Referral_Opt_In__c!=null),'background-color:C00','background-color:transparent')}"></div>     
                                    <apex:inputField value="{!case.Compliance_Override_Comments__c}" style="width:300px;height:45px"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>                            
                        
                        <!-- For CMI 2015 Iteration 3, rendered condition is added as this field should be rendered only for cases created prior to Iteration 3-->                            
                        <apex:pageBlockSectionItem rendered="{!case.createddate <rel3DeploymentDateValue}"> 
                            <apex:outputLabel value="Compliance Opt In" rendered="{!case.createddate <rel3DeploymentDateValue}"/>
                            <apex:inputCheckbox value="{!case.Compliance_Opt_In__c}" rendered="{!case.createddate <rel3DeploymentDateValue}">
                                <apex:actionSupport event="onclick" rerender="complianceOverrideOptIn" status="compOptIn"/> 
                            </apex:inputCheckbox> 
                        </apex:pageBlockSectionItem>                                                
                    </apex:pageBlockSection>
                    
                    <!--Start changes for CMI 2015 Iteration 3-->
                    <apex:pageblocksection columns="1" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                        <apex:pageBlockSectionItem rendered="{!case.createddate >= rel3DeploymentDateValue}"> 
                            <apex:outputLabel value="Referral Opt In" rendered="{!case.createddate >= rel3DeploymentDateValue}"/>
                            <apex:inputField value="{!case.Referral_Opt_In__c}" rendered="{!case.createddate >= rel3DeploymentDateValue}">
                                <!--For CMI 2016 April Release referralButton is added in rerender attribute-->
                                <!--Close Case Panel has been removed as a part of CMI April 2019 release. To avoid clearing fields in close case section when referral optin is changed-->
                                <apex:actionSupport event="onchange" rerender="functionalArea,complianceOverrideOptIn,Comments,referralButton" status="compOptIn" action="{!checkOptInAndNullifyReferralDisposition}"/> 
                            </apex:inputField>                            
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>                                        
                    <!--End changes for CMI 2015 Iteration 3-->
                </apex:actionRegion>            
                <!--End changes for for CMI 2014 Release 2-->
                
                <apex:actionStatus id="compOptIn">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus> 
                <apex:pageBlockSection id="overallReview" columns="2">
                    <apex:inputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!case.Compliance_Opt_In__c}"/>
                    <!--Start changes for CMI 2015 Iteration 2-->
                    <apex:outputField value="{!case.CL_Exception_Review_Disposition__c}" rendered="{!!case.Compliance_Opt_In__c}"/>                    
                    <!--End changes for CMI 2015 Iteration 2-->
                    <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:300px;height:45px;" rendered="{!case.createddate < rel3DeploymentDateValue}" />                    
                </apex:pageBlockSection>            
                                
                <apex:pageBlockSection id="CLInvestigation" columns="2">
                    <apex:inputField value="{!case.C_L_Investigation_Disposition__c}"/>
                    <apex:inputField value="{!case.C_L_Investigation_Comments__c}" style="width:300px;height:45px;" rendered="{!case.createddate < rel3DeploymentDateValue}" />
                </apex:pageBlockSection>
                                                 
                <!--Start Changes for CMI 2014-->
                <apex:outputPanel rendered="{!case.createddate <rel3DeploymentDateValue}">
                <apex:actionRegion >    
                    <apex:pageBlockSection id="depositInvestigation" columns="2">
                        <!--For CMI 2014 Release 3, action region and action support are added for the vbeloer -->
                        <apex:pageBlockSectionItem helptext="Privacy, Reg CC, Reg D, Reg E"> 
                            <apex:outputLabel value="Deposit/Others Investigation Disposition"/>
                             <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF((case.Deposit_Others_C_L_Disposition__c='Investigation Required'||case.Deposit_Others_C_L_Disposition__c='Pending Review')&& $ObjectType.Case.fields.Deposit_Others_Investigation_Disposition__c.Updateable,'background-color:C00','background-color:transparent')}"></div>                                            
                            <!--<apex:actionRegion >-->    
                                            <apex:inputField value="{!case.Deposit_Others_Investigation_Disposition__c}" >
                                                <apex:actionSupport event="onchange" reRender="depositInvestigation,RegLaw,RegLawLabel" status="RegLawStatus1"/>
                                            </apex:inputField>
                            <!--</apex:actionRegion>-->
                                        </div>
                                    </apex:define>
                        </apex:pageBlockSectionItem>
                        <!--<apex:inputField value="{!case.Deposit_Others_C_L_Comments__c}" style="width:300px;height:45px" required="{!IF((case.Deposit_Group_Summary__c=HTMLENCODE('Document related information for C&L Exception Review prior to case closure.')),true,false)}"/>-->
                        <!--For CMI 2014 Release 3, the Investigation Comments field is rendered as required even if the corresponding Investigation Disposition field is 'Exception'-->
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Deposit/Others Investigation Comments"/>                   
                        <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(OR(case.Deposit_Others_C_L_Disposition__c='Investigation Required',case.Deposit_Others_C_L_Disposition__c='Pending Review',case.Deposit_Others_Investigation_Disposition__c='Exception'),'background-color:C00','background-color:transparent')}"></div>       
                                        <apex:inputField value="{!case.Deposits_Other_Investigation_Comments__c}" style="width:300px;height:45px" />
                                  </div>
                                </apex:define>
                        </apex:pageBlockSectionItem> 
                    </apex:pageBlockSection>

                    <apex:pageBlockSection id="fairBankingInvestigation" columns="2">
                        <!--For CMI 2014 Release 3, action region and action support are added for the vbeloer -->
                        <apex:pageBlockSectionItem helptext="UDAAP,ECOA,FHA,CRA"> 
                            <apex:outputLabel value="Fair Banking Investigation Disposition"/>
                            <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF((case.Fair_Banking_C_L_Disposition__c='Investigation Required' || case.Fair_Banking_C_L_Disposition__c='Pending Review')&&($ObjectType.Case.fields.Fair_Banking_Investigation_Disposition__c.Updateable),'background-color:C00','background-color:transparent')}"></div>                          
                            <!--<apex:actionRegion >-->    
                                <apex:inputField value="{!case.Fair_Banking_Investigation_Disposition__c}">
                                    <apex:actionSupport event="onchange" reRender="fairBankingInvestigation,RegLaw,RegLawLabel" status="RegLawStatus1"/>
                                </apex:inputField>
                                </div>
                                </apex:define>
                            <!--</apex:actionRegion>-->
                        </apex:pageBlockSectionItem>
                        <!--For CMI 2014 Release 3, the Investigation Comments field is rendered as required even if the corresponding Investigation Disposition field is 'Exception'-->
                           <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Fair Banking Investigation Comments"/>                   
                            <apex:define name="requiredClientFeedback">
                                    <div class="requiredInput">
                                        <div class="requiredBlock" style="{!IF(OR(case.Fair_Banking_C_L_Disposition__c='Investigation Required',case.Fair_Banking_C_L_Disposition__c='Pending Review',case.Fair_Banking_Investigation_Disposition__c='Exception'),'background-color:C00','background-color:transparent')}"></div>       
                                        <apex:inputField value="{!case.Fair_Banking_Investigation_Comments__c}" style="width:300px;height:45px" />
                                  </div>
                            </apex:define>
                        </apex:pageBlockSectionItem> 
