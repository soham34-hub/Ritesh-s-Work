                                        <div class="requiredBlock" style="{!IF(OR(case.Lending_Savings_C_L_Disposition__c='Investigation Required',case.Lending_Savings_C_L_Disposition__c='Pending Review',case.Lending_Saving_Investigation_Disposition__c='Exception'),'background-color:C00','background-color:transparent')}"></div>       
                                        <apex:inputField value="{!case.Lending_Savings_Investigation_Comments__c}" style="width:300px;height:45px" />
                                  </div>
                                </apex:define>
                        </apex:pageBlockSectionItem> 
