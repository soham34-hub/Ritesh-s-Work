        <style type="text/css">
            .custPopup
            {
            background-color: white;
            border-width: 2px;
            border-style: solid;
            z-index: 9999;
            left: 35%;
            padding:1%;
            position: fixed;
            width:58%;
            margin-left: -15%;
            top:45%;
            height:11%;
            }
            .popupBackground
            {
            background-color:black;
            opacity: 0.20;
            filter: alpha(opacity = 20);
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 9998;
            }
        </style>
        <!--End Changes for CMI 2014-->
    </apex:form>   
