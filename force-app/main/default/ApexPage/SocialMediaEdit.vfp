

<apex:page standardController="Case" action="{!retrieveArrangementSummariesList}" extensions="SocialMediaEdit_ControllerExtension,CMIClientManagement_ControllerExtension,CategoryLists_ControllerExtension" id="id1" >
    <apex:messages style="color:red;font-weight:bold;" />
    
    <script type="text/javascript" >
    
    var originalOnload = window.onload;
    window.onload = f1;
    
    function f1() 
    {
        originalOnload();
        if(document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='' || document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='Non SunTrust Impact')
        { 
            document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCauseDetails}').style.display='none';
        }         
    }  
    
    function hidefieldsrootCauseDetail()
    {
        
        if(document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='' || document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='Dissatisfaction with Bank Policy or Procedure' || document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCause.id3}').value=='Non SunTrust Impact')
        {
            
            document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCauseDetails}').style.display='none';
        }
        else
        {
            document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCauseDetails}').style.display='block';
        }
    }
    
    
    function f2()
    {
        document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.rootCauseDetails}').style.display='none';   
    } 
    <!--start changes for CMI 2016 December release-->
        <!--Complaint From or About A Supplier is nullified on selecting supplier search-->
        function vendorsearch()
                              {
                                  document.getElementById('{!$Component.id1.SocialMediaEditForm.SMCase.clientFeedbackDetails.SupplierBlock.SupplierField}').value='';       
                              }  
                                  <!--End changes for CMI 2016 December release-->
                                  
                                  function noenter(e)
                                  {
                                  if(window.event)
                                  {
                                  key = window.event.keyCode; 
                              } 
                                  else
                                  {
                                  key = e.which; 
                              }
                                  if(key == 13) 
                                  {
                                  var ele=document.getElementById('id1:SocialMediaEditForm:SMCase:fbcat:fbcat1:catButton:catSearchButton');
                                  ele.click();
                                  return false;
                              } 
                                  else
                                  {
                                  return true;
                              }
                              } 
                                  
                                  </script>
    
    <apex:form id="SocialMediaEditForm" >
        
        <apex:outputField value="{!case.Cat_Ref_Name__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_1__c}" rendered="FALSE" /> 
        <apex:outputField value="{!case.Cat_Level_2__c}" rendered="FALSE" /> 
        <apex:outputField value="{!case.Cat_Level_3__c}" rendered="FALSE" />     
        <apex:outputField value="{!case.Cat_Level_4__c}" rendered="FALSE" />
        <apex:outputField value="{!case.Cat_Level_5__c}" rendered="FALSE" />
        <apex:outputField value="{!case.CMI_Deleted_case__c}" rendered="FALSE" />
        <apex:outputField rendered="false" value="{!case.Account_For_Open_Cases__c}"/>
        <apex:outputField rendered="false" value="{!case.Account_For_Closed_Cases__c}"/>
        <!-- B-2078 changes for CMI September 2018 Release--> 
        <apex:outputField value="{!case.servicing__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.Srvc_and_operational__c}" rendered="FALSE"/>
        <apex:outputField value="{!case.operational__c}" rendered="FALSE"/>
        <!-- End of B-2078 changes for CMI September 2018 Release-->
        <apex:pageBlock title="Social Media Case" mode="edit" id="SMCase">
            <apex:pageBlockButtons location="both">
                <apex:commandButton action="{!save}" value="Save" />
                <apex:commandButton action="{!cancel}" value="Cancel" />
            </apex:pageBlockButtons>
            
            <!-- *************************************** -->
            <!-- *   C A S E   I N F O R M A T I O N   * -->
            <!-- *************************************** -->
            
            <!-- Define the JavaScript function setFocus-->
            <apex:actionFunction name="setFocus" focus="click" rerender="originId" />
            
            <apex:pageBlockSection title="Case Information" columns="1" id="caseinfo">
                <apex:outputField value="{!case.CaseNumber}" />
                <apex:outputField id="originId" value="{!case.OwnerId}" />
                
                <apex:inputField value="{!case.Origin}" required="true" />
                <!--Commented for CMI 2014. As rendering of some sections is dependent on Case Type-->
                <!--<apex:inputField value="{!case.Type}" required="True" />-->
                
                <!--Start Changes For CMI 2014--> 
                <apex:pageBlockSectionItem >
                    <apex:outputlabel value="Case Type"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Type}" required="True">
                            <!--clientInfoSection is added in rerender attribute for CMI 2014.1 break/fixes-->
                            <!--For CMI 2016 April Release initiativeTracking added in rerender attribute-->
                            <!--Start Changes for CMI October 2017 Release-->
                            <apex:actionSupport event="onchange" rerender="supplierDetailsPanel,ComplianceEvaluation,clientInfoSection,authorisedThirdParty,renderResolutionDeatils,slaSection,LOBAccountDetailsPanel,ComplianceEvaluationSummary,feedbackCategorySection,bypassClientContactMethodFields,clientFollowUpSection,functionalArea,sourceRecievedDateTime,isThisAClient,clientFeedbackDetails,initiativeTracking,serviceingChallenge,serviceingChallengeReported,servicingInteractionDispositonFields" status="MainStatus"/>
                            <!--End Changes for CMI October 2017 Release-->
                            
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End changes for CMI 2014-->                
                <apex:inputField value="{!case.Call_Source__c}" required="True" />
            </apex:pageBlockSection>   
            <!--Start changes for CMI 2014-->
            <apex:outputPanel id="sourceRecievedDateTime" >
                <apex:pageBlockSection rendered="{!case.Type = 'Complaint'}" columns="1">
                    <apex:pageBlockSectionItem rendered="{!(SRDEditable)}">
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock" style="{!IF(case.Type='Complaint','background-color:C00','background-color:transparent')}" ></div>
                                <apex:inputField value="{!case.Source_Received_Date_Time__c}" rendered="{!SRDEditable}"/>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem rendered="{!NOT(SRDEditable)}">  
                        <apex:outputlabel value="Source Received Date/Time"  />
                        <apex:outputField value="{!case.Source_Received_Date_Time__c}" rendered="{!!SRDEditable}"/>
                    </apex:pageBlockSectionItem>
                    
                </apex:pageBlockSection>
            </apex:outputPanel>
            <!--End changes for CMI 2014-->
            
            
            <apex:actionStatus id="MainStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->
            
            <!-- ******************************************* -->
            <!-- *   C L I E N T   I N F O R M A T I O N   * -->
            <!-- ******************************************* -->
            <apex:outputPanel id="isThisAClient" >
                <apex:outputPanel rendered="{!case.Type != 'Positive Feedback/Compliment'}" >
                    <apex:pageBlockSection title="Client Information" columns="2" id="clientInfoSection">
                        <!--Start Changes for CMI 2014-->
                        <apex:pageblocksectionitem >
                            <apex:outputlabel value="Is this a Client?" />
                            <apex:actionRegion >
                                <!--The field is made required for CMI 2014-->
                                <apex:inputField value="{!case.Is_this_a_Client__c}" required="{!case.Special_Initiatives__c<>null }"  >                            
                                    
                                    <!--In rerender modalDialog,nameSearch,renderAccountDetails is added for CIS Search in CMI 2014 and clientInfoSection for CMI 2014 break/fixes-->
                                    <!--For CMI 2014 Release 2, ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields are added in rerender attribute-->
                                    <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="modalDialog,clientFollowUpSection,nameSearch,renderAccountDetails,clientInfoSection,authorisedThirdParty,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields" status="clientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageblocksectionitem>
                        <!--End Changes for CMI 2014-->
                        <!--<br/>-->
                    </apex:pageBlockSection>
                </apex:outputPanel>
                
                
                <apex:outputPanel rendered="{!case.Type == 'Positive Feedback/Compliment'}" >
                    <apex:pageBlockSection title="Client Information" columns="1" id="clientInfoSectionForPositiveFeedbackSec">
                        <!--Start Changes for CMI 2014-->
                        <apex:pageblocksectionitem >
                            <apex:outputlabel value="Is this a Client?" />
                            <apex:actionRegion >
                                <!--The field is made required for CMI 2014-->
                                <apex:inputField value="{!case.Is_this_a_Client__c}" >                            
                                    
                                    <!--In rerender modalDialog,nameSearch,renderAccountDetails is added for CIS Search in CMI 2014 and clientInfoSection for CMI 2014 break/fixes-->
                                    <!--For CMI 2014 Release 2, ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields are added in rerender attribute-->
                                    <apex:actionSupport event="onchange" action="{!clearClientInformationFields}" rerender="modalDialog,clientFollowUpSection,nameSearch,renderAccountDetails,clientInfoSectionForPositiveFeedbackSec,authorisedThirdParty,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,bypassClientContactMethodFields" status="clientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageblocksectionitem>
                        <!--End Changes for CMI 2014-->
                        
                    </apex:pageBlockSection>
                </apex:outputPanel>
            </apex:outputPanel>
            
            
            <!-- End changes for CMI 2014 Release 3 -->
            
            
            <!--Start changes for CIS Search for CMI 2014-->
            <apex:outputPanel id="modalDialog">
                <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='Yes'}">
                    <!--For CMI 2014 Release 2, the disabled attribute has been added in the below button-->
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showModalDialog}" reRender="accountSearch,nameSearch,LOBAccountDetailsPanel" value="Search Client" disabled="{!case.BypassSearchProcess__c}"/>                                                   
                    <!--<c:Modal_Dialog id="accountSearch" visible="{!assignArrangement.assignIsModalOpen}">
                        <c:SearchComponent caseReference="{!case}" invokePoint="fromCase" accountDetailsList="{!assignAccountDetails}" modalClose="{!assignArrangement}"/>
                        <!--<div style="text-align:center">
<apex:commandButton immediate="true" action="{!hideModalDialog}" reRender="accountSearch,nameSearch,renderAccountDetails" value="Return To Case"/>
</div>-->
                        <!--<br/>                   
                    </c:Modal_Dialog>-->                            
                </apex:pageBlockSection>
                
                <apex:pageblockSection rendered="{!case.Is_this_a_Client__c='No'}">                        
                    <apex:commandButton style="margin-left:37%" immediate="true" action="{!showCreateModalDialog}" reRender="accountCreate,nameSearch" value="Create Observer"/>                        
                    <!--<c:Modal_Dialog id="accountCreate" visible="{!createModalStatus}">
                        <c:CreateClientComponent caseReference="{!case}" sourcePage="fromCase" />
                        <div style="text-align:center">
                            <apex:commandButton immediate="true" action="{!hideCreateModalDialog}" reRender="accountCreate,nameSearch,renderAccountDetails" value="Return To Case" />                   
                        </div>
                        <br/>
                    </c:Modal_Dialog> -->                   
                </apex:pageblockSection>
            </apex:outputPanel>
            
            <apex:outputPanel id="authorisedThirdParty">
                <apex:outputPanel rendered="{!AND(NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}">
                    <apex:pageblockSection >
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <!--<apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!(case.Is_this_a_Client__c='No' || (case.Is_this_a_Client__c='Yes' && (case.Type='Complaint' || case.Type='Tracking Only')))}"/>--> 
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This An Authorized Third Party" />
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}" rendered="{!(NOT(case.BypassSearchProcess__c))}">
                                    <apex:actionSupport event="onchange"  reRender="clientRelatedFields,clientRelatedFields1,authorizedClientDetails,authorisedThirdParty" status="ClientStatus"/>
                                </apex:inputField> 
                            </apex:actionRegion> 
                        </apex:pageBlockSectionItem>  
                        <br/>
                        <apex:pageBlockSectionItem id="authorizedClientDetails">
                            <apex:outputlabel value="Contact Name" rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}" />                                                
                            <apex:inputField required="{!case.Is_This_An_Authorized_Third_Party__c = 'Yes'}" value="{!case.Contact_Name__c}" rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}" />
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem id="authorizedClientDetails1">
                            <apex:outputlabel value="Contact Phone" rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}"/>
                            <apex:inputField value="{!case.Contact_Phone__c}" rendered="{!AND(OR(case.Is_This_An_Authorized_Third_Party__c = 'Yes',case.Is_This_An_Authorized_Third_Party__c = 'No',case.Business_or_Personal__c = 'Business'),NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}"/>                               
                        </apex:pageBlockSectionItem>
                    </apex:pageblockSection>
                </apex:outputPanel>
            </apex:outputPanel>    
            
            <!--Start Changes  for CMI 2014 Release 2-->
            <!--This section is added to bypass the client search when it is not displaying any results -->
            <apex:outPutPanel id="ClientSectionAfterBypassingSearchClient"> 
                <apex:outputPanel rendered="{!(assignArrangement.byPassSearchProcess && case.Is_this_a_Client__c='Yes')}">                         
                    <apex:pageBlockSection >                         
                        <apex:pageBlockSectionItem >    
                            <apex:outputlabel value="Bypass Client Search"/> 
                            <apex:actionRegion > 
                                <apex:inputCheckbox value="{!case.BypassSearchProcess__c}" >
                                    <apex:actionSupport action="{!nullifyFieldsForBypassingSearchProcess}" event="onclick" rerender="clientInfoSection,clientInfoSectionForPositiveFeedbackSec,authorisedThirdParty,modalDialog,ClientSectionAfterBypassingSearchClient,FieldsOnBypassingSearchProcess,nameSearch,renderAccountDetails,clientFollowUpSection,bypassClientContactMethodFields,LOBAccountDetailsPanel"  status="ClientStatus"/>
                                </apex:inputCheckbox> 
                            </apex:actionRegion> 
                        </apex:pageblocksectionitem>
                    </apex:pageBlockSection>
                </apex:outputPanel>
            </apex:outputPanel>
            <apex:outputPanel id="FieldsOnBypassingSearchProcess">
                <apex:outPutPanel rendered="{!case.BypassSearchProcess__c && case.Is_this_a_Client__c == 'Yes'}">
                    <apex:pageBlockSection columns="1" >                              
                        <apex:pageBlockSectionItem >
                            <!-- Start Changes for CMI 2014 Release 3 -->                        
                            <apex:outputlabel value="Reason for Bypass"/>
                            <!-- End Changes for CMI 2014 Release 3 -->
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Reason_for_Overriding_Search_Process__c}" required="true">
                                    <apex:actionSupport event="onchange" rerender="CINField"  status="ClientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>                             
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="authorizedClientDetailsBypass">
                        <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}" required="true" value="{!case.Contact_Name__c}"/> <br/>
                        <apex:inputField rendered="{!AND(OR(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='ES Tracking Only'))}"  required="true" value="{!case.Contact_Phone__c}"/>
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="CINField" columns="1">                              
                        <apex:inputField value="{!case.CIN__c}" rendered="{!case.Reason_for_Overriding_Search_Process__c='System Not Available'}"/>
                        <!--Commented For CMI 2014 Release 3.TIN Field is not needed-->
                        <!--<apex:inputField value="{!case.TIN__c}" required="true"/>-->
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection columns="1" >                              
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This A Private Wealth Client?" />
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" required="true">                                
                                    <apex:actionSupport event="onchange" status="AccountTypeStatus" rerender="LOBAccountDetailsPanel"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <!--End changes for CMI 2014 Release 3-->
                        
                        <!--Below Field is added for CMI 2014 Release 3-->
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Account Type"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Account_Type__c}" required="true">
                                    <apex:actionSupport event="onchange" reRender="accTypeDetail,AlternateAddress,AccountNumber" status="AccountTypeStatus" action="{!defaultAccountTypeDetailField}"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    
                    <!--The below Field is added for CMI 2014 Release 3-->
                    <apex:pageBlockSection id="AccountNumber">
                        <apex:inputField id="AccountNumber" value="{!case.Account_Number__c}" required="{!case.Account_Type__c!="Treasury & Payment Solutions" && case.Account_Type__c!="Wholesale Other"}"/> 
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="accTypeDetail">
                        <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. -->
                        <!--Start of changes for feb 2017-->
                        <!--Account type detail should render for account type=Commercial loan-->
                        <apex:inputField value="{!case.Account_Type_Detail__c}" rendered="{!case.Account_Type__c='Private Wealth Mgmt' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c='Consumer Loan' || case.Account_Type__c = 'Wholesale Other' || case.Account_Type__c = 'Commercial Loan'}"  required="true"/>
                        <!--End of changes for feb 2017--> 
                        <!-- For CMI 2014 Release 3 the below field is added -->
                        <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card'}"/>                    
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection id="isThisAuthThirdParty">
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This An Authorized Third Party" />
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_An_Authorized_Third_Party__c}">
                                    <apex:actionSupport event="onchange"  reRender="authorizedClientDetailsBypass" status="ClientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection> 
                    
                    
                    
                </apex:outPutPanel>
            </apex:outPutPanel>
            <!--End Changes  for CMI 2014 Release 2-->
            
            <!--For CMI 2014 Release 2, the below two outputPanels are added-->
            <apex:outputPanel id="nameSearch">
                <!--<apex:outputPanel rendered="{!NOT(case.BypassSearchProcess__c)}">-->  
                <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added-->             
                <apex:pageblockSection columns="1" rendered="{!(case.CIN__c!=Null || case.Client_Name__c<>null) && NOT(case.BypassSearchProcess__c) }">
                    <apex:outputField rendered="false" value="{!case.Account_For_Open_Cases__c}"/>
                    <apex:outputField rendered="false" value="{!case.Account_For_Closed_Cases__c}"/>
                    <apex:outputField rendered="{!case.Client_Name__c<>null &&(case.Account_For_Open_Cases__c=null || case.Account_For_Open_Cases__c='')&&(case.Account_For_Closed_Cases__c=null || case.Account_For_Closed_Cases__c='')}" value="{!case.Client_Name__c}"/>
                    <!--Start changes for CMI 2016 April release.Client Name is displayed as a link to open the Related Account Record-->
                    <apex:pageBlockSectionItem rendered="{!case.Client_Name__c<>null && ((case.Account_For_Open_Cases__c!=null && case.Account_For_Open_Cases__c!='') || (case.Account_For_Closed_Cases__c!=null && case.Account_For_Closed_Cases__c!=''))}">
                        <apex:outputLabel value="Client Name"/>
                        <apex:actionRegion >                                                                                                    
                            <apex:commandLink status="LOBDetailStatus" value="{!case.Client_Name__c}" action="{!redirectToAccount}" immediate="true" target="_blank"/>                                                                                   
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <!--End changes for CMI 2016 April release.--> 
                    <apex:outputField rendered="{!case.CIN__c<>null}" value="{!case.CIN__c}"/>
                    <apex:outputField rendered="{!case.Business_or_Personal__c<>null}" value="{!case.Business_or_Personal__c}"/>
                    <!--Fields for HH Information-->
                    <!--<apex:outputField rendered="{!(case.HH_Info__c!=Null && case.HH_Info__c!='')}" value="{!case.HH_Info__c}"/>-->
                    <apex:outputField rendered="{!(case.Client_Servicing_Code__c!=Null && case.Client_Servicing_Code__c!='')}" value="{!case.Client_Servicing_Code__c}"/>                                                            
                    <!--<apex:outputField rendered="{!(case.Client_Segmentation_Code__c!=Null && case.Client_Segmentation_Code__c!='')}" value="{!case.Client_Segmentation_Code__c}"/>-->
                    <!--Fields for HH Information-->
                </apex:pageBlockSection>  
                
                
                <!--For CMI 2014 Release 2, rendered attribute is added-->    
                <apex:pageBlockSection rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c) && !comingAfterCreatingClient }">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Select Account" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient )}"/>
                        <apex:define name="requiredSelectAccount">
                            <apex:actionRegion >                                    
                                <apex:selectList size="1" value="{!selectedAccountInformation}" rendered="{!(case.CIN__c!=Null && !comingAfterCreatingClient )}">
                                    <apex:selectOptions value="{!accountsList}"/>
                                    <apex:actionSupport event="onchange" action="{!storeSelectedAccountDetails}" reRender="selectAccountModal, renderAccountDetails" status="selectAccountStatus"/>
                                </apex:selectList>                                               
                            </apex:actionRegion>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                </apex:pageblockSection>
                <c:Modal_Dialog id="selectAccountModal" visible="{!assignArrangement.assignIsAccountModalOpen}" width="35%" left="35%" height="85%">
                    <c:SelectAccountComponent caseReference="{!case}" modalStatus="{!assignArrangement}"/>
                    <br/>
                </c:Modal_Dialog>
                
                <apex:actionStatus id="selectAccountStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                <!--</apex:outputPanel>-->
            </apex:outputPanel><!--nameSearch-->
            
            <!--For CMI 2014 Release 2, the below outputPanel is added-->
            <apex:outputPanel id="renderAccountDetails"> 
                <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added-->
                <apex:pageblockSection rendered="{!NOT(case.BypassSearchProcess__c) && case.Client_Name__c != null}" columns="1">
                    <!--For CMI 2014 Release 2, client name is checked in the rendered condition of the below two fields-->                    
                    <!--Start changes for CMI 2016 June Release.If STProduct is present for the Selected AccountNumber,AccountNumber displays as a link which redirects to STProduct-->                        
                    <apex:pageBlockSectionItem rendered="{!((stProductId!=null && stProductId!='') && case.Account_Number__c<>null && selectedAccountInformation!='Other' && !comingAfterCreatingClient && case.Special_Initiatives__c=='CMI' && case.Client_Name__c!=Null && case.Client_Name__c!='')}">
                        <apex:outputLabel value="Account Number"/>
                        <apex:actionRegion >                                                                                                    
                            <apex:commandLink reRender="" status="LOBDetailStatus" value="{!case.Account_Number__c}" action="{!redirectToSTProduct}" immediate="true" target="_blank"/>                                                                                   
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:outputfield value="{!case.Account_Number__c}" rendered="{!(OR(stProductId=null,stProductId="") && case.Account_Number__c<>null && selectedAccountInformation!='Other' && !comingAfterCreatingClient && case.Special_Initiatives__c=='CMI' && case.Client_Name__c!=Null && case.Client_Name__c!='')}" />
                    <!--End changes for CMI 2016 June Release.-->
                    <apex:outputField rendered="{!(case.Account_Type__c<>null && selectedAccountInformation!='Other' && !comingAfterCreatingClient && case.Special_Initiatives__c=='CMI' && case.Client_Name__c!=Null && case.Client_Name__c!='')}" value="{!case.Account_Type__c}" />
                    <apex:inputField rendered="{!(((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c!=Null ))||case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Number__c}"/>
                    <!--Start changes for for CMI 2014 Release 2.actionSupport is included for AccountTypeField-->
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Account Type" rendered="{!(((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c!=Null ))||case.Special_Initiatives__c<>'CMI'}"/>
                        <apex:actionRegion >
                            <apex:inputField rendered="{!(((selectedAccountInformation=='Other' || comingAfterCreatingClient) && case.CIN__c!=Null ))||case.Special_Initiatives__c<>'CMI'}" value="{!case.Account_Type__c}" >
                                <apex:actionSupport event="onchange" rerender="accountTypeDetail,acctTypeInputHidden" status="clientStatus" action="{!defaultAccountTypeDetailField}"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageblockSection>
                <apex:pageblockSection id="accountTypeDetail" rendered="{!NOT(case.BypassSearchProcess__c) && case.Client_Name__c != null }">  
                    <!-- For CMI 2014 Release 3 the rendering condition for Account Type Detail is changed. -->                   
                    <apex:inputField rendered="{!((case.Account_Type__c='Private Wealth Mgmt') || (case.Business_or_Personal__c = 'Business' && case.Account_Type__c = 'Wholesale Other')) && case.Client_Name__c!=Null && case.Client_Name__c!=''}" value="{!case.Account_Type_Detail__c}"  required="true"/>
                    <!--Start of changes for feb 2017-->
                    <!--Account type detail should render for account type=Commercial loan-->
                    <apex:pageBlockSectionItem rendered="{!(case.Account_Type__c = 'Credit card' || (case.Account_Type__c = 'Credit Card') || case.Account_Type__c='Consumer Loan' || case.Account_Type__c = 'Commercial Loan')}">
                        <apex:outputLabel value="Account Type Detail" />
                        <apex:define name="requiredSelectAccount">
                            <div class="requiredInput">
                                <div class="requiredBlock"></div>
                                <apex:selectList size="1" value="{!case.Account_Type_Detail__c}" >
                                    <apex:selectOptions value="{!acctTypeDetailFieldValue}"/>                                                    
                                </apex:selectList>
                            </div>
                        </apex:define> 
                    </apex:pageBlockSectionItem>
                    <!--End of changes for feb 2017-->
                    <!-- For CMI 2014 Release 3 the below field is added -->
                    <apex:inputField value="{!case.Is_This_Relationship_Managed_By_SAD__c}" rendered="{!(case.Account_Type__c = 'Commercial Loan' || case.Account_Type__c = 'Credit Card' || case.Account_Type__c = 'Credit card') && case.Client_Name__c!=Null && case.Client_Name__c!=''}"/>                
                </apex:pageblockSection>
                <!--End changes for for CMI 2014 Release 2.-->            
                
                <!--End changes for CIS Search for CMI 2014-->
            </apex:outputPanel><!--renderAccountDetails--> 
            
            <apex:pageBlockSection columns="1" id="functionalArea">   
                <apex:inputField value="{!case.Name_Handle__c}" />
                <!--For CMI 2014 breaks/fixes,Client Email is commented because this field is also present in clientFollowUpSection-->
                <!--<apex:inputField value="{!case.Client_Email__c}" />-->
                <apex:inputField value="{!case.Number_of_Followers__c}" />
                
                
                <apex:inputField value="{!case.Functional_Area__c}" required="{!IF((case.Type='Complaint' && case.Special_Initiatives__c!=Null),true,false)}" rendered="{!case.Type != 'Positive Feedback/Compliment'}"/>
                
                <!--End Changes for CMI 2014-->
                
            </apex:pageBlockSection>
            
            <apex:outputPanel id="bypassClientContactMethodFields">
                <apex:outputPanel rendered="{!case.BypassSearchProcess__c }">
                    <apex:pageBlockSection columns="1" >
                        <apex:pageBlockSectionItem rendered="{!OR(case.Type='Complaint',case.Type='Tracking Only')}">
                            <apex:outputlabel value="Client Follow Up Needed?"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="True">
                                    <apex:actionSupport event="onchange" action="{!nullifyFieldsForClientFollowUpChanges}" reRender="bypassClientContactMethodFields" status="ClientStatus"/>
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Contact Method" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" />
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Contact_Method__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes'}" required="true">
                                    <apex:actionSupport event="onchange" reRender="bypassClientContactMethodFields" status="ClientStatus" />
                                </apex:inputField>
                            </apex:actionRegion> 
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Phone'}">
                            <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}"/>  
                            <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='No' || (case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'))}" required="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>                                                                    
                        </apex:pageBlockSectionItem>
                        
                        <!--For CMI 2014 Release 3 below field is added-->
                        <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Phone'}">
                            <apex:outputLabel value="Best Time To Call" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}"/>  
                            <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone'}" required="true"/>                                                                    
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem rendered="{!case.Contact_Method__c='Email'}">
                            <apex:outputlabel value="Alternate Email" rendered="{!(case.Contact_Method__c='Email')}"/>                                           
                            <apex:inputField value="{!case.Alternate_Email__c}" rendered="{!(case.Contact_Method__c='Email')}" required="true"/>                                    
                        </apex:pageblocksectionItem>
                    </apex:pageblocksection>
                    
                    <!--For CMI 2014 Release 3,Alternate Address Field is added to a new PageBlockSection.Because it is rendered based on AccountType Field-->
                    <apex:pageBlockSection id="AlternateAddress">
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Alternate Address" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}"/>  
                            <apex:inputField value="{!case.Alternate_Address__c}" style="width:200px; height:100px" rendered="{!case.Contact_Method__c='Mail' || case.Account_Type__c='Credit Card' || case.Account_Type__c='Debit Card'}" required="true"/>                                                                    
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                </apex:outputPanel>
            </apex:outputPanel>    
            <!--Start Changes for CMI 2014-->
            <!--For CMI 2014 Release 2, the below outputPanel is added-->
            <apex:outputPanel id="clientFollowUpSection">
                <!--For CMI 2014 Release 2, id attribute is removed and rendered attribute is added for the below section-->
                <apex:pageBlockSection rendered="{!NOT(case.BypassSearchProcess__c)}" columns="1">
                    <apex:pageBlockSectionItem rendered="{!AND(NOT(case.BypassSearchProcess__c),OR(case.Type='Complaint',case.Type='Tracking Only'))}">
                        <apex:outputlabel value="Client Follow Up Needed?"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Client_Follow_Up_Needed__c}" required="true">
                                <apex:actionSupport event="onchange" action="{!nullifyFieldsForClientFollowUpChanges}" rerender="clientFollowUpSection" status="clientStatus"/>
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!case.Client_Follow_Up_Needed__c='Yes' && NOT(case.BypassSearchProcess__c)}" Columns="1">   
                    <!--Contact Method added for CMI 2014-->
                    <!--Start changes for CMI 2014 breaks/fixes-->
                    <!--Rendering condition of ContactMethod,ClientContactNumber,AlternatePhoneNumber,ContactAddress,AlternateAddress,ClientEmail is changed because for Tracking Only cases search and create functionality are not there and these fields should be  input fields--> 
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Contact Method" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>
                        <apex:actionRegion >
                            <apex:inputField value="{!case.Contact_Method__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" required="{!IF(case.Type!='Tracking Only',True,False)}">
                                <apex:actionSupport event="onchange" action="{!nullifyFieldsForClientFollowUpChanges}" reRender="clientFollowUpSection" status="clientStatus" />
                            </apex:inputField>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection> 
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection columns="1" rendered="{!(case.Contact_Method__c='Phone') && NOT(case.BypassSearchProcess__c)}" Columns="1">              
                    <apex:pageBlockSectionItem >
                        <!--Rendering conditions included for CMI 2014-->
                        <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Client_Contact_Number__c=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>
                        <apex:inputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Client_Contact_Number__c=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" required="{!IF(case.Type!='Tracking Only',True,False)}"/>                                        
                    </apex:pageBlockSectionItem>
                    
                    <!-- Client contact number output field added for CMI 2014 -->
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Client Phone" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Client_Contact_Number__c!=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only')}"/>
                        <apex:outputField value="{!case.Client_Contact_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && case.Client_Contact_Number__c!=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only')}"/>                                        
                    </apex:pageBlockSectionItem>
                    
                    <!--Alternate Phone Number added for CMI 2014-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Alternate Phone Number" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>  
                        <apex:inputField value="{!case.Alternate_Phone_Number__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" required="{!IF((case.Type!='Tracking Only' && case.Is_this_a_Client__c='No'),True,False)}"/>                                                                    
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem >
                        <!--Rendering conditions included for CMI 2014-->
                        <apex:outputlabel value="Best Time To Call" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>                                           
                        <apex:inputField value="{!case.Best_Time_To_Call__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Phone' && ((case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" required="{!IF(case.Type!='Tracking Only',True,False)}"/>                                    
                    </apex:pageblocksectionItem>
                </apex:pageBlockSection>
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Mail') && NOT(case.BypassSearchProcess__c)}" Columns="1">                              
                    <!--Contact Address added for CMI 2014-->
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && ((case.Contact_Address__c=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>
                        <apex:inputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && ((case.Contact_Address__c=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" style="width:200px; height:100px" required="{!IF(case.Type!='Tracking Only',True,False)}"/>                                        
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Contact Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Contact_Address__c!=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only')}"/>
                        <apex:outputField value="{!case.Contact_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && case.Contact_Address__c!=null && case.Is_this_a_Client__c='Yes' && case.Type!='Tracking Only')}"/>                                        
                    </apex:pageBlockSectionItem>
                    
                    <!--Alternate Address added for CMI 2014-->
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Alternate Address" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>  
                        <apex:inputField value="{!case.Alternate_Address__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Mail' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" style="width:200px; height:100px" required="{!IF((case.Type!='Tracking Only' && case.Is_this_a_Client__c='No'),True,False)}"/>                                                                    
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                
                <!--For CMI 2014 release 2  the below pageBlockSection is added for proper rendering of fields-->
                <apex:pageBlockSection rendered="{!(case.Contact_Method__c='Email') && NOT(case.BypassSearchProcess__c)}" Columns="1">                       
                    <!--Client Email added for CMI 2014-->
                    <!--Start changes for CMI 2017 May Release-->
                    <!--Client Email Field and Alternate Email Field is displayed as optional if the Client Email is invalid from CIS--> 
                    <apex:pageBlockSectionItem >
                        <apex:outputlabel value="Client Email" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}"/>                                           
                        <apex:inputField value="{!case.Client_Email__c}" rendered="{!(case.Client_Follow_Up_Needed__c='Yes' && case.Contact_Method__c='Email' && ((case.Is_this_a_Client__c!=Null && case.Type!='Tracking Only') || case.Type='Tracking Only'))}" required="{!IF(case.Type!='Tracking Only',True,False)}"/>                                    
                    </apex:pageblocksectionItem>                                        
                </apex:pageblocksection>
                <!--End changes for CMI 2014 breaks/fixes-->
                <!--end of ClientFollowUpSection-->
                
                <apex:actionStatus id="clientStatus">
                    <apex:facet name="start">
                        <div style="text-align:center;">
                            <img src="{!$Resource.SpinIcon}"/>
                        </div>
                    </apex:facet>
                </apex:actionStatus>          
                <!--End Changes for CMI 2014-->
            </apex:outputPanel><!--clientFollowUpSection-->
            
            <!-- Start changes for CMI 2014 Release 3 -->
            <apex:outputpanel id="LOBAccountDetailsPanel" title="LOB Account Details" rendered="{!NOT(case.BypassSearchProcess__c)}">
                <apex:outputPanel rendered="{!case.Type != 'Positive Feedback/Compliment'}">
                    <apex:pageBlockSection title="LOB Account Details" />
                    <div style="Margin-Left:2%">
                        <!--Start changes for CMI 2015 Iteration 2-->
                        <apex:outputText Style="font-weight:bold;" value="Private Wealth Client Details" rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c) && (case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c =='PWM') && case.Type == 'Complaint'}" />
                    </div>
                    <apex:pageBlockSection id="IsThisPrivateWealthClient" rendered="{!NOT(case.BypassSearchProcess__c)}">
                        <apex:pageBlockSectionItem >
                            <apex:outputlabel value="Is This A Private Wealth Client?" rendered="{!NOT(case.BypassSearchProcess__c)}"/>
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!NOT(case.BypassSearchProcess__c)}">                                
                                    <apex:actionSupport event="onchange" status="LOBDetailStatus" rerender="lob,officerId"/>                                
                                </apex:inputField>
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem>
                        <apex:outputField value="{!case.Is_This_A_Private_Wealth_Client__c}" rendered="{!case.Case_Association_Type__c='Related Case'}"/>
                    </apex:pageBlockSection>
                    <apex:outputPanel id="lob">
                        <apex:outputPanel rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}">  
                            <apex:pageBlockSection columns="2" >
                                <apex:outputField value="{!case.LOB_Relationship__c}" rendered="{!(case.LOB_Relationship__c=='PWM' || case.Client_Servicing_Code__c =='PWM')}"/>
                                <apex:inputField rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Relationship_ID__c}"/>
                                <apex:pageBlockSectionItem >
                                    <apex:outputlabel rendered="{!(case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes') }" value="Officer Search"/>
                                    <apex:actionRegion >
                                        <apex:inputField rendered="{!(case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Officer_Search__c}" onkeypress="return false;" onkeydown="return false;">                                
                                            <apex:actionSupport event="onchange" action="{!populateContactRelatedFields}" status="LOBDetailStatus" rerender="officerId"/>                                
                                        </apex:inputField>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                            </apex:pageBlockSection>
                        </apex:outputPanel>
                    </apex:outputPanel>
                    <apex:outputPanel id="officerId">
                        <apex:outputPanel rendered="{!(case.LOB_Relationship__c='PWM'|| case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}">
                            <apex:pageBlockSection columns="2" > 
                                <!--<apex:pageblockSection id="officerId" rendered="{!(case.CIN__c!=Null) && NOT(case.BypassSearchProcess__c)}" >-->                            
                                <apex:outputField rendered="{!case.Officers_Employee_ID__c!=Null && case.Officers_Employee_ID__c!='' && (case.LOB_Relationship__c='PWM' || case.Client_Servicing_Code__c =='PWM' || case.Is_This_A_Private_Wealth_Client__c='Yes')}" value="{!case.Officers_Employee_ID__c}"/>                            
                                
                                <!--Start changes for CMI 2015 Iteration 2-->
                            </apex:pageBlockSection>
                        </apex:outputPanel>
                    </apex:outputPanel>
                    <br/> 
                    
                    <apex:actionStatus id="LOBDetailStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputPanel>
            </apex:outputpanel>
            <!-- End changes for CMI 2014 Release 3 --> 
            
            <!-- Start Changes for CMI 2015 Iteration 1 -->
            <!-- **************************************************** -->
            <!-- *   C L I E N T   F E E D B A C K   D E T A I L S  * -->
            <!-- **************************************************** -->
            
            <!--Id attribute added for CMI 2014-->
            <!--Start changes for CMI 2015 Iteration 2-->
            
            <apex:actionRegion >
                <apex:pageBlockSection title="Client Feedback Details" id="clientFeedbackDetails">                       <!--Commented for CMI 2014 because Supplier Search needs to be rendered when Is Feedback field is equal to Supplier.-->                        
                    <!--Start Changes for CMI 2014-->
                    <apex:pageblocksectionitem >
                        <apex:outputlabel value="Is Feedback regarding a TM/ Dept/ Supplier?"/>                            
                        <apex:inputField value="{!case.Is_Feedback_regarding_a_TM_Dept__c}" required="{!case.Type = 'Complaint'}">
                            <apex:actionSupport event="onchange" rerender="clientFeedbackDetails,serviceingChallenge,serviceingChallengeReported supplierDetailsPanel,servicingInteractionDispositonFields" status="complaintDetailStatus"/>                                
                        </apex:inputField>                            
                    </apex:pageblocksectionitem>
                    
                    <!--End Changes for CMI 2014-->    
                    
                    <apex:outputPanel rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null)}" > 
                        <c:CustomLookup value="{!Case.Teammate_Search__c}" object="Contact" objectName="Case" fieldName="Teammate_Search__c" displayFields="Email,Title,Phone"  required="{!(case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate'|| case.Is_Feedback_regarding_a_TM_Dept__c='Branch Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI Teammate' || case.Is_Feedback_regarding_a_TM_Dept__c='Other Teammate')}"/>
                    </apex:outputPanel>
                    <br/>
                    
                    <apex:outputPanel id="branchSearch" rendered="{!(case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null)}"> 
                        <c:CustomLookup value="{!Case.Department_Search__c}" object="Org_Unit__c" objectName="Case" fieldName="department_search__c" displayFields="RecordType.Name,Cost_Center__c,Address__c,City__c,State__c" required="{!(case.Is_Feedback_regarding_a_TM_Dept__c='Branch/Department' || case.Is_Feedback_regarding_a_TM_Dept__c='Branch' || case.Is_Feedback_regarding_a_TM_Dept__c='STOLI')}"/>  
                    </apex:outputPanel>
                    <br/>
                    
                    <!--Start Changes for CMI 2014-->
                    <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}">
                        <apex:outputlabel value="Supplier Search"/>                            
                        <!--Start Changes for CMI 2014 break/fixes-->
                        <!--Added onkeypress to supress the Enter and Any other input-->
                        <apex:define name="requiredSupplier">
                            <div class="requiredInput">
                                <div class="requiredBlock" style="{!IF(case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>                                  
                                <!--start changes for CMI 2016 December release-->
                                <!--Added an onclick function-->
                                <apex:inputField value="{!case.Vendor_Search__c}" onclick="vendorsearch();">
                                    <!--End changes for CMI 2016 December release-->
                                    <!--End Changes for CMI 2014 break/fixes-->      
                                    <apex:actionSupport event="onchange" action="{!populateSupplierRelatedFields}" reRender="supplierDetailsPanel,clientFeedbackDetails" status="complaintDetailStatus"/>
                                </apex:inputField>
                            </div>
                        </apex:define>                            
                    </apex:pageBlockSectionItem>
                    <!--End Changes for CMI 2014-->
                    
                    <apex:pageBlockSectionItem rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) }" />
                    
                    <apex:pageBlockSectionItem id="SupplierBlock" rendered="{!((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier')||(case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) && case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c!='' }">
                        <apex:outputlabel value="Complaint from or about a Supplier?"/>
                        <apex:define name="requiredComplaintFromSupplier">
                            <div class="requiredInput">
                                <div class="requiredBlock" style="{!IF((case.Vendor_Search__c!=Null&&case.Vendor_Search__c!='')|| case.Is_Feedback_regarding_a_TM_Dept__c='Supplier','background-color:C00','background-color:transparent')}"></div>  
                                <apex:inputField value="{!case.Complaint_From_or_About_A_Supplier__c}" id="SupplierField"></apex:inputField>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>                                                                        
                    <!--End Changes for CMI 2014 release 3-->
                    
                    <apex:pageBlockSectionItem rendered="{!AND(case.Is_Feedback_regarding_a_TM_Dept__c=='Other Department',case.Is_Feedback_regarding_a_TM_Dept__c <>'')}">
                        <apex:outputlabel value="Other Department List"/>
                        <apex:define name="otherDepartment">
                            <div class="requiredInput">
                                <div class="requiredBlock"/>   
                                <apex:inputField value="{!case.Other_Department_List__c}"/>
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                </apex:pageblocksection>
                
                <!--Start Changes for CMI September 2017 Release-->
                <apex:outputPanel id="servicingInteractionDispositonFields">
                    <!--Start Changes for CMI October 2017 Release-->
                    <!--Start Changes for CMI April 2018 Release-->
                    <!--Servicing interaction fields to display when Tracking only:Feedback condition-->
                    <apex:pageblockSection columns="1" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null && case.Is_Feedback_regarding_a_TM_Dept__c='SunTrust Teammate'&& (case.type=='Complaint' || case.type=='Tracking Only: Feedback')}">
                        <!--Start Changes for CMI April 2018 Release-->
                        <!--End Changes for CMI October 2017 Release-->    
                        <apex:pageBlockSectionItem >
                            <apex:outputLabel value="Servicing Interaction Disposition"/>
                            <apex:inputField value="{!case.Srvc_Interaction_Disposition__c}"/> 
                        </apex:pageBlockSectionItem> 
                        <br/>  
                        <apex:pageBlockSectionItem rendered="{!OR(($Profile.Name =='CFS & MH Phone/Research Manager'),($Profile.Name =='CFS Phone/Research User'),($Profile.Name =='CFS Phone/Research Manager'),($Profile.Name =='CLEAR Manager'),($Profile.Name =='CARRT Manager'),($Profile.Name =='MERT Manager'),($Profile.Name =='Social Media Manager'),($Profile.Name =='Operations Managers'),($Profile.Name =='CPR Manager'),($Profile.Name =='System Administrator'),($Profile.Name =='Social Media Specialist'))}">
                            <apex:outputLabel value="Servicing Interaction Comments"/>
                            <apex:inputTextarea value="{!case.Srvc_Interaction_Comments__c}" cols="80" rows="7"/>
                        </apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem rendered="{!AND(($Profile.Name !='CFS & MH Phone/Research Manager'),($Profile.Name !='CFS Phone/Research User'),($Profile.Name !='CFS Phone/Research Manager'),($Profile.Name !='CLEAR Manager'),($Profile.Name !='CARRT Manager'),($Profile.Name !='MERT Manager'),($Profile.Name !='Social Media Manager'),($Profile.Name !='Operations Managers'),($Profile.Name !='CPR Manager'),($Profile.Name !='System Administrator'),($Profile.Name !='Social Media Specialist'))}">
                            <apex:outputLabel value="Servicing Interaction Comments" />
                            <apex:outputfield value="{!case.Srvc_Interaction_Comments__c}" />
                        </apex:pageBlockSectionItem>                                 
                    </apex:pageblockSection>
                </apex:outputPanel>
                <!--End Changes for CMI September 2017 Release--> 
                
                <apex:outputPanel id="serviceingChallenge">
                    <apex:pageblocksection columns="1" >
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.CreatedDate>rel2DeploymentDateValue && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && ( case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback' )}" > 
                            <apex:outputLabel value="Servicing Challenges Category"/>
                            <apex:define name="requiredServicingCategory">
                                <div class="requiredInput">
                                    <div class="requiredBlock"></div>  
                                    <apex:inputfield value="{!case.Servicing_Challenges_Category__c}"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem> 
                        
                        <apex:pageBlockSectionItem rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!='' && case.CreatedDate>rel2DeploymentDateValue && case.Is_Feedback_regarding_a_TM_Dept__c!='Other Department' && ( case.Type == 'Complaint' || case.Type == 'Tracking Only: Feedback' )}" > 
                            <apex:outputLabel value="Servicing Challenges Reported"/>                          
                            <apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7" />                            
                        </apex:pageBlockSectionItem> 
                    </apex:pageblocksection>
                </apex:outputPanel> 
                
                <!--Start Change Feb 2017-->                    
                <!--End Change Feb 2017--> 
                
            </apex:actionRegion>
            
            <!--           
<apex:outputPanel id="serviceingChallengeReported">
<apex:pageBlockSection columns="1" rendered="{!case.Is_Feedback_regarding_a_TM_Dept__c!='No' && case.Is_Feedback_regarding_a_TM_Dept__c!=Null}"> 
<apex:pageBlockSectionItem > 
<apex:outputLabel value="Servicing Challenges Reported"/>                          
<apex:inputTextArea value="{!case.Servicing_Challenges_Reported__c}" cols="80" rows="7" />                            
</apex:pageBlockSectionItem> 
</apex:pageBlockSection> 
</apex:outputPanel> -->
            
            <!--End Changes for CMI 2014 Release 3-->
            <!--End changes for CMI 2015 Iteration 2-->
            <apex:pageBlockSection columns="1" rendered="{!NOT(case.Type='Tracking Only')}">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Client Feedback"/>
                    
                    <apex:define name="requiredInputDiv">
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            
                            <apex:inputTextArea value="{!case.Description}" cols="80" rows="7" />
                        </div>
                    </apex:define>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <!--Start changes for CMI 2016 April Release.Prior Contacts and Prior Contacts Utilized fields are displayed-->
            <apex:pageBlockSection columns="1" id="priorContacts" rendered="{!case.CreatedDate>bugAprilDeploymentDateValue}">
                <apex:pageBlockSectionItem helpText="Include the number of contacts client stated and/or contacts discovered during research.">                        
                    <apex:outputLabel value="# of Prior Contacts"/>
                    <apex:actionRegion > 
                        <apex:inputField value="{!case.Number_of_Prior_Contacts__c}">
                            <apex:actionSupport event="onchange"  reRender="priorContacts" status="complaintDetailStatus"/>
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <apex:inputField value="{!case.Prior_Contacts_Utilized__c}" required="{!case.Number_of_Prior_Contacts__c!='No Prior Contacts Noted' && case.Number_of_Prior_Contacts__c!=Null}"/> 
                <apex:pageBlockSectionItem helpText="In addition to teammate identified in teammate search, list all other persons identified in the complaint. Include RACF IDs for teammates where appropriate.">                        
                            <apex:outputLabel value="Other Persons Identified in Complaint"/> 
                            <!--Start Changes for CMI Pilot--> 
                            <!--<apex:define name="requiredClientFeedback"> 
                                <div class="requiredInput"> 
                                    <div class="requiredBlock"></div> -->
                                    <!-- Removed the Required= "True" attribute to display our custom error message --> 
                                    <apex:inputTextArea value="{!case.Other_Persons_Identified_in_Complaint__c}" cols="80" rows="7" /> 
                                <!--</div> 
                            </apex:define>-->
                        </apex:pageBlockSectionItem>   
            </apex:pageBlockSection>
            <!--End changes for CMI 2016 April Release--> 
            
            <apex:pageBlockSection columns="1" rendered="{!NOT(case.Type='Tracking Only')}">
                <apex:inputField value="{!case.Sentiment__c}" required="True" />
            </apex:pageBlockSection>
            
            <apex:pageBlockSection columns="1" rendered="{!case.Type='Tracking Only'}">
                <apex:inputTextArea value="{!case.Description}" cols="80" rows="7" />
                <apex:inputField value="{!case.Sentiment__c}" required="True" />
            </apex:pageBlockSection>
            
            
            
            <!--Start Changes for CMI 2014-->
            <apex:actionStatus id="complaintDetailStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->
            
            <!--Start Changes for CMI 2014-->
            <!-- ******************************************* --> 
            <!-- *        SUPPLIER DETAILS SECTION         * -->
            <!-- ******************************************* --> 
            
            <!--Start of SupplierDetailsPanel-->
            <apex:outputPanel id="supplierDetailsPanel">
                <apex:pageBlockSection title="Supplier Details" columns="2" rendered="{!((case.Type='Complaint' || case.Type='Positive Feedback/Compliment') && (((case.Is_Feedback_regarding_a_TM_Dept__c='Supplier') && (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='')) || (case.Vendor_Search__c!=Null && case.Vendor_Search__c!='' && case.Is_Feedback_regarding_a_TM_Dept__c!='No')))}">
                    <apex:outputField value="{!case.Business_Owner__c}"/>
                    <apex:outputField value="{!case.Service_Manager__c}"/>
                    <apex:outputField value="{!case.Supplier_Manager__c}"/>
                    <apex:inputField value="{!case.Supplier_Services__c}"/>
                </apex:pageBlockSection>
            </apex:outputpanel>
            <!--End of SupplierDetailsPanel"-->
            <!--End Changes for CMI 2014-->
            
            <!-- Start Changes for CMI 2015 Iteration 1 -->
            <!-- ************************************************** --> 
            <!-- *   C O M P L I A N C E   E V A L U A T I O N    * -->
            <!-- ************************************************** --> 
            <!--Start of "ComplianceEvaluationPanel"-->
            <apex:outputpanel id="ComplianceEvaluationPanel">
                <apex:outputpanel id="ComplianceEvaluation">             
                    <!--The below output panel is added for CMI 2015 Iteration 2 as it should render for old cases only-->
                    <apex:outputpanel rendered="{!case.CreatedDate<rel2DeploymentDateValue}">
                        
                        <apex:pageBlockSection title="Feedback/Complaint Designation" columns="1" collapsible="true" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Resolved by Point of Contact?" for="quest1"/>
                                <apex:define name="requiredQ1">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1"/>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Allegation of wrongful/unethical conduct?" for="quest2"/>
                                <apex:define name="requiredQ2">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.PCQ_Q2__c}" id="quest2">
                                                <!--Commented for CMI 2014-->
                                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c--> 
                                                <!--<apex:actionSupport event="onchange" rerender="Quest2DependentQuestions,Question2DependentQuestions,Quest2ADependentQuestions,Question2BDependentQuestions" status="ComplianceEvaluationStatus" />-->
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection id="Quest2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <!--rendered attribute is removed for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Reg/Law Cited?" for="quest3"/>
                                <apex:define name="requiredQ2A">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <!--rendered attribute is removed for CMI 2014-->                            
                                            <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                            <apex:inputField value="{!case.PCQ_Q2_A__c}" id="quest3">
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection id="Quest2ADependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem >
                                <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}"/>
                                <apex:define name="requiredLawOrReg">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                            <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                            <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4" rendered="{!case.PCQ_Q2_A__c='Yes'}">  
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestions" status="ComplianceEvaluationStatus" />
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/>
                                <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.PCQ_Q2_A__c='Yes' && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                        
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection id="Question2DependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">                        
                            <apex:pageBlockSectionItem >
                                <!--rendered attribute is removed for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="High Risk Terms?" for="quest6"/>
                                <apex:define name="requiredQ2B">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <!--rendered attribute is removed for CMI 2014-->                            
                                            <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->                        
                                            <apex:inputField value="{!case.PCQ_Q2_B__c}" id="quest6">
                                                <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <apex:pageBlockSection id="Question2BDependentQuestions" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null)}">
                            <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}"/>                        
                                <apex:define name="requiredHighRisk">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                            <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                            <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7" rendered="{!case.PCQ_Q2_B__c='Yes'}">
                                                <apex:actionSupport event="onchange" action="{!renderOtherHighRiskTerms}" rerender="Question2BDependentQuestions" status="ComplianceEvaluationStatus"/>
                                            </apex:inputField>
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <!--PCQ_Q2__c is removed from rendered attribute for CMI 2014-->                            
                                <!--PCQ_Q2_A__c and PCQ_Q2_B__c are not dependent on PCQ_Q2__c-->
                                <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8" rendered="{!(case.PCQ_Q2_B__c='Yes' && CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                                                       
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel>
                    
                    <!--Start changes for CMI 2105 Iteration 2-->
                    <!--The below section should be rendered for cases created after CMI 2015 Iteration 2--> 
                    <apex:outputPanel rendered = "{!case.CreatedDate>rel2DeploymentDateValue}">
                        <apex:pageBlockSection title="Feedback/Complaint Designation" columns="2" collapsible="true" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Resolved by Point of Contact?" for="quest1Section2"/> 
                                <apex:define name="requiredQ1"> 
                                    <div class="requiredInput"> 
                                        <div class="requiredBlock"></div> 
                                        <apex:inputField value="{!case.PCQ_Q1__c}" id="quest1Section2"/> 
                                    </div> 
                                </apex:define> 
                            </apex:pageBlockSectionItem>                                                                                          
                        </apex:pageBlockSection>                          
                        
                        <apex:pageBlockSection id="Quest2ADependentQuestionsSection2" columns="1" rendered="{!(case.Type='Complaint' && case.Special_Initiatives__c!=Null )}"> 
                            <apex:pageBlockSectionItem > 
                                <apex:outputLabel value="Select specific Regulation or Law Cited" for="quest4" />     
                                <apex:define name="requiredLawOrRegSection2">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion > 
                                            <apex:inputField value="{!case.Law_or_Regulation_Violated__c}" id="quest4Section2">
                                                <apex:actionSupport event="onchange" rerender="Quest2ADependentQuestionsSection2" status="ComplianceEvaluationStatus" /> 
                                            </apex:inputField> 
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem> 
                            
                            <apex:pageBlockSectionItem >
                                <apex:outputLabel value="Other Regulation or Law?" for="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}"/> 
                                <apex:inputField value="{!case.Other_Regulation_Law__c}" id="quest5" rendered="{!(case.Law_or_Regulation_Violated__c != null && CONTAINS(case.Law_or_Regulation_Violated__c,'Other'))}" required="true"/>                       
                            </apex:pageBlockSectionItem>                         
                        </apex:pageBlockSection> 
                        
                        
                        <apex:pageBlockSection id="Question2BDependentQuestionsSection2" columns="1" rendered="{!case.Type='Complaint' && case.Special_Initiatives__c!=Null}"> 
                            <apex:pageBlockSectionItem helptext="Previously 'High Risk Terms'">
                                <apex:outputLabel value="Select specific Complaint Indicator Terms" for="quest7Section2"/>
                                <apex:define name="requiredHighRisk">
                                    <div class="requiredInput">
                                        <div class="requiredBlock"></div>
                                        <apex:actionRegion >
                                            <apex:inputField value="{!case.High_Risk_Terms__c}" id="quest7Section2">
                                                <apex:actionSupport event="onchange" rerender="Question2BDependentQuestionsSection2" status="ComplianceEvaluationStatus" action="{!renderOtherHighRiskTerms}"/>
                                            </apex:inputField> 
                                        </apex:actionRegion>
                                    </div>
                                </apex:define>
                            </apex:pageBlockSectionItem>
                            
                            <apex:pageBlockSectionItem >
                                <!--For CMI 2015 Iteration 2 rendered="{!case.PCQ_Q2_B__c='Yes'}" is removed from the output label and input field-->
                                <apex:outputLabel value="Other Complaint Indicator Terms" for="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}"/>                        
                                <apex:inputField value="{!case.Other_High_Risk_Terms__c}" id="quest8Section2" rendered="{!(CONTAINS(case.High_Risk_Terms__c,'Other')&& renderOtherHighRiskTerms)}" required="true"/>                      
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                    </apex:outputPanel> 
                    <!--End changes for CMI 2015 Iteration 2-->
                    
                    <apex:actionRegion >
                        
                    </apex:actionRegion>
                    
                    <br/> 
                    <apex:actionStatus id="MainStatusSub"> 
                        <apex:facet name="start"> 
                            <div style="text-align:center;"> 
                                <img src="{!$Resource.SpinIcon}"/> 
                            </div> 
                        </apex:facet> 
                    </apex:actionStatus>     
                    
                    <!-- Start Changes for CMI 2014 Release 3 -->                    
                    <apex:pageBlockSection columns="2">
                        <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}" >
                            <apex:outputLabel value="Was PCQ Information Sufficient/Accurate?"/>
                            <apex:inputField value="{!case.Was_TM_Information_Sufficient_Accurate__c}"/>
                        </apex:pageBlockSectionItem>                                            
                        <apex:pageBlockSectionItem rendered="{!case.createddate < bugFebDeploymentDateValue}">
                            <apex:outputLabel value="PCQ Information Comments"/>
                            <apex:inputField value="{!case.TM_Information_Comments__c}" style="width:300px;height:45px;"/>
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                    <!-- End Changes for CMI 2014 Release 3 -->
                    
                    <apex:actionStatus id="ComplianceEvaluationStatus">
                        <apex:facet name="start">
                            <div style="text-align:center;">
                                <img src="{!$Resource.SpinIcon}"/>
                            </div>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:outputpanel>
            </apex:outputpanel>
            <!--End of "ComplianceEvaluationPanel"-->
            <!-- End Changes for CMI 2015 Iteration 1  -->
            
            <!-- ******************************************* -->
            <!-- *    F E E D B A C K   C A T E G O R Y    * -->
            <!-- ******************************************* -->
            
            <apex:outputPanel id="feedbackCategorySection">
                <apex:outputPanel rendered="{!case.Type != 'Positive Feedback/Compliment'}">
                    <apex:pageBlockSection title="Feedback Category" columns="2">
                        <!-- Start changes for CMI 2014 Release 3 -->
                        <!-- Submitter category fields are removed as part of requiremnt -->
                        <!-- End changes for CMI 2014 Release 3 -->
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection columns="1" id="fbcat">
                        
                        <!-- ******************************************* -->
                        <!-- *           C A T E G O R I E S           * -->
                        <!-- ******************************************* -->
                        
                        <apex:outputPanel id="CategoryPanel" >
                            
                            
                            
                            <!--Start changes for CMI 2016 July Release.Filtering of Categories using Search Text implemented-->
                            <apex:pageBlockSection id="fbcat1" columns="1">
                                <apex:pageBlockSectionItem id="catButton" >
                                    <apex:outputLabel value="Search Category"/>
                                    <apex:actionRegion >                              
                                        <apex:inputText value="{!searchTextValue}" onkeypress="return noenter(event);"/>
                                        <apex:commandButton value="Search" action="{!categorySearch}"  rerender="CategoryPanel" status="CategoryStatus" id="catSearchButton"/>
                                        <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!searchTextValue != null}" style="color:red;font-weight:bold;"/>
                                    </apex:actionRegion>
                                </apex:pageBlockSectionItem>
                                <!-- <apex:outputText value="To re-display all values, clear out the value entered and select Search again." rendered="{!searchTextValue != null}" style="color:red;font-weight:bold;margin-right:0%;"/> -->
                            </apex:pageBlockSection>
                            <!--End changes for CMI 2016 July Release-->
                            <br/>
                            <div style="margin-left: 12%;">                    
                                <!--Start changes for CMI 2016 June Release-->
                                <!--Cat level 3 is included for the June release-->
                                <apex:outputLabel value="CAT Level 3" for="level3choice" /> 
                                &nbsp; 
                                <apex:actionStatus id="level3choiceStatus"> 
                                    <apex:facet name="start"> 
                                        <img src="{!$Resource.SpinIcon}" /> 
                                    </apex:facet> 
                                </apex:actionStatus> 
                                &nbsp; 
                                <apex:actionRegion > 
                                    <apex:selectList value="{!Level3Choice}" multiselect="False" 
                                                     size="10" id="level3choice" style="width:40%"> 
                                        <apex:selectOptions value="{!SubmitterLevel3Choices}" /> 
                                        <apex:actionSupport event="onchange" action="{!updateLists}" 
                                                            reRender="CategoryPanel" status="level3choiceStatus" /> 
                                    </apex:selectList> 
                                </apex:actionRegion> 
                                
                                <br /> 
                                <br /> 
                                <!--End changes for CMI 2016 June Release-->
                                
                                <!-- Start  changes for CMI 2014 Release 3 -->
                                <!-- Cat Level 1, Cat Level 2, Cat Level 3 field have been removed as part of this requirement from this section -->
                                <!-- End changes for CMI 2014 Release 3 -->
                                <apex:outputLabel value="Cat Level 4" for="level4choice" />
                                &nbsp;
                                <apex:actionStatus id="level4choiceStatus">
                                    <apex:facet name="start">
                                        <img src="{!$Resource.SpinIcon}" />
                                    </apex:facet>
                                </apex:actionStatus>
                                &nbsp;
                                <apex:actionRegion >
                                    <apex:selectList value="{!Level4Choice}" multiselect="False"
                                                     size="10" id="level4choice">
                                        <apex:selectOptions value="{!Level4Choices}" />
                                        <apex:actionSupport event="onchange" action="{!updateLists}"
                                                            reRender="CategoryPanel" status="level4choiceStatus" />
                                    </apex:selectList>
                                </apex:actionRegion>
                                
                                <br />
                                <br />
                                
                                <apex:outputLabel value="Cat Level 5" for="level5choice" />
                                &nbsp;
                                <apex:actionStatus id="level5choiceStatus">
                                    <apex:facet name="start">
                                        <img src="{!$Resource.SpinIcon}" />
                                    </apex:facet>
                                </apex:actionStatus>
                                &nbsp;
                                <apex:actionRegion >
                                    <apex:selectList value="{!Level5Choice}" multiselect="False"
                                                     size="10" id="level5choice">
                                        <apex:selectOptions value="{!Level5Choices}" />
                                        <apex:actionSupport event="onchange" action="{!updateLists}"
                                                            reRender="CategoryPanel" status="level5choiceStatus" />
                                    </apex:selectList>
                                </apex:actionRegion>
                                
                                <br />
                                <br />
                                
                            </div>
                            
                            <apex:actionStatus id="CategoryStatus">
                                <apex:facet name="start">
                                    <div style="text-align:center;">
                                        <img src="{!$Resource.SpinIcon}" />
                                    </div>   
                                </apex:facet>
                            </apex:actionStatus>
                        </apex:outputPanel>
                        
                        
                    </apex:pageBlockSection>
                </apex:outputPanel>
            </apex:outputPanel>
            
            
            <!-- ******************************************* -->
            <!-- *   R E S O L U T I O N   D E T A I L S   * -->
            <!-- ******************************************* -->
            
            <!--<apex:outputPanel id="renderResolutionDeatils">-->
            <apex:outputPanel id="renderResolutionDeatils" rendered="{!case.Type != 'Positive Feedback/Compliment'}">
                <apex:pageBlockSection id="refund" title="Resolution Details"> <!--id attribute in pageBlockSection added for CMI 2014 break/fixes-->
                    <!--For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
                    
                    <apex:pageblocksectionitem >
                        <apex:outputlabel value="Relief Provided?"/>
                        <apex:actionRegion > 
                            <apex:inputField value="{!case.Refund__c}"> 
                                <apex:actionSupport event="onchange" reRender="refund,typeOfRelief" status="resolutionDetailsStatus" /> 
                            </apex:inputField> 
                        </apex:actionRegion> 
                    </apex:pageblocksectionitem>
                    <apex:inputField value="{!case.Remediation__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
                    <!--Start Changes for CMI 2014-->
                    <!--For CMI 2015 Iteration2 the below field is rendered for Non-Monetary Relief also-->
                    
                    <!--End Changes for CMI 2014-->
                    
                    
                    
                    
                    
                    <!--start changes for CMI 2016 October release-->
                </apex:pageBlockSection>
                <!--start changes for CMI 2016 October release-->
                <apex:pageBlockSection id="typeOfRelief" columns="1">
                    <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/>
                    <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Non-Monetary Relief' || case.Refund__c='Non-Monetary Relief' }"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
                    <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Explanation'}"/>
                </apex:pageBlockSection>
                <!--end changes for CMI 2016 October release-->
                <!--Fields Shifted-->
                <apex:pageBlockSection id="rootCause"> 
                    <apex:inputField value="{!case.Root_Cause__c}" id="id3" onchange="hidefieldsrootCauseDetail();" />
                </apex:pageBlockSection>
                
                
                
                <!--Start Changes for CMI 2014-->
                <apex:pageBlockSection id="rootCauseDetails" columns="1">
                    <apex:inputField value="{!case.Root_Cause_Detail__c}"/>
                    
                </apex:pageBlockSection>
                <apex:pageBlockSection >
                    <apex:inputField value="{!case.Was_Client_Satisfied_with_Resolution__c}"/> 
                    <apex:inputField value="{!case.Business_Impact__c}"/>
                </apex:pageBlockSection>
                
            </apex:outputPanel>
            <!--end changes for CMI 2016 October release-->
            <!--Start Changes for CMI 2014 break/fixes-->
            <apex:actionStatus id="resolutionDetailsStatus"> 
                <apex:facet name="start"> 
                    <div style="text-align:center;"> 
                        <img src="{!$Resource.SpinIcon}"/> 
                    </div> 
                </apex:facet> 
            </apex:actionStatus>
            <!--End Changes for CMI 2014 break/fixes-->
            <!--</apex:outputPanel>-->
            
            
            
            
            <!-- ******************************************* -->
            <!-- *   C L O S E   C A S E   D E T A I L S   * -->
            <!-- ******************************************* -->
            
            <apex:pageBlockSection title="Close Case Details" id="ClosedCasePanel">
                
                <!--Start Changes for CMI 2014-->
                <!--Commented for CMI 2014-->
                <!--As some rendering conditions need to be applied on this field-->
                <!--<apex:inputField value="{!case.Status}" required="True">-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status"/>
                    <apex:actionRegion >
                        <apex:inputField value="{!case.Status}" required="True">
                            
                            <!--Start changes for feb 2017-->  
                            <!--Removed pop up when status is set to closed-->         
                            <!--For CMI 2016 April Release priorContacts added to the reRender attribute in the below line to make # of Prior Contacts field as required when closed--> 
                            <!--<apex:actionSupport event="onchange" action="{!openCaseStatusSummaryPopup}" reRender="caseStatusSummaryPopup"/>-->
                            <!--End changes for feb 2017-->
                        </apex:inputField>
                    </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <!--End Changes for CMI 2014-->
                <!-- Start Changes for CMI 2015 Iteration 1
<apex:inputField value="{!case.Follow_Up_Date__c}" />
End Changes for CMI 2015 Iteration 1  -->
                <apex:inputField value="{!case.Status_Reason__c}" required="True" />
                <apex:inputField value="{!case.Priority}" required="True" rendered="{!case.Type!='Complaint'}"/>
                <apex:inputField value="{!case.Auto_Closed_Review__c}"/>
                <!--Start changes for CMI 2016 April release--> 
                <apex:inputField value="{!case.Was_Client_Satisfied_with_Resolution__c}" rendered="{!case.Type!='Complaint'}"/>             
                <!--End changes for CMI 2016 April release-->
                <!--Start Changes for CMI 2014-->
                <!--Start Changes for CMI August 2017 Release-->
                <apex:inputField value="{!case.Case_Status_Summary__c}" style="width:300px;height:45px" rendered="{!AND(case.Case_Association_Type__c != 'Transfer to CARRT', case.Case_Association_Type__c != 'Transfer to CRT',case.Case_Association_Type__c != 'Transfer to MERT', case.Case_Association_Type__c != 'Escalated to OOP')}"/>
                <apex:outputField value="{!case.Case_Status_Summary__c}" style="width:300px;height:45px" rendered="{!OR(case.Case_Association_Type__c = 'Transfer to CARRT', case.Case_Association_Type__c = 'Transfer to CRT',case.Case_Association_Type__c = 'Transfer to MERT', case.Case_Association_Type__c = 'Escalated to OOP')}"/>
                <!--End Changes for CMI August 2017 Release-->
                <!--Start changes for CMI 2016 April release--> 
                <apex:inputField value="{!case.Business_Impact__c}" rendered="{!case.Type!='Complaint'}"/>             
                <!--End changes for CMI 2016 April release-->
                <apex:inputField value="{!case.Case_Comments_Reviewed__c}"/>
                <!--End Changes for CMI 2014-->
                
                <!--Commented for CMI 2014 because Root Cause Details needs to be rendered according to this field values-->
                <!--<apex:inputField value="{!case.Root_Cause__c}" />-->
            </apex:pageBlockSection>  
            
            <!--Start Changes for CMI 2014-->
            
            
            <apex:pageBlockSection >
                <apex:inputField value="{!case.Responded__c}" />
                <!-- Start Changes for CMI 2015 Iteration 1
<apex:inputField value="{!case.Impacted__c}" />
End Changes for CMI 2015 Iteration 1  -->
            </apex:pageBlockSection>
            
            <apex:actionStatus id="closeCaseDetailsStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!--End Changes for CMI 2014-->
            
            <apex:pageBlockSection columns="1" >               
                <apex:inputField value="{!case.Resolution_Comments__c}" style="width:500px;height:140px;" />
                <br />
                <apex:inputField value="{!case.CPR_Additional_Comments__c}" style="width:500px;height:140px;" rendered="{!case.Type='Complaint' || case.Type='Tracking Only'}"/>
                <!--Start Changes for CMI 2016 october release-->
                <!--<apex:inputField value="{!case.CPR_Additional_Comments__c}" style="width:500px;height:140px;" rendered="{!case.Type!='Complaint'}"/>-->
                <!--End Changes for CMI 2016 october release-->
            </apex:pageBlockSection>
            
            <!--Start changes for CMI 2016 April Release-->
            <apex:pageBlockSection id="initiativeTracking">
                <apex:inputField value="{!case.Initiative_Tracking__c}" rendered="{!case.Type='Complaint' || case.Type='Tracking Only'}"/>
            </apex:pageBlockSection>
            <!--End changes for CMI 2016 April Release-->
            
            <!-- ********************************************************** -->
            <!-- *                 S Y S T E M   F I E L D S              * -->
            <!-- ********************************************************** -->
            <!--
<apex:pageBlockSection title="System Assigned Fields"
rendered="false">

<apex:inputField value="{!case.CreatedDate}" />
<apex:inputField value="{!case.Closed_Date__c}" />
<apex:inputField value="{!case.LastModifiedById}" />
<apex:inputField value="{!case.LastModifiedDate}" />

<apex:inputField value="{!case.Contact_Name__c}" />
<apex:inputField value="{!case.Age_Days__c}" />
<apex:inputField value="{!case.Age_Hours__c}" />
<br />
</apex:pageBlockSection>
-->
            <br />
            
            <!--Start changes for CMI 2014 Release 2-->
            
            <!-- *********************************************************** --> 
            <!-- *                          S L A                          * -->
            <!-- *********************************************************** --> 
            <apex:outputPanel id="slaSection">
                <!--Start changes of october release 2016-->
                <!--Fields shifted-->
                <apex:pageBlockSection title="SLA" columns="2" rendered="{!case.Type != 'Positive Feedback/Compliment'}">
                    <apex:outputField value="{!case.Was_Mandated_Acknowledgement_SLA_Met__c}"/>
                    <apex:outputField value="{!case.Was_Mandated_Response_SLA_Met__c}"/>
                    <!--<apex:inputField value="{!case.Was_Mandated_Response_SLA_Met__c}"/>-->
                    
                    <apex:inputField value="{!case.Acknowledgement_Method__c}" />
                    <apex:outputField value="{!case.Mandated_Response_SLA_Date__c}"/>
                    <!-- Start Changes for CMI 2015 Iteration 1
<apex:inputField value="{!case.Mandated_Acknowledgement_Bus_Days__c}" />
End Changes for CMI 2015 Iteration 1 -->
                    <apex:outputField value="{!case.Mandated_Acknowledgement_SLA_Date__c}" /> 
                    <apex:inputField value="{!case.Response_Date_Time_Sent__c}" />                  
                    <apex:inputField value="{!case.Acknowledgement_Date_Time_Sent__c}" />
                    
                    <apex:outputField value="{!case.Mandated_Response_Extension_SLA_Date__c}" />
                    <br/><apex:inputField value="{!case.Extension_Notification_Date_Time_Sent__c}" /> 
                    <apex:inputField value="{!case.If_SLA_Missed_Provide_Reason_s__c}"/>
                    <br/><apex:inputField value="{!case.SLA_Missed_Comments__c}" style="width:500px;height:140px;"/>
                    <apex:inputField value="{!case.ClosedDate}" rendered="false" />
                </apex:pageBlockSection>
            </apex:outputPanel>
            <!--End changes of october release 2016-->
            <!--End changes for CMI 2014 Release 2-->
            
            <!--Start Changes for CMI 2014-->
            
            
            
            <!--************************************************** --> 
            <!-- *         Compliance Evaluation Summary          * -->
            <!-- ************************************************** -->
            <!--Start of "ComplianceEvaluationSummary"-->
            <apex:outputPanel id="ComplianceEvaluationSummary">
                <apex:pageBlockSection rendered="{!case.Type != 'Positive Feedback/Compliment'}" title="Complaint Evaluation Summary" columns="1">            
                    <!--Start changes for for CMI 2014 Release 2-->
                    <apex:pageBlockSection id="complianceOverrideOptIn">  
                        <!--For CMI 2015 Iteration 2, compliance override checkbox is replaced by Compliance override reason and compliance opt in comments field is added-->                                                                          
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Compliance Override Reason"/>  
                            <apex:actionRegion >
                                <apex:inputField value="{!case.Compliance_Override_Reason__c}">
                                    <apex:actionSupport event="onchange" rerender="complianceOverrideOptIn" status="compOptIn1"/> 
                                </apex:inputField>                  
                            </apex:actionRegion>
                        </apex:pageBlockSectionItem> 
                        <apex:pageBlockSectionItem > 
                            <apex:outputLabel value="Referral Override/Opt In Comments"/>                
                            <apex:define name="requiredClientFeedback">
                                <div class="requiredInput">
                                    <div class="requiredBlock" style="{!IF(OR(case.Compliance_Opt_In__c,case.Compliance_Override_Reason__c != null),'background-color:C00','background-color:transparent')}"></div>     
                                    <apex:inputField value="{!case.Compliance_Override_Comments__c}" style="width:300px;height:45px"/>
                                </div>
                            </apex:define>
                        </apex:pageBlockSectionItem>                                                                                                
                    </apex:pageBlockSection>
                    <!--End changes for for CMI 2014 Release 2-->
                    
                    <!--Start Changes for CMI 2017 April Release-->
                    <APEX:actionRegion >
                        <apex:pageblocksection columns="1">
                            <apex:pageBlockSectionItem > 
                                <apex:outputLabel value="Referral Opt In"/>
                                <apex:inputField value="{!case.Referral_Opt_In__c}">
                                    <!--For CMI 2016 April Release referralButton is added in rerender attribute-->
                                    <apex:actionSupport event="onchange" rerender="ClosedCasePanel,Comments,referralButton" status="compOptIn1" action="{!checkOptInAndNullifyReferralDisposition}"/> 
                                </apex:inputField>                            
                            </apex:pageBlockSectionItem>
                        </apex:pageblocksection>
                    </apex:actionRegion>
                    
                    <apex:actionStatus id="compOptIn1"> 
                        <apex:facet name="start"> 
                            <div style="text-align:center;"> 
                                <img src="{!$Resource.SpinIcon}"/> 
                            </div> 
                        </apex:facet> 
                    </apex:actionStatus>
                    
                    
                    <apex:inputField value="{!case.Reg_Law_Potential_Exception__c}" rendered="false"/> 
                    <apex:inputField value="{!case.Compliance_Referral_Reg_Law_Trigger__c}" rendered="false"/>
                    <apex:inputField value="{!case.ComplianceSMEReview_Reg_Law_Trigger__c}" rendered="false"/>
                    <apex:inputField value="{!case.Reg_Law_Risk_SME_Review_Completed__c}" rendered="false"/>
                    <apex:inputField value="{!case.Compliance_SME_Review_No_Reg_Law_Trigger__c}" rendered="false"/> 
                    
                    <apex:actionRegion >
                        <apex:outputPanel >                                                                
                            <apex:outputPanel id="referrals">
                                
                                <div style="margin-Left:2%">
                                    <apex:outputText Style="font-weight:bold;color:red" value="Reminder: As each reg/law SME review is completed, the Compliance SME Review Comments should be updated with review findings." />
                                </div>
                                <br/>
                                
                                <apex:pageBlockTable value="{!assignComplianceReferralRecord}"  var="CR">
                                    
                                    <apex:column headerValue="Delete">               
                                        <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" />                                                      
                                        <apex:inputCheckbox value="{!CR.showCheckbox}" rendered="{!CR.deleteRecord && !$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable}" disabled="true"/>                            
                                    </apex:column>  
                                    
                                    
                                    <apex:column id="RegLaw" headerValue="Reg/Law" >
                                        <apex:outputText value="{!CR.assignRegLawName}" rendered="{!CR.assignRegLawName!=null && CR.assignRegLawName!=''}"/>                          
                                        <apex:selectList value="{!CR.assignRegLawName}" multiselect="False"
                                                         size="1"  rendered="{!CR.assignRegLawName=null || CR.assignRegLawName=''}" >
                                            <apex:selectOptions value="{!regLawValues}" />
                                            <apex:actionSupport event="onchange" action="{!actionOnRegLaw}" status="ReferralStatus" reRender="referrals"/>
                                        </apex:selectList> 
                                    </apex:column>
                                    
                                    <apex:column id="SMENeeded" headerValue="SME Review Needed?">                                                
                                        <apex:outputText value="{!CR.assignSMEReviewNeeded}"  rendered="{!!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                                        <apex:define name="requiredSelectAccount">
                                            <div class="requiredInput">
                                                <div class="requiredBlock"></div>                            
                                                <apex:selectList multiselect="false" size="1" value="{!CR.assignSMEReviewNeeded}" rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && !disableAddButtonValue && CR.assignRegLawName!='No Reg/Law Exception Found'}" >                
                                                    <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                                    <apex:selectOption itemValue="No" itemLabel="No"/>
                                                    <apex:selectOption itemValue="Yes" itemLabel="Yes"/>                          
                                                </apex:selectList>
                                            </div>
                                        </apex:define>                                                                  
                                    </apex:column>
                                    
                                    <apex:column headerValue="Reg/Law Exception">
                                        <apex:outputText value="{!CR.assignRegLawExceptionValue}"  rendered="{!!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable || disableAddButtonValue || CR.assignRegLawName='No Reg/Law Exception Found'}"/>
                                        
                                        <apex:outputPanel rendered="{!$ObjectType.Case.fields.Reg_Law_Potential_Exception__c.Updateable && !disableAddButtonValue &&  CR.assignRegLawName!='No Reg/Law Exception Found'}">
                                            
                                            <apex:selectList multiselect="false" size="1" value="{!CR.assignRegLawExceptionValue}" > 
                                                <apex:selectOption itemValue="--None--" itemLabel="--None--"/>
                                                <apex:selectOption itemValue="Exception" itemLabel="Exception"/>
                                                <apex:selectOption itemValue="NoException" itemLabel="No Exception"/>
                                                <apex:actionSupport event="onchange" action="{!actionOnRegLawException}" status="ReferralStatus" reRender="referrals"/>                    
                                            </apex:selectList>
                                            
                                        </apex:outputPanel>
                                    </apex:column>                   
                                    
                                    <apex:column headerValue="SME Review Completed">                        
                                        <apex:inputCheckbox value="{!CR.assignSMEReviewCompleted}" disabled="true"/>                                                                                                                                               
                                    </apex:column>                                                                                            
                                    
                                </apex:pageBlockTable>                                         
                                
                                <!--Start changes for CMI 2016 April Release-->                                        
                                <apex:outputPanel id="referralButton">
                                    <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name='Compliance & Risk Specialist' && !disableAddButtonValue && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review'))}">
                                        <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="ReferralStatus"/>                
                                        <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name!='Compliance & Risk Specialist' && !disableAddButtonValue && (!((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required')) || ((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review'))}">
                                        <apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="ReferralStatus"/>                
                                        <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="ReferralStatus"/>
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable ||((case.CL_Exception_Review_Disposition__c='' || case.CL_Exception_Review_Disposition__c='No Action Required') && (case.Referral_Opt_In__c=null || case.Referral_Opt_In__c='' || case.Referral_Opt_In__c='Reputational Risk Review' || case.Referral_Opt_In__c='Monitoring Review')) && !((case.CL_Exception_Review_Disposition__c='No Action Required' && exceptionDispositionValue='Pending Review' && case.Referral_Opt_In__c='Reputational Risk Review') || case.Referral_Opt_In__c='Monitoring Review')}">
                                        <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                        <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                                    </apex:outputPanel>                                                    
                                    
                                    <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name!='Compliance & Risk Specialist'}">
                                        <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                        <apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="ReferralStatus"/>
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!disableAddButtonValue && $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && $Profile.Name='Compliance & Risk Specialist'}">
                                        <apex:commandButton value="Add New Reg/Law" disabled="true"/>                
                                        <apex:commandButton value="Delete Reg/Law" disabled="true"/>
                                    </apex:outputPanel>                       <!--</apex:outputPanel>    -->  
                                    <!--<apex:outputPanel >
<apex:commandButton value="Add New Reg/Law" action="{!insertRow}" reRender="referrals" status="ReferralStatus" rendered="{! $ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && ($Profile.Name='Compliance & Risk Specialist' || $Profile.Name='Compliance & Risk Manager'|| $Profile.Name='System Administrator' || $Profile.Name='Super User')}"/>                
<apex:commandButton value="Delete Reg/Law" action="{!deleteRow}" rerender="referrals" status="ReferralStatus" rendered="{!$ObjectType.Case.fields.ComplianceSMEReview_Reg_Law_Trigger__c.Updateable && ($Profile.Name='Compliance & Risk Specialist' || $Profile.Name='Compliance & Risk Manager' || $Profile.Name='System Administrator' || $Profile.Name='Super User')}"/>
</apex:outputPanel>
<apex:outputPanel rendered="{!$Profile.Name!='Compliance & Risk Specialist' && $Profile.Name!='Compliance & Risk Manager' && $Profile.Name!='System Administrator' && $Profile.Name!='Super User'}">
<apex:commandButton value="Add New Reg/Law5" disabled="true"  rendered="{!$Profile.Name!='Compliance & Risk Specialist'  && $Profile.Name!='Compliance & Risk Manager' && $Profile.Name!='System Administrator' && $Profile.Name!='Super User'}"/>                
<apex:commandButton value="Delete Reg/Law5" disabled="true"  rendered="{!$Profile.Name!='Compliance & Risk Specialist'  && $Profile.Name!='Compliance & Risk Manager' && $Profile.Name!='System Administrator' && $Profile.Name!='Super User'}"/>
</apex:outputPanel>-->                                                                                                             
                                    
                                    <!--End changes for CMI 2016 April Release-->  
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </apex:outputPanel>
                        
                        <apex:actionStatus id="ReferralStatus">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus> 
                    </apex:actionRegion>
                    <!--End April 2017 CE table-->            
                    <apex:pageBlockSection id="Comments" columns="2">
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputPanel > 
                                <apex:pageblocksection columns="1">
                                    <apex:pageBlockSectionItem >
                                        <apex:outputLabel value="Compliance Referral Comments" style="display:block;width:150px;font-weight:bold; font-size:11px" />
                                        <apex:inputField value="{!case.CL_Exception_Review_Comments__c}" style="width:375px;height:140px;font-size:12px;" required="{!case.CL_Exception_Review_Disposition__c='Investigation Required' || case.CL_Exception_Review_Disposition__c='No Investigation Required' || case.CL_Exception_Review_Disposition__c='Pending Review' || case.Referral_Opt_In__c='Monitoring Review'}" />
                                    </apex:pageBlockSectionItem>
                                </apex:pageblocksection>
                            </apex:outputPanel>
                        </apex:pageBlockSectionItem>
                        
                        <apex:pageBlockSectionItem >
                            <apex:outputPanel style="width:30px" >
                                <apex:pageblocksection columns="1">
                                    <apex:pageBlockSectionItem >
                                        <apex:outputLabel value="Compliance SME Review Comments"  style="display:block;width:150px;" />
                                        <apex:inputField value="{!case.C_L_Investigation_Comments__c}" style="width:380px;height:140px;" />
                                    </apex:pageBlockSectionItem> 
                                </apex:pageblocksection>
                            </apex:outputPanel>                                         
                        </apex:pageBlockSectionItem>
                        
                    </apex:pageblocksection>   
                    <!--Start April 2017-->
                    <apex:actionRegion >    
                        <apex:pageblocksection >                 
                            <apex:pageBlockSectionItem >
                                <apex:outputPanel >
                                    <apex:pageblocksection >
                                        <apex:pageblocksectionItem >
                                            <apex:outputLabel value="Compliance Review: Case Quality" style="display:block;width:143px;" />
                                            <apex:inputField value="{!Case.Compliance_Review_Case_Quality__c}" styleClass="myMultiClass" >
                                                <apex:actionSupport event="onchange" rerender="QualityCommentsField" status="QualityFields"/>
                                            </apex:inputField>
                                        </apex:pageblocksectionItem>
                                    </apex:pageblocksection>
                                </apex:outputPanel>                 
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        
                        <apex:pageblocksection id="QualityCommentsField" columns="2">                    
                            <apex:pageBlockSectionItem >
                                <apex:outputPanel >
                                    <apex:pageblocksection columns="1" >
                                        <apex:pageblocksectionItem >
                                            <apex:outputLabel value="Compliance Review: Case Quality Comments" style="display:block;width:143px;" />
                                            <apex:define name="requiredClientFeedback">
                                                <div class="requiredInput">
                                                    <!--For CMI 2015 Iteration 3, this field is rendered as required if Referral opt in is not null-->
                                                    <div class="requiredBlock" style="{!IF(OR(case.Compliance_Review_Case_Quality__c!=null),'background-color:C00','background-color:transparent')}"></div>
                                                    <apex:inputField value="{!case.Compliance_Case_Comments__c}" style="width:380px;height:140px;"  />
                                                </div>
                                            </apex:define>                      
                                        </apex:pageblocksectionItem>
                                    </apex:pageblocksection>
                                </apex:outputPanel>                 
                            </apex:pageBlockSectionItem>
                        </apex:pageBlockSection>
                        <apex:actionStatus id="QualityFields">
                            <apex:facet name="start">
                                <div style="text-align:center;">
                                    <img src="{!$Resource.SpinIcon}"/>
                                </div>
                            </apex:facet>
                        </apex:actionStatus> 
                    </apex:actionRegion>
                    <!--End April 2017-->      
                    
                    
                    
                </apex:pageBlockSection>
            </apex:outputPanel>
            <!--End of "ComplianceEvaluationSummary"-->
            <!--End Changes for CMI 2014-->
            
            <!--Start Changes for CMI 2014-->
            <!--<apex:outputPanel id="caseStatusSummaryPopup">
<apex:outputPanel styleClass="popupBackground" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}"/>
<apex:outputPanel styleClass="custPopup" layout="block" rendered="{!case.status='Closed' && messageNotSeenByUser==true}">
<div align="center" style="height:70%">
<apex:outputText style="font-weight:800;" value="{!messageBody}"/>
</div>
<div style="height:35%">
<apex:actionRegion >
<apex:commandButton style="margin-left:45%" value="OK" action="{!closeCaseStatusSummaryPopup}" reRender="caseStatusSummaryPopup"/>
</apex:actionRegion>
</div>
</apex:outputPanel>
</apex:outputPanel>-->
            <!--End Changes for CMI 2014-->
            <!--Start changes for CMI 2014 Release 3 Warranty fixes 2 -->
            
            
            
            <!--End changes for CMI 2014 Release 3 Warranty fixes 2 --> 
            <!-- Start changes for Feb 2016 Monthly release -->
            <!-- Start changes for Feb 2017 Monthly release -->
            <apex:actionRegion >
                <apex:pageBlockSection id="exempt" columns="2" title="System Assigned fields">                                
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="{!$ObjectType.Case.fields.Exempt_from_CPR_Reporting__c.label}"/>
                        
                        <apex:inputField value="{!case.Exempt_from_CPR_Reporting__c}">
                            <apex:actionSupport event="onchange" action="{!exemptFromCAOReportingOverriden}" status="exemptStatus" rerender="exempt,exempt1"/>
                        </apex:inputField>
                        
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageBlockSectionItem >
                        <!--<apex:outputLabel value="ByPass Validation"/>
<apex:inputcheckbox value="{!case.Bypass_Validation__c}"/>-->
                    </apex:pageBlockSectionItem>
                    
                    
                    <apex:pageBlockSectionItem id="exemptOverrideForCheck">
                        <apex:outputLabel value="Mandated ACK SLA Met Override" />
                        <apex:inputField value="{!case.Mandated_ACK_SLA_Met__c }">
                            <apex:actionSupport event="onchange" action="{!exemptFromCAOReportingOverridenforACKOverride}" status="exemptStatus" rerender="exempt,exempt1"/>
                        </apex:inputField>
                    </apex:pageBlockSectionItem>
                    
                    <apex:pageblocksectionItem ></apex:pageblocksectionItem> 
                    
                    
                    <apex:pageBlockSectionItem id="exemptOverrideForResponse">
                        <apex:outputLabel value="Mandated Response SLA Met Override" />
                        <apex:inputField value="{!case.Mandated_Response_SLA_Met_Override__c}">
                            <apex:actionSupport event="onchange" action="{!exemptFromCAOReportingOverridenforRESPoverride}" status="exemptStatus" rerender="exempt,exempt1"/>
                        </apex:inputField>
                    </apex:pageBlockSectionItem>                               
                    
                </apex:pageBlockSection>
                
                <apex:pageblocksection columns="1" id="exempt1">
                    <apex:pageBlockSectionItem id="exemptOverride">
                        <apex:outputLabel value="{!$ObjectType.Case.fields.Exempt_from_CAO_Reporting_Override__c.label}" rendered="{!((assignDisplayExemptOverride)|| (assignDisplayExemptOverrideforACKoverride) || (assignDisplayExemptOverrideforRESPoverride))|| ((case.Exempt_from_CAO_Reporting_Override__c != null && case.Exempt_from_CAO_Reporting_Override__c != '')) || ((case.Exempt_from_CAO_Reporting_Override__c == null || case.Exempt_from_CAO_Reporting_Override__c == '') && (previousValueForExempt))}" />
                        <apex:define name="requiredInputDiv"> 
                            <div class="requiredInput"> 
                                <div class="requiredBlock"></div>
                                <apex:inputField value="{!case.Exempt_from_CAO_Reporting_Override__c}" rendered="{!((assignDisplayExemptOverride)|| (assignDisplayExemptOverrideforACKoverride) || (assignDisplayExemptOverrideforRESPoverride))|| ((case.Exempt_from_CAO_Reporting_Override__c != null && case.Exempt_from_CAO_Reporting_Override__c != '')) || ((case.Exempt_from_CAO_Reporting_Override__c == null || case.Exempt_from_CAO_Reporting_Override__c == '') && (previousValueForExempt))}"  style="width:1000px" />
                            </div>
                        </apex:define>
                    </apex:pageBlockSectionItem>
                </apex:pageblocksection>   
                
            </apex:actionRegion>
            <apex:actionStatus id="exemptStatus">
                <apex:facet name="start">
                    <div style="text-align:center;">
                        <img src="{!$Resource.SpinIcon}"/>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <!-- End changes for Feb 2016 Monthly release -->           
        </apex:pageBlock>
        <!--    
// This is used to set the focus, because after validation rule errors
// the calendar for the Month_Year_Problem_Started__c was automatically 
// popping open making for a bad user experience.
-->
        <script language="text/javascript">
        <body onload="setFocus()">
            </script>
