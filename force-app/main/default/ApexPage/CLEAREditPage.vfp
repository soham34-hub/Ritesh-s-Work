        <!-- ******************************************* --> 
        
        <apex:pageBlockSection id="refund" title="Resolution Details"><!--id attribute in pageBlockSection added for CMI 2014 break/fixes-->
            <!--For CMI 2014 break/fixes, Relief Amount and Relief Type fields should be rendered when Relief Provided is 'Monetary Relief'-->
            <apex:pageblocksectionitem >
                <apex:outputlabel value="Relief Provided?"/>
                <apex:actionRegion > 
                    <apex:inputField value="{!case.Refund__c}"> 
                        <apex:actionSupport event="onchange" reRender="refund" status="resolutionDetailsStatus" /> 
                    </apex:inputField> 
                </apex:actionRegion> 
            </apex:pageblocksectionitem>
            <apex:inputField value="{!case.Remediation__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
            <!--For CMI 2015 Iteration2 the below field is rendered for Non-Monetary Relief also-->
            <!--start changes for CMI 2016 October release-->
            <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Monetary Relief' || case.Refund__c='Monetary Relief'}"/><!--Rendering condition and Required attribute added for CMI 2014 break/fixes-->
             <br/><br/><apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!case.Refund__c='Closed With Non-Monetary Relief'   || case.Refund__c='Non-Monetary Relief'}"/>
             <apex:inputField value="{!case.Type_of_Refund__c}" required="true" rendered="{!Case.Refund__c='Closed With Explanation' }"/>
            <!--end changes for CMI 2016 October release-->
        </apex:pageBlockSection>
        
        <!--Start Changes for CMI 2014 break/fixes-->
        <apex:actionStatus id="resolutionDetailsStatus"> 
            <apex:facet name="start"> 
                <div style="text-align:center;"> 
                    <img src="{!$Resource.SpinIcon}"/> 
                </div> 
            </apex:facet> 
        </apex:actionStatus>
        <!--End Changes for CMI 2014 break/fixes-->
 
                        
        <!-- ******************************************* --> 
        <!-- *       WAS THIS A MIDIRECTED COMUNICATION* --> 
        <!-- ******************************************* --> 

        <apex:pageBlockSection title="Was This a Misdirected Communication?" columns="1"> 
            <apex:inputField value="{!case.Misdirected_Category__c}" />
            <apex:inputField value="{!case.Misdirected_Call_Comments__c}" style="width:500px;height:140px;" />
        </apex:pageBlockSection> 
                          
        <!-- ********************************************************** --> 
        <!-- *   R E S E A R C H   F O L L O W   U P   N E E D E D    * --> 
        <!-- ********************************************************** --> 

        <!--<apex:pageBlockSection title="Research/Follow Up Needed?"> 
            <apex:inputField value="{!case.Follow_Up_to_Case__c}" 
